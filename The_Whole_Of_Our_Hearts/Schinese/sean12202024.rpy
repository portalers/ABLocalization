translate Schinese sean12202024kcp2_4017544c:

    # rocco "So I'm guessing you called them? How long are they gonna take?"
    rocco "所以你是打给他们了？他们说要多久？"

# game/sean12202024.rpy:1990
translate Schinese sean12202024kcp2_dc996a1b:

    # sean Embarrassed "..."
    sean Embarrassed "……"


translate Schinese sean12202024kcp2_f7fd280a:

    # sean Neutral "Neither of you called 9-1-1."
    sean Neutral "你们两个都没打911。"

# game/sean12202024.rpy:1976
translate Schinese sean12202024kcp2_1eca8f04:

    # "They both just look at me."
    "他们两个呆看着我。"

# game/sean12202024.rpy:1977
translate Schinese sean12202024kcp2_c76be41b:

    # "Really guys."
    "真的假的。"

# game/sean12202024.rpy:1980
translate Schinese sean12202024kcp2_cab676ab:

    # rocco "They would take an hour to get here. Cops are useless for shit like this."
    rocco "他们要一小时才会到。这种事找警察没用。"

# game/sean12202024.rpy:1983
translate Schinese sean12202024kcp2_aa93de77:

    # sean "I'm pretty sure the fire department is literally two blocks away."
    sean "消防局不就只离这里两个街区吗。"


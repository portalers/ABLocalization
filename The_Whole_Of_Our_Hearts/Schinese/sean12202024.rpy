# game/sean12202024.rpy:2135
translate Schinese sean12202024kcp2_e369be49:

    # narrator Scared "I shrug and start to follow them. Only to immediately stop as our eyes go wide."
    narrator Scared "我耸耸肩，跟着他们。大家却立刻停住，瞪大双眼。"

# game/sean12202024.rpy:2140
translate Schinese sean12202024kcp2_76b2fe88:

    # nvl clear
    nvl clear

# game/sean12202024.rpy:2154
translate Schinese sean12202024kcp2_1df15131:

    # nulln Scared "Crawling on the ground towards us is a Raccoon."
    nulln Scared "一只浣熊正爬向我们。"

# game/sean12202024.rpy:2155
translate Schinese sean12202024kcp2_a5bdbf5e:

    # nulln "He pulls himself forward on a four fingered paw."
    nulln "用一只四指的爪把自己往前拉进。"

# game/sean12202024.rpy:2156
translate Schinese sean12202024kcp2_5ee9f4bb:

    # nulln "A noose wrapped around his neck."
    nulln "脖子上缠着绞索。"

# game/sean12202024.rpy:2157
translate Schinese sean12202024kcp2_a0a915eb:

    # nulln "Dark blue ichor leaks from his body dripping down below him into the dark abyss."
    nulln "深蓝色的体液从他身上渗出，滴落到下方的黑暗深渊。"

# game/sean12202024.rpy:2158
translate Schinese sean12202024kcp2_8d979d9b:

    # nulln "In our stunned silence we can hear his pained breathing."
    nulln "我们震惊而沉默，听见他苦痛的呼吸声。"

# game/sean12202024.rpy:2159
translate Schinese sean12202024kcp2_e0f52357:

    # nulln "His lone eye meets ours as more ichor drains from an empty socket."
    nulln "他仅剩的一只眼对上我们的目光，更多体液从空洞的眼窝流下。"

# game/sean12202024.rpy:2161
translate Schinese sean12202024kcp2_4a7a265d:

    # nulln "At first he looks sad, but then relief floods his face."
    nulln "他起初神色悲伤，但脸上随即涌现解脱。"

# game/sean12202024.rpy:2162
translate Schinese sean12202024kcp2_e6ac1103:

    # nulln "Like he just found help."
    nulln "像是终于找到了救援。"

# game/sean12202024.rpy:2168
translate Schinese sean12202024kcp2_6abada4f:

    # nulln "Arthur takes a step forward, but Rocco juts out a paw."
    nulln "Arthur向前踏一步，但Rocco伸出一爪挡着。"

# game/sean12202024.rpy:2169
translate Schinese sean12202024kcp2_b1e9ad35:

    # nulln "The dog is on edge. His tail is stiff and his fur is standing on end. I see him bare his fangs at the poor raccoon."
    nulln "狗在警戒，尾巴僵硬、毛发直竖，对那可怜的浣熊露出獠牙。"

# game/sean12202024.rpy:2171
translate Schinese sean12202024kcp2_2041ad3b:

    # nulln "In a moment he stops, seeing something we don't."
    nulln "片刻后他就僵住，察觉了我们没看见的东西。"

# game/sean12202024.rpy:2172
translate Schinese sean12202024kcp2_69d22b97:

    # nvl clear
    # nulln "I scan around the raccoon trying to make out what he saw in the darkness."
    nvl clear
    nulln "我扫视浣熊周围，想看清他在黑暗中看到了什么。"

# game/sean12202024.rpy:2174
translate Schinese sean12202024kcp2_b972838c:

    # nulln "There's horror in Rocco's eyes."
    nulln "Rocco眼中充满恐惧。"

# game/sean12202024.rpy:2175
translate Schinese sean12202024kcp2_40e57df2:

    # nulln "Like he just realized something."
    nulln "像是刚意识到了什么。"

# game/sean12202024.rpy:2188
translate Schinese sean12202024kcp2_dd8f4ce4:

    # rocco "RUN!"
    rocco "{b}快跑！{/b}"

# game/sean12202024.rpy:2198
translate Schinese sean12202024kcp2_26059cd2:

    # "In an instant Arthur is thrown into me and we bolt. I hear a wheezing cry as we start sprinting away from the raccoon."
    "倾刻间，Arthur被推到我身上，我们拔腿狂奔。跑离浣熊时，我听见一声哭喊般的绝叫。"

# game/sean12202024.rpy:2216
translate Schinese sean12202024kcp2_7dae7b03:

    # arthur sideSeanHole Scared "W-What the fuck dude! He needs help!"
    arthur sideSeanHole Scared "搞、搞什么鬼啊！他需要帮助！"

# game/sean12202024.rpy:2220
translate Schinese sean12202024kcp2_83e7d41a:

    # rocco "KEEP FUCKING RUNNING AND DON'T LOOK BACK!"
    rocco "{b}给我他妈继续跑，别回头！{/b}"

# game/sean12202024.rpy:2223
translate Schinese sean12202024kcp2_e669331d:

    # "We continue to sprint away from the poor man."
    "我们继续跑离那可怜的男人。"

# game/sean12202024.rpy:2224
translate Schinese sean12202024kcp2_4d822a00:

    # "We run and we run into the dark abyss. Farther away from where we entered."
    "我们不断冲进黑暗深渊，离入口越来越远。"

# game/sean12202024.rpy:2225
translate Schinese sean12202024kcp2_19756e05:

    # "I don't think it matters at this point. We weren't ever getting out of here."
    "事到如今，这大概已经不重要了。反正我们根本就出不去。"

# game/sean12202024.rpy:2229
translate Schinese sean12202024kcp2_6baede1f:

    # rocco "WHATEVER HAPPENED TO THAT GUY AIN'T HAPPENIN' TO US!"
    rocco "{b}我们绝对不能碰上那人遭遇的事！{/b}"

# game/sean12202024.rpy:2232
translate Schinese sean12202024kcp2_43c5c0bf:

    # narrator Crying "I feel my legs begin to burn. I hadn't run this fast, for this long, in a while."
    narrator Crying "我双腿开始发疼。我好久没跑这么快、这么久了。"

# game/sean12202024.rpy:2233
translate Schinese sean12202024kcp2_d3d73a35:

    # "I could see that Arthur was also struggling. I know the lion was more in shape than I, but lugging that bari must be a pain for him."
    "我看得出Arthur也很吃力。我知道那狮子体能比我好，但扛着那把萨克斯风想必也很不好过。"

# game/sean12202024.rpy:2236
translate Schinese sean12202024kcp2_74c891bc:

    # rocco "D-DON'T LOOK BACK! KEEP FUCKING RUNNING!"
    rocco "{b}不、不要回头！他妈一直跑就对了！{/b}"

# game/sean12202024.rpy:2240
translate Schinese sean12202024kcp2_a34c9a47:

    # narrator Scared "Arthur's pace is starting to slow and I can feel my legs giving out."
    narrator Scared "Arthur步伐开始变慢，我也感觉双腿快撑不住了。"

# game/sean12202024.rpy:2241
translate Schinese sean12202024kcp2_f216ac90:

    # "I see the lion stumble a bit. He's able to catch himself, but he can't keep running for long."
    "狮子踉跄了一下。他勉强稳住，但撑不了多久了。"

# game/sean12202024.rpy:2244
translate Schinese sean12202024kcp2_361c5ddc:

    # rocco Trauma "ARTHUR DITCH THE FUCKING SAX! THIS ISN'T A JOKE!"
    rocco Trauma "{b}ARTHUR你他妈快丢了那把萨克斯风！这不是在开玩笑！{/b}"

# game/sean12202024.rpy:2247
translate Schinese sean12202024kcp2_6c0d3984:

    # arthur "Door!"
    arthur "门！"

# game/sean12202024.rpy:2251
translate Schinese sean12202024kcp2_f403b678:

    # rocco "What?"
    rocco "什么？"

# game/sean12202024.rpy:2255
translate Schinese sean12202024kcp2_6c0d3984_1:

    # arthur "Door!"
    arthur "有门！"

# game/sean12202024.rpy:2258
translate Schinese sean12202024kcp2_4fd35e93:

    # narrator Concerned "Between heavy breaths I see it."
    narrator Concerned "在沉重的呼吸间，我看到了。"

# game/sean12202024.rpy:2270
translate Schinese sean12202024kcp2_2bcd7abf:

    # "A door in the middle of the darkness."
    "黑暗正中央有一扇门。"

# game/sean12202024.rpy:2271
translate Schinese sean12202024kcp2_facc00f9:

    # "It's perfectly lit despite there being no light."
    "明明没有光源，却被完整照亮。"

# game/sean12202024.rpy:2277
translate Schinese sean12202024kcp2_3d3294c1:

    # "Rocco rushes ahead of us and shoulder bashes the mysterious door open."
    "Rocco冲到我们前面，用肩膀撞开那扇神秘的门。"

# game/sean12202024.rpy:2279
translate Schinese sean12202024kcp2_fd8cd527:

    # "We use the last of our energy to get in, and he slams the door shut."
    "我们用尽最后的力气冲进去后，他甩上门。"

# game/sean12202024.rpy:2301
translate Schinese sean12202024kcp2_9ba2077c:

    # narrator sideSeanHole Scared "I stop myself in the middle of the room, paws on my knees heaving."
    narrator sideSeanHole Scared "我停在房间中央，双爪撑着膝盖喘息。"

# game/sean12202024.rpy:2302
translate Schinese sean12202024kcp2_df9e6958:

    # "I look over to Arthur who looks like he's about to throw up."
    "我看向Arthur，他好像快吐了。"

# game/sean12202024.rpy:2303
translate Schinese sean12202024kcp2_6d58e0e7:

    # "I stumble over to the poor lion and help him set his bari on the side of a bed."
    "我蹒跚地走到可怜的狮子身边，帮他把萨克斯风放到一张床边。"

# game/sean12202024.rpy:2304
translate Schinese sean12202024kcp2_47068f95:

    # "After I catch my breath I give the room a quick scan."
    "喘过来气后，我快速扫视这个房间。"

# game/sean12202024.rpy:2305
translate Schinese sean12202024kcp2_884dcff6:

    # "Wait a second."
    "等一下。"

# game/sean12202024.rpy:2307
translate Schinese sean12202024kcp2_57716eb0:

    # sean Concerned "Rocco... why does this place look like your room?"
    sean Concerned "Rocco……这里怎么好像是你的房间？"

# game/sean12202024.rpy:2324
translate Schinese sean12202024ka_d640cf50:

    # nvl clear
    # narrator sideSean Neutral "I wake up to the harsh rays of the sun."
    nvl clear
    narrator sideSean Neutral "我被刺眼的阳光唤醒。"

# game/sean12202024.rpy:2330
translate Schinese sean12202024ka_a608e333:

    # narrator sideSean Happy "I look at my phone and sure enough there's already a text message from Cody."
    narrator sideSean Happy "我看了眼手机，果然Cody已经传讯息来了。"

# game/sean12202024.rpy:2349
translate Schinese sean12202024ka_d1d82383:

    # narrator sideSean Neutral "It takes Cody a couple minutes to respond."
    narrator sideSean Neutral "Cody过了几分钟才回。"

# game/sean12202024.rpy:2362
translate Schinese sean12202024ka_9c874e57:

    # codyPhone sideSean Happy "Rocco made the reservation for the three of us."
    codyPhone sideSean Happy "Rocco已经帮我们三个预约好了。"

# game/sean12202024.rpy:2367
translate Schinese sean12202024ka_13b683aa:

    # codyPhone sideSean Neutral "4 :/"
    codyPhone sideSean Neutral "4 :/"

# game/sean12202024.rpy:2371
translate Schinese sean12202024ka_7f844392:

    # codyPhone sideSean Happy "I know... but it gives us plenty of time to check out stuff at the mall!"
    codyPhone sideSean Happy "我知道……但至少有很多时间能逛商场！"

# game/sean12202024.rpy:2376
translate Schinese sean12202024ka_76b2fe88:

    # nvl clear
    nvl clear

# game/sean12202024.rpy:2382
translate Schinese sean12202024ka_2301857f:

    # nulln Neutral "I just sit on my bed for a moment. The weight of yesterday's investigation settled in my mind."
    nulln Neutral "我在床上静坐了一会儿。昨天调查的重担沉在我心里。"

# game/sean12202024.rpy:2383
translate Schinese sean12202024ka_e24422b9:

    # nulln "A filled hotel with no one in it. Artificial eyes that captured their existence, yet no one to remember them."
    nulln "一家住满人的旅馆，里面却空无一人。人造之眼捕捉到了他们的存在，却没有活人记得他们；"

# game/sean12202024.rpy:2384
translate Schinese sean12202024ka_2d363daa:

    # nulln Quiet2 "Artifacts left behind uncovered by archeologists that live in their same generation."
    nulln Quiet2 "与他们同时代的考古学家，发掘出了被其遗留下的文物。"

# game/sean12202024.rpy:2385
translate Schinese sean12202024ka_127e6a7c:

    # nulln "And a hole that swallowed a chunk of the world I'm forced to call home."
    nulln "还有一个大洞，吞没了我被迫称为家的世界的一部分。"

# game/sean12202024.rpy:2386
translate Schinese sean12202024ka_45418277:

    # nulln "All kept in those walls."
    nulln "全都保存在那些墙壁里。"

# game/sean12202024.rpy:2387
translate Schinese sean12202024ka_1129b32e:

    # nulln "Like a museum during the apocalypse dedicated to those who died in it."
    nulln "彷佛末日时期为了死去之人而存在的博物馆。"

# game/sean12202024.rpy:2388
translate Schinese sean12202024ka_0b68d251:

    # nulln "Hopefully those people aren't dead."
    nulln "希望那些人还活着。"

# game/sean12202024.rpy:2390
translate Schinese sean12202024ka_56822ae0:

    # nvl clear
    # nulln Concerned "I try to piece together everything on my trip back. The conversations I had with myself on the drive home."
    nvl clear
    nulln Concerned "我试着拼凑回家路上的一切。开车回家时的自言自语。"

# game/sean12202024.rpy:2392
translate Schinese sean12202024ka_0bad70d7:

    # nulln Scrutinizing "Stopping for gas, and then miraculously having s'more stuff for the campfire."
    nulln Scrutinizing "停下来加油，然后奇迹般地有了用营火烤的棉花糖。"

# game/sean12202024.rpy:2393
translate Schinese sean12202024ka_106f7ef1:

    # nulln "It was strange."
    nulln "很奇怪。"

# game/sean12202024.rpy:2394
translate Schinese sean12202024ka_f0f0ed7a:

    # nulln "I don't remember picking anything up from the gas station, but we still had s'mores that night."
    nulln "我不记得有在加油站买东西，但当晚我们确实有棉花糖。"

# game/sean12202024.rpy:2397
translate Schinese sean12202024ka_ba177fd4:

    # nulln Neutral "What was stranger was me walking off by myself."
    nulln Neutral "更奇怪的是，我是单独走开的。"

# game/sean12202024.rpy:2398
translate Schinese sean12202024ka_8a2b77ca:

    # nulln "I mean sure it was a long ride, but I should've asked Rocco and Cody if they wanted to come with me."
    nulln "车程很长不假，但我还是应该问问Rocco和Cody要不要一起散步。"

# game/sean12202024.rpy:2399
translate Schinese sean12202024ka_90f824b4:

    # nulln Quiet2 "Especially with how weird Cody has been acting I really should've been there for him."
    nulln Quiet2 "尤其Cody最近表现得这么怪，我真该多陪陪他。"

# game/sean12202024.rpy:2400
translate Schinese sean12202024ka_ec6c2269:

    # nulln "Talking to myself doesn't really fix anything."
    nulln "自言自语根本没有帮助。"

# game/sean12202024.rpy:2401
translate Schinese sean12202024ka_cc7113c9:

    # nvl clear
    # nulln "Cody having a scalpel in his bathroom makes me ditching him even worse."
    nvl clear
    nulln "Cody浴室里有手术刀，让我抛下他这件事变得更不妙。"

# game/sean12202024.rpy:2403
translate Schinese sean12202024ka_05a241c2:

    # nulln "He had been waiting all semester to finally hang out."
    nulln "他等了整整一学期，才终于能一起玩。"

# game/sean12202024.rpy:2404
translate Schinese sean12202024ka_61bd646d:

    # nulln Neutral "Wait..."
    nulln Neutral "等等……"

# game/sean12202024.rpy:2405
translate Schinese sean12202024ka_4527daab:

    # nulln Scrutinizing "I never went into his bathroom."
    nulln Scrutinizing "我根本没进过他的浴室。"

# game/sean12202024.rpy:2406
translate Schinese sean12202024ka_f44ee554:

    # nulln Neutral "How would I know- No, stop over thinking things."
    nulln Neutral "又怎么会知道……不，别想太多了。"

# game/sean12202024.rpy:2407
translate Schinese sean12202024ka_56893ddd:

    # nulln "I need to retrace these past days not dive into one thing."
    nulln "不能只着眼一件事，应该追溯这几天。"

# game/sean12202024.rpy:2409
translate Schinese sean12202024ka_21aecda2:

    # nulln Concerned "I still don't understand why I thought it was a good idea to leave Cody alone."
    nulln Concerned "我还是不明白怎么会觉得独留Cody一个人是个好主意。"

# game/sean12202024.rpy:2410
translate Schinese sean12202024ka_4777fd51:

    # nulln "He had been waiting all semester to hang out with Rocco and I."
    nulln "他等了整个学期，才终于能跟Rocco和我一起玩。"

# game/sean12202024.rpy:2411
translate Schinese sean12202024ka_4363c2e5:

    # nulln Neutral "I guess I needed answers, and walking with Cody wouldn't give them to me."
    nulln Neutral "我需要答案，跟Cody一起走是得不到的。"

# game/sean12202024.rpy:2412
translate Schinese sean12202024ka_5ef31a80:

    # nvl clear
    # nulln "It wouldn't be fair to him to be in that stressful of a situation, but it's also not fair to ditch him for Rocco."
    nvl clear
    nulln "给他太大压力固然不好，但为了Rocco而抛下他也不公平。"

# game/sean12202024.rpy:2414
translate Schinese sean12202024ka_c119c0c3:

    # nulln "It's still weird though, who was he talking to when I got back?"
    nulln "不过还是很奇怪，我回来的时候，他是在跟谁说话？"

# game/sean12202024.rpy:2415
translate Schinese sean12202024ka_3c6ec978:

    # nulln Embarrassed "No, stop over thinking things. I need to retrace these past days not dive into one thing."
    nulln Embarrassed "不，别想太多了。不能只着眼一件事，应该追溯这几天。"

# game/sean12202024.rpy:2416
translate Schinese sean12202024ka_76b2fe88_1:

    # nvl clear
    nvl clear

# game/sean12202024.rpy:2418
translate Schinese sean12202024ka_8c821195:

    # nulln Neutral "What was even weirder was taking an entire wing to myself."
    nulln Neutral "更奇怪的是，我一个人包下了整个侧翼。"

# game/sean12202024.rpy:2419
translate Schinese sean12202024ka_ee079b90:

    # nulln "Standing outside that smelly room for so long and then just leaving it."
    nulln "都站在那臭房间外头那么久了，却又直接离开。"

# game/sean12202024.rpy:2420
translate Schinese sean12202024ka_e2a90eaa:

    # nulln "Talking with myself about Cody, and then Sarah's room."
    nulln "自言自语谈论Cody，还有Sarah的房间。"

# game/sean12202024.rpy:2421
translate Schinese sean12202024ka_ff54cde7:

    # nulln "The fact that she had recorded evidence of her husband assaulting her, but she didn't remember who he was."
    nulln "她录下了丈夫施暴的证据，却不记得他是谁。"

# game/sean12202024.rpy:2422
translate Schinese sean12202024ka_1a6e35dc:

    # nulln Concerned "Was that what happened to Rocco?"
    nulln Concerned "那就是发生在Rocco身上的事吗？"

# game/sean12202024.rpy:2423
translate Schinese sean12202024ka_9512283b:

    # nulln "Are they going through the same stuff?"
    nulln "他们是在经历同样的事吗？"

# game/sean12202024.rpy:2424
translate Schinese sean12202024ka_0452eade:

    # nulln "I mean, I don't talk to myself{cps=5}... {/cps}out loud."
    nulln "我知道自己不会自言自语{cps=5}……{/cps}不会脱口而出的。"

# game/sean12202024.rpy:2425
translate Schinese sean12202024ka_62c4c092:

    # nulln Quiet2 "Am I forgetting someone..."
    nulln Quiet2 "我是不是忘了谁……"

# game/sean12202024.rpy:2426
translate Schinese sean12202024ka_4213b2c1:

    # nvl clear
    # nulln Embarrassed "No..."
    nvl clear
    nulln Embarrassed "不……"

# game/sean12202024.rpy:2428
translate Schinese sean12202024ka_4b075b78:

    # nulln "No, that's impossible."
    nulln "不会的，那不可能。"

# game/sean12202024.rpy:2429
translate Schinese sean12202024ka_67afbbe8:

    # nulln "There's no way I would forget anyone!"
    nulln "我不可能会忘记任何人！"

# game/sean12202024.rpy:2430
translate Schinese sean12202024ka_17efbcf9:

    # nulln "I've just been verbalizing everything that's been stressing me out."
    nulln "我只是把所有给我压力的事都说出口而已。"

# game/sean12202024.rpy:2431
translate Schinese sean12202024ka_71170feb:

    # nulln Trauma "I did that after Casey-"
    nulln Trauma "我之前就那样做过了，是在Casey——"

# game/sean12202024.rpy:2433
translate Schinese sean12202024ka_76b2fe88_2:

    # nvl clear
    nvl clear

# game/sean12202024.rpy:2441
translate Schinese sean12202024ka_0b677f0c:

    # narrator sideSean Neutral "I spend most of the time waiting for Cody and Rocco on my phone."
    narrator sideSean Neutral "等Cody和Rocco的时候，我大部分时间都在滑手机。"

# game/sean12202024.rpy:2442
translate Schinese sean12202024ka_de927f44:

    # "Mom and Dad had already left for church.{nw}"
    "妈和爸已经出门去教会了。{nw}"

# game/sean12202024.rpy:2443
translate Schinese sean12202024ka_7132d065:

    # narrator Quiet2 "Mom and Dad had already left for church.{fast} The last time I went with them the sermon just so happened to be on 'curing homosexuality'."
    narrator Quiet2 "妈和爸已经出门去教会了。{fast}上次我和他们一起去的时候，讲道内容刚好是「治疗同性恋」。"

# game/sean12202024.rpy:2444
translate Schinese sean12202024ka_9c80cd45:

    # "I know they didn't plan it. It was my idea, and a spur of the moment decision."
    "那当然不是他们安排的。是我一时冲动，自己提出要去的。"

# game/sean12202024.rpy:2445
translate Schinese sean12202024ka_a018b736:

    # "I mostly wanted to go and see if I could finally visit Casey's grave."
    "主要是想去看看，是否终于能拜访Casey的墓。"

# game/sean12202024.rpy:2446
translate Schinese sean12202024ka_35384957:

    # narrator Sad "The ban still hasn't been lifted."
    narrator Sad "禁令至今未曾解除。"

# game/sean12202024.rpy:2460
translate Schinese sean12202024ka_009d5a04:

    # narrator sideSean Happy "The drive over is fairly uneventful."
    narrator sideSean Happy "开车过去的路上无事发生。"

# game/sean12202024.rpy:2461
translate Schinese sean12202024ka_492ddbce:

    # "Cody, looks a lot better than he did yesterday, and Rocco is definitely happy to get a day off."
    "Cody气色比昨天好多了，Rocco能放一天假显然很开心。"

# game/sean12202024.rpy:2462
translate Schinese sean12202024ka_6b1d7132:

    # narrator Neutral "The parking lot is surprisingly dead even though it's 1:00."
    narrator Neutral "停车场出奇地冷清，这都已经一点了。"

# game/sean12202024.rpy:2472
translate Schinese sean12202024ka_e9710c28:

    # narrator sideSean Neutral "Inside the story is mostly the same. Shutters are closed over many of the stores."
    narrator sideSean Neutral "里面的情况大致相同。许多店面的卷帘都拉上了。"

# game/sean12202024.rpy:2473
translate Schinese sean12202024ka_b58b8488:

    # "The soft pretzel booth that Casey and I always ate at was empty."
    "我和Casey以前常去吃的软脆饼摊位空无一人。"

# game/sean12202024.rpy:2474
translate Schinese sean12202024ka_11d3c868:

    # "The ceiling tiles were covered in water stains and buckets of rain water sat beneath them."
    "天花板的磁砖布满污渍，下面摆着接雨水的水桶。"

# game/sean12202024.rpy:2477
translate Schinese sean12202024ka_913caea5:

    # rocco "Damn... I don't remember this place being a shit hole."
    rocco "靠……我都不记得这里有这么破烂了。"

# game/sean12202024.rpy:2481
translate Schinese sean12202024ka_aa80ee9a:

    # cody "It's all a facade anyways."
    cody "反正都是表面功夫。"

# game/sean12202024.rpy:2484
translate Schinese sean12202024ka_aefdf207:

    # "We both look at Cody."
    "我俩一同看向Cody。"

# game/sean12202024.rpy:2488
translate Schinese sean12202024ka_323c645f:

    # cody Concerned "The place was slowly falling apart behind the scenes."
    cody Concerned "这地方本来就在慢慢崩坏。"

# game/sean12202024.rpy:2490
translate Schinese sean12202024ka_3aa0544f:

    # cody "Casey and I found an unlocked service door. Rocco, you were there, remember?"
    cody "我和Casey有找到一扇没锁的服务门。Rocco，你也在场，记得吗？"

# game/sean12202024.rpy:2495
translate Schinese sean12202024ka_9d40c947:

    # rocco Neutral "No?"
    rocco Neutral "不记得啊？"

# game/sean12202024.rpy:2498
translate Schinese sean12202024ka_ba4f178d:

    # cody "It was like four or five years ago.{nw}"
    cody "大概四五年前。{nw}"

# game/sean12202024.rpy:2501
translate Schinese sean12202024ka_f8bfacc4:

    # cody Happy "It was like four or five years ago.{fast} You kept getting scared thinking there were ghosts, or that we would get caught."
    cody Happy "大概四五年前。{fast}你一直很害怕，以为有鬼或会被人抓到。"

# game/sean12202024.rpy:2506
translate Schinese sean12202024ka_aa4ee7db:

    # rocco Neutral "Ghosts aren't real dipshit. Why would I be scared of something that doesn't exist?"
    rocco Neutral "世上又没有鬼，白痴。我干嘛要怕不存在的东西？"

# game/sean12202024.rpy:2509
translate Schinese sean12202024ka_28ce4bdd:

    # "We both pause looking at him."
    "我俩一同停下来看他。"

# game/sean12202024.rpy:2518
translate Schinese sean12202024ka_ca39f00c:

    # nulln Neutral "Rocco hated ghost stories, horror movies, or anything that was scary."
    nulln Neutral "Rocco讨厌鬼故事、恐怖电影，或任何可怕的东西。"

# game/sean12202024.rpy:2520
translate Schinese sean12202024ka_dcdc2d7a:

    # nulln "I remember he had to leave... No... No he stayed for Nightmare on Elm Street..."
    nulln "我记得他走掉……不对……他确实看完了《猛鬼街》……"

# game/sean12202024.rpy:2522
translate Schinese sean12202024ka_d7425e7c:

    # nulln "He sat next to Cody, and listened to him explain the practical effects. But he was scared of horror."
    nulln "他坐在Cody旁边，听他解释那些实景特效。但他的确怕恐怖片。"

# game/sean12202024.rpy:2523
translate Schinese sean12202024ka_85909f84:

    # nulln "He was-"
    nulln "他是——"

# game/sean12202024.rpy:2524
translate Schinese sean12202024ka_76b2fe88_3:

    # nvl clear
    nvl clear

# game/sean12202024.rpy:2531
translate Schinese sean12202024ka_113c7dba:

    # rocco Scared "Sean!"
    rocco Scared "Sean！"

# game/sean12202024.rpy:2534
translate Schinese sean12202024ka_12ca71dd:

    # "I jump as the dog bellows at me."
    "狗吼了我一声，吓了我一大跳。"

# game/sean12202024.rpy:2538
translate Schinese sean12202024ka_8051f850:

    # rocco Embarrassed "If you're gonna zonk out don't do it in the middle of the isle."
    rocco Embarrassed "你要发呆也别站在走道中间嘛。"

# game/sean12202024.rpy:2542
translate Schinese sean12202024ka_7af1bfeb:

    # "I turn to see the people now around me. There aren't a lot, but I am blocking their way."
    "我转头看到周围的人。虽然不多，但我挡住了他们的路。"

# game/sean12202024.rpy:2543
translate Schinese sean12202024ka_9995796e:

    # "I accidentally bump into someone as I awkwardly stumble back to the group."
    "我尴尬地退回他们那边时，还不小心撞到了其他人。"

# game/sean12202024.rpy:2546
translate Schinese sean12202024ka_a033f505:

    # sean "S-sorry. Rocco, I thought you hated scary stuff."
    sean "对、对不起。Rocco，我以为你讨厌恐怖类型的。"

# game/sean12202024.rpy:2549
translate Schinese sean12202024ka_3e2afb55:

    # narrator Neutral "He groans, I guess they had moved on from that."
    narrator Neutral "他呻吟一声，他们大概已经换了话题了。"

# game/sean12202024.rpy:2552
translate Schinese sean12202024ka_f30d4c0c:

    # rocco "It's gore that makes me want to throw up. I don't give a shit about scary stuff. It's not real."
    rocco "是血腥的部份会让我反胃。恐怖的部份我才不管。又不是真的。"

# game/sean12202024.rpy:2557
translate Schinese sean12202024ka_5dd6758a:

    # cody Embarrassed "You ok Sean?"
    cody Embarrassed "你还好吗Sean？"

# game/sean12202024.rpy:2560
translate Schinese sean12202024ka_d54cd148:

    # sean "Yeah... I just... who were we thinking of?"
    sean "还好……我只是……我们刚刚是在想谁的事？"

# game/sean12202024.rpy:2565
translate Schinese sean12202024ka_2ae62b78:

    # narrator Neutral "They both shrug and move on. We make our way over to the book store."
    narrator Neutral "他们双双耸肩继续走。我们走向书店。"

# game/sean12202024.rpy:2569
translate Schinese sean12202024ka_594e74d6:

    # cody "For some reason I thought you hated horror."
    cody "不知道为什么，我以为你讨厌恐怖片。"

# game/sean12202024.rpy:2572
translate Schinese sean12202024ka_b7310056:

    # rocco "It's gore that makes me want to throw up."
    rocco "是血腥的部份会让我反胃。"

# game/sean12202024.rpy:2573
translate Schinese sean12202024ka_91a1f1da:

    # rocco "I don't give a shit about 'scary' stuff. It's not real."
    rocco "恐怖的部份我才不管。又不是真的。"

# game/sean12202024.rpy:2577
translate Schinese sean12202024ka_8b3097f9:

    # narrator Happy "Ah, that makes sense."
    narrator Happy "哦，这就说得通了。"

# game/sean12202024.rpy:2578
translate Schinese sean12202024ka_09eb3d9a:

    # "We continue through the dead mall, and make our way over to the book store."
    "我们继续穿过死气沉沉的商场，走向书店。"

# game/sean12202024.rpy:2595
translate Schinese sean12202024ka_8757f749:

    # nulln sideSean Happy "Cody and I always loved coming here."
    nulln sideSean Happy "我和Cody一直都很喜欢来这里。"

# game/sean12202024.rpy:2598
translate Schinese sean12202024ka_69bf5cfa:

    # nulln "The library was great to snag old comics and adventure novels, but the store is where we could 'purchase' the new stuff."
    nulln "图书馆是很适合找旧漫画和冒险小说，但书店才是能「买」新东西的地方。"

# game/sean12202024.rpy:2600
translate Schinese sean12202024ka_657de0bf:

    # nulln "We'd find a book that looked interesting, or try to hunt down a copy of something we had already started, and read it."
    nulln "我们会来找感觉有意思的书，或继续读已经看过的。"

# game/sean12202024.rpy:2603
translate Schinese sean12202024ka_7200b7d7:

    # nulln "We each kept a memo pad of the books and page number we were on. That way we could just pick up where we left off."
    nulln "我们各自把看过的书和页数记在笔记上。这样就能从上次没看完的地方继续读。"

# game/sean12202024.rpy:2605
translate Schinese sean12202024ka_25d8c603:

    # nulln "I'm sure the employees didn't care, but to us it was the heist of the century."
    nulln "员工估计完全不在意，但对我们来说，那可是世纪大劫案。"

# game/sean12202024.rpy:2606
translate Schinese sean12202024ka_843e645c:

    # nulln "Casey would pretend to patrol the shelves on 'lookout' for any employees."
    nulln "Casey会穿梭书架间假装要找东西，充当「望风的」，以免有员工来。"

# game/sean12202024.rpy:2607
translate Schinese sean12202024ka_42b43d4b:

    # nulln "Rocco would find a chair like a normal person, and either chat with someone or take a nap."
    nulln "Rocco会像正常人一样找张椅子，要么跟人聊天，要么打瞌睡。"

# game/sean12202024.rpy:2608
translate Schinese sean12202024ka_76b2fe88_4:

    # nvl clear
    nvl clear

# game/sean12202024.rpy:2612
translate Schinese sean12202024ka_8100504f:

    # "Rocco really wasn't a book guy.{nw}"
    "Rocco不怎么爱看书。{nw}"

# game/sean12202024.rpy:2613
translate Schinese sean12202024ka_865f1a8f:

    # narrator Scrutinizing "Rocco really wasn't a book guy.{fast} Which was surprising when he picked up a copy of the second Dune book."
    narrator Scrutinizing "Rocco不怎么爱看书。{fast}所以他拿起《沙丘》第二集时，我很意外。"

# game/sean12202024.rpy:2617
translate Schinese sean12202024ka_b423637e:

    # rocco Embarrassed "Yes Sean, surprisingly I am literate."
    rocco Embarrassed "没错，Sean，我识字，意外吧。"

# game/sean12202024.rpy:2621
translate Schinese sean12202024ka_709d2401:

    # sean Neutral "I just didn't take you for a Sci-fi guy?"
    sean Neutral "我只是没想到你是科幻迷？"

# game/sean12202024.rpy:2627
translate Schinese sean12202024ka_32a4a4bc:

    # rocco "Oh? What do you think I'd read?"
    rocco "哦？那你觉得我会看什么？"

# game/sean12202024.rpy:2631
translate Schinese sean12202024ka_ff4c924b:

    # rocco "Oh? What do you think I'd read Gayboy?"
    rocco "哦？那你觉得我会看什么，小gay炮？"

# game/sean12202024.rpy:2640
translate Schinese sean12202024ka_4229aeeb:

    # rocco "I mean I tried some history stuff. Wanted to learn about the Britanics since the Smith name comes from there."
    rocco "我是有看过历史书。想了解一下不列颠人，毕竟Smith这个姓氏就是来自那里。"

# game/sean12202024.rpy:2643
translate Schinese sean12202024ka_dab4f8de:

    # sean Happy "Oh, that's cool! Why'd you stop?"
    sean Happy "喔，酷耶！那为什么不看了？"

# game/sean12202024.rpy:2648
translate Schinese sean12202024ka_841c3c65:

    # rocco Neutral "Well I went down a rabbit hole, and then got turned off finding some pseudo science bullshit."
    rocco Neutral "哦我越读越分心，最后看到一些伪科学鬼扯就没兴趣了。"

# game/sean12202024.rpy:2651
translate Schinese sean12202024ka_9ed134ce:

    # "Oh..."
    "喔……"

# game/sean12202024.rpy:2656
translate Schinese sean12202024ka_43b50f02:

    # rocco "Also those books were dry as hell!"
    rocco "而且那些书无聊得要死！"

# game/sean12202024.rpy:2661
translate Schinese sean12202024ka_f62293ad:

    # cody "I told you to read historical accounts at work. They may not be accurate, but they're meant to be entertaining."
    cody "我就叫你在工作的时候去读历史叙事啦。可能不准确，但至少有点意思。"

# game/sean12202024.rpy:2665
translate Schinese sean12202024ka_cb26ad3c:

    # "Rocco puts on a bad pompous voice."
    "Rocco夸张地装腔作势："

# game/sean12202024.rpy:2669
translate Schinese sean12202024ka_2749ee72:

    # rocco Happy "I am a scholar of truth! And I shalln't fill my brain with bullshit!"
    rocco Happy "我是真理的学者！莫要让头脑被鬼扯荼毒！"

# game/sean12202024.rpy:2672
translate Schinese sean12202024ka_f9f7cce1:

    # "We both laugh at that."
    "我们都被逗笑了。"

# game/sean12202024.rpy:2677
translate Schinese sean12202024ka_0c6d0350:

    # rocco "Oh yeah, Cody and I go down to the Renfaire every day eating mutton and catching the plague."
    rocco "对呀，Cody和我每天都会去文艺复兴市集吃羊肉、感染瘟疫。"

# game/sean12202024.rpy:2681
translate Schinese sean12202024ka_aaed66a4:

    # cody "Wait, is there a Renfaire nearby?"
    cody "等等，这附近有文艺复兴市集吗？"

# game/sean12202024.rpy:2684
translate Schinese sean12202024ka_f49565f2:

    # narrator Neutral "We both look at him."
    narrator Neutral "我俩一同看向他。"

# game/sean12202024.rpy:2689
translate Schinese sean12202024ka_002c0db7:

    # cody Embarrassed "What? It could be fun."
    cody Embarrassed "干嘛？可能很好玩啊。"

# game/sean12202024.rpy:2692
translate Schinese sean12202024ka_45ac2660:

    # rocco Neutral "Look I'm not into that nerd shit."
    rocco Neutral "我对那种宅物才没兴趣呢。"

# game/sean12202024.rpy:2697
translate Schinese sean12202024ka_3c4611e4:

    # sean "And sci-fi isn't 'nerd shit'?"
    sean "科幻就不「宅」了？"

# game/sean12202024.rpy:2700
translate Schinese sean12202024ka_1d2c45b4:

    # rocco "Sci-fi is sophisticated. Fantasy is about your type of men killing giant furless monsters."
    rocco "科幻高雅得很。奇幻才是你喜欢的那种男人去杀一堆大怪物的故事。"

# game/sean12202024.rpy:2705
translate Schinese sean12202024ka_40dad3bf:

    # sean Angry "Oh so the sci-fi novel about a cult, riding a worm, that poops drugs is high art."
    sean Angry "喔，讲述邪教、骑乘会拉出毒品的大虫的科幻小说就算高雅艺术了？"

# game/sean12202024.rpy:2708
translate Schinese sean12202024ka_df07569c:

    # narrator Neutral "I hear Cody snicker off to the side. Rocco is less impressed with my synopsis."
    narrator Neutral "Cody在旁边偷笑。Rocco则对我的摘要不太爽。"

# game/sean12202024.rpy:2712
translate Schinese sean12202024ka_ead69bfa:

    # sean Happy "Maybe you should give fantasy a shot."
    sean Happy "也许你该读点奇幻故事看看。"

# game/sean12202024.rpy:2719
translate Schinese sean12202024ka_56d286a9:

    # narrator Embarrassed "Rocco looks at me like a man ready to kill for the first time."
    narrator Embarrassed "Rocco看我的眼神，活像第一次准备好要杀人了。"

# game/sean12202024.rpy:2723
translate Schinese sean12202024ka_02aa6c8c:

    # rocco "I'm not dressing up as the dog that gets fucked in the coliseum!"
    rocco "我才不要打扮成在竞技场被操的狗！"

# game/sean12202024.rpy:2726
translate Schinese sean12202024ka_50b886df:

    # sean "That's not-"
    sean "那不是——"

# game/sean12202024.rpy:2729
translate Schinese sean12202024ka_7941b6ac:

    # rocco "I'm not doing it!"
    rocco "绝对不要！"

# game/sean12202024.rpy:2734
translate Schinese sean12202024ka_ff64812f:

    # cody "I tried..."
    cody "我试过了……"

# game/sean12202024.rpy:2738
translate Schinese sean12202024ka_bd7b0149:

    # sean Neutral "Wait... you didn't!"
    sean Neutral "等一下……真的假的！"

# game/sean12202024.rpy:2741
translate Schinese sean12202024ka_7a4da365:

    # "Rocco looks away embarrassed. Cody is just giggling to himself."
    "Rocco尴尬地别过脸。Cody暗自偷笑。"

# game/sean12202024.rpy:2744
translate Schinese sean12202024ka_a1b7b769:

    # sean Happy "Holy shit I was fucking around! You actually read-"
    sean Happy "我操，我只是想开个玩笑！但你真的看了——"

# game/sean12202024.rpy:2748
translate Schinese sean12202024ka_b869804d:

    # rocco "Sean not in public!"
    rocco "Sean，别在公共场合讲啦！"

# game/sean12202024.rpy:2752
translate Schinese sean12202024ka_2b5901f0:

    # sean "But I thought you weren't 'into that gay shit'."
    sean "我还以为你「对基佬玩意没兴趣」。"

# game/sean12202024.rpy:2756
translate Schinese sean12202024ka_813d3c7d:

    # rocco "Sean I swear to god!"
    rocco "Sean算我求你了！"

# game/sean12202024.rpy:2761
translate Schinese sean12202024ka_2e296179:

    # cody Neutral "I tried. He didn't want to read a story from a woman's perspective."
    cody Neutral "我试过了。他不想看女性视角的故事。"

# game/sean12202024.rpy:2764
translate Schinese sean12202024ka_6dffdd5d:

    # "There's venom to his words. Then Cody's tone is more teasing."
    "他语气不悦。而Cody则语带调侃。"

# game/sean12202024.rpy:2769
translate Schinese sean12202024ka_bf2f9e03:

    # cody "So I gave him a story from a man's."
    cody "我就给了他一本男性视角的。"

# game/sean12202024.rpy:2772
translate Schinese sean12202024ka_10d50498:

    # narrator Neutral "Rocco is blushing. He's doing everything in his power to avoid eye contact with me."
    narrator Neutral "Rocco脸红了。极力避免跟我对上眼。"

# game/sean12202024.rpy:2773
translate Schinese sean12202024ka_09598acc:

    # narrator Happy "You know what that serves him right."
    narrator Happy "我说吧，这是他活该。"

# game/sean12202024.rpy:2776
translate Schinese sean12202024ka_85d77e07:

    # cody "I was surprised when he told me he finished it."
    cody "我很意外他后来跟我说他看完了。"

# game/sean12202024.rpy:2781
translate Schinese sean12202024ka_98937c1d:

    # sean "Ok wait, what did you think?"
    sean "那，你觉得怎么样？"

# game/sean12202024.rpy:2784
translate Schinese sean12202024ka_ddb5e43c:

    # "Rocco has already left the isle wandering off into the store."
    "Rocco已经离开走道，在店里晃了。"

# game/sean12202024.rpy:2787
translate Schinese sean12202024ka_49b43811:

    # "We catch up with him, and the dog has immediately moved onto something else."
    "我们追上狗后，他马上就转移话题了。"

# game/sean12202024.rpy:2792
translate Schinese sean12202024ka_6313170f:

    # rocco Neutral "Well I do dickweed. My concussions haven't made me illiterate."
    rocco Neutral "我当然识字了，蠢货。脑震荡又没害我阅读困难。"

# game/sean12202024.rpy:2795
translate Schinese sean12202024ka_227d9ef9:

    # sean "Ok, well what do you read then Mr. Literate."
    sean "好吧，那你都读什么，识字男。"

# game/sean12202024.rpy:2800
translate Schinese sean12202024ka_c38187da:

    # rocco "Usually whatever Cody recommends. Outside of that it's mostly history stuff."
    rocco "通常都是Cody推荐的。除此之外大多是历史书籍。"

# game/sean12202024.rpy:2803
translate Schinese sean12202024ka_c66e009d:

    # rocco "I just finished one about all the rancid shit we did to the native people."
    rocco "我刚看完一本关于我们对原住民做过的那些糟心事。"

# game/sean12202024.rpy:2806
translate Schinese sean12202024ka_c48afb28:

    # cody "Yeah that one is a hard read..."
    cody "对，那本挺难读的……"

# game/sean12202024.rpy:2809
translate Schinese sean12202024ka_c8b98a71:

    # rocco "A lot easier when you're crammed behind a desk with jack shit to do."
    rocco "在前台无事可做时就好读多了。"

# game/sean12202024.rpy:2812
translate Schinese sean12202024ka_52f17f19:

    # cody "Fair."
    cody "也是。"

# game/sean12202024.rpy:2816
translate Schinese sean12202024ka_2104604f:

    # "He chuckles. Cody starts picking through other sci-fi novels."
    "他轻笑。Cody开始翻其他科幻小说。"

# game/sean12202024.rpy:2819
translate Schinese sean12202024ka_ba54cba3:

    # sean Happy "So what's been your favorite one so far?"
    sean Happy "那到目前为止你最喜欢哪本书？"

# game/sean12202024.rpy:2823
translate Schinese sean12202024ka_a0b6dd46:

    # rocco "A weird book called Cienie. Cody recommended it to me because I wanted something different."
    rocco "一本叫《Cienie》的怪书。我说想看点不一样的，Cody就推荐给我了。"

# game/sean12202024.rpy:2826
translate Schinese sean12202024ka_d235f952:

    # sean "Never heard of it. What's it about?"
    sean "没听过。是讲什么的？"

# game/sean12202024.rpy:2829
translate Schinese sean12202024ka_faef8c19:

    # rocco "It's a modern day, detective novel, set in a small polish town. Protag is investigating his missing mom; while paranormal shit goes down."
    rocco "现代侦探小说，背景是波兰的一个小镇。主角在调查母亲的失踪；同时还有一些超自然事件。"

# game/sean12202024.rpy:2832
translate Schinese sean12202024ka_59a49f9a:

    # narrator Neutral "Hitting close to home."
    narrator Neutral "还挺接近现实的。"

# game/sean12202024.rpy:2837
translate Schinese sean12202024ka_679f207f:

    # rocco "It's different, but I kinda like it. It's also not stupidly long."
    rocco "颇新奇，但我挺喜欢的。而且也没特别长。"

# game/sean12202024.rpy:2840
translate Schinese sean12202024ka_72e288e7:

    # "He taps the first dune book with the copy of the second."
    "他用第二集《沙丘》敲了敲第一集。"

# game/sean12202024.rpy:2843
translate Schinese sean12202024ka_69d8e54a:

    # rocco "Don't get me wrong, I like it, but I also don't like sticking with the same book for over a month."
    rocco "别误会，我是喜欢，但也不喜欢一个月都读同一本书。"

# game/sean12202024.rpy:2850
translate Schinese sean12202024ka_430bf566:

    # rocco Happy "So what've you been reading?"
    rocco Happy "那你最近在读什么？"

# game/sean12202024.rpy:2854
translate Schinese sean12202024ka_c8f52bbe:

    # sean "Cody and I talked about it on our walk, but the last few issues of After It All came out."
    sean "我和Cody散步时聊过了，但《After It All》最后几册出了。"

# game/sean12202024.rpy:2857
translate Schinese sean12202024ka_772a38a9:

    # sean "I've been finishing up a comic called After It All. The last few issues came out recently."
    sean "我在追完一本叫《After It All》的漫画。最后几册最近出了。"

# game/sean12202024.rpy:2860
translate Schinese sean12202024ka_22e24ded:

    # cody "Wait really? I thought it was on an indefinite hiatus."
    cody "等一下，真的吗？我以为无限期休刊了。"

# game/sean12202024.rpy:2864
translate Schinese sean12202024ka_60117e1d:

    # rocco Neutral "What's it about?"
    rocco Neutral "那是在讲什么的？"

# game/sean12202024.rpy:2867
translate Schinese sean12202024ka_e0d8a1dc:

    # sean "It's just your standard zombie comic. Though the outbreak is only in The States. The rest of the world quarantined us off."
    sean "就是普通的殭尸漫画。不过疫情只发生在美国。我们被其余的世界隔离了。"

# game/sean12202024.rpy:2871
translate Schinese sean12202024ka_b8f4d7c3:

    # narrator Embarrassed "Cody playfully jabs me in the shoulder."
    narrator Embarrassed "Cody嬉闹地戳了我肩膀。"

# game/sean12202024.rpy:2874
translate Schinese sean12202024ka_18551520:

    # cody "Dude spoilers!"
    cody "不要剧透啦！"

# game/sean12202024.rpy:2877
translate Schinese sean12202024ka_10d98461:

    # sean "Sorry."
    sean "抱歉。"

# game/sean12202024.rpy:2880
translate Schinese sean12202024ka_86ddfecf:

    # "I give a nervous chuckle."
    "我紧张地轻笑。"

# game/sean12202024.rpy:2884
translate Schinese sean12202024ka_15392e03:

    # rocco Neutral "What, you think I'd like it?"
    rocco Neutral "怎么，你觉得我会喜欢吗？"

# game/sean12202024.rpy:2889
translate Schinese sean12202024ka_05e59d15:

    # cody "Maybe, I know you want to 'read real books', but there's still a lot of interesting stuff that can only be done in a comic."
    cody "或许吧，我知道你是想「读正经的书」，但还是有很多东西只能以漫画的方式呈现。"

# game/sean12202024.rpy:2894
translate Schinese sean12202024ka_fb3d616b:

    # rocco "Sean do you still have the early issues?"
    rocco "Sean，你还有最前几册吗？"

# game/sean12202024.rpy:2900
translate Schinese sean12202024ka_ed9dca12:

    # sean Embarrassed "Uuh... n-no. I... uum... those were... Casey's. He, well, I gave them back to him before... camp."
    sean Embarrassed "呃……没、没有。我……嗯……那些是……Casey的。他，呃，我还给他了……在他去矫正营前。"

# game/sean12202024.rpy:2901
translate Schinese sean12202024ka_8addad6c:

    # sean Quiet2 "They probably got thrown out with the rest of his 'demonic' stuff."
    sean Quiet2 "大概跟他其他那些「恶魔」物品一起被丢掉了。"

# game/sean12202024.rpy:2906
translate Schinese sean12202024ka_d63fd3af:

    # "That soured the mood."
    "气氛因此变得沉重。"

# game/sean12202024.rpy:2909
translate Schinese sean12202024ka_6c34471b:

    # rocco "Sorry."
    rocco "抱歉。"

# game/sean12202024.rpy:2912
translate Schinese sean12202024ka_1076681f:

    # sean Neutral "It's not your fault."
    sean Neutral "不是你的错。"

# game/sean12202024.rpy:2915
translate Schinese sean12202024ka_b78c24b0:

    # rocco Quiet2 "Sure..."
    rocco Quiet2 "嗯……"

# game/sean12202024.rpy:2919
translate Schinese sean12202024ka_7f2cde0d:

    # "Cody looks between us and I can see his fur start to puff up. It made the matting in it more noticeable, but I tried not to stare."
    "Cody交互看着我们两个。他的毛有点炸开了，让打结的地方更明显，但我尽量不盯着看。"

# game/sean12202024.rpy:2925
translate Schinese sean12202024ka_3b14f602:

    # cody "Wh-why don't we go get some lunch! I-I'm not really interested in picking up anything here anyways!"
    cody "我、我们干脆去吃午餐吧！反、反正我也没打算在这买东西！"

# game/sean12202024.rpy:2929
translate Schinese sean12202024ka_58cab3f4:

    # rocco "You sure?"
    rocco "你确定？"

# game/sean12202024.rpy:2932
translate Schinese sean12202024ka_8ad976ff:

    # cody "Yeah it's...{nw}"
    cody "对，没……{nw}"

# game/sean12202024.rpy:2934
translate Schinese sean12202024ka_ab859e36:

    # cody "Yeah it's...{fast} it's fine!"
    cody "对，没……{fast}没关系！"

# game/sean12202024.rpy:2948
translate Schinese sean12202024ka_26c9b33f:

    # narrator sideSean Happy "The food court isn't as dead as the rest of the mall."
    narrator sideSean Happy "美食广场不像其他地方那么空。"

# game/sean12202024.rpy:2949
translate Schinese sean12202024ka_9cd08bf6:

    # "A lion, hairless cat, and crow sit at one table. A hyena, cheetah, dog and raccoon are at another."
    "一张桌子坐着狮子、无毛猫和乌鸦。另一张坐着鬣狗、猎豹、狗和浣熊。"

# game/sean12202024.rpy:2950
translate Schinese sean12202024ka_3243ea32:

    # "Along the wall, various restaurants with employees as dead as the mall sit open. The aromas drifting off of them compete for dominance in my nose."
    "各种餐厅沿墙排列，员工和商场一样死气沉沉。飘出的香气在我鼻子里争夺主导权。"

# game/sean12202024.rpy:2962
translate Schinese sean12202024ka_1911733b:

    # "Rocco walks off, probably to get the aforementioned pizza. I turn to follow him and spot a familiar bat at the counter."
    "Rocco走离，大概是要买之前提过的披萨。我转身跟着他，便看到柜台有位眼熟的蝙蝠。"
# game/sean12202024.rpy:2967
translate Schinese sean12202024ka_54bb176a:

    # claire "Oh hey guys!"
    claire "你们好啊！"

# game/sean12202024.rpy:2970
translate Schinese sean12202024ka_86785182:

    # rocco "Sup!"
    rocco "嗨！"

# game/sean12202024.rpy:2973
translate Schinese sean12202024ka_9dad429b:

    # "Rocco's tail begins to wag."
    "Rocco尾巴摇动。"

# game/sean12202024.rpy:2978
translate Schinese sean12202024ka_1e28bdd6:

    # claire "Lake these were the guys I was telling you about."
    claire "Lake，他们就是我跟你提过的人。"

# game/sean12202024.rpy:2981
translate Schinese sean12202024ka_a8a40109:

    # "Behind the counter an androgynous hyena stands. Their gray, sauce stained apron, contrasts their neon green hair and gold piercings. They extend a paw out and we shake it."
    "柜台后方站着一只中性气质的鬣狗。沾满酱汁的灰围裙和TA萤光绿的发色与金色穿环形成对比。TA伸出爪子，和我们握手。"

# game/sean12202024.rpy:2984
translate Schinese sean12202024ka_5d16e67a:

    # rocco "Just three slices, one meat-lovers, one pepperoni, and one with the green bell peppers."
    rocco "就三片，一片肉多多、一片义式香肠，还有一片青椒的那个。"

# game/sean12202024.rpy:2987
translate Schinese sean12202024ka_ec93ae6b:

    # lake "The supreme?"
    lake "至尊披萨？"

# game/sean12202024.rpy:2990
translate Schinese sean12202024ka_36ed9949:

    # rocco "Yeah."
    rocco "对。"

# game/sean12202024.rpy:2996
translate Schinese sean12202024ka_bd74846f:

    # lake "Commin' up boss."
    lake "马上来，老板。"

# game/sean12202024.rpy:3002
translate Schinese sean12202024ka_f7911e8f:

    # "Lake takes the slices and throws them in the oven to warm up."
    "Lake拿起披萨片丢进烤箱加热。"

# game/sean12202024.rpy:3006
translate Schinese sean12202024ka_b05417e6:

    # claire sideSean Neutral "I was telling Lake and Hailey about the investigation."
    claire sideSean Neutral "我在跟Lake和Hailey讲调查的事。"

# game/sean12202024.rpy:3015
translate Schinese sean12202024ka_fa9527d8:

    # "As if on queue, a bird walks out from the next door noodle stand,{nw}"
    "恰巧，一只鸟从隔壁拉面摊走出来，{nw}"

# game/sean12202024.rpy:3017
translate Schinese sean12202024ka_5df52673:

    # "As if on queue, a bird walks out from the next door noodle stand,{fast} and gives Claire a peck on the cheek."
    "恰巧，一只鸟从隔壁拉面摊走出来，{fast}在Claire脸颊上啄了一下。"

# game/sean12202024.rpy:3022
translate Schinese sean12202024ka_8581d933:

    # "They look back at us, and then whisper something to Claire. She whispers something back, and the bird turns to look at us."
    "TA回望我们，然后向Claire耳语。对方也回了几句后，鸟转身面向我们。"

# game/sean12202024.rpy:3027
translate Schinese sean12202024ka_0208734d:

    # whomst "H-hello... I'm um... tired-{nw}"
    whomst "你、你们好……我是、呃……好累——{nw}"

# game/sean12202024.rpy:3030
translate Schinese sean12202024ka_c521e1c3:

    # whomst "H-hello... I'm um... tired-{fast} I MEAN{nw}"
    whomst "你、你们好……我是、呃……好累——{fast}{b}我是说{/b}{nw}"

# game/sean12202024.rpy:3031
translate Schinese sean12202024ka_5a98cc7a:

    # hailey "H-hello... I'm um... tired- I MEAN{fast} HAILEY!"
    hailey "你、你们好……我是、呃……好累——{b}我是说{/b}{fast}HAILEY！"

# game/sean12202024.rpy:3034
translate Schinese sean12202024ka_4b16f408:

    # narrator sideSean Concerned "Claire chuckles as Hailey's feather poof out. Kinda reminds me of myself a few years ago."
    narrator sideSean Concerned "Hailey的羽毛都炸开了，Claire轻笑出声。感觉有点像几年前的我。"

# game/sean12202024.rpy:3043
translate Schinese sean12202024ka_41e5f8a4:

    # narrator Happy "We introduce ourselves as Lake pulls the pizzas out of the oven. Rocco pays for the slices and the five of us head over to a table to chat."
    narrator Happy "Lake在我们自我介绍时将披萨从烤箱拿出。Rocco付了钱后，我们五人走到一张桌边聊天。"

# game/sean12202024.rpy:3049
translate Schinese sean12202024ka_c4628311:

    # narrator Neutral "We tell Hailey about what we found in the hotel. Well... more like what we didn't find."
    narrator Neutral "我们跟Hailey讲了在旅馆发现的事物。嗯……应该说没找到的事物。"

# game/sean12202024.rpy:3052
translate Schinese sean12202024ka_f755ce02:

    # hailey "It is a weird coincidence. And no one's turned up?"
    hailey "这巧合挺诡异的。而且没有人现身？"

# game/sean12202024.rpy:3055
translate Schinese sean12202024ka_4790b832:

    # rocco "Not from what I've heard. Unless someone's keeping me out of the loop."
    rocco "据我所知没有。除非有人把我排除在消息外。"

# game/sean12202024.rpy:3062
translate Schinese sean12202024ka_b9d329fa:

    # hailey Concerned "Those white eyes were creepy. Do you think they have anything to do with the disappearances?"
    hailey Concerned "那些白眼睛好恐怖喔。你们觉得跟失踪案有关吗？"

# game/sean12202024.rpy:3065
translate Schinese sean12202024ka_15097001:

    # cody "It's a theory, but the thought of something being down there doesn't sit well with me."
    cody "确实有可能，但一想到那底下有什么在，我就不太安心。"

# game/sean12202024.rpy:3071
translate Schinese sean12202024ka_d3433ab0:

    # rocco Scared "I mean there is the rope. It could climb out and get into town."
    rocco Scared "那里有绳子。它可能会爬上来小镇里。"

# game/sean12202024.rpy:3077
translate Schinese sean12202024ka_9ee2cc66:

    # hailey Concerned "You said you walk by the hole every morning right Rocco?"
    hailey Concerned "你说你每天早上都会经过那个坑吧，Rocco？"

# game/sean12202024.rpy:3081
translate Schinese sean12202024ka_e4e5d71d:

    # rocco "Yeah?"
    rocco "嗯啊？"

# game/sean12202024.rpy:3086
translate Schinese sean12202024ka_81637257:

    # hailey Neutral "You give off an... aura. I wonder if that's scaring it back into the hole."
    hailey Neutral "你散发着一种……气场。我在想是不是这把它吓回坑里的。"

# game/sean12202024.rpy:3089
translate Schinese sean12202024ka_89f788cb:

    # rocco "An aura?"
    rocco "气场？"

# game/sean12202024.rpy:3092
translate Schinese sean12202024ka_5dba68ab:

    # hailey "Yes. It's faint, but something has attached its spirit to you. It doesn't feel malicious, but it is intense."
    hailey "对。很微弱，但有什么的灵魂依附在你身上了。感觉没有恶意，但很强烈。"

# game/sean12202024.rpy:3099
translate Schinese sean12202024ka_5667dfa0:

    # narrator Happy "Rocco begins sniffing his pits. Cody and I try to stifle any laughter."
    narrator Happy "Rocco嗅了嗅自己的腋下。我和Cody努力憋笑。"

# game/sean12202024.rpy:3101
translate Schinese sean12202024ka_bc84c29e:

    # "The dog gives us a look as Hailey pulls out a rock on a silver necklace."
    "狗瞪了我们一眼，同时Hailey从一条银项链上摘下一颗石头。"

# game/sean12202024.rpy:3106
translate Schinese sean12202024ka_ffefae39:

    # hailey Neutral "Like I said, I don't think it's malicious, but you may want to get a protective ward to carry on you. It could attract negative spirits."
    hailey Neutral "我是说了感觉没有恶意，但你或许该带个护身符。不然可能会吸引到恶灵。"

# game/sean12202024.rpy:3110
translate Schinese sean12202024ka_4f46f64e:

    # rocco "Thanks... Can we get back on topic?"
    rocco "谢谢……我们能回到正题吗？"

# game/sean12202024.rpy:3113
translate Schinese sean12202024ka_25bbb351:

    # "Claire clears her throat."
    "Claire清了清嗓子。"

# game/sean12202024.rpy:3117
translate Schinese sean12202024ka_443804b1:

    # claire "I did my own digging through the files. I still had an hour left after writing my report and nothing better to do."
    claire "我自己翻过档案。毕竟写完报告后还剩一小时，也没什么其他事好做的。"

# game/sean12202024.rpy:3120
translate Schinese sean12202024ka_2f56c94a:

    # "Claire hands us her phone with a note document open."
    "Claire把手机递给我们，上面开着笔记文件。"

# game/sean12202024.rpy:3127
translate Schinese sean12202024ka_0a99f080:

    # claire Concerned "Rocco do you remember a P.I. or a cop coming in to talk to someone?"
    claire Concerned "Rocco，你记得有私家侦探或警察来跟人谈话吗？"

# game/sean12202024.rpy:3130
translate Schinese sean12202024ka_25b4f964:

    # "The dog looks up at her. By his face alone we know what he's going to say."
    "狗抬头看她。光看他的表情，我们就料他的回答了。"

# game/sean12202024.rpy:3133
translate Schinese sean12202024ka_761589c7:

    # rocco "No one mentioned it."
    rocco "没人提过。"

# game/sean12202024.rpy:3138
translate Schinese sean12202024ka_7310ea67:

    # claire Neutral "Do you know about a tabby working at the hotel? The employee files I looked at only have names, and I don't plan on breaching privacy any more than that."
    claire Neutral "你知道旅馆有只虎斑猫员工吗？我看的员工档案只有名字，我也不打算再进一步侵犯隐私。"

# game/sean12202024.rpy:3142
translate Schinese sean12202024ka_fc478d7d:

    # rocco "You have access to-{nw}"
    rocco "你有权限看——{nw}"

# game/sean12202024.rpy:3144
translate Schinese sean12202024ka_9ac3a8b5:

    # rocco sideSean Quiet2 "You have access to-{fast} never mind. No, there isn't a tabby that works at the hotel. I wouldn-"
    rocco sideSean Quiet2 "你有权限看——{fast}算了。没，旅馆没有虎斑猫员工。我不会——"

# game/sean12202024.rpy:3147
translate Schinese sean12202024ka_5cf139d9:

    # "He cuts himself off."
    "他突然停住。"

# game/sean12202024.rpy:3151
translate Schinese sean12202024ka_7df958fb:

    # rocco "Fuck this I just want to have a normal day off!"
    rocco "我操，我只不过想好好休个假！"

# game/sean12202024.rpy:3159
translate Schinese sean12202024ka_253c6a8a:

    # sean Neutral "I found something."
    sean Neutral "我有一些发现。"

# game/sean12202024.rpy:3162
translate Schinese sean12202024ka_f3dfca85:

    # narrator Embarrassed "Everyone's eyes look at me, and I feel myself shrink in the seat."
    narrator Embarrassed "他们望了过来，让我在座位上缩了一下。"

# game/sean12202024.rpy:3165
translate Schinese sean12202024ka_434f58c0:

    # sean "When I was investigating the hotel by myself."
    sean "我一个人调查旅馆的时候，"

# game/sean12202024.rpy:3168
translate Schinese sean12202024ka_89d8883d:

    # sean Neutral "I checked out a room, I think the person staying there was Sarah Anderson."
    sean Neutral "有间我检查过的房间，好像是一个叫Sarah Anderson的人住的。"

# game/sean12202024.rpy:3169
translate Schinese sean12202024ka_36be3551:

    # sean "It was room 105... maybe 106. There was a voice recorder in it with some... pretty damning stuff."
    sean "应该是105号房……或106吧。里面有一台录音机，录了一些……很操蛋的内容。"

# game/sean12202024.rpy:3172
translate Schinese sean12202024ka_41563a33:

    # sean "She said an investigator came by to follow up on her assault report. She didn't remember being assaulted or filing a report."
    sean "她说有个调查员来跟进她的性侵案。她却不记得自己被性侵过，也不记得报过案。"

# game/sean12202024.rpy:3174
translate Schinese sean12202024ka_b004bf0e:

    # sean "When the investigator gave her the name of her assaulter she didn't know who it was."
    sean "当调查员告诉她施暴者的名字时，她不知道那是谁。"

# game/sean12202024.rpy:3178
translate Schinese sean12202024ka_95fe1469:

    # rocco "Fuck me."
    rocco "我操。"

# game/sean12202024.rpy:3182
translate Schinese sean12202024ka_b6a7d42d:

    # sean Embarrassed "I didn't bring it up yesterday because I didn't think it would be important. Plus the cops are already on it."
    sean Embarrassed "我昨天没提是因为没觉得很重要。而且警察已经在处理了。"

# game/sean12202024.rpy:3185
translate Schinese sean12202024ka_f5827195:

    # narrator Quiet "Claire and Hailey give me a look. I can't help but slide down in my chair a bit more."
    narrator Quiet "Claire和Hailey瞥了我一眼。我又不禁在椅子上滑低了点。"

# game/sean12202024.rpy:3188
translate Schinese sean12202024ka_6fe42d96:

    # claire "You really think the cops are gonna do anything."
    claire "你真觉得警察会做什么事吗？"

# game/sean12202024.rpy:3191
translate Schinese sean12202024ka_f00b4ca2:

    # sean Embarrassed "No?"
    sean Embarrassed "不会吗？"

# game/sean12202024.rpy:3194
translate Schinese sean12202024ka_1118ef15:

    # hailey Neutral "If anything, they're just gonna let the guy go with a stern talking to."
    hailey Neutral "顶多也就教训那人一顿后就放他走人了。"

# game/sean12202024.rpy:3197
translate Schinese sean12202024ka_4287e102:

    # "There's a venom to Hailey's words. One that I didn't expect from the shy bird. Claire gives her a sympathetic look."
    "Hailey语气愤恨。没想到会从这只腼腆的鸟口中听到。Claire同情地望了她一眼。"

# game/sean12202024.rpy:3203
translate Schinese sean12202024ka_2ce4c9fb:

    # claire Concerned "I wish there was more we can do."
    claire Concerned "真希望有更多我们能做的事。"

# game/sean12202024.rpy:3206
translate Schinese sean12202024ka_a3250f4a:

    # rocco "Sometimes the best thing to do is nothing. People get paid to look into shit like this."
    rocco "有时候最好什么都别做。这种事有人会专门拿钱来办的。"

# game/sean12202024.rpy:3211
translate Schinese sean12202024ka_3f225e8f:

    # rocco Neutral "Having a gang of misfits playing investigator will probably fuck something up."
    rocco Neutral "让一群局外人来玩侦探游戏，大概只会帮倒忙。"

# game/sean12202024.rpy:3213
translate Schinese sean12202024ka_b2091771:

    # "I think that was supposed to make us feel better."
    "他这么说，应该是要让我们心理好过一点。"

# game/sean12202024.rpy:3218
translate Schinese sean12202024ka_7eb7e7b5:

    # claire "Look, the main thing was the investigator and the staff member."
    claire "我说，重点是那个调查员和员工。"

# game/sean12202024.rpy:3219
translate Schinese sean12202024ka_061efc94:

    # claire "The fact that you don't know either of them makes me concerned."
    claire "你们全都不认识，让我很担心。"

# game/sean12202024.rpy:3223
translate Schinese sean12202024ka_a4bb554e:

    # claire Concerned "Is there any way I could convince the three of you and Hank to move out for a bit? At least until this mystery is over."
    claire Concerned "你们三个和Hank能暂时搬走吗？至少等到这个谜团事件结束。"

# game/sean12202024.rpy:3226
translate Schinese sean12202024ka_31abf6e0:

    # claire "I know we only met yesterday, but something is wrong with that town."
    claire "我们确实昨天才刚认识，但那个小镇有问题。"

# game/sean12202024.rpy:3227
translate Schinese sean12202024ka_cfdc4eee:

    # claire Neutral "I'm worried you all are going to go missing and I won't remember."
    claire Neutral "我很怕你们都会闹失踪，而我却不记得了。"

# game/sean12202024.rpy:3230
translate Schinese sean12202024ka_520936ba:

    # sean "What makes you say that?"
    sean "怎么这么说？"

# game/sean12202024.rpy:3240
translate Schinese sean12202024ka_936a8be7:

    # claire "Remember how we said we ran into someone?"
    claire "还记得我们说有碰到一个人吗？"

# game/sean12202024.rpy:3243
translate Schinese sean12202024ka_ebf85243:

    # sean Scrutinizing "Sure?"
    sean Scrutinizing "那怎么了？"

# game/sean12202024.rpy:3247
translate Schinese sean12202024ka_43dc47ff:

    # claire Embarrassed "What was their name Sean?"
    claire Embarrassed "那个人叫什么名字，Sean？"

# game/sean12202024.rpy:3250
translate Schinese sean12202024ka_302da091:

    # "I don't remember, and I think Claire can see that."
    "我不记得了，我想Claire也看得出来。"

# game/sean12202024.rpy:3252
translate Schinese sean12202024ka_09424faa:

    # narrator Neutral "In fact, now that I think about it, we didn't run into anyone yesterday."
    narrator Neutral "事实上，现在想来，我们昨天根本没碰见任何人。"

# game/sean12202024.rpy:3259
translate Schinese sean12202024ka_d6915d37:

    # claire Scared "What was their species Sean?"
    claire Scared "那个人种族是什么，Sean？"

# game/sean12202024.rpy:3262
translate Schinese sean12202024ka_abe7fd90:

    # "We didn't run into anyone yesterday, and Claire can see it on my face."
    "我们昨天没碰到任何人，Claire从我表情看出来了。"

# game/sean12202024.rpy:3265
translate Schinese sean12202024ka_f0ad8d6f:

    # claire Quiet2 "We wouldn't pay it any mind if we weren't talking about it right now."
    claire Quiet2 "要不是现在在谈这事，我们根本不会去在意。"

# game/sean12202024.rpy:3268
translate Schinese sean12202024ka_affe88c5:

    # claire "We just forgot a person existed, and we didn't pay it a second thought."
    claire "我们就这样忘了有个人存在过，连想都没多想。"

# game/sean12202024.rpy:3272
translate Schinese sean12202024ka_612711a3:

    # narrator Concerned "Rocco gives me a sympathetic look."
    narrator Concerned "Rocco同情地看了我一眼。"

# game/sean12202024.rpy:3273
translate Schinese sean12202024ka_951e2717:

    # "We don't say anything and the noise of the food court fills our ears."
    "我们默默无言，美食广场的噪音充斥耳朵。"

# game/sean12202024.rpy:3281
translate Schinese sean12202024ka_f65d3ca0:

    # claire Concerned "Remember how Cody said he ran into someone?"
    claire Concerned "还记得Cody说他有碰到一个人吗？"

# game/sean12202024.rpy:3284
translate Schinese sean12202024ka_1326f80f:

    # "We all look at the raccoon."
    "我们一同看向浣熊。"

# game/sean12202024.rpy:3287
translate Schinese sean12202024ka_eb5bfb88:

    # claire "What was their name Cody?"
    claire "那个人叫什么名字，Cody？"

# game/sean12202024.rpy:3291
translate Schinese sean12202024ka_145cd6ae:

    # cody "I-I don't know."
    cody "我、我不知道。"

# game/sean12202024.rpy:3294
translate Schinese sean12202024ka_7a8e4a63:

    # "He begins scratching at his arm."
    "他开始挠自己的手臂。"

# game/sean12202024.rpy:3299
translate Schinese sean12202024ka_4df77498:

    # claire "What was their species Cody?"
    claire "那个人种族是什么，Cody？"

# game/sean12202024.rpy:3303
translate Schinese sean12202024ka_e5e23591:

    # cody "I d-don't know. I didn't- I mean I remember saying I did, but I didn't run into anyone. But why would I..."
    cody "我、我不知道。我没……我是记得有说过，但我真没碰到任何人。可是我怎么会……"

# game/sean12202024.rpy:3307
translate Schinese sean12202024ka_98362f3d:

    # "Cody trails off into his own head. Claire turns to the rest of us."
    "Cody陷入沉思。Claire转向我们其他人。"

# game/sean12202024.rpy:3310
translate Schinese sean12202024ka_289cf0f1:

    # claire "We wouldn't even think about it, if I hadn't wrote it down."
    claire "要不是我写下来了，我们根本不会在意这种事。"


# TODO: Translation updated at 2023-03-19 20:06

# game/murdochroute3.rpy:4
translate Schinese murdochroute3_74be125b:

    # "When I get to the store I’m handed a list of tasks."
    "我刚到店里，就被塞了张任务清单。"

# game/murdochroute3.rpy:5
translate Schinese murdochroute3_6c2bf15b:

    # "Murdoch lets me handle the inventory of the store, and I’m grateful for that."
    "Murdoch安排我整理库存，这让我很是感激。"

# game/murdochroute3.rpy:6
translate Schinese murdochroute3_8cdbfebe:

    # "Most of the day passes without incident."
    "平安无事的一天过去了。"

# game/murdochroute3.rpy:7
translate Schinese murdochroute3_a66fd251:

    # "Mostly just a steady stream of people purchasing canned goods and disposable paper products."
    "大多是来买罐头食品和一次性纸制品的熟客。"

# game/murdochroute3.rpy:8
translate Schinese murdochroute3_9429f11f:

    # "A well dressed older woman comes in inquiring for something called strychnine, and Ralph moves quickly to help her."
    "一位穿着讲究的老妇人来店里找一个叫士的宁还是什么的东西，Ralph三两下就搞定了。"

# game/murdochroute3.rpy:9
translate Schinese murdochroute3_462dec6d:

    # "I don’t have any time or any place to talk about what I dreamed last night."
    "我忙得没有机会提起昨晚的梦。"

# game/murdochroute3.rpy:10
translate Schinese murdochroute3_89786fc6:

    # "And part of me is grateful for that too."
    "这我也挺感激的。"

# game/murdochroute3.rpy:11
translate Schinese murdochroute3_c0f67bc9:

    # "When my mind’s on work there isn’t much room for other things."
    "在专心工作时，我就无暇去顾及其他事。"

# game/murdochroute3.rpy:12
translate Schinese murdochroute3_dab91fad:

    # "I think I understand now why idle thoughts are dangerous."
    "我大概明白胡思乱想为什么很危险了。"

# game/murdochroute3.rpy:14
translate Schinese murdochroute3_0ebff561:

    # al "“You there.”"
    al "“喂，你。”"

# game/murdochroute3.rpy:15
translate Schinese murdochroute3_1b00a1e7:

    # "I’m so surprised by this man’s appearance I have to bite my own tongue to keep myself from letting loose an unholy string of expletives. "
    "这男人冷不丁地出现，吓得我必须咬住舌头，才不至于把脏话喷出来。"

# game/murdochroute3.rpy:17
translate Schinese murdochroute3_07f16701:

    # al "“We’re closing up shop early today.”"
    al "“今天提早关店。”"

# game/murdochroute3.rpy:20
translate Schinese murdochroute3_d2eeef9e:

    # al "“Tell my son and the cashier that they should go back to the house to prepare for the bachelor party.”"
    al "“转告我儿子和收银员，他们该回家为单身派对做准备了。”"

# game/murdochroute3.rpy:22
translate Schinese murdochroute3_8b716f96:

    # "I feel like he should be telling them this instead since he’s the boss."
    "这种事不该由你这个老板讲吗？"

# game/murdochroute3.rpy:23
translate Schinese murdochroute3_b2193727:

    # "But I know better than to argue."
    "当然了，我是不会回嘴的。"

# game/murdochroute3.rpy:25
translate Schinese murdochroute3_f2098e1e:

    # ra "“We’re prepared on our end.”"
    ra "“我们已经准备就绪了。”"

# game/murdochroute3.rpy:28
translate Schinese murdochroute3_4de7e9ff:

    # mu "“Everything’s already sorted.”"
    mu "“都打点好了。”"

# game/murdochroute3.rpy:31
translate Schinese murdochroute3_055c3552:

    # al "“Good. I’ll be late to the house if I can make it at all.”"
    al "“很好。我会晚点到，如果我能赶上的话。”"

# game/murdochroute3.rpy:33
translate Schinese murdochroute3_adc3e2cf:

    # "He nods."
    "他点点头。"

# game/murdochroute3.rpy:35
translate Schinese murdochroute3_468df762:

    # al "“Off you all go.”"
    al "“你们走吧。”"

# game/murdochroute3.rpy:37
translate Schinese murdochroute3_270028a8:

    # "I nod, and then pull my suit from one of the closets and sling it over my left shoulder."
    "我点头，从衣柜里拿出正装，吊在左肩上。"

# game/murdochroute3.rpy:39
translate Schinese murdochroute3_3fa46ee1:

    # "I’m really looking forward to the days where I don’t have to carry around formal wear like an idiot."
    "真怀念不用像个白痴一样，带着身西装到处跑的日子。"

# game/murdochroute3.rpy:42
translate Schinese murdochroute3_bc8bccf1:

    # m "“Y’all mind if we talk while we walk?”"
    m "“介意边走边谈么？”"

# game/murdochroute3.rpy:47
translate Schinese murdochroute3_bbaf4d5a:

    # "The two of them look at one another."
    "他们互相看了眼对方。"

# game/murdochroute3.rpy:50
translate Schinese murdochroute3_a8adec36:

    # mu "“About what?”"
    mu "“谈什么？”"

# game/murdochroute3.rpy:52
translate Schinese murdochroute3_1b65cb1b:

    # m "“Similar stuff to what we talked about at the lake.”"
    m "“类似咱们在湖边谈过的那些。”"

# game/murdochroute3.rpy:54
translate Schinese murdochroute3_2ce2f0a7:

    # ra "“Not really the time nor the place.”"
    ra "“时间跟地点都不适合。”"

# game/murdochroute3.rpy:57
translate Schinese murdochroute3_68b775ab:

    # mu "“Unless you think it’s urgent.”"
    mu "“除非你很急。”"

# game/murdochroute3.rpy:58
translate Schinese murdochroute3_fd539dc5:

    # m "“Not really sure.”"
    m "“我不确定。”"

# game/murdochroute3.rpy:59
translate Schinese murdochroute3_dff25fde:

    # m "“It was a dream, after all.”"
    m "“毕竟只是个梦。”"

# game/murdochroute3.rpy:61
translate Schinese murdochroute3_183925b9:

    # "They both tense up."
    "他们俩紧张起来。"

# game/murdochroute3.rpy:63
translate Schinese murdochroute3_908e39a5:

    # ra "“There’s a history of weird dreams becoming particularly lucid around these parts.”"
    ra "“这里常有人做异常清晰的怪梦。”"

# game/murdochroute3.rpy:66
translate Schinese murdochroute3_2b5c9892:

    # ra "“Though if it’s related to what we talked about the lake, I haven’t the faintest idea.”"
    ra "“但跟湖有关的，我尚不得知。”"

# game/murdochroute3.rpy:68
translate Schinese murdochroute3_31d008bb:

    # m "“Do any of those dreams ever turn out to be about things that really happen?”"
    m "“这种梦成真过吗？”"

# game/murdochroute3.rpy:69
translate Schinese murdochroute3_f7320639:

    # m "“Or things that can come true.”"
    m "“或可能成真？”"

# game/murdochroute3.rpy:71
translate Schinese murdochroute3_7a85793f:

    # ra "“I sure hope not.”"
    ra "“但愿没有。”"

# game/murdochroute3.rpy:74
translate Schinese murdochroute3_d33ef0d6:

    # ra "“Or else you’re gonna be bangin’ my brains out soon.”"
    ra "“否则我早就被你操翻了。”"

# game/murdochroute3.rpy:76
translate Schinese murdochroute3_94004a03:

    # "Oh."
    "哦。"

# game/murdochroute3.rpy:78
translate Schinese murdochroute3_28656fda:

    # mu "“Ralph.”"
    mu "“Ralph。”"

# game/murdochroute3.rpy:80
translate Schinese murdochroute3_18049bfa:

    # ra "“Oh come on, that one was easy.”"
    ra "“这还算好的呢。”"

# game/murdochroute3.rpy:83
translate Schinese murdochroute3_fde662a2:

    # mu "“Anyway, I’ve had strange dreams before myself.”"
    mu "“回到正题，我也做过诡异的梦。”"

# game/murdochroute3.rpy:84
translate Schinese murdochroute3_ba8d8248:

    # m "“Oh?”"
    m "“哦？”"

# game/murdochroute3.rpy:8122
translate Schinese murdochroute3_e7b2dee2:

    # mu "“Holly once talked about an idea written by the French philosopher Émile Boirac.”"
    mu "“听Holly说，法国哲学家艾米利·波拉克提出过一个概念。”"

# game/murdochroute3.rpy:8124
translate Schinese murdochroute3_fdf4227f:

    # "I can already feel my eyes glazing over."
    "我感觉双眼已经在打转了。"

# game/murdochroute3.rpy:8125
translate Schinese murdochroute3_aa2f64bc:

    # m "“Uh huh.”"
    m "“嗯，嗯。”"

# game/murdochroute3.rpy:8127
translate Schinese murdochroute3_fa877208:

    # mu "“He had written about why cultures around the world might believe in premonitions or prophecy.”"
    mu "“为什么世界各地都会不约而同地相信预言或预感呢？”"

# game/murdochroute3.rpy:8130
translate Schinese murdochroute3_8e8d2a08:

    # mu "“The idea suggests that people can experience a sensation for the first time while distracted or addled.”"
    mu "“他认为，若第一次体验发生在分神或无意识中──”"

# game/murdochroute3.rpy:8133
translate Schinese murdochroute3_53f74a4d:

    # mu "“But then when the second time happens, memory of the first kicks in, and it feels much stronger and much more eerie.”"
    mu "“──在经历第二次时，就会唤起第一次的回忆，从而产生更加鲜明的既视感。”"

# game/murdochroute3.rpy:8135
translate Schinese murdochroute3_0746d850:

    # m "“I see.”"
    m "“这样啊。”"

# game/murdochroute3.rpy:8136
translate Schinese murdochroute3_a6eaf9d0:

    # m "“I don’t think that’s what happened.”"
    m "“但我的情况好像不同。”"

# game/murdochroute3.rpy:8138
translate Schinese murdochroute3_d73313e8:

    # mu "“Maybe not, but it’s the first thing I could think of.”"
    mu "“也许吧，我只是率先想到了这个。”"

# game/murdochroute3.rpy:8140
translate Schinese murdochroute3_c3838823:

    # m "“Thanks anyway.”"
    m "“总之谢了。”"

# game/murdochroute3.rpy:8142
translate Schinese murdochroute3_e46c1363:

    # mu "“Do you remember much about the dream?”"
    mu "“你还记得那个梦吗？”"

# game/murdochroute3.rpy:8144
translate Schinese murdochroute3_5299863a:

    # m "“To be honest it’s fading quick.”"
    m "“老实说，不多。”"

# game/murdochroute3.rpy:8145
translate Schinese murdochroute3_c18c4a77:

    # m "“Now I’m down to bare bone details.”"
    m "“只记得个大概。”"

# game/murdochroute3.rpy:8146
translate Schinese murdochroute3_506d4a07:

    # m "“Even the voices in them are getting harder to place.”"
    m "“连声音的主人是男是女都分不清楚了。”"

# game/murdochroute3.rpy:8147
translate Schinese murdochroute3_8c6ee1e1:

    # m "“Like when you hear a person talkin’, but you’re both underwater.”"
    m "“就像隔着水听着别人讲话。”"

# game/murdochroute3.rpy:8149
translate Schinese murdochroute3_4b4ba432:

    # "Murdoch droops a little at that and Ralph’s eyes narrow."
    "听到这话，Murdoch有点垂头丧气，Ralph则鼓起眼睛。"

# game/murdochroute3.rpy:8150
translate Schinese murdochroute3_5d3480e6:

    # "I should change the subject."
    "得换个话题。"

# game/murdochroute3.rpy:8151
translate Schinese murdochroute3_52b4fc99:

    # m "“Forget it.”"
    m "“算了。”"

# game/murdochroute3.rpy:8152
translate Schinese murdochroute3_d9d6ebc3:

    # m "“It’s not important.”"
    m "“反正也不重要。”"

# game/murdochroute3.rpy:8154
translate Schinese murdochroute3_c690109f:

    # "We all stopped to let a tumbleweed pass us by."
    "我们停下脚步，看着一株风滚草滚过。"

# game/murdochroute3.rpy:8159
translate Schinese murdochroute3_62df7a86:

    # m "“So what should I know to be ready for this bachelor party?”"
    m "“所以，这场单身派对有什么我该留意的么？”"

# game/murdochroute3.rpy:8161
translate Schinese murdochroute3_acafcb85:

    # mu "“Never been to a bachelor party before, Sam?”"
    mu "“你没有参加过单身派对吗，Sam？”"

# game/murdochroute3.rpy:8163
translate Schinese murdochroute3_7b80ed73:

    # m "“Never really knew many bachelors.”"
    m "“我又不认识多少单身汉。”"

# game/murdochroute3.rpy:8164
translate Schinese murdochroute3_f8393144:

    # m "“At least not rich ones.”"
    m "“有钱的那种。”"

# game/murdochroute3.rpy:8166
translate Schinese murdochroute3_6f545166:

    # ra "“Get ready for lots of drinking and a stripper or two.”"
    ra "“不外乎花天酒地，脱衣舞娘咯。”"

# game/murdochroute3.rpy:8168
translate Schinese murdochroute3_627eb72a:

    # m "“Sounds like every night at the Hip.”"
    m "“就是Hip每晚的日常嘛。”"

# game/murdochroute3.rpy:8170
translate Schinese murdochroute3_ff96a769:

    # mu "“As it happens...”"
    mu "“其实...”"

# game/murdochroute3.rpy:8172
translate Schinese murdochroute3_e53bc644:

    # "He gives me a slightly apologetic grin."
    "他略带歉意地笑了笑。"

# game/murdochroute3.rpy:8173
translate Schinese murdochroute3_c651d0c8:

    # m "“No.”"
    m "“不是吧。”"

# game/murdochroute3.rpy:8175
translate Schinese murdochroute3_4f5db396:

    # mu "“That’s the venue.”"
    mu "“会场就设在那里。”"

# game/murdochroute3.rpy:8177
translate Schinese murdochroute3_1cef62c8:

    # m "“Christ.”"
    m "“我的天。”"

# game/murdochroute3.rpy:8178
translate Schinese murdochroute3_13591ee7:

    # "I’d hoped one of the people I work with could have warned me about something like this."
    "就没个同事能提醒我一下吗？"

# game/murdochroute3.rpy:8179
translate Schinese murdochroute3_f3767558:

    # m "“I could have left my damn suit in my closet too.”"
    m "“早知道，我就把这身累赘存衣柜里了。”"

# game/murdochroute3.rpy:8181
translate Schinese murdochroute3_de511f24:

    # ra "“Except you don’t work there.”"
    ra "“你可不在那儿工作啊。”"

# game/murdochroute3.rpy:8184
translate Schinese murdochroute3_d36a3b7f:

    # ra "“Remember?”"
    ra "“别忘了哦？”"

# game/murdochroute3.rpy:8186
translate Schinese murdochroute3_5a3e0e59:

    # m "“You really think folks would have noticed.”"
    m "“迟早会露馅儿的。”"

# game/murdochroute3.rpy:8190
translate Schinese murdochroute3_3c197fb5:

    # "The fox and the rat exchange skeptical glances."
    "狐狸跟老鼠交换了一下眼神。"

# game/murdochroute3.rpy:8193
translate Schinese murdochroute3_c261a44c:

    # mu "“They’d know.”"
    mu "“的确。”"

# game/murdochroute3.rpy:8196
translate Schinese murdochroute3_2ff29670:

    # ra "“No doubt.”"
    ra "“毫无疑问。”"

# game/murdochroute3.rpy:8199
translate Schinese murdochroute3_bed41649:

    # mu "“Here we are.”"
    mu "“我们到了。”"

# game/murdochroute3.rpy:8203
translate Schinese murdochroute3_0428fa0e:

    # "I can see the Byrnes house peeking out from behind a row of houses."
    "隔着一排房屋，我也能瞥到耸立在后方的Byrnes家宅。"

# game/murdochroute3.rpy:8204
translate Schinese murdochroute3_b435f719:

    # "And there’s somebody standing at the gate."
    "还有个人站在大门前。"

# game/murdochroute3.rpy:8205
translate Schinese murdochroute3_17deb8b3:

    # "It’s..."
    "那是..."

# game/murdochroute3.rpy:8207
translate Schinese murdochroute3_4fc86384:

    # "...Mrs. Byrnes."
    "...Byrnes夫人。"

# game/murdochroute3.rpy:8209
translate Schinese murdochroute3_c9c4aa7a:

    # gr "“Goodness me.”"
    gr "“哎呀。”"

# game/murdochroute3.rpy:8212
translate Schinese murdochroute3_7d92dbb0:

    # gr "“Looks like the cavalry’s here.”"
    gr "“骑士们来了。”"

# game/murdochroute3.rpy:8215
translate Schinese murdochroute3_303126e8:

    # gr "“You all must be at least an hour early.”"
    gr "“你们至少早了一个钟头。”"

# game/murdochroute3.rpy:8220
translate Schinese murdochroute3_e9f0bacd:

    # "Murdoch opens his mouth but she turns her attention to the gate."
    "Murdoch正想开口，她却把目光移向了大门。"

# game/murdochroute3.rpy:8223
translate Schinese murdochroute3_9b25250f:

    # gr "“I certainly hope you’re all fed and aren’t thirsty because sun tea takes at least three hours and the batch in the backyard has at least an hour to go.”"
    gr "“希望你们已经酒饱饭足了。日光茶少说要晒三个小时，而后院最近的一批都还差一个钟头。”"

# game/murdochroute3.rpy:8225
translate Schinese murdochroute3_c85373fc:

    # mu "“That won’t be necessary.”"
    mu "“没这个必要。”"

# game/murdochroute3.rpy:8228
translate Schinese murdochroute3_073a6904:

    # gr "“Making a guest comfortable is always necessary, Murdy.”"
    gr "“让客人们感到宾至如归一直很有必要，Murdy。”"

# game/murdochroute3.rpy:8231
translate Schinese murdochroute3_fa3477a0:

    # ra "“Yeah, that’s right, Murdy.”"
    ra "“就是说呀，Murdy。”"

# game/murdochroute3.rpy:8233
translate Schinese murdochroute3_8a40da2f:

    # "Murdoch glared at him."
    "Murdoch瞪了他一眼。"

# game/murdochroute3.rpy:8235
translate Schinese murdochroute3_3c8ee028:

    # gr "“Nine out of ten guests will tell you that they aren’t thirsty.”"
    gr "“十个客人中，有九个会说他们不渴。”"

# game/murdochroute3.rpy:8238
translate Schinese murdochroute3_d6b566e2:

    # gr "“But you put a cup of tea in front of them without asking and they’ll almost always drink.”"
    gr "“但只要默默地把茶递上去，几乎没人会拒绝的。”"

# game/murdochroute3.rpy:8241
translate Schinese murdochroute3_36c018cf:

    # gr "“If only you learned a little bit of hospitality, then your housemate might not be skin and bones.”"
    gr "“稍微懂点待客之道，你的室友也不至于瘦成皮包骨。”"

# game/murdochroute3.rpy:8246
translate Schinese murdochroute3_d461c757:

    # "That put a grin on Murdoch’s face and wiped the smile off of Ralph."
    "Murdoch露出一丝坏笑，Ralph则板起了脸。"

# game/murdochroute3.rpy:8249
translate Schinese murdochroute3_3ee8df1d:

    # gr "“I hope you both take lessons from this young man.”"
    gr "“你们真该多学学这位年轻人。”"

# game/murdochroute3.rpy:8253
translate Schinese murdochroute3_a3fde9d1:

    # "She nods at me."
    "她点头朝我示意。"

# game/murdochroute3.rpy:8255
translate Schinese murdochroute3_0565c4d6:

    # gr "“Now he looks like he eats right.”"
    gr "“瞧瞧，他的饮食一定很均衡。”"

# game/murdochroute3.rpy:8257
translate Schinese murdochroute3_1f44e0ea:

    # "I don’t dare tell her that my diet’s mostly just preserved meat and vegetables."
    "我不敢说我的食物主要是腌肉和蔬菜。"

# game/murdochroute3.rpy:8260
translate Schinese murdochroute3_e31dc5d7:

    # "We follow her through the front door and I’m greeted with the apple and spice scents of the Byrne’s family’s foyer."
    "我们跟着她穿过正门，进到弥漫着苹果和香料气味的门厅。"

# game/murdochroute3.rpy:8262
translate Schinese murdochroute3_acd4f099:

    # gr "“The girls are out back in the rose garden, so don’t any of you think about pestering them.”"
    gr "“姑娘们在玫瑰园，可别打搅了她们。”"

# game/murdochroute3.rpy:8265
translate Schinese murdochroute3_98d8161a:

    # m "“What for?”"
    m "“为什么？”"

# game/murdochroute3.rpy:8267
translate Schinese murdochroute3_ef9c89eb:

    # "She quirked an eyebrow."
    "她挑起眉毛。"

# game/murdochroute3.rpy:8269
translate Schinese murdochroute3_064afc74:

    # gr "“For the bachelorette party?”"
    gr "“当然是淑女派对呀？”"

# game/murdochroute3.rpy:8272
translate Schinese murdochroute3_6acaeaf2:

    # gr "“Is this your first wedding, honey?”"
    gr "“这是你第一次参加婚礼吗，亲爱的？”"

# game/murdochroute3.rpy:8273
translate Schinese murdochroute3_c9917d81:

    # "The first one with wealthy people..."
    "有钱人的是第一次..."

# game/murdochroute3.rpy:8275
translate Schinese murdochroute3_f6a97420:

    # m "“Been a while.”"
    m "“很久没参加了。”"

# game/murdochroute3.rpy:8276
translate Schinese murdochroute3_cd127d78:

    # "I feel something hook onto my elbow."
    "我被人勾住了胳膊。"

# game/murdochroute3.rpy:8279
translate Schinese murdochroute3_875b5233:

    # mu "“Let me show our guest to the upstairs bathroom.”"
    mu "“我先带客人去楼上的浴室。”"

# game/murdochroute3.rpy:8282
translate Schinese murdochroute3_abb132eb:

    # gr "“I’ll get a kettle of tea boiling.”"
    gr "“那么我来泡茶吧。”"

# game/murdochroute3.rpy:8285
translate Schinese murdochroute3_a41d777a:

    # gr "“I can tell we could all use the caffeine.”"
    gr "“看得出来，大家都需要点咖啡因。”"

# game/murdochroute3.rpy:8288
translate Schinese murdochroute3_f4f230fe:

    # "Murdoch is guiding me up the stairs."
    "Murdoch把我带上楼。"

# game/murdochroute3.rpy:8289
translate Schinese murdochroute3_fe10ab79:

    # m "“Uh...”"
    m "“呃...”"

# game/murdochroute3.rpy:8290
translate Schinese murdochroute3_4c27638d:

    # m "“There something wrong?”"
    m "“怎么了吗？”"

# game/murdochroute3.rpy:8291
translate Schinese murdochroute3_a8401027:

    # mu "“Oh, no. Not in particular.”"
    mu "“啊，不，没什么。”"

# game/murdochroute3.rpy:8295
translate Schinese murdochroute3_59a4ff5b:

    # mu "“I just want us all to be prepared.”"
    mu "“我只是想要大家都做好准备。”"

# game/murdochroute3.rpy:8299
translate Schinese murdochroute3_05aa7bf0:

    # mu "“I’ll come find you when you’re sorted out.”"
    mu "“等你收拾好了我再来。”"

# game/murdochroute3.rpy:8301
translate Schinese murdochroute3_e9d43f11:

    # m "“We can probably just get dressed in the same room.”"
    m "“咱们可以用同一间房啊？”"

# game/murdochroute3.rpy:8305
translate Schinese murdochroute3_9156df74:

    # "He’s already gone."
    "他已经走了。"

# game/murdochroute3.rpy:8306
translate Schinese murdochroute3_3f739ce1:

    # "I sigh."
    "我叹了口气。"

# game/murdochroute3.rpy:8307
translate Schinese murdochroute3_89cbec43:

    # "This is one of the nicer bathrooms I’ve ever been in."
    "在我去过的浴室中，这算是高级的了。"

# game/murdochroute3.rpy:8308
translate Schinese murdochroute3_b4ddb786:

    # "There’s porcelain knickknacks, and silver bells."
    "陶瓷摆件，还有银铃。"

# game/murdochroute3.rpy:8309
translate Schinese murdochroute3_5c3fa61b:

    # "I hang the suit up on the door."
    "我把西装挂在门上。"

# game/murdochroute3.rpy:8310
translate Schinese murdochroute3_2f77b16c:

    # "And then I hear something."
    "接着听到什么动静。"

# game/murdochroute3.rpy:8311
translate Schinese murdochroute3_111f78aa:

    # "I go to the window and see something below."
    "我来到窗边一看。"

# game/murdochroute3.rpy:8312
translate Schinese murdochroute3_4ff4122d:

    # "It’s the sisters."
    "是两姐妹。"

# game/murdochroute3.rpy:8313
translate Schinese murdochroute3_8eae3c7c:

    # "Wedding superstition is that you’re not supposed to look at the women until they come out of a box, right?"
    "婚礼上有一种迷信，是姑娘们露面前不能被人看到，来着？"

# game/murdochroute3.rpy:8314
translate Schinese murdochroute3_0bcd3d8f:

    # "Or is that just the groom?"
    "还是不能被新郎看到？"

# game/murdochroute3.rpy:8315
translate Schinese murdochroute3_3a5ea4d4:

    # "Or just on the wedding day?"
    "还是只在婚礼当天不行？"

# game/murdochroute3.rpy:8316
translate Schinese murdochroute3_16997087:

    # "Hrm."
    "唔。"

# game/murdochroute3.rpy:8317
translate Schinese murdochroute3_d03bfe39:

    # "Fuck it."
    "管它呢。"

# game/murdochroute3.rpy:8318
translate Schinese murdochroute3_fc8fbacf:

    # dh "“You seem rather placid.”"
    dh "“你好像很平静嘛。”"

# game/murdochroute3.rpy:8319
translate Schinese murdochroute3_fe1ad68a:

    # ho "“Well, why shouldn’t I be?”"
    ho "“为什么要不平静呢？”"

# game/murdochroute3.rpy:8320
translate Schinese murdochroute3_570874bc:

    # ho "“I’m about to be surrounded by good food.”"
    ho "“再过不久，我们就有美食享用了。”"

# game/murdochroute3.rpy:8321
translate Schinese murdochroute3_3a7fddb1:

    # ho "“Good company.”"
    ho "“在亲朋好友的陪伴下。”"

# game/murdochroute3.rpy:8322
translate Schinese murdochroute3_475a8e1e:

    # ho "“I haven’t been to a proper party in nearly a year, much less one planned for me.”"
    ho "“我将近一年没参加过正式的派对了，更别提这次我是主角。”"

# game/murdochroute3.rpy:8323
translate Schinese murdochroute3_7095b185:

    # dh "“And everything’s fine?”"
    dh "“一切都好吗？”"

# game/murdochroute3.rpy:8324
translate Schinese murdochroute3_41acd426:

    # ho "“Is it not?”"
    ho "“有哪里不好吗？”"

# game/murdochroute3.rpy:8325
translate Schinese murdochroute3_cc5c5559:

    # dh "“It’s just strange to me that you don’t have jitters yet.”"
    dh "“我只是好奇你怎么还没有紧张起来。”"

# game/murdochroute3.rpy:8326
translate Schinese murdochroute3_04c210fc:

    # ho "“Why would I?”"
    ho "“为什么要紧张？”"

# game/murdochroute3.rpy:8327
translate Schinese murdochroute3_7a278cc5:

    # ho "“I’ve looked forward to this day my entire life.”"
    ho "“我这辈子就盼着这一天了。”"

# game/murdochroute3.rpy:8328
translate Schinese murdochroute3_483bb330:

    # dh "“Which means you have expectations.”"
    dh "“这代表你的心态很积极。”"

# game/murdochroute3.rpy:8329
translate Schinese murdochroute3_fab18d74:

    # ho "“Which means I have confidence, dear.”"
    ho "“还代表我很有自信，亲爱的。”"

# game/murdochroute3.rpy:8330
translate Schinese murdochroute3_41ded0bd:

    # dh "“Even if you shoot down his move proposal?”"
    dh "“虽然你还是拒绝了他搬出去住的提议？”"

# game/murdochroute3.rpy:8331
translate Schinese murdochroute3_95998862:

    # ho "“The issue is on the backburner for now.”"
    ho "“这点有待商榷。”"

# game/murdochroute3.rpy:8332
translate Schinese murdochroute3_c2b69572:

    # ho "“I don’t think it’s particularly important.”"
    ho "“虽然我是觉得没什么大不了的。”"

# game/murdochroute3.rpy:8333
translate Schinese murdochroute3_0c89aea2:

    # ho "“A home is still a home, wherever we might end up.”"
    ho "“不管去哪儿，我们都能落地生根。”"

# game/murdochroute3.rpy:8334
translate Schinese murdochroute3_268636c1:

    # dh "“And I suppose you think that will go over well with her?”"
    dh "“那你觉得能说服她吗？”"

# game/murdochroute3.rpy:8335
translate Schinese murdochroute3_2dec57fa:

    # ho "“I suppose that it will have to.”"
    ho "“不能也得能。”"

# game/murdochroute3.rpy:8336
translate Schinese murdochroute3_933a4a9e:

    # ho "“It’s my life, after all.”"
    ho "“毕竟，这是我自己的人生。”"

# game/murdochroute3.rpy:8337
translate Schinese murdochroute3_b5cfa547:

    # dh "“Despite its gravitational pull on the rest of us.”"
    dh "“但我们这些留下的人也会被攥得更紧了。”"

# game/murdochroute3.rpy:8338
translate Schinese murdochroute3_47dca731:

    # ho "“There’s no way that can last.”"
    ho "“不会一直这样下去的。”"

# game/murdochroute3.rpy:8339
translate Schinese murdochroute3_8e2fdb93:

    # dh "“We’re going on three decades.”"
    dh "“快三十年了呢。”"

# game/murdochroute3.rpy:8340
translate Schinese murdochroute3_3367d12c:

    # ho "“Then I’m sorry.”"
    ho "“那我就先说声抱歉了。”"

# game/murdochroute3.rpy:8341
translate Schinese murdochroute3_90085186:

    # dh "“If you were sorry then you’d push back a little harder when she puts more responsibilities on you.”"
    dh "“你要真觉得抱歉，就该在她推给你更多责任的时候果断拒绝。”"

# game/murdochroute3.rpy:8342
translate Schinese murdochroute3_818faac0:

    # ho "“You should know by now that guilt trips don’t work on me.”"
    ho "“你也知道，我不吃道德绑架这一套。”"

# game/murdochroute3.rpy:8343
translate Schinese murdochroute3_467c5268:

    # dh "“I wasn’t doing anything of the sort you silly thing.”"
    dh "“我才没有道德绑架你，笨蛋。”"

# game/murdochroute3.rpy:8344
translate Schinese murdochroute3_c84196cf:

    # ho "“You were.”"
    ho "“你有。”"

# game/murdochroute3.rpy:8345
translate Schinese murdochroute3_0a2ea103:

    # ho "“Now hold still.”"
    ho "“先别动。”"

# game/murdochroute3.rpy:8346
translate Schinese murdochroute3_e2d295ac:

    # ho "“There’s clumps in your tail.”"
    ho "“你的尾巴分岔了。”"

# game/murdochroute3.rpy:8347
translate Schinese murdochroute3_5d59bf83:

    # mu "“Evening, girls.”"
    mu "“晚上好啊，姑娘们。”"

# game/murdochroute3.rpy:8348
translate Schinese murdochroute3_7f8aab44:

    # dh "“Murdoch!”"
    dh "“Murdoch！”"

# game/murdochroute3.rpy:8349
translate Schinese murdochroute3_383512c8:

    # ho "“You’re a little early?”"
    ho "“你来得有点早了吧？”"

# game/murdochroute3.rpy:8350
translate Schinese murdochroute3_a7e75ae0:

    # mu "“Better than late, no?”"
    mu "“总比迟到好，对吧？”"

# game/murdochroute3.rpy:8351
translate Schinese murdochroute3_46a0edce:

    # ho "“After a fashion.”"
    ho "“半斤八两。”"

# game/murdochroute3.rpy:8352
translate Schinese murdochroute3_37585523:

    # mu "“It’s your day, Holly.”"
    mu "“今天可是你大喜的日子啊，Holly。”"

# game/murdochroute3.rpy:8353
translate Schinese murdochroute3_cd108401:

    # mu "“Can I get you anything.”"
    mu "“有什么地方需要我帮忙吗？”"

# game/murdochroute3.rpy:8354
translate Schinese murdochroute3_26724e1a:

    # ho "“A water might be nice.”"
    ho "“那就帮我拿杯水吧。”"

# game/murdochroute3.rpy:8355
translate Schinese murdochroute3_cbc1c74b:

    # dh "“I have a few things written down that we could use for the party.”"
    dh "“我罗列了些派对用的物品。”"

# game/murdochroute3.rpy:8356
translate Schinese murdochroute3_98110574:

    # dh "“Here it is.”"
    dh "“给你。”"

# game/murdochroute3.rpy:8357
translate Schinese murdochroute3_704ef33a:

    # mu "“Excellent.”"
    mu "“包在我身上。”"

# game/murdochroute3.rpy:8358
translate Schinese murdochroute3_67a59d41:

    # mu "“I’ll see it done after I get dressed myself.”"
    mu "“我换好衣服就去办。”"

# game/murdochroute3.rpy:8359
translate Schinese murdochroute3_355a27a1:

    # "My tail tips over something and I hear a sharp ringing sound."
    "我的尾巴碰到了什么东西，发出刺耳的铃声。"

# game/murdochroute3.rpy:8360
translate Schinese murdochroute3_2d019588:

    # "I realize now that the window is wide open and I’m almost entirely nude."
    "这才惊觉现在窗户大开，而我本人近乎全裸。"

# game/murdochroute3.rpy:8361
translate Schinese murdochroute3_ad8835bd:

    # "So I step away as quickly as I can."
    "我连忙退后。"

# game/murdochroute3.rpy:8362
translate Schinese murdochroute3_bfc9bffb:

    # "I don’t hear anybody screaming, so I assume nobody saw me."
    "没听见有人尖叫，所以应该没被看到。"

# game/murdochroute3.rpy:8363
translate Schinese murdochroute3_fc7ff3a3:

    # "I better hurry up..."
    "我最好抓紧了..."

# game/murdochroute3.rpy:8364
translate Schinese murdochroute3_609a70de:

    # "There."
    "搞定。"

# game/murdochroute3.rpy:8365
translate Schinese murdochroute3_0268368c:

    # "Shirt tucked."
    "上衣扎好了。"

# game/murdochroute3.rpy:8366
translate Schinese murdochroute3_42039b75:

    # "Vest buttoned."
    "背心扣好了。"

# game/murdochroute3.rpy:8368
translate Schinese murdochroute3_221c483f:

    # "Cufflinks slotted."
    "袖扣装好了。"

# game/murdochroute3.rpy:8372
translate Schinese murdochroute3_463d9a79:

    # "I walk downstairs and poke my head into the living room."
    "我走下楼，把头探进客厅。"

# game/murdochroute3.rpy:8374
translate Schinese murdochroute3_7b863cda:

    # "I don’t see Murdoch or Ralph yet."
    "Murdoch和Ralph都不在。"

# game/murdochroute3.rpy:8376
translate Schinese murdochroute3_07f7950e:

    # gr "“Oh good, you’re here.”"
    gr "“很好，你来了。”"

# game/murdochroute3.rpy:8379
translate Schinese murdochroute3_9fda605f:

    # gr "“Make yourself comfortable.”"
    gr "“放轻松。”"

# game/murdochroute3.rpy:8382
translate Schinese murdochroute3_3bf94912:

    # gr "“We don’t stigmatize the help in this house.”"
    gr "“我们家从不亏待帮手。”"

# game/murdochroute3.rpy:8384
translate Schinese murdochroute3_c6b05797:

    # "I nod, feeling my cheeks get a bit flushed."
    "我点点头，感觉脸颊微微发烫。"

# game/murdochroute3.rpy:8385
translate Schinese murdochroute3_83f89e0c:

    # "She puts a cup on a coaster in front of me and pours it."
    "她把杯子放在我面前的杯垫上，并往里倒茶。"

# game/murdochroute3.rpy:8387
translate Schinese murdochroute3_d0abe9fd:

    # gr "“Drink.”"
    gr "“请喝吧。”"

# game/murdochroute3.rpy:8389
translate Schinese murdochroute3_722a41f8:

    # "I remember her earlier comments and know it’s not a suggestion."
    "我想起她之前说过的话，恍悟道这不是建议。"

# game/murdochroute3.rpy:8390
translate Schinese murdochroute3_fe23443b:

    # "The taste is strong, but smooth."
    "味道很浓，但很顺喉。"

# game/murdochroute3.rpy:8391
translate Schinese murdochroute3_55adad37:

    # "Surprisingly nice."
    "意外的好喝。"

# game/murdochroute3.rpy:8393
translate Schinese murdochroute3_c83b908c:

    # gr "“So what are you all about?”"
    gr "“所以你将来有什么打算？”"

# game/murdochroute3.rpy:8395
translate Schinese murdochroute3_2e57e23c:

    # m "“What am I about, ma’am?”"
    m "“打算？”"

# game/murdochroute3.rpy:8397
translate Schinese murdochroute3_3bbca04b:

    # "She shrugs."
    "她耸耸肩。"

# game/murdochroute3.rpy:8399
translate Schinese murdochroute3_34d9b1c1:

    # gr "“Your hopes.”"
    gr "“你的展望。”"

# game/murdochroute3.rpy:8402
translate Schinese murdochroute3_894e5c99:

    # gr "“Your dreams.”"
    gr "“抱负。”"

# game/murdochroute3.rpy:8405
translate Schinese murdochroute3_93e34987:

    # gr "“Your ambitions.”"
    gr "“理想。”"

# game/murdochroute3.rpy:8408
translate Schinese murdochroute3_8da43cb4:

    # gr "“Ideologies?”"
    gr "“野心？”"

# game/murdochroute3.rpy:8411
translate Schinese murdochroute3_bcb8ad90:

    # gr "“Anything really.”"
    gr "“什么都行。”"

# game/murdochroute3.rpy:8414
translate Schinese murdochroute3_89db0b5c:

    # gr "“I haven’t quite sketched a mental image of you.”"
    gr "“我对你的认识还不够。”"

# game/murdochroute3.rpy:8417
translate Schinese murdochroute3_580a151d:

    # gr "“The ink smudges are there, sure, but nothing substantial.”"
    gr "“不足以勾勒出轮廓。”"

# game/murdochroute3.rpy:8419
translate Schinese murdochroute3_a2d6c814:

    # m "“I don’t mean to be rude, but I don’t think I’m very interesting.”"
    m "“无意冒犯，但我自认为不是一个有趣的人。”"

# game/murdochroute3.rpy:8421
translate Schinese murdochroute3_b84b912c:

    # gr "“It’s quite rude to keep a conversation on ice, Mr. Ayers.”"
    gr "“把话谈僵可是很失礼的，Ayers先生。”"

# game/murdochroute3.rpy:8424
translate Schinese murdochroute3_cd7e88e7:

    # gr "“You can tell me anything you like.”"
    gr "“随便聊聊吧。”"

# game/murdochroute3.rpy:8427
translate Schinese murdochroute3_cf2c8403:

    # gr "“Considering the great many families I come across in my line of work, I can guarantee that anything you could tell me I’ve probably heard about something else.”"
    gr "“我行业多年，与形形色色的家庭打过交道，也算是见多识广了。”"

# game/murdochroute3.rpy:8430
translate Schinese murdochroute3_82ebad37:

    # gr "“I’ve been told I have an open mind.”"
    gr "“我可是被评价为很开明的。”"

# game/murdochroute3.rpy:8433
translate Schinese murdochroute3_3e9c27fa:

    # gr "“Unless you’re a communist.”"
    gr "“除非你是共产主义者。”"

# game/murdochroute3.rpy:8435
translate Schinese murdochroute3_447f94b8:

    # m "“I’m afraid I don’t know much about politics, ma’am.”"
    m "“恐怕我并不了解政治，夫人。”"

# game/murdochroute3.rpy:8437
translate Schinese murdochroute3_116e1a7e:

    # gr "“Well, that’s no good.”"
    gr "“这可不好。”"

# game/murdochroute3.rpy:8440
translate Schinese murdochroute3_b3320d4c:

    # gr "“You’re what, 23?”"
    gr "“你多大年纪了，23？”"

# game/murdochroute3.rpy:8442
translate Schinese murdochroute3_e06d6098:

    # m "“25.”"
    m "“25。”"

# game/murdochroute3.rpy:8444
translate Schinese murdochroute3_f1ae26f2:

    # gr "“How can you possibly get your government to protect you if you don’t even know what your government can do for you?”"
    gr "“你如果连自己政府的底细都摸不清，又怎么能指望它为你遮风挡雨呢？”"

# game/murdochroute3.rpy:8446
translate Schinese murdochroute3_59a27d4c:

    # m "“I guess that’s true.”"
    m "“您说的是。”"

# game/murdochroute3.rpy:8448
translate Schinese murdochroute3_58f17dad:

    # gr "“I was joking about the communism by the way.”"
    gr "“顺带一提，刚才那句共产主义是开玩笑的。”"

# game/murdochroute3.rpy:8451
translate Schinese murdochroute3_a138dc62:

    # gr "“Your labor’s good to me, even if you don’t believe in the dollar.”"
    gr "“就算信仰共产制，你一样帮了我大忙。”"

# game/murdochroute3.rpy:8453
translate Schinese murdochroute3_aa2ec381:

    # gr "“Do you at least plan on voting this November?”"
    gr "“说到底，你有计划参与今年十一月份的投票吗？”"

# game/murdochroute3.rpy:8454
translate Schinese murdochroute3_86fda81c:

    # m "“I don’t really vote.”"
    m "“我很少投票。”"

# game/murdochroute3.rpy:8456
translate Schinese murdochroute3_c560beda:

    # gr "“So not only do you not know what to vote for, but you wouldn’t even if you did?”"
    gr "“所以你不仅不知道该投谁，就连投都不去投？”"

# game/murdochroute3.rpy:8459
translate Schinese murdochroute3_b6e55e22:

    # gr "“That’s pitiful.”"
    gr "“太可怜了。”"

# game/murdochroute3.rpy:8461
translate Schinese murdochroute3_a20c56ed:

    # gr "“I’m sorry our country failed you.”"
    gr "“是我们的国家辜负了你。”"

# game/murdochroute3.rpy:8463
translate Schinese murdochroute3_5e313d3d:

    # gr "“Because it’s been failing me since birth, sweetheart.”"
    gr "“自打我出生起，它就没有一刻不让我失望，亲爱的。”"

# game/murdochroute3.rpy:8466
translate Schinese murdochroute3_f0c9bef7:

    # gr "“You at least know that women can’t currently vote in this country, right?”"
    gr "“你起码知道这个国家的女性没有投票权吧？”"

# game/murdochroute3.rpy:8468
translate Schinese murdochroute3_fc5869b9:

    # "That’s something I do know, at least..."
    "这个我好歹还是知道的..."

# game/murdochroute3.rpy:8469
translate Schinese murdochroute3_b6198e92:

    # m "“Unfortunately.”"
    m "“很不幸。”"

# game/murdochroute3.rpy:8471
translate Schinese murdochroute3_c5ca3b8c:

    # "She sees my frown and smiles."
    "她看到我皱眉，露出微笑。"

# game/murdochroute3.rpy:8473
translate Schinese murdochroute3_9b4c605c:

    # gr "“That won’t be the case for long.”"
    gr "“时代在变了。”"

# game/murdochroute3.rpy:8475
translate Schinese murdochroute3_1df467dd:

    # gr "“I’d wager the house on that.”"
    gr "“我可以用我的房子起誓。”"

# game/murdochroute3.rpy:8478
translate Schinese murdochroute3_24ed587d:

    # "We hear a knock on the door."
    "敲门声传来。"

# game/murdochroute3.rpy:8480
translate Schinese murdochroute3_0874402c:

    # gr "“Oh, for heaven’s sake.”"
    gr "“哎呀，我的天。”"

# game/murdochroute3.rpy:8483
translate Schinese murdochroute3_0ebc0608:

    # gr "“You know, it would be the bee’s knees if everybody were early at school every day.”"
    gr "“要是学生们也有早到的习惯就好了。”"

# game/murdochroute3.rpy:8486
translate Schinese murdochroute3_b9a367d9:

    # gr "“Go on and get the door.”"
    gr "“去应门吧。”"

# game/murdochroute3.rpy:8488
translate Schinese murdochroute3_7ef5f344:

    # "I don’t think I could disobey this woman if I tried."
    "我想，我是不可能违抗这个女人的。"

# game/murdochroute3.rpy:8490
translate Schinese murdochroute3_d3baaf01:

    # "I stand up and march to the door."
    "我站起来，走到门前。"

# game/murdochroute3.rpy:8491
translate Schinese murdochroute3a_084c0f57:

    # "Then I put my paw on the cold handle, twist it, and then tug it open."
    "用手握住冰凉的门把，把门打开。"

# game/murdochroute3.rpy:459
translate Schinese murdochroute3a_ea85d284:

    # "I crack the door just a bit and look past the crack."
    "我只开了一小道门缝，窥向外头。"

# game/murdochroute3.rpy:461
translate Schinese murdochroute3a_1fdabb88:

    # m "“Who’s there?”"
    m "“谁？”"

# game/murdochroute3.rpy:463
translate Schinese murdochroute3a_c56e020e:

    # ji "“What do you mean who’s there?”"
    ji "“还能有谁？”"

# game/murdochroute3.rpy:464
translate Schinese murdochroute3a_db2c4122:

    # ji "“The anticipated party.”"
    ji "“当然是预定要来的客人了。”"

# game/murdochroute3.rpy:465
translate Schinese murdochroute3a_826c9c75:

    # "I can hear Jim’s tail lashing just from the tone of his voice."
    "光凭Jim的声音，我就听得出他在甩尾巴。"

# game/murdochroute3.rpy:466
translate Schinese murdochroute3a_171758f3:

    # reuunk "“Is everything alright over there?”"
    reuunk "“里面没事吧？”"

# game/murdochroute3.rpy:467
translate Schinese murdochroute3a_00bfb466:

    # "I hear a man’s voice I’ve never heard before."
    "一个陌生的男人说话了。"

# game/murdochroute3.rpy:468
translate Schinese murdochroute3a_32aafbed:

    # neiunk "“Jim?”"
    neiunk "“Jim？”"

# game/murdochroute3.rpy:469
translate Schinese murdochroute3a_5f0f8fc6:

    # "Then another."
    "又一个。"

# game/murdochroute3.rpy:470
translate Schinese murdochroute3a_2d4a8cbe:

    # ji "“I should hope so.”"
    ji "“没事最好。”"

# game/murdochroute3.rpy:471
translate Schinese murdochroute3a_2d9773ee:

    # ji "“Though I can’t for the life of me tell why the front door is cracked open in this manor.”"
    ji "“只是我想不通，这么栋宅子，为何正门只开一小条缝。”"

# game/murdochroute3.rpy:472
translate Schinese murdochroute3a_5f2a1826:

    # ji "“Is there a smuggling operation going on in there?”"
    ji "“难不成是在进行走私交易？”"

# game/murdochroute3.rpy:473
translate Schinese murdochroute3a_94004a03:

    # "Oh."
    "哦。"

# game/murdochroute3.rpy:482
translate Schinese murdochroute3a_ff5f4bbc:

    # "Right."
    "对了。"

# game/murdochroute3.rpy:475
translate Schinese murdochroute3a_e38ad1dc:

    # "This is Murdoch’s front door, not my bedroom."
    "这是Murdoch家的大门，不是我房间的。"

# game/murdochroute3.rpy:476
translate Schinese murdochroute3a_ac84a8d9:

    # "Force of habit."
    "习惯了。"

# game/murdochroute3.rpy:477
translate Schinese murdochroute3a_f16f92c2:

    # m "“Ah, sorry, I’ll--”"
    m "“抱歉，我马上-”"

# game/murdochroute3.rpy:479
translate Schinese murdochroute3a_84bccfc5:

    # gr "“Oh no you won’t!”"
    gr "“噢，那可不行！”"

# game/murdochroute3.rpy:481
translate Schinese murdochroute3a_32b8179c:

    # "I jump hearing Mrs. Byrnes’ voice right behind me as she touches my shoulder, brushing it to signal my scooting out of the way."
    "Byrnes夫人的声音自我正后方响起，吓了我一跳。她把手搭在我的肩膀上一划，示意我让开。"

# game/murdochroute3.rpy:756
translate Schinese murdochroute3a_e66de030:

    # gr "“Not one step forward, you rascals.”"
    gr "“你们几个无赖，休想再往前一步了。”"

# game/murdochroute3.rpy:486
translate Schinese murdochroute3a_5dfae96b:

    # gr "“Holly’s still trying her dress on.”"
    gr "“Holly还在试装呢。”"

# game/murdochroute3.rpy:489
translate Schinese murdochroute3a_006b6dd8:

    # gr "“I won’t risk for one moment the chance for you to lay eyes on her before the wedding.”"
    gr "“婚礼开始前，我绝不会让你们有一丝看到她的可能性。”"

# game/murdochroute3.rpy:491
translate Schinese murdochroute3a_59768de6:

    # gr "“It’s bad luck you know!”"
    gr "“不然会触霉头的！”"

# game/murdochroute3.rpy:493
translate Schinese murdochroute3a_0f638adf:

    # "I think there’s some playfulness in Mrs. Byrnes voice, but it’s hard to tell."
    "Byrnes夫人半开玩笑地说道，又或者她并没有在开玩笑。"

# game/murdochroute3.rpy:494
translate Schinese murdochroute3a_044f2054:

    # ji "“Well we’re not exactly sticklers for tradition.”"
    ji "“拘泥于传统不是我们的风格。”"

# game/murdochroute3.rpy:495
translate Schinese murdochroute3a_45713c0a:

    # "Jim is noticeably less amused."
    "Jim显然不怎么高兴。"

# game/murdochroute3.rpy:497
translate Schinese murdochroute3a_9871a707:

    # gr "“Well while you’re under this roof you will be.”"
    gr "“入了乡，就得随俗。”"

# game/murdochroute3.rpy:500
translate Schinese murdochroute3a_ade4a55a:

    # gr "“Hold for a moment.”"
    gr "“请稍等吧。”"

# game/murdochroute3.rpy:503
translate Schinese murdochroute3a_3c4faa91:

    # "She closes the door on him and spins around, looking."
    "她关上门，转身张望起来。"

# game/murdochroute3.rpy:505
translate Schinese murdochroute3a_09fc6dcc:

    # "Then she sighs."
    "然后叹了口气。"

# game/murdochroute3.rpy:508
translate Schinese murdochroute3a_84126901:

    # gr "“Now where’s Murdy when you need him...”"
    gr "“Murdy又跑到哪里去了，现在正是需要他的时候...”"

# game/murdochroute3.rpy:510
translate Schinese murdochroute3a_cce14498:

    # "Her eyes fixate on me."
    "说着，她盯上了我。"

# game/murdochroute3.rpy:512
translate Schinese murdochroute3a_da1b1562:

    # gr "“You go find him and keep the girls on high alert.”"
    gr "“你去找找他，顺便让姑娘们提高警惕。”"

# game/murdochroute3.rpy:515
translate Schinese murdochroute3a_1db87573:

    # gr "“I’ll hold the fort.”"
    gr "“这里交给我。”"

# game/murdochroute3.rpy:517
translate Schinese murdochroute3a_1aeaa021:

    # gr "“I wouldn’t put it past this crew to sneak out to the garden and steal a look.”"
    gr "“那几个小子会跑去花园里偷看我也丝毫不意外。”"

# game/murdochroute3.rpy:519
translate Schinese murdochroute3a_b59cb80e:

    # m "“Alright...”"
    m "“好的...”"

# game/murdochroute3.rpy:521
translate Schinese murdochroute3a_5a549992:

    # "I hear somebody turn a corner in the hall."
    "我听见有人转过大厅拐角。"

# game/murdochroute3.rpy:523
translate Schinese murdochroute3a_dfa01cfc:

    # "I half expect it to be Ralph or Murdoch’s father, but it isn’t."
    "起初我以为那是Ralph或Murdoch的爸爸，但都不是。"

# game/murdochroute3.rpy:524
translate Schinese murdochroute3a_979e6aac:

    # m "“Dahlia.”"
    m "“Dahlia。”"

# game/murdochroute3.rpy:526
translate Schinese murdochroute3a_6a38a891:

    # "She gives me a curt nod."
    "她轻点了一下头。"

# game/murdochroute3.rpy:528
translate Schinese murdochroute3a_d0b69dbb:

    # dh "“Mr. Ayers.”"
    dh "“Ayers先生。”"

# game/murdochroute3.rpy:530
translate Schinese murdochroute3a_2fa4eb80:

    # m "“I thought you’d still be out in the garden right now.”"
    m "“我以为你还在花园。”"

# game/murdochroute3.rpy:532
translate Schinese murdochroute3a_97c7b050:

    # dh "“What makes you say that?”"
    dh "“您是怎么知道的？”"

# game/murdochroute3.rpy:534
translate Schinese murdochroute3a_173f58f8:

    # "I realize for a moment that I probably wasn’t supposed to have heard her and her sister’s conversation from the bathroom."
    "我才发觉刚才在浴室里偷听她们姐妹聊天是不应该的。"

# game/murdochroute3.rpy:535
translate Schinese murdochroute3a_cedb39b3:

    # "So I just jerk my head in the direction of the foyer."
    "于是我把头瞥向门厅。"

# game/murdochroute3.rpy:536
translate Schinese murdochroute3a_ac694345:

    # m "“Your momma told me you would be.”"
    m "“是夫人告诉我的。”"

# game/murdochroute3.rpy:537
translate Schinese murdochroute3a_0f567014:

    # "She purses her lips."
    "她抿了抿嘴唇。"

# game/murdochroute3.rpy:539
translate Schinese murdochroute3a_21e0eb15:

    # dh "“I see.”"
    dh "“这样啊。”"

# game/murdochroute3.rpy:541
translate Schinese murdochroute3a_a97e798b:

    # m "“Gave me orders to find Murdoch and have us shield Holly from Jim’s sight, or somethin’.”"
    m "“她要我去找Murdoch，保护Holly不被Jim看见，之类的。”"

# game/murdochroute3.rpy:543
translate Schinese murdochroute3a_ed1b931f:

    # dh "“That sounds like her.”"
    dh "“的确像是她会说的话。”"

# game/murdochroute3.rpy:546
translate Schinese murdochroute3a_3f21d392:

    # dh "“Murdoch’s already in the garden, so you won’t have to look for very long.”"
    dh "“Murdoch就在花园里，您不用花时间找他了。”"

# game/murdochroute3.rpy:548
translate Schinese murdochroute3a_5f1875b7:

    # m "“Oh, good.”"
    m "“哦，太好了。”"

# game/murdochroute3.rpy:550
translate Schinese murdochroute3a_4cb5b841:

    # m "“Have you seen Ralph?”"
    m "“你有看见Ralph吗？”"

# game/murdochroute3.rpy:552
translate Schinese murdochroute3a_d4f8fd0d:

    # dh "“Father took him to carry a few things.”"
    dh "“父亲带他去搬几样东西。”"

# game/murdochroute3.rpy:554
translate Schinese murdochroute3a_c236c4f9:

    # "There’s one less person to worry about for now."
    "少了一个要担心的人。"

# game/murdochroute3.rpy:555
translate Schinese murdochroute3a_287013e6:

    # m "“Right. Thanks.”"
    m "“谢谢。”"

# game/murdochroute3.rpy:557
translate Schinese murdochroute3a_86f04b66:

    # dh "“Be patient before you make yourself known if you decide to go out there.”"
    dh "“要去外面的话，最好耐心等待露面的时机。”"

# game/murdochroute3.rpy:560
translate Schinese murdochroute3a_986ec21f:

    # dh "“We’re all under a lot of pressure.”"
    dh "“大家的压力都很大。”"

# game/murdochroute3.rpy:562
translate Schinese murdochroute3a_6b272915:

    # "Weird thing to say."
    "这话真奇怪。"

# game/murdochroute3.rpy:563
translate Schinese murdochroute3a_6f19d038:

    # m "“Alright.”"
    m "“知道了。”"

# game/murdochroute3.rpy:565
translate Schinese murdochroute3a_24a323e8:

    # "I walk out back through a little room with a screen door at the back and find myself in the rose garden."
    "我穿过一道纱门，来到了房子后面的玫瑰园。"

# game/murdochroute3.rpy:566
translate Schinese murdochroute3a_414b59fa:

    # "High fences block my view of most things out here save a few gaps in the lattice."
    "高高的栅栏阻碍了我的大部分视线，只能透过间隔看到一点东西。"

# game/murdochroute3.rpy:567
translate Schinese murdochroute3a_d24e414b:

    # "But I can hear Murdoch and Holly conversing."
    "不过听得见Murdoch在跟Holly交谈。"

# game/murdochroute3.rpy:568
translate Schinese murdochroute3a_989b3dcc:

    # mu "“I’m just not particularly interested.”"
    mu "“我就是提不起兴致。”"

# game/murdochroute3.rpy:569
translate Schinese murdochroute3a_7780e05e:

    # ho "“Why?”"
    ho "“为什么？”"

# game/murdochroute3.rpy:570
translate Schinese murdochroute3a_39ff9e47:

    # ho "“It’s just one party.”"
    ho "“不过是一场派对。”"

# game/murdochroute3.rpy:571
translate Schinese murdochroute3a_26efc695:

    # mu "“Regardless.”"
    mu "“总之。”"

# game/murdochroute3.rpy:572
translate Schinese murdochroute3a_f01b3b2d:

    # mu "“His friends are coming.”"
    mu "“他的朋友们也会来。”"

# game/murdochroute3.rpy:573
translate Schinese murdochroute3a_056ce8de:

    # mu "“I doubt I’ll be missed.”"
    mu "“没我什么事了吧。”"

# game/murdochroute3.rpy:574
translate Schinese murdochroute3a_d8556e00:

    # ho "“There’s another side to that coin too.”"
    ho "“跟你有没有关系还不好说呢。”"

# game/murdochroute3.rpy:575
translate Schinese murdochroute3a_6456d365:

    # ho "“Do you even know how many parties I’ve had to attend when I’ve preferred to stay in?”"
    ho "“你知不知道有多少派对，是我宁愿待在家里也不想去的？”"

# game/murdochroute3.rpy:576
translate Schinese murdochroute3a_c39c4424:

    # mu "“Isn’t that beside the point?”"
    mu "“这不是重点吧？”"

# game/murdochroute3.rpy:577
translate Schinese murdochroute3a_943d6237:

    # ho "“No.”"
    ho "“不对。”"

# game/murdochroute3.rpy:578
translate Schinese murdochroute3a_e32227ad:

    # ho "“It’s the entire point.”"
    ho "“这恰恰是整件事的重点。”"

# game/murdochroute3.rpy:579
translate Schinese murdochroute3a_287568d9:

    # ho "“I’ll finely dot it with a peacock’s quill if I must.”"
    ho "“如果可以的话，我都想用孔雀羽毛笔给你标记出来了。”"

# game/murdochroute3.rpy:580
translate Schinese murdochroute3a_e3f4eb97:

    # ho "“You’re not obliged to fulfill a fraction of the social obligations I’ve had over the years.”"
    ho "“你又不用承担我这么些年所承担的社交义务。”"

# game/murdochroute3.rpy:581
translate Schinese murdochroute3a_0354e343:

    # ho "“They didn’t ship you to finishing school, nor dictate the cut of your clothing, nor the colors of fabric that look best on you nigh daily.”"
    ho "“他们不会把你送去精修学校，也不会规定你的着装，更不会唠叨你每天穿哪个颜色才合身。”"

# game/murdochroute3.rpy:582
translate Schinese murdochroute3a_977e0a3a:

    # ho "“You’re not even expected to give them grandchildren.”"
    ho "“甚至不指望你为他们延续香火。”"

# game/murdochroute3.rpy:583
translate Schinese murdochroute3a_40d7f101:

    # mu "“Holly...”"
    mu "“Holly...”"

# game/murdochroute3.rpy:584
translate Schinese murdochroute3a_300afac1:

    # ho "“I’m just curious to hear what you think, Murdoch.”"
    ho "“我真的很好奇你的想法，Murdoch。”"

# game/murdochroute3.rpy:585
translate Schinese murdochroute3a_f27f5b6e:

    # ho "“Do you think they’d treat me the same if they found me stealing off into the night to dance in a barn?”"
    ho "“你觉得如果我也在晚上偷偷溜去谷仓跳舞，下场会跟你一样简单吗？”"

# game/murdochroute3.rpy:586
translate Schinese murdochroute3a_0ceb625d:

    # ho "“Father would have me examined if he found me even going for groceries after dark.”"
    ho "“光是晚上买东西被逮到，父亲都要仔细盘问我一番。”"

# game/murdochroute3.rpy:587
translate Schinese murdochroute3a_68e84b48:

    # mu "“I know you have it hard as well.”"
    mu "“我知道你也有你的难处。”"

# game/murdochroute3.rpy:588
translate Schinese murdochroute3a_c67b6d4b:

    # "The vixen bursts out an angry little laugh."
    "雌狐没好气地笑了声。"

# game/murdochroute3.rpy:589
translate Schinese murdochroute3a_f3157b61:

    # ho "“Hard? You?”"
    ho "“也？你？”"

# game/murdochroute3.rpy:590
translate Schinese murdochroute3a_bb630db1:

    # ho "“So going to a party is hard now?”"
    ho "“参加个派对都成难处了？”"

# game/murdochroute3.rpy:591
translate Schinese murdochroute3a_c469d2f8:

    # mu "“No...”"
    mu "“不是...”"

# game/murdochroute3.rpy:592
translate Schinese murdochroute3a_81ce4869:

    # ho "“And here I thought you would jump at the opportunity to do something you do all the time anyway.”"
    ho "“你整天潇洒快活，居然会放过这个机会吗。”"

# game/murdochroute3.rpy:594
translate Schinese murdochroute3a_aada63c7:

    # mu "“It’s not the same.”"
    mu "“这不一样。”"

# game/murdochroute3.rpy:595
translate Schinese murdochroute3a_18dacfd9:

    # ho "“I never said it was, but can’t you just do this one last thing?”"
    ho "“我没说一样，但你就不能做这最后一次吗？”"

# game/murdochroute3.rpy:596
translate Schinese murdochroute3a_ec5d6d24:

    # ho "“The wedding’s tomorrow.”"
    ho "“明天就是婚礼了。”"

# game/murdochroute3.rpy:597
translate Schinese murdochroute3a_3baa8f40:

    # ho "“Everybody needs to be in a good mood for this all to work out.”"
    ho "“为了确保万无一失，所有人都必须开心。”"

# game/murdochroute3.rpy:598
translate Schinese murdochroute3a_fce95952:

    # mu "“If everything has to go perfectly for everything to work out, doesn’t that make the plan...”"
    mu "“要是每件事都得完美才能进行下去，你不会觉得这计划...”"

# game/murdochroute3.rpy:599
translate Schinese murdochroute3a_8cc938fd:

    # mu "“...bad?”"
    mu "“...不对劲吗？”"

# game/murdochroute3.rpy:600
translate Schinese murdochroute3a_89d9b98a:

    # "I hear her sigh as she puts down something that sounds like a magazine."
    "我听见她放下了类似杂志的东西。"

# game/murdochroute3.rpy:601
translate Schinese murdochroute3a_c224f702:

    # ho "“I think we’re good enough to do perfectly for one more day.”"
    ho "“再保持一天完美，对我们而言应该不在话下。”"

# game/murdochroute3.rpy:602
translate Schinese murdochroute3a_6a48f708:

    # ho "“Besides... do you have any better ideas?”"
    ho "“再说...难道你有更好的主意？”"

# game/murdochroute3.rpy:603
translate Schinese murdochroute3a_578f1de7:

    # ho "“I’ll hear them if you do.”"
    ho "“我洗耳恭听。”"

# game/murdochroute3.rpy:604
translate Schinese murdochroute3a_1e55b358:

    # "Murdoch doesn’t say anything for a while."
    "Murdoch陷入了沉默。"

# game/murdochroute3.rpy:605
translate Schinese murdochroute3a_d3130b35:

    # ho "“You still want to get everybody out of town, right?”"
    ho "“你依然想让所有人都搬出这座小镇，没错吧？”"

# game/murdochroute3.rpy:606
translate Schinese murdochroute3a_1fd4bb30:

    # mu "“...Right.”"
    mu "“...没错。”"

# game/murdochroute3.rpy:607
translate Schinese murdochroute3a_3ea5b70e:

    # ho "“If mother sees what a good change of pace the city is for me, I know she’ll want to move.”"
    ho "“我敢说，如果看到我在城市里的生活，母亲一定会想搬出去的。”"

# game/murdochroute3.rpy:608
translate Schinese murdochroute3a_43fc6e00:

    # ho "“Father will fall in line after that.”"
    ho "“父亲也会跟随她的脚步。”"

# game/murdochroute3.rpy:609
translate Schinese murdochroute3a_b8e207bc:

    # mu "“And what if they don’t?”"
    mu "“如果他们不想呢？”"

# game/murdochroute3.rpy:610
translate Schinese murdochroute3a_d6b00ae0:

    # ho "“Then that’s their decision.”"
    ho "“那是他们自己的决定。”"

# game/murdochroute3.rpy:611
translate Schinese murdochroute3a_1ddad6af:

    # ho "“Jim might want to stay for a while but I don’t think he’ll stay here for long.”"
    ho "“Jim或许愿意在这停留一段时间，但是我想不会太久的。”"

# game/murdochroute3.rpy:612
translate Schinese murdochroute3a_ad7aee7c:

    # mu "“And you really think he’ll bring us all?”"
    mu "“你真觉得他会把我们全带走？”"

# game/murdochroute3.rpy:613
translate Schinese murdochroute3a_efe91d09:

    # ho "“Maybe not, but I do, yes.”"
    ho "“不，但我有把握。”"

# game/murdochroute3.rpy:614
translate Schinese murdochroute3a_3c36a00c:

    # mu "“Why?”"
    mu "“什么把握？”"

# game/murdochroute3.rpy:615
translate Schinese murdochroute3a_dfb54147:

    # ho "“Because I know for a fact that he loves me.”"
    ho "“因为他真心爱我。”"

# game/murdochroute3.rpy:616
translate Schinese murdochroute3a_7220c174:

    # ho "“And he’ll want to help take care of my family.”"
    ho "“自然也乐意帮助我的家人。”"

# game/murdochroute3.rpy:617
translate Schinese murdochroute3a_d0f85323:

    # mu "“But what if he doesn’t?”"
    mu "“但如果他不是呢？”"

# game/murdochroute3.rpy:618
translate Schinese murdochroute3a_b5bceb89:

    # ho "“I’m not going to entertain something I don’t think is true.”"
    ho "“我从不去考虑不现实的东西。”"

# game/murdochroute3.rpy:619
translate Schinese murdochroute3a_5dbd7419:

    # mu "“I don’t have the assurance that you do.”"
    mu "“我可没有你那样的自信。”"

# game/murdochroute3.rpy:620
translate Schinese murdochroute3a_68ddef91:

    # ho "“It won’t come to that.”"
    ho "“他一定是。”"

# game/murdochroute3.rpy:621
translate Schinese murdochroute3a_e8483450:

    # mu "“But what if it does?”"
    mu "“万一呢？”"

# game/murdochroute3.rpy:622
translate Schinese murdochroute3a_188017cb:

    # ho "“Then I can handle it.”"
    ho "“那我也能承受。”"

# game/murdochroute3.rpy:623
translate Schinese murdochroute3a_a5192e38:

    # m "“Pardon.”"
    m "“打扰了。”"

# game/murdochroute3.rpy:628
translate Schinese murdochroute3a_be272622:

    # "When I turn the corner they both look at me and stare."
    "我从拐角走出，他们齐刷刷地看过来。"

# game/murdochroute3.rpy:630
translate Schinese murdochroute3a_cec8699a:

    # mu "“Sam?”"
    mu "“Sam？”"

# game/murdochroute3.rpy:632
translate Schinese murdochroute3a_cd4c3e2b:

    # ho "“What does he want?”"
    ho "“有何贵干？”"

# game/murdochroute3.rpy:634
translate Schinese murdochroute3a_ce20d2ad:

    # "There’s an edge in her tone that isn’t usually there."
    "与平时不同，她的话里带着刺。"

# game/murdochroute3.rpy:635
translate Schinese murdochroute3a_84987d7a:

    # m "“Not much of anything from present company.”"
    m "“不是什么大事。”"

# game/murdochroute3.rpy:636
translate Schinese murdochroute3a_254c16c0:

    # m "“Just bearing the news that your fiance has arrived.”"
    m "“只是来告知你们，未婚夫到了。”"

# game/murdochroute3.rpy:638
translate Schinese murdochroute3a_98c0077a:

    # mu "“Already?”"
    mu "“已经到了？”"

# game/murdochroute3.rpy:641
translate Schinese murdochroute3a_0e062a40:

    # ho "“He’s early.”"
    ho "“他来早了。”"

# game/murdochroute3.rpy:643
translate Schinese murdochroute3a_bde7b58c:

    # m "“Sounds like he brought company too.”"
    m "“好像还带了其他人。”"

# game/murdochroute3.rpy:645
translate Schinese murdochroute3a_4be5aeac:

    # ho "“That would be Neil and Reubin, then.”"
    ho "“多半是Neil和Reubin。”"

# game/murdochroute3.rpy:649
translate Schinese murdochroute3a_1eb26b33:

    # "We hear the back door open."
    "后门打开了。"

# game/murdochroute3.rpy:651
translate Schinese murdochroute3a_5e21030f:

    # "Then we hear Mrs. Byrnes voice before we see her."
    "未见其人，先闻其声。"

# game/murdochroute3.rpy:653
translate Schinese murdochroute3a_9364ce4c:

    # gr "“Alright, change of plans.”"
    gr "“好啦，计划有变。”"

# game/murdochroute3.rpy:658
translate Schinese murdochroute3a_362ea058:

    # "Mrs. Byrnes shows up with Dahlia at her side, marching into the garden like it’s unconquered wilderness."
    "Byrnes夫人在Dahlia的陪伴下，如拓荒者一般雄赳赳气昂昂地闯进花园。"

# game/murdochroute3.rpy:660
translate Schinese murdochroute3a_41ff34d7:

    # gr "“Your father hasn’t found all the catering equipment and I don’t trust those gentlemen to behave themselves.”"
    gr "“你们的父亲还没找齐招待用的物品，我也不信那几位先生会乖乖听话。”"

# game/murdochroute3.rpy:663
translate Schinese murdochroute3a_f74aab97:

    # gr "“We’ll have the men distract them while you’re in the proper condition to meet with them.”"
    gr "“在你准备好见他们之前，先让小伙子们应付一下吧。”"

# game/murdochroute3.rpy:665
translate Schinese murdochroute3a_999d6d3b:

    # "Murdoch steps out of the way as she places a heavy looking basket in front of Holly then turns to us."
    "Murdoch闪到一旁，以便她把一个看着就重的篮子摆在Holly面前，接着转过身来。"

# game/murdochroute3.rpy:667
translate Schinese murdochroute3a_e74a650f:

    # gr "“Well?”"
    gr "“嗯？”"

# game/murdochroute3.rpy:670
translate Schinese murdochroute3a_ab74165a:

    # gr "“Hop to it boys!”"
    gr "“还不快去！”"

# game/murdochroute3.rpy:673
translate Schinese murdochroute3a_50f3a740:

    # gr "“The ladies need some space.”"
    gr "“给淑女们留点空间。”"

# game/murdochroute3.rpy:676
translate Schinese murdochroute3a_27aa598d:

    # "The corner of murdoch’s smile tightens a bit and he nods,{nw}"
    "Murdoch脸上的笑容一僵，他点点头，{nw}"

# game/murdochroute3.rpy:678
translate Schinese murdochroute3a_7bf6b5b6:

    # extend " looking at me and jerking his head back in the direction of the door."
    extend "然后看向我，甩头示意门的方向。"

# game/murdochroute3.rpy:684
translate Schinese murdochroute3a_e7d583e0:

    # "Once we get back inside, the first thing I hear is a booming shout from a door slightly ajar."
    "一进屋，便有一声吼叫从某虚掩的门后传来。"

# game/murdochroute3.rpy:686
translate Schinese murdochroute3a_f21e6eca:

    # al "“MURDOCH!”"
    al "“{b}MURDOCH！{/b}”"

# game/murdochroute3.rpy:688
translate Schinese murdochroute3a_1c986b42:

    # "It’s his father’s voice."
    "是他爸。"

# game/murdochroute3.rpy:690
translate Schinese murdochroute3a_ca72a0ee:

    # "He glances at the hallway leading to the door first, then the door going downstairs."
    "他先是看向大厅另一侧的门，再看向通往楼下的门。"

# game/murdochroute3.rpy:692
translate Schinese murdochroute3a_79f80a1c:

    # "He skips a step when he hears the yell again, then he sticks his head through the doorway."
    "又被一声吼吓了一大跳后，他掂头望向门廊。"

# game/murdochroute3.rpy:694
translate Schinese murdochroute3a_92d3198f:

    # mu "“What?”"
    mu "“怎么了？”"

# game/murdochroute3.rpy:696
translate Schinese murdochroute3a_41203131:

    # al "“We could use some help down here!”"
    al "“来下面帮忙！”"

# game/murdochroute3.rpy:698
translate Schinese murdochroute3a_89119312:

    # mu "“Mother says I need to deal with the guests.”"
    mu "“母亲交代我去应付客人。”"

# game/murdochroute3.rpy:700
translate Schinese murdochroute3a_f4b87c7e:

    # al "“They’re grown men and can deal with themselves.”"
    al "“他们是成年人了，知道如何打发时间。”"

# game/murdochroute3.rpy:701
translate Schinese murdochroute3a_b54ef985:

    # al "“Last winter’s boxes are all screwed up and everything’s in the wrong place.”"
    al "“去年冬天的箱子全都被人翻过，乱七八糟的。”"

# game/murdochroute3.rpy:702
translate Schinese murdochroute3a_f2280cbc:

    # al "“You been messin’ around down here?”"
    al "“是你干的吗？”"

# game/murdochroute3.rpy:704
translate Schinese murdochroute3a_fe0ccb4c:

    # mu "“No dad, I don’t go into the cellar.”"
    mu "“不是，我不去地窖的。”"

# game/murdochroute3.rpy:706
translate Schinese murdochroute3a_fbbbffb8:

    # al "“Well if it’s not you then it was one of your sisters.”"
    al "“那就是你的姐妹们了。”"

# game/murdochroute3.rpy:708
translate Schinese murdochroute3a_12d6d8f1:

    # mu "“Is this really important right now?”"
    mu "“这很重要吗，在这个时点？”"

# game/murdochroute3.rpy:710
translate Schinese murdochroute3a_c3cc941a:

    # al "“If words come out of my mouth, they’re important, you hear?”"
    al "“从我嘴里说出来的就重要，听见没有？”"

# game/murdochroute3.rpy:711
translate Schinese murdochroute3a_a7dcb714:

    # al "“Now get your ass down here.”"
    al "“还不赶紧下来。”"

# game/murdochroute3.rpy:713
translate Schinese murdochroute3a_1d863013:

    # "The hair on his tail sticks up when he looks at the doorway."
    "他望着门廊，尾巴上的毛都翘起来了。"

# game/murdochroute3.rpy:715
translate Schinese murdochroute3a_cff163f5:

    # "He gives me a quick look."
    "他瞥了我一眼。"

# game/murdochroute3.rpy:717
translate Schinese murdochroute3a_ccc3c86a:

    # mu "“I’ll catch up.”"
    mu "“我晚点过去。”"

# game/murdochroute3.rpy:719
translate Schinese murdochroute3a_dd6ccf5a:

    # m "“Well what am I supposed to do?”"
    m "“那我怎么办？”"

# game/murdochroute3.rpy:721
translate Schinese murdochroute3a_db99d969:

    # mu "“Just let them talk.”"
    mu "“让他们聊天就好了。”"

# game/murdochroute3.rpy:723
translate Schinese murdochroute3a_ec9c357a:

    # m "“Talk about what?”"
    m "“聊什么？”"

# game/murdochroute3.rpy:724
translate Schinese murdochroute3a_22c591d5:

    # "By the time I ask the question his tail is slipping past the door."
    "话音未落，他的尾巴早已消失在门后。"

# game/murdochroute3.rpy:725
translate Schinese murdochroute3a_6ae0bf78:

    # "It’s hard not to groan as I look at the corridor in front of me and shake my head."
    "我摇头看着眼前的走廊，很难不发出叹息。"

# game/murdochroute3.rpy:726
translate Schinese murdochroute3a_d7525073:

    # "I hear more voices down the hall."
    "更多声音从大厅传来。"

# game/murdochroute3.rpy:727
translate Schinese murdochroute3a_d5850d15:

    # "The muscles on my neck tense up a little bit."
    "脖子上的肌肉变得有点僵硬。"

# game/murdochroute3.rpy:728
translate Schinese murdochroute3a_b6619a8e:

    # "I remember Holly mentioning over that dinner that Neil, whoever he is, is a congressman."
    "我记得Holly在晚餐上说过，那个叫Neil的家伙是国会议员。"

# game/murdochroute3.rpy:729
translate Schinese murdochroute3a_4e685688:

    # "I’ve never met anybody that important before."
    "我从来没和这么重要的人物打过交道。"

# game/murdochroute3.rpy:730
translate Schinese murdochroute3a_74d80e22:

    # "The closest I’ve ever gotten is talking to the mayor once."
    "顶多就跟镇长说了几句话。"

# game/murdochroute3.rpy:731
translate Schinese murdochroute3a_10433ca4:

    # "Hope I don’t mess up and make him propose some crazy new law."
    "希望我别搞砸，害他提出什么诡异的法案。"

# game/murdochroute3.rpy:732
translate Schinese murdochroute3a_3a514c7e:

    # "Their voices get louder as I approach, but I don’t want them to see me yet."
    "越接近动静就越大，但我还不想被他们察觉。"

# game/murdochroute3.rpy:738
translate Schinese murdochroute3a_ab55ea06:

    # reuunk "“If we’re stuck standing around much longer I’ll have to look outside to make sure there aren’t any people scraping their way across the desert in life boats.”"
    reuunk "“再这样待下去，我可要跑沙漠里看有没有人在划救生船了。”"

# game/murdochroute3.rpy:739
translate Schinese murdochroute3a_f2a672f3:

    # "The musical voice comes from a broad, stout cat who teeters on his feet as he talks."
    "这抑扬顿挫的声音来自一只踮着脚、体态丰腴的猫。"

# game/murdochroute3.rpy:740
translate Schinese murdochroute3a_75d8c1e9:

    # ji "“Such is the way of things, poor Reubin.”"
    ji "“这就是人生啊，小Reubin。”"

# game/murdochroute3.rpy:741
translate Schinese murdochroute3a_378812f3:

    # reu "“So it goes! So it goes...”"
    reu "“人生啊！人生...”"

# game/murdochroute3.rpy:742
translate Schinese murdochroute3a_19fb0c45:

    # "The marbled fox smirks."
    "大理石纹狐狸咧嘴一笑。"

# game/murdochroute3.rpy:743
translate Schinese murdochroute3a_2f952225:

    # ji "“I’m very familiar with how you like to be quick about things, but I thought Medical school would have taught you some discipline by now.”"
    ji "“看来学医也没能改改你的急性子啊。”"

# game/murdochroute3.rpy:744
translate Schinese murdochroute3a_31619e11:

    # "The cat surprises me with a sudden burst of uproarious laughter."
    "猫突然爆笑起来，吓了我一跳。"

# game/murdochroute3.rpy:745
translate Schinese murdochroute3a_2efcdb7a:

    # "That makes the tall, thin dog, who I assume has to be Neil, snort."
    "旁边八成是Neil的那只瘦高的狗对此嗤之以鼻道："

# game/murdochroute3.rpy:746
translate Schinese murdochroute3a_68f88dd2:

    # nei "“I wouldn’t trust this one with a scalpel until after he’s two drinks in.”"
    nei "“这家伙不喝上一两杯，都不敢拿手术刀。”"

# game/murdochroute3.rpy:747
translate Schinese murdochroute3a_1e85f7cd:

    # "His voice is deep and grim."
    "他的音色低沉而冷峻。"

# game/murdochroute3.rpy:748
translate Schinese murdochroute3a_18dbe830:

    # nei "“Your fiance has a lovely little home, really.”"
    nei "“不过说真的，你未婚妻的家的确小巧玲珑。”"

# game/murdochroute3.rpy:749
translate Schinese murdochroute3a_2c11dac1:

    # "... did he say little?"
    "...他是不是说了，小？"

# game/murdochroute3.rpy:750
translate Schinese murdochroute3a_bf53b558:

    # "My old house growing up used to be about the size of the foyer alone."
    "我老家的房子撑死也就这里的门厅大。"

# game/murdochroute3.rpy:751
translate Schinese murdochroute3a_297669d4:

    # nei "“Pity it seems like we’re not going to see the rest of it.”"
    nei "“遗憾的是，我们似乎无法一览其全貌了。”"

# game/murdochroute3.rpy:752
translate Schinese murdochroute3a_af5f73de:

    # "The cat wipes his eye and nods profusely."
    "猫揉了揉眼睛，连连点头。"

# game/murdochroute3.rpy:753
translate Schinese murdochroute3a_a083efcb:

    # reu "“I know you said she runs a tight ship, but it feels more like we’re stranded at the dock.”"
    reu "“我是听你说她的船规很严，但咱们这不是连码头都没离开嘛。”"

# game/murdochroute3.rpy:754
translate Schinese murdochroute3a_95b6973e:

    # ji "“Oh, Reubin, you don’t know the half of it.”"
    ji "“唉，Reubin，这才只是冰山一角。”"

# game/murdochroute3.rpy:797
translate Schinese murdochroute3a_8ca47395:

    # ji "“She’s the captain, make no mistake.”"
    ji "“她是船长，呼风唤雨。”"

# game/murdochroute3.rpy:756
translate Schinese murdochroute3a_3caffdf3:

    # nei "“And what of the husband?”"
    nei "“那她老公呢？”"

# game/murdochroute3.rpy:757
translate Schinese murdochroute3a_463a7fed:

    # ji "“Far more than her husband.”"
    ji "“她比她老公厉害多了。”"

# game/murdochroute3.rpy:758
translate Schinese murdochroute3a_b59d0691:

    # ji "“Frankly, if I had to wager...”"
    ji "“不开玩笑...”"

# game/murdochroute3.rpy:759
translate Schinese murdochroute3a_1f7c5461:

    # ji "“...I’d say he’s not doing any of the thrusting in that bed.”"
    ji "“...我估计他连在床上的主动权都没有。”"

# game/murdochroute3.rpy:760
translate Schinese murdochroute3a_13c4927e:

    # reu "“Cheeky thing to say, considering that’s going to be your position in a few days.”"
    reu "“还真敢说，没准儿过几天你也自身难保喽。”"

# game/murdochroute3.rpy:761
translate Schinese murdochroute3a_4eec7f50:

    # ji "“It sounds as if you fancy the image, poor Reubin.”"
    ji "“听起来你就好这口啊，小Reubin。”"

# game/murdochroute3.rpy:762
translate Schinese murdochroute3a_1ed3eb88:

    # reu "“Well I think you could certainly use some humbling.”"
    reu "“我只是觉得你该收敛点了。”"

# game/murdochroute3.rpy:763
translate Schinese murdochroute3a_707dc9ff:

    # nei "“It’s called the old ball and chain for a reason, Jim Jim.”"
    nei "“之所以有‘婚姻的枷锁’这个叫法，可不是闹着玩的，Jim Jim。”"

# game/murdochroute3.rpy:764
translate Schinese murdochroute3a_01e06c7e:

    # ji "“Tease all you like, but you’ll both be sorry if you underestimate me.”"
    ji "“随你们怎么说，将来可别后悔。”"

# game/murdochroute3.rpy:766
translate Schinese murdochroute3a_13d11a0b:

    # "Murdoch was right."
    "Murdoch说的没错。"

# game/murdochroute3.rpy:767
translate Schinese murdochroute3a_528a70ee:

    # "They don’t seem much like the types who need additional conversation."
    "他们确实不太需要外人提供话题。"

# game/murdochroute3.rpy:768
translate Schinese murdochroute3a_064e7ec8:

    # "Works for me."
    "正合我意。"

# game/murdochroute3.rpy:769
translate Schinese murdochroute3a_10b6b575:

    # reu "“We could just ask the fellow over there for some help.”"
    reu "“问问那边那位好了。”"

# game/murdochroute3.rpy:770
translate Schinese murdochroute3a_3f8ee56b:

    # reu "“He looks like he’s waiting for something to do.”"
    reu "“他似乎很闲的样子。”"

# game/murdochroute3.rpy:771
translate Schinese murdochroute3a_e81efaa7:

    # "Wait..."
    "慢着..."

# game/murdochroute3.rpy:772
translate Schinese murdochroute3a_97340fb3:

    # "Is he talking about me?"
    "他指的是我？"

# game/murdochroute3.rpy:773
translate Schinese murdochroute3a_7a6e2f7b:

    # "They could see me this whole time?!"
    "他们从一开始就发现我了？！"

# game/murdochroute3.rpy:774
translate Schinese murdochroute3a_a2368004:

    # ji "“I don’t think that would be such a good idea.”"
    ji "“不太好吧。”"

# game/murdochroute3.rpy:775
translate Schinese murdochroute3a_f717e92a:

    # nei "“He’s right you know.”"
    nei "“没什么不好的。”"

# game/murdochroute3.rpy:776
translate Schinese murdochroute3a_36c224d3:

    # nei "“If he had something to do, he would be doing it.”"
    nei "“如果有事，那他早就去忙了。”"

# game/murdochroute3.rpy:777
translate Schinese murdochroute3a_c525cfac:

    # nei "“If he’s any good, I mean...”"
    nei "“前提是他派得上用场的话...”"

# game/murdochroute3.rpy:778
translate Schinese murdochroute3a_240080e7:

    # ji "“Leave him be for now.”"
    ji "“还是饶了他吧。”"

# game/murdochroute3.rpy:779
translate Schinese murdochroute3a_d4894bfe:

    # ji "“He’ll have his work cut out for him tonight at the party.”"
    ji "“今晚的派对有他忙的。”"

# game/murdochroute3.rpy:780
translate Schinese murdochroute3a_9e7d03fc:

    # nei "“And what does that mean, exactly?”"
    nei "“此话怎讲？”"

# game/murdochroute3.rpy:781
translate Schinese murdochroute3a_4914da37:

    # "Yeah..."
    "就是啊..."

# game/murdochroute3.rpy:782
translate Schinese murdochroute3a_c1aba2f1:

    # "What does that mean?"
    "什么叫有我忙的？"

# game/murdochroute3.rpy:783
translate Schinese murdochroute3a_a3261ed0:

    # ji "“Let’s see how our conversations go a few drinks in.”"
    ji "“咱们边喝边聊吧。”"

# game/murdochroute3.rpy:787
translate Schinese murdochroute3a_30df0e0b:

    # "I exhale a breath of relief when I hear Murdoch and Ralph chatting down the hall."
    "我听见Murdoch和Ralph的说话声从大厅传来，总算松了口气。"

# game/murdochroute3.rpy:793
translate Schinese murdochroute3a_feda49cf:

    # mu "“Oh! Hello!”"
    mu "“大家好啊！”"

# game/murdochroute3.rpy:795
translate Schinese murdochroute3a_15eb3a8c:

    # "The fox walks up to take and shake each one of the men’s hands."
    "狐狸走进来，跟所有人依次握了手。"

# game/murdochroute3.rpy:957
translate Schinese murdochroute3a_85e3a10f:

    # mu "“You must be Neil and you must be Reubin.”"
    mu "“你一定是Neil，那这边这位就是Reubin了。”"

# game/murdochroute3.rpy:799
translate Schinese murdochroute3a_c628d745:

    # mu "“I know you’ve both come a long way to be here.”"
    mu "“欢迎二位远道而来。”"

# game/murdochroute3.rpy:801
translate Schinese murdochroute3a_34c8acbb:

    # nei "“I’m accustomed to traveling often.”"
    nei "“旅行对我来说早就是家常便饭了。”"

# game/murdochroute3.rpy:802
translate Schinese murdochroute3a_af3068fe:

    # reu "“I can say the same!”"
    reu "“我也一样！”"

# game/murdochroute3.rpy:803
translate Schinese murdochroute3a_5af3f0f5:

    # reu "“Though, admittedly, the tumbleweeds are a change of pace.”"
    reu "“但说实话，风滚草我着实第一次见。”"

# game/murdochroute3.rpy:805
translate Schinese murdochroute3a_9911dc0f:

    # mu "“I suppose you wouldn’t have those, but there’s a bounciness to them that I admire.”"
    mu "“你们可能不熟悉，但我很欣赏风滚草的弹性。”"

# game/murdochroute3.rpy:807
translate Schinese murdochroute3a_924fff9e:

    # reu "“And we hear you’re very bouncy.”"
    reu "“我们听说你也很有弹性。”"

# game/murdochroute3.rpy:808
translate Schinese murdochroute3a_ca93a5c3:

    # "All three of them laugh."
    "他们三个大笑起来。"

# game/murdochroute3.rpy:810
translate Schinese murdochroute3a_77b58c70:

    # "Murdoch clears his throat and then nods."
    "Murdoch清了清嗓子，点点头。"

# game/murdochroute3.rpy:812
translate Schinese murdochroute3a_6f54b274:

    # mu "“Well, ah, shall I fetch you any drinks?”"
    mu "“那么，呃，你们想喝点什么吗？”"

# game/murdochroute3.rpy:814
translate Schinese murdochroute3a_d74dd17f:

    # nei "“Are they not being put to use?”"
    nei "“这种活不该由他们干吗？”"

# game/murdochroute3.rpy:815
translate Schinese murdochroute3a_f93eea28:

    # "Neil gestures to me, then to Ralph."
    "Neil看向我跟Ralph。"

# game/murdochroute3.rpy:817
translate Schinese murdochroute3a_fa604702:

    # mu "“Ah, the groundskeeper is not present.”"
    mu "“哦，工作人员现在不在。”"

# game/murdochroute3.rpy:819
translate Schinese murdochroute3a_6b8b75d4:

    # mu "“But this is Sam, one of the stockers at the general store.”"
    mu "“这位是Sam，杂货店里的员工。”"

# game/murdochroute3.rpy:821
translate Schinese murdochroute3a_29210e5a:

    # "I nod, deciding not to speak."
    "我沉默地点点头。"

# game/murdochroute3.rpy:823
translate Schinese murdochroute3a_6de556a3:

    # mu "“And this is Ralph, who is my childhood friend.”"
    mu "“这位是Ralph，我儿时的玩伴。”"

# game/murdochroute3.rpy:827
translate Schinese murdochroute3a_dbcd3fca:

    # ra "“Did you really think I was going to serve you a slice of sausage on a stick or something?”"
    ra "“要我往香肠上插根签子送过来么？”"

# game/murdochroute3.rpy:829
translate Schinese murdochroute3a_f3613951:

    # "He glances over Ralph from bottom to top."
    "他自下而上打量着Ralph。"

# game/murdochroute3.rpy:830
translate Schinese murdochroute3a_aea14479:

    # nei "“My mistake.”"
    nei "“失礼了。”"

# game/murdochroute3.rpy:833
translate Schinese murdochroute3a_88cec391:

    # "Murdoch gives Ralph a look that says please don’t without speaking it aloud."
    "Murdoch用眼神示意Ralph别惹事。"

# game/murdochroute3.rpy:835
translate Schinese murdochroute3a_138e4d6d:

    # ji "“Hold the drinks for now.”"
    ji "“饮料晚点再说吧。”"

# game/murdochroute3.rpy:839
translate Schinese murdochroute3a_e25ad6af:

    # ji "“There’s plenty of them where we’re going.”"
    ji "“咱们要逛的地方还多着呢。”"

# game/murdochroute3.rpy:842
translate Schinese murdochroute3a_89134eda:

    # mu "“Agreed.”"
    mu "“确实。”"

# game/murdochroute3.rpy:848
translate Schinese murdochroute3a_3f26b795:

    # "The walk to the Hip is whatever the opposite of an awkward silence is."
    "我不知道怎么形容去往Hip的路上，但肯定是尴尬和沉默的反义词。"

# game/murdochroute3.rpy:849
translate Schinese murdochroute3a_34b1f3b0:

    # "The three men chat among themselves, as tight as brothers."
    "那三个人聊得火热，好像亲兄弟一样。"

# game/murdochroute3.rpy:850
translate Schinese murdochroute3a_f38e3d2d:

    # "They don’t make any attempts to pause or ask Ralph or Murdoch or myself any such thing."
    "完全没在意Ralph、Murdoch和我。"

# game/murdochroute3.rpy:851
translate Schinese murdochroute3a_9cdbf85f:

    # "I’m grateful for that for my sake alone."
    "我倒是巴不得一直这样。"

# game/murdochroute3.rpy:852
translate Schinese murdochroute3a_81aaf24b:

    # "But when the doctor brings up astronomy or the congressman brings up film I can tell the fox wants to jump in."
    "不过在医生提到天文学、跟议员提到拍摄的时候，狐狸明显想要加入话题。"

# game/murdochroute3.rpy:854
translate Schinese murdochroute3a_1b2526be:

    # "It sours me some."
    "看得我有点心酸。"

# game/murdochroute3.rpy:857
translate Schinese murdochroute3a_d3e5c848:

    # "There’s a small crowd hovering outside the Hip, which tells me that the inside is going to be packed."
    "Hip外面聚集了一小撮人，这表示里面顾客很多。"

# game/murdochroute3.rpy:860
translate Schinese murdochroute3a_72930e72:

    # "When we step inside I can see that I’m right."
    "进门后发现我果然没猜错。"

# game/murdochroute3.rpy:861
translate Schinese murdochroute3a_881823a9:

    # "The Hip is close to full for a weekday evening."
    "以工作日的晚上来说，酒馆几乎坐满了。"

# game/murdochroute3.rpy:863
translate Schinese murdochroute3a_99fb76c8:

    # "Looks like the whole staff is on deck."
    "全部员工都在场。"

# game/murdochroute3.rpy:864
translate Schinese murdochroute3a_79ab885a:

    # "They brought out the white linens and candles for the tables tonight."
    "今晚的桌子上摆了白桌巾跟蜡烛。"

# game/murdochroute3.rpy:865
translate Schinese murdochroute3a_6860d210:

    # "Harlan is talkin’ fast with a crowd of men asking for drinks."
    "Harlan正在快速接待一群酒客。"

# game/murdochroute3.rpy:866
translate Schinese murdochroute3a_2dbcf5c4:

    # "Waitresses carrying hot bowls of sizzling dishes scurry back and forth to each end of the dining area, pushing trolleys full of shining containers."
    "女服务员们则端着滋滋作响的菜肴、推着满载闪亮碗盘的餐车，在用餐区之间匆匆往返。"

# game/murdochroute3.rpy:867
translate Schinese murdochroute3a_b8d68a11:

    # "Hard to think this is the same place where I sleep day in and day out considerin’ what’s going on."
    "难以想象这是我每天睡觉的地方。"

# game/murdochroute3.rpy:868
translate Schinese murdochroute3a_8a6f2163:

    # "What’s stranger is the person walking up to me with a notebook in her hand."
    "更令我意想不到的是拿着笔记本走来的那个人。"

# game/murdochroute3.rpy:874
translate Schinese murdochroute3a_d2f725f3:

    # cy "“Good evening gentlemen.”"
    cy "“晚上好，先生们。”"

# game/murdochroute3.rpy:877
translate Schinese murdochroute3a_6624da1a:

    # cy "“Table for five?”"
    cy "“五位吗？”"

# game/murdochroute3.rpy:880
translate Schinese murdochroute3a_ad6a1fb8:

    # ji "“Six.”"
    ji "“六位。”"

# game/murdochroute3.rpy:883
translate Schinese murdochroute3a_c005025b:

    # "She looks them over and stops at me with a slightly confused look on her face."
    "她把他们几个打量了个遍，最后停在我这里，脸上带着困惑的表情。"

# game/murdochroute3.rpy:884
translate Schinese murdochroute3a_4d6c326f:

    # "I think she’s staring at the suit I’m wearing."
    "好像是在看我身上的正装。"

# game/murdochroute3.rpy:887
translate Schinese murdochroute3a_ea9dbae3:

    # cy "“We’re packed tightly tonight, but I can squeeze you all in somewhere.”"
    cy "“今晚人太多了，我尽量给你们找个位子。”"

# game/murdochroute3.rpy:890
translate Schinese murdochroute3a_26b4beb6:

    # ji "“We have a reservation.”"
    ji "“我们预约过。”"

# game/murdochroute3.rpy:893
translate Schinese murdochroute3a_b9490395:

    # "She looks us all over again."
    "她再次打量我们。"

# game/murdochroute3.rpy:895
translate Schinese murdochroute3a_655ac556:

    # cy "“I see.”"
    cy "“这样啊。”"

# game/murdochroute3.rpy:897
translate Schinese murdochroute3a_2e943516:

    # cy "“The wine and dine situation is first come first serve.”"
    cy "“但酒水和服务是先到先得的。”"

# game/murdochroute3.rpy:899
translate Schinese murdochroute3a_378812f3_1:

    # reu "“So it goes! So it goes...”"
    reu "“人生啊！人生...”"

# game/murdochroute3.rpy:901
translate Schinese murdochroute3a_13c4f702:

    # cy "“I apologize for any misunderstandings.”"
    cy "“希望不会给你们造成误解。”"

# game/murdochroute3.rpy:904
translate Schinese murdochroute3a_5b3ef37e:

    # cy "“I presume you booked a room upstairs, then?”"
    cy "“几位订的可是楼上？”"

# game/murdochroute3.rpy:907
translate Schinese murdochroute3a_5d436ed7:

    # ji "“That was my intention.”"
    ji "“我就是这个意思。”"

# game/murdochroute3.rpy:910
translate Schinese murdochroute3a_0b295a2a:

    # cy "“Your surname?”"
    cy "“姓氏是？”"

# game/murdochroute3.rpy:913
translate Schinese murdochroute3a_d8b810f7:

    # ji "“Surname is Sterling.”"
    ji "“Sterling。”"

# game/murdochroute3.rpy:917
translate Schinese murdochroute3a_babc1c25:

    # "Cynthia flips through the papers and her brow lifts a bit."
    "Cynthia翻着书页，扬起眉头。"

# game/murdochroute3.rpy:919
translate Schinese murdochroute3a_655ac556_1:

    # cy "“I see.”"
    cy "“好的。”"

# game/murdochroute3.rpy:923
translate Schinese murdochroute3a_d4bdcc47:

    # cy "“Easily done.”"
    cy "“没问题。”"

# game/murdochroute3.rpy:925
translate Schinese murdochroute3a_0b675495:

    # cy "“You’ve a few hours before everything’s ready.”"
    cy "“房间还有几个小时才能准备好。”"

# game/murdochroute3.rpy:928
translate Schinese murdochroute3a_0ddda093:

    # cy "“There’s an open table by the window.”"
    cy "“窗边正好有张空桌。”"

# game/murdochroute3.rpy:931
translate Schinese murdochroute3a_200db7bc:

    # ji "“Let’s be on our way, then.”"
    ji "“那咱们先坐吧。”"

# game/murdochroute3.rpy:933
translate Schinese murdochroute3a_1bd216a8:

    # "It’s pretty clear that he’s talking to just the new folks."
    "这句话显然是向他那两个朋友说的。"

# game/murdochroute3.rpy:936
translate Schinese murdochroute3a_f9b64779:

    # cy "“Before you go, could I borrow him for a moment?”"
    cy "“在此之前，能请这位先生借一步说话吗？”"

# game/murdochroute3.rpy:939
translate Schinese murdochroute3a_617d849a:

    # "Jim shrugs and gestures."
    "Jim耸耸肩。"

# game/murdochroute3.rpy:941
translate Schinese murdochroute3a_b5928c79:

    # ji "“It’s no business of mine.”"
    ji "“我无所谓。”"

# game/murdochroute3.rpy:944
translate Schinese murdochroute3a_3bb08599:

    # cy "“I’ll return him shortly.”"
    cy "“很快就好。”"

# game/murdochroute3.rpy:950
translate Schinese murdochroute3a_6da45bb1:

    # "She pulls me into one of the staff washrooms."
    "她把我拉进一间员工厕所。"

# game/murdochroute3.rpy:951
translate Schinese murdochroute3a_55c3d082:

    # cy "“You look expensive.”"
    cy "“你看着好气派。”"

# game/murdochroute3.rpy:953
translate Schinese murdochroute3a_26722cf0:

    # cy "“Are they gangsters?”"
    cy "“他们是黑帮的吗？”"

# game/murdochroute3.rpy:955
translate Schinese murdochroute3a_c651d0c8:

    # m "“No.”"
    m "“不是。”"

# game/murdochroute3.rpy:1082
translate Schinese murdochroute3a_8fe17382:

    # "I don’t actually know that."
    "其实我不知道。"

# game/murdochroute3.rpy:957
translate Schinese murdochroute3a_2fa96393:

    # "At least they aren’t to my knowledge."
    "至少据我所知不是。"

# game/murdochroute3.rpy:959
translate Schinese murdochroute3a_b7488547:

    # m "“There’s a wedding tomorrow.”"
    m "“明天有场婚礼。”"

# game/murdochroute3.rpy:960
translate Schinese murdochroute3a_c65cb451:

    # cy "“Oh?”"
    cy "“哦？”"

# game/murdochroute3.rpy:962
translate Schinese murdochroute3a_7afbbec7:

    # cy "“I love weddings.”"
    cy "“我超爱婚礼的。”"

# game/murdochroute3.rpy:964
translate Schinese murdochroute3a_b3e1b9e9:

    # m "“I don’t think you’d care much for this one.”"
    m "“我不觉得这一场你会喜欢。”"

# game/murdochroute3.rpy:966
translate Schinese murdochroute3a_de1f3b41:

    # cy "“I’m assuming the groom is the one you didn’t book for the smoke room.”"
    cy "“新郎就是没预约吸烟室的那一个吧？”"

# game/murdochroute3.rpy:967
translate Schinese murdochroute3a_4819f49d:

    # m "“One?”"
    m "“一个？”"

# game/murdochroute3.rpy:968
translate Schinese murdochroute3a_8947309a:

    # m "“Wait...”"
    m "“等一下...”"

# game/murdochroute3.rpy:969
translate Schinese murdochroute3a_f76978c7:

    # m "“Cynthia, how many people am I booked for tonight?”"
    m "“Cynthia，今晚有几个人订了我？”"

# game/murdochroute3.rpy:971
translate Schinese murdochroute3a_0a249dc6:

    # cy "“The note says four at once.”"
    cy "“账上写着一次四个。”"

# game/murdochroute3.rpy:973
translate Schinese murdochroute3a_fe45e06f:

    # "I’m reeling a little bit."
    "我有点踉跄。"

# game/murdochroute3.rpy:974
translate Schinese murdochroute3a_49dfed84:

    # "Four?"
    "四个？"

# game/murdochroute3.rpy:975
translate Schinese murdochroute3a_29978954:

    # "Murdoch is barely keeping it together with one man."
    "Murdoch光是应付一个人都那么难过。"

# game/murdochroute3.rpy:976
translate Schinese murdochroute3a_a7225f71:

    # "I don’t know what three would do to him."
    "更别提再添两个了。"

# game/murdochroute3.rpy:977
translate Schinese murdochroute3a_81dd58f1:

    # "I briefly find it funny that Ralph clearly wasn’t paid for, but it’s no surprise considering the direction that conversation would go."
    "Ralph是唯一一个没有被算在里面的，让我稍微觉得有点好笑，但仔细一考虑倒也不奇怪。"

# game/murdochroute3.rpy:979
translate Schinese murdochroute3a_6f1519e7:

    # m "“What a mess.”"
    m "“真倒霉。”"

# game/murdochroute3.rpy:980
translate Schinese murdochroute3a_17b24673:

    # cy "“Don’t you mean a blessing?”"
    cy "“我看是走运吧？”"

# game/murdochroute3.rpy:982
translate Schinese murdochroute3a_ce9e46f4:

    # cy "“Four for one booking just about quadrupled your rate for a night.”"
    cy "“一次接待四个，你一晚上就赚了四晚的钱。”"

# game/murdochroute3.rpy:984
translate Schinese murdochroute3a_a680e5fc:

    # m "“The groom is involved.”"
    m "“有新郎在。”"

# game/murdochroute3.rpy:985
translate Schinese murdochroute3a_1e9f5049:

    # "She tilts her head."
    "她歪头。"

# game/murdochroute3.rpy:987
translate Schinese murdochroute3a_41207681:

    # cy "“Oh.”"
    cy "“啊。”"

# game/murdochroute3.rpy:988
translate Schinese murdochroute3a_999889b0:

    # m "“So is somebody who I think won’t want to be involved.”"
    m "“还有另一个人，我知道他不想参加。”"

# game/murdochroute3.rpy:990
translate Schinese murdochroute3a_8ad14238:

    # cy "“I could take him for the night.”"
    cy "“可以让他今晚来找我。”"

# game/murdochroute3.rpy:992
translate Schinese murdochroute3a_e911d2dc:

    # cy "“He’d still have to pay me of course.”"
    cy "“当然，钱是不能少的。”"

# game/murdochroute3.rpy:993
translate Schinese murdochroute3a_482463b1:

    # m "“I don’t think that idea works in this case.”"
    m "“恐怕不太行。”"

# game/murdochroute3.rpy:994
translate Schinese murdochroute3a_b92b6fa9:

    # m "“I’ll break it to him and let him decide.”"
    m "“我去跟他谈谈，让他自己决定吧。”"

# game/murdochroute3.rpy:996
translate Schinese murdochroute3a_cd9f2b51:

    # cy "“That’s generally how these things get resolved.”"
    cy "“基本上也只有这个法子了。”"

# game/murdochroute3.rpy:998
translate Schinese murdochroute3a_ed8a0530:

    # "I nod and part ways with her, finding my way to Jim’s table."
    "我点头跟她道别，回去找Jim他们。"

# game/murdochroute3.rpy:1003
translate Schinese murdochroute3a_2ea28084:

    # "Once I take my seat, the noise of the piano picks up."
    "我才入座，钢琴声就响了。"

# game/murdochroute3.rpy:1009
translate Schinese murdochroute3a_e272199c:

    # "One of the waitresses brings us a flagon of water and cups."
    "一个女服务员为我们端来一壶水和几个杯子。"

# game/murdochroute3.rpy:1010
translate Schinese murdochroute3a_e212086e:

    # reu "“Really now...”"
    reu "“真的假的...”"

# game/murdochroute3.rpy:1011
translate Schinese murdochroute3a_e44a40c2:

    # reu "“No dinner reservations?”"
    reu "“不能给晚餐订位？”"

# game/murdochroute3.rpy:1012
translate Schinese murdochroute3a_429d6a1c:

    # nei "“I suppose that’s the countryside for you.”"
    nei "“这就是所谓的乡土人情吧。”"

# game/murdochroute3.rpy:1013
translate Schinese murdochroute3a_3535a3a3:

    # "Jim whistles."
    "Jim吹了声口哨。"

# game/murdochroute3.rpy:1015
translate Schinese murdochroute3a_390c32de:

    # ji "“There’s charm enough if you know where to look.”"
    ji "“擦亮眼睛，你们就会发现其中的乐趣了。”"

# game/murdochroute3.rpy:1017
translate Schinese murdochroute3a_4ec64534:

    # "His eyes flick to me and to Murdoch for a moment."
    "他瞄了眼我跟Murdoch。"

# game/murdochroute3.rpy:1018
translate Schinese murdochroute3a_f0d24633:

    # nei "“See what I told you?”"
    nei "“我对你说什么来着？”"

# game/murdochroute3.rpy:1019
translate Schinese murdochroute3a_ff029ca3:

    # nei "“He’s whupped already...”"
    nei "“他已经被鞭挞过了...”"

# game/murdochroute3.rpy:1020
translate Schinese murdochroute3a_3a3ad4ea:

    # reu "“Poor boy’s gone local.”"
    reu "“都同化了啊，可怜的孩子。”"

# game/murdochroute3.rpy:1022
translate Schinese murdochroute3a_a6f95345:

    # ji "“You acquire a bit of wanderlust when you choose to go outside.”"
    ji "“出门在外，谁不想尝尝鲜呢。”"

# game/murdochroute3.rpy:1025
translate Schinese murdochroute3a_402f6e8c:

    # ji "“You should try it sometime when he’s not stitching bodies together and he’s not in an office thinking up new taxes to draft.”"
    ji "“推荐你们在没有缝尸体、或坐在办公室里起草新税法的时候也来试试看。”"

# game/murdochroute3.rpy:1027
translate Schinese murdochroute3a_b72b7ac2:

    # reu "“I touch a good deal of healthy bodies in the city.”"
    reu "“城里的好苗子要多少有多少。”"

# game/murdochroute3.rpy:1028
translate Schinese murdochroute3a_1b3cc5b3:

    # reu "“We have beds aplenty and don’t have to make do with hay bales.”"
    reu "“还有大把的床，不用在干草堆上凑活。”"

# game/murdochroute3.rpy:1031
translate Schinese murdochroute3a_669ec06c:

    # ra "“Pardon my interruption, but I’m very curious.”"
    ra "“恕我插句话，但我实在好奇：”"

# game/murdochroute3.rpy:1033
translate Schinese murdochroute3a_36fd5eff:

    # ra "“Has a single one of you been inside of a barn in your life.”"
    ra "“你们有谁进过农舍么，哪怕一次也好？”"

# game/murdochroute3.rpy:1035
translate Schinese murdochroute3a_0f121a3d:

    # ji "“Can’t say I know the pleasure.”"
    ji "“我没有这个殊荣。”"

# game/murdochroute3.rpy:1037
translate Schinese murdochroute3a_2cfd0c14:

    # nei "“My father owns a horse barn.”"
    nei "“我父亲有个马厩。”"

# game/murdochroute3.rpy:1041
translate Schinese murdochroute3a_a18b0ea8:

    # ra "“So he had you shovel the shit and everything?”"
    ra "“那他有让你铲过屎之类的吗？”"

# game/murdochroute3.rpy:1043
translate Schinese murdochroute3a_b28d8236:

    # nei "“That’s what the staff is for.”"
    nei "“那是工人们的活。”"

# game/murdochroute3.rpy:1045
translate Schinese murdochroute3a_eef78c00:

    # ra "“Right, right.”"
    ra "“的确，的确。”"

# game/murdochroute3.rpy:1046
translate Schinese murdochroute3a_52f88eb3:

    # ra "“So we can agree that you all have hands as smooth as a baby’s bare cheek.”"
    ra "“想必各位的手都如婴儿脸颊一般顺滑吧。”"

# game/murdochroute3.rpy:1050
translate Schinese murdochroute3a_9688152a:

    # "The cat snorts while sipping his water while Jim and Neil glance at one another, then back to the rat."
    "猫嗤之以鼻、继续喝着他的水，Jim则跟Neil交换了个眼神，又一起看向老鼠。"

# game/murdochroute3.rpy:1052
translate Schinese murdochroute3a_7036bbeb:

    # nei "“Let’s hear your background then.”"
    nei "“那就听听你的故事吧。”"

# game/murdochroute3.rpy:1054
translate Schinese murdochroute3a_de7d9b50:

    # ra "“Whatever you’d like to know.”"
    ra "“随便。”"

# game/murdochroute3.rpy:1056
translate Schinese murdochroute3a_6a9cbdeb:

    # nei "“What does a Southlander do spending his days tucked away in Emma County?”"
    nei "“一个南方佬，你跑到{rb}艾玛县{/rb}{rt}Emma County{/rt}是想干什么？”"

# game/murdochroute3.rpy:1058
translate Schinese murdochroute3a_41975dcb:

    # ra "“Pharmacology.”"
    ra "“药剂师。”"

# game/murdochroute3.rpy:1060
translate Schinese murdochroute3a_e212086e_1:

    # reu "“Really now...”"
    reu "“真的假的...”"

# game/murdochroute3.rpy:1062
translate Schinese murdochroute3a_03c17e3c:

    # ji "“Reubin here might like the pill-pushing talk but I hope we can change the subject.”"
    ji "“我知道你想跟他交流嗑药的心得，Reubin，但麻烦你打住。”"

# game/murdochroute3.rpy:1064
translate Schinese murdochroute3a_66875f82:

    # nei "“Funny job for a Southlander.”"
    nei "“南方佬做这种职业还真好笑。”"

# game/murdochroute3.rpy:1066
translate Schinese murdochroute3a_4bb61f05:

    # "Ralph swirled his glass."
    "Ralph摇晃着酒杯。"

# game/murdochroute3.rpy:1067
translate Schinese murdochroute3a_4fd36706:

    # ra "“Funny how?”"
    ra "“怎么好笑了？”"

# game/murdochroute3.rpy:1068
translate Schinese murdochroute3a_5431803f:

    # nei "“Surely a nation built from criminals has all sorts of uses for men in the pharmaceutical business.”"
    nei "“不过一个由罪犯组成的国家，确实少不了制药业。”"

# game/murdochroute3.rpy:1070
translate Schinese murdochroute3a_57e76660:

    # ra "“Too true!”"
    ra "“太对了！”"

# game/murdochroute3.rpy:1071
translate Schinese murdochroute3a_7c915a67:

    # ra "“They teach us how to process and identify all substances known to man.”"
    ra "“我们能学到如何鉴别与处理目前所有已知的物质。”"

# game/murdochroute3.rpy:1075
translate Schinese murdochroute3a_ca3073b9:

    # ra "“If you make enough friends like me then you can recoup all the coke you’d need for your friends south of the border after Harrison anti-drug passed.”"
    ra "“多交点像我这样的朋友，你就知道在哈里森禁毒法通过后，该怎么把可卡因捎给你那些南部边境的朋友们了。”"

# game/murdochroute3.rpy:1079
translate Schinese murdochroute3a_a6680032:

    # "Neil chuffed and put his glass down at the table."
    "Neil差点把水喷出来。"

# game/murdochroute3.rpy:1080
translate Schinese murdochroute3a_668ba95a:

    # "Reubin was roaring with laughter."
    "Reubin大笑不止。"

# game/murdochroute3.rpy:1139
translate Schinese murdochroute3a_ba3dd02c:

    # reu "“He’s got you by the balls there!”"
    reu "“被戳到痛处了吧！”"

# game/murdochroute3.rpy:1084
translate Schinese murdochroute3a_eff277b9:

    # nei "“I wasn’t aware that the tabloids made it all the way out to the boonies...”"
    nei "“没想到乡下人也会看小报...”"

# game/murdochroute3.rpy:1086
translate Schinese murdochroute3a_27fb5cdf:

    # ra "“Oh, certainly.”"
    ra "“噢，还真会。”"

# game/murdochroute3.rpy:1089
translate Schinese murdochroute3a_7344fa63:

    # ra "“We had two presses, if you would believe, before the one got burnt down.”"
    ra "“说出来怕你不信，我们还有两间报社，不过其中一间被烧掉了。”"

# game/murdochroute3.rpy:1092
translate Schinese murdochroute3a_ce36c76a:

    # ra "“Telephones and electricity too.”"
    ra "“还有电话跟电力呢。”"

# game/murdochroute3.rpy:1095
translate Schinese murdochroute3a_041b6865:

    # ra "“We don’t want to make it too frightful out here for city people like you.”"
    ra "“不然可要把你们这些城里人给吓跑咯。”"

# game/murdochroute3.rpy:1098
translate Schinese murdochroute3a_1d843e40:

    # ji "“They got you wrapped up in a scandal, Neil?”"
    ji "“你都身陷丑闻了，Neil？”"

# game/murdochroute3.rpy:1101
translate Schinese murdochroute3a_7ccdea76:

    # ji "“Now there’s the hotblooded Neil I used to know.”"
    ji "“这才是我认识的那个热血Neil嘛。”"

# game/murdochroute3.rpy:1104
translate Schinese murdochroute3a_00350846:

    # ji "“I really have been missing out.”"
    ji "“看来我真是错过了不少啊。”"

# game/murdochroute3.rpy:1106
translate Schinese murdochroute3a_448577ad:

    # "Neil stared sternly, lips curling up as he finished another chug of water."
    "Neil严肃地瞪了他一眼，又喝了一大口水。"

# game/murdochroute3.rpy:1107
translate Schinese murdochroute3a_7c173c09:

    # "Then the bottom of his glass thudded against the table."
    "杯子砸到桌上，发出砰的一声响。"

# game/murdochroute3.rpy:1110
translate Schinese murdochroute3a_54dde453:

    # nei "“Baseless accusations of course.”"
    nei "“那当然只是毫无根据的指控。”"

# game/murdochroute3.rpy:1111
translate Schinese murdochroute3a_00aaeb00:

    # nei "“They couldn’t make up enough lies about me to take me to court.”"
    nei "“他们想把我告上法庭，却连足以令人信服的谎言都编不出来。”"

# game/murdochroute3.rpy:1114
translate Schinese murdochroute3a_5fb20433:

    # "Jim sighed dramatically."
    "Jim戏剧性地叹了口气。"

# game/murdochroute3.rpy:1116
translate Schinese murdochroute3a_1fece47b:

    # ji "“Dusty, dutiful Neil.”"
    ji "“尽职的Neil，却落得一身灰。”"

# game/murdochroute3.rpy:1119
translate Schinese murdochroute3a_7b7427b5:

    # ji "“I figured you’d insist upon going by the books.”"
    ji "“我知道，你总是按部就班的。”"

# game/murdochroute3.rpy:1121
translate Schinese murdochroute3a_03e471d7:

    # "Neil plucked a pipe from his pocket, carefully stuffed a bit of tobacco into the end, put it into his mouth and lit it."
    "Neil从口袋里掏出烟斗，精心装了点烟草，含在嘴里后点燃。"

# game/murdochroute3.rpy:1122
translate Schinese murdochroute3a_ad516298:

    # nei "“You sound disappointed to hear that.”"
    nei "“你听起来有些失望啊。”"

# game/murdochroute3.rpy:1124
translate Schinese murdochroute3a_bbaf7c83:

    # ji "“Seems pointless to be a senator if you don’t get caught up in a scandal or two.”"
    ji "“不传出一两件丑闻，这议员岂不是白当了？”"

# game/murdochroute3.rpy:1126
translate Schinese murdochroute3a_e6b8dc48:

    # nei "“Perhaps that’s why I enact legislation and you study rocks, old boy.”"
    nei "“所以在我制定法规的时候，你还在玩石头，大男孩。”"

# game/murdochroute3.rpy:1128
translate Schinese murdochroute3a_0f121a3d_1:

    # ji "“Can’t say I know the pleasure.”"
    ji "“前边那个还是饶了我吧。”"

# game/murdochroute3.rpy:1130
translate Schinese murdochroute3a_bc79975a:

    # nei "“We keep our noses clean enough.”"
    nei "“我们一向清廉正直。”"

# game/murdochroute3.rpy:1132
translate Schinese murdochroute3a_d52e5b81:

    # ra "“Especially if they never catch you, eh?”"
    ra "“尤其是没被抓到的时候，对吧？”"

# game/murdochroute3.rpy:1134
translate Schinese murdochroute3a_6ba702e7:

    # nei "“Why not?”"
    nei "“这还用问吗？”"

# game/murdochroute3.rpy:1135
translate Schinese murdochroute3a_83a5ae4a:

    # nei "“After all, that seems to be the fantasy you want to entertain.”"
    nei "“反正你就是这么幻想的。”"

# game/murdochroute3.rpy:1137
translate Schinese murdochroute3a_28656fda:

    # mu "“Ralph.”"
    mu "“Ralph。”"

# game/murdochroute3.rpy:1145
translate Schinese murdochroute3a_4ca27878:

    # mu "“Behave.”"
    mu "“安分点。”"

# game/murdochroute3.rpy:1141
translate Schinese murdochroute3a_1746defb:

    # ra "“Come, now, I’m just another performer providing tonight’s entertainment...”"
    ra "“别这么说嘛，今晚我不过是一介弄臣罢了...”"

# game/murdochroute3.rpy:1143
translate Schinese murdochroute3a_2cbdcafb:

    # "He makes a gesture at Reubin, who’s in tears from laughing so hard, and Jim, who’s wearing an undeniable smirk."
    "他向笑到流眼泪的Reubin和藏不住脸上窃笑的Jim致意。"

# game/murdochroute3.rpy:1147
translate Schinese murdochroute3a_f52851dd:

    # "A performer I’ve never seen before takes the stage and starts to sing."
    "有一位我没见过的表演者登台演唱。"

# game/murdochroute3.rpy:1148
translate Schinese murdochroute3a_ce779fd5:

    # "She’s pretty good, but the crowd is still talking amongst themselves, barely listening."
    "她唱得是不错，但人们都在自顾自地聊天，几乎没有谁在听。"

# game/murdochroute3.rpy:1149
translate Schinese murdochroute3a_4b3606cb:

    # "Most of the audience members paying attention have eyes set on the backup dancers joining the stage."
    "大部分观众也只是盯着伴舞。"

# game/murdochroute3.rpy:1150
translate Schinese murdochroute3a_b8aa0259:

    # "They aren’t exactly wearing much."
    "她们穿得很少。"

# game/murdochroute3.rpy:1151
translate Schinese murdochroute3a_28d2d005:

    # "Flowing dresses with slips that show off a lot of leg."
    "飘逸的洋装搭配衬裙，将大腿的春色暴露无遗。"

# game/murdochroute3.rpy:1152
translate Schinese murdochroute3a_ceeb5968:

    # "Neil leans forward in his seat."
    "Neil把身子探向前方。"

# game/murdochroute3.rpy:1154
translate Schinese murdochroute3a_46c82a79:

    # nei "“Finally, something easy on the eyes.”"
    nei "“终于有养眼的节目了。”"

# game/murdochroute3.rpy:1156
translate Schinese murdochroute3a_eae26027:

    # ra "“Well.”"
    ra "“这个嘛。”"

# game/murdochroute3.rpy:1159
translate Schinese murdochroute3a_7e6e1417:

    # ra "“They’re certainly women.”"
    ra "“毕竟是实打实的女人。”"

# game/murdochroute3.rpy:1161
translate Schinese murdochroute3a_588e1c3d:

    # reu "“They most certainly are...”"
    reu "“的确...”"

# game/murdochroute3.rpy:1162
translate Schinese murdochroute3a_a3219a22:

    # "The cat’s leaning forward too."
    "猫也探出了身子。"

# game/murdochroute3.rpy:1164
translate Schinese murdochroute3a_b47905fd:

    # ji "“What’s the matter Neil?”"
    ji "“怎么了，Neil？”"

# game/murdochroute3.rpy:1167
translate Schinese murdochroute3a_03383f6f:

    # ji "“Are you saying our party isn’t fair enough for you?”"
    ji "“对我们的派对不满意吗？”"

# game/murdochroute3.rpy:1169
translate Schinese murdochroute3a_ea653e9e:

    # nei "“It’s fair enough for a party that serves only sausage, if you get my drift.”"
    nei "“对于一个只提供香肠的派对来说，是没什么不满的，如果你明白我意思的话。”"

# game/murdochroute3.rpy:1172
translate Schinese murdochroute3a_d375af0e:

    # ji "“Perhaps all meat has flavor, if you get my drift.”"
    ji "“每种香肠的风味都不同啊，如果你明白我意思的话。”"

# game/murdochroute3.rpy:1174
translate Schinese murdochroute3a_0a1b926e:

    # nei "“I suppose if you lived in a place like this you’d be desperate enough to think so.”"
    nei "“生活在这种地方，你会饥不择食也正常。”"

# game/murdochroute3.rpy:1175
translate Schinese murdochroute3a_a7d95070:

    # nei "“I’ve never seen more men in this county than my days in service, and that’s quite the feat.”"
    nei "“我服役时都没见过这么多的男人，太夸张了。”"

# game/murdochroute3.rpy:1176
translate Schinese murdochroute3a_695d0ce5:

    # nei "“The fattest wallets will empty quick enough if you’re surviving on showgirls.”"
    nei "“如果唯一的寄托就只有歌舞女郎，你再厚的钱包也鼓不了多久。”"

# game/murdochroute3.rpy:1178
translate Schinese murdochroute3a_43aa6d34:

    # ji "“Poor, proud Neil.”"
    ji "“骄贵的小Neil。”"

# game/murdochroute3.rpy:1181
translate Schinese murdochroute3a_dc666650:

    # ji "“We’ve shared girls before.”"
    ji "“咱们共享过的姑娘还少吗。”"

# game/murdochroute3.rpy:1184
translate Schinese murdochroute3a_b3c5f63f:

    # ji "“Surely you weren’t thinking about just her in those hasty moments.”"
    ji "“兴致上来了，你心里也不会只想着她一个人吧。”"

# game/murdochroute3.rpy:1186
translate Schinese murdochroute3a_92ba57a0:

    # nei "“Scoundrel.”"
    nei "“你这个流氓。”"

# game/murdochroute3.rpy:1188
translate Schinese murdochroute3a_6031556f:

    # ji "“I welcome the insult.”"
    ji "“随你怎么说。”"

# game/murdochroute3.rpy:1190
translate Schinese murdochroute3a_18291bc1:

    # nei "“I haven’t even have my first drink yet.”"
    nei "“我连一杯都还没喝呢。”"

# game/murdochroute3.rpy:1192
translate Schinese murdochroute3a_41ee0656:

    # ji "“Then what’ll it be?”"
    ji "“来点儿什么？”"

# game/murdochroute3.rpy:1194
translate Schinese murdochroute3a_33f64cb7:

    # nei "“Let me have a look at their strongest gin.”"
    nei "“就试试他们家最烈的琴酒好了。”"

# game/murdochroute3.rpy:1196
translate Schinese murdochroute3a_d0c2b4eb:

    # ji "“And what are you in the mood for Reubin?”"
    ji "“Reubin你呢？”"

# game/murdochroute3.rpy:1253
translate Schinese murdochroute3a_e76be431:

    # reu "“To drink or to slip into?”"
    reu "“喝的还是捅的？”"

# game/murdochroute3.rpy:1200
translate Schinese murdochroute3a_fd4e3671:

    # ji "“Whichever you prefer to answer.”"
    ji "“都行。”"

# game/murdochroute3.rpy:1202
translate Schinese murdochroute3a_f5403ed6:

    # reu "“Any port in a storm, right?”"
    reu "“将就将就是吧？”"

# game/murdochroute3.rpy:1203
translate Schinese murdochroute3a_f2033b85:

    # reu "“But to answer both: something smooth.”"
    reu "“那我就一次回答两边：滑顺的。”"

# game/murdochroute3.rpy:1207
translate Schinese murdochroute3a_a8d8823e:

    # mu "“I’ll be right back.”"
    mu "“我去去就回。”"

# game/murdochroute3.rpy:1208
translate Schinese murdochroute3a_49c40941:

    # mu "“I think I need some air.”"
    mu "“透透气。”"

# game/murdochroute3.rpy:1209
translate Schinese murdochroute3a_5e64e351:

    # "He looks a little queasy."
    "他看起来有点不舒服。"

# game/murdochroute3.rpy:1211
translate Schinese murdochroute3a_bf85da54:

    # ji "“You’re a bit off.”"
    ji "“你没事吧。”"

# game/murdochroute3.rpy:1214
translate Schinese murdochroute3a_ccf99d18:

    # ji "“Maybe take it easy on any drinks.”"
    ji "“少喝一点比较好。”"

# game/murdochroute3.rpy:1217
translate Schinese murdochroute3a_43f91f18:

    # "I think I could use a break from all this too."
    "我也待不下去了。"

# game/murdochroute3.rpy:1218
translate Schinese murdochroute3a_e34d9fe4:

    # m "“Me too.”"
    m "“我也去透透气。”"

# game/murdochroute3.rpy:1220
translate Schinese murdochroute3a_6af455d4:

    # ji "“Don’t go far.”"
    ji "“别走太远了。”"

# game/murdochroute3.rpy:1222
translate Schinese murdochroute3a_0067e186:

    # "He looks at the rat."
    "他看向老鼠。"

# game/murdochroute3.rpy:1224
translate Schinese murdochroute3a_044e99fb:

    # ji "“Do you need to join them?”"
    ji "“你要跟他们一起吗？”"

# game/murdochroute3.rpy:1227
translate Schinese murdochroute3a_6e460bb3:

    # ra "“Not at all.”"
    ra "“不用。”"

# game/murdochroute3.rpy:1230
translate Schinese murdochroute3a_27c3d59e:

    # ra "“I’m very comfortable right now.”"
    ra "“我待着很舒服。”"

# game/murdochroute3.rpy:1232
translate Schinese murdochroute3a_e0fe2284:

    # ji "“That’s great to hear.”"
    ji "“那就好。”"

# game/murdochroute3.rpy:1237
translate Schinese murdochroute3a_8a059508:

    # "I hear their voices fading as I follow Murdoch’s big tail through the crowds of people."
    "我跟随Murdoch的大尾巴穿越人群，他们的谈话声逐渐远去。"

# game/murdochroute3.rpy:1238
translate Schinese murdochroute3a_4fc07112:

    # ra "“Now that I think on it...”"
    ra "“我突然想到...”"

# game/murdochroute3.rpy:1239
translate Schinese murdochroute3a_f58ddbc7:

    # ra "“I think I know exactly the right topic for this bachelor party.”"
    ra "“一个最适合这个单身派对的话题。”"

# game/murdochroute3.rpy:1240
translate Schinese murdochroute3a_38a79f7d:

    # ji "“And what’s that?”"
    ji "“什么话题？”"

# game/murdochroute3.rpy:1241
translate Schinese murdochroute3a_8fc5e0cc:

    # ra "“Religion!”"
    ra "“宗教信仰！”"

# game/murdochroute3.rpy:1246
translate Schinese murdochroute3a_a9b89a47:

    # "I follow him until he runs into a wall of people and can barely walk."
    "我一路跟着他，直到他被一面人墙堵住。"

# game/murdochroute3.rpy:1247
translate Schinese murdochroute3a_9fb3c300:

    # "So I tug on his tail to get his attention."
    "我见状拉他尾巴，好引起他的注意。"

# game/murdochroute3.rpy:1249
translate Schinese murdochroute3a_60bf2060:

    # "He flinches and swirls around,{nw}"
    "他惊愕地转身，{nw}"

# game/murdochroute3.rpy:1251
translate Schinese murdochroute3a_62ec96cb:

    # extend " then breaths in relief when he sees me."
    extend "看到是我后才松了口气。"

# game/murdochroute3.rpy:1346
translate Schinese murdochroute3a_9bb2eacc:

    # m "“You want to head up to my room?”"
    m "“要去我的房间吗？”"

# game/murdochroute3.rpy:1253
translate Schinese murdochroute3a_6ac161a2:

    # m "“It’s quiet there.”"
    m "“清静一点。”"

# game/murdochroute3.rpy:1255
translate Schinese murdochroute3a_7dd067e5:

    # "He nods, and I lead him up the stairs."
    "他点点头，我便带他上楼。"

# game/murdochroute3.rpy:1261
translate Schinese murdochroute3a_2028c50e:

    # "When we’re inside the room, he exhales."
    "进到房间后，他叹了口气。"

# game/murdochroute3.rpy:1263
translate Schinese murdochroute3a_6061883c:

    # mu "“I saw you talking to that woman you work with.”"
    mu "“我之前看到你在跟那个女同事交谈。”"

# game/murdochroute3.rpy:1265
translate Schinese murdochroute3a_3d4b8770:

    # "He starts pacing."
    "他开始踱步。"

# game/murdochroute3.rpy:1267
translate Schinese murdochroute3a_592bef15:

    # mu "“Did she say he booked you?”"
    mu "“她是不是说了你被预约的事？”"

# game/murdochroute3.rpy:1269
translate Schinese murdochroute3a_8ce61eb8:

    # "I nod."
    "我点头。"

# game/murdochroute3.rpy:1270
translate Schinese murdochroute3a_3b4f35c4:

    # m "“That she did.”"
    m "“是说了。”"

# game/murdochroute3.rpy:1273
translate Schinese murdochroute3a_879f6062:

    # mu "“Oh of course he would.”"
    mu "“唉，果然。”"

# game/murdochroute3.rpy:1274
translate Schinese murdochroute3a_11baca48:

    # mu "“Of course he would.”"
    mu "“我就知道。”"

# game/murdochroute3.rpy:1276
translate Schinese murdochroute3a_95451227:

    # "He stops pacing for a moment and looks at me."
    "他停下脚步，凝视着我。"

# game/murdochroute3.rpy:1278
translate Schinese murdochroute3a_2d8bed6c:

    # mu "“You and him and who else.”"
    mu "“除了你们，还有谁？”"

# game/murdochroute3.rpy:1280
translate Schinese murdochroute3a_e333f3ad:

    # m "“And his two buddies.”"
    m "“还有他那两个朋友。”"

# game/murdochroute3.rpy:1281
translate Schinese murdochroute3a_4ef3d84f:

    # "I rub the back of my head."
    "我揉着后脑勺。"

# game/murdochroute3.rpy:1282
translate Schinese murdochroute3a_6b5dd66c:

    # m "“And you too.”"
    m "“还有你。”"

# game/murdochroute3.rpy:1284
translate Schinese murdochroute3a_52ee1ef1:

    # "He nods and sits down on my bed with a thud."
    "他点点头，猛地坐到我的床上。"

# game/murdochroute3.rpy:1286
translate Schinese murdochroute3a_bb022f45:

    # "Then he scratches beneath the fur on his head, aggressively."
    "然后把手指埋在毛下，使劲抓挠。"

# game/murdochroute3.rpy:1287
translate Schinese murdochroute3a_d94b2868:

    # m "“You don’t look so good.”"
    m "“看你脸色不太好。”"

# game/murdochroute3.rpy:1288
translate Schinese murdochroute3a_c80b4a8f:

    # "I open the drawer and take out one of my cigarettes."
    "我拉开抽屉，抽出一根烟。"

# game/murdochroute3.rpy:1290
translate Schinese murdochroute3a_f3488062:

    # mu "“So then how do I fix this?”"
    mu "“那怎么样才能变好？”"

# game/murdochroute3.rpy:1292
translate Schinese murdochroute3a_825ed0f0:

    # "The lighter is cold to the touch as I flick it."
    "我用指尖轻点冰凉的打火机。"

# game/murdochroute3.rpy:1293
translate Schinese murdochroute3a_6a16cb30:

    # m "“It’s good sometimes that you don’t.”"
    m "“有时候，你就该让人知道自己不好。”"

# game/murdochroute3.rpy:1294
translate Schinese murdochroute3a_aeca2ff7:

    # "He shakes his head."
    "他摇了摇头。"

# game/murdochroute3.rpy:1296
translate Schinese murdochroute3a_afe7087e:

    # mu "“Not tonight.”"
    mu "“今晚不行。”"

# game/murdochroute3.rpy:1298
translate Schinese murdochroute3a_5aafeb50:

    # m "“Or the next one either, I reckon.”"
    m "“这么说的话，明晚也一样吧。”"

# game/murdochroute3.rpy:1300
translate Schinese murdochroute3a_2baba2cf:

    # mu "“That’s Holly’s wedding.”"
    mu "“毕竟是Holly的婚礼。”"

# game/murdochroute3.rpy:1302
translate Schinese murdochroute3a_bfb943a0:

    # m "“Mmm.”"
    m "“嗯。”"

# game/murdochroute3.rpy:1303
translate Schinese murdochroute3a_0670f349:

    # m "“And then it’s the busiest day at the store.”"
    m "“又是在店里忙碌。”"

# game/murdochroute3.rpy:1304
translate Schinese murdochroute3a_5b61184c:

    # m "“And then it’s picture day.”"
    m "“又是拍照日的。”"

# game/murdochroute3.rpy:1305
translate Schinese murdochroute3a_3fc9f1a6:

    # m "“Funny how it’s always somethin’, ain’t it?”"
    m "“一刻也不得闲是吧？”"

# game/murdochroute3.rpy:1307
translate Schinese murdochroute3a_4e58404d:

    # "He shrugged."
    "他耸耸肩。"

# game/murdochroute3.rpy:1309
translate Schinese murdochroute3a_9e7eb3df:

    # mu "“Why’s that your problem all of a sudden?”"
    mu "“你怎么突然在意起这个了？”"

# game/murdochroute3.rpy:1310
translate Schinese murdochroute3a_847e35b3:

    # "I shrug back."
    "我同样耸肩。"

# game/murdochroute3.rpy:1312
translate Schinese murdochroute3a_fc08aef3:

    # m "“Because you’re sort of my boss in a way, ain’t you?”"
    m "“你总归是我的老板，不是吗？”"

# game/murdochroute3.rpy:1313
translate Schinese murdochroute3a_2e121332:

    # m "“Hard to get paid if you keel over.”"
    m "“你倒下的话，就没人付我薪水了。”"

# game/murdochroute3.rpy:1315
translate Schinese murdochroute3a_e84d95bd:

    # mu "“The boss is my dad, Sam.”"
    mu "“我爸才是老板，Sam。”"

# game/murdochroute3.rpy:1316
translate Schinese murdochroute3a_3dd3bb28:

    # mu "“I’m just an assistant manager.”"
    mu "“我只是副经理。”"

# game/murdochroute3.rpy:1318
translate Schinese murdochroute3a_0fee615e:

    # m "“Don’t think I’d be around too long if you weren’t callin’ some of the shots.”"
    m "“好歹你有发号施令，不然我可待不久。”"

# game/murdochroute3.rpy:1319
translate Schinese murdochroute3a_dc83a6e1:

    # "He looks in the mirror and rakes his claws through the fur on his head."
    "他面向镜子，用爪梳理头上的毛发。"

# game/murdochroute3.rpy:1321
translate Schinese murdochroute3a_e4d42aa0:

    # mu "“When the whole lot of us are out of town, I’m not going to have to do these things anymore.”"
    mu "“等离开这座小镇后，我们就再也不用过这样的日子了。”"

# game/murdochroute3.rpy:1322
translate Schinese murdochroute3a_b284f555:

    # mu "“You’ll see.”"
    mu "“等着瞧吧。”"

# game/murdochroute3.rpy:1324
translate Schinese murdochroute3a_a89d0d3c:

    # m "“So you’re saying it’s only temporary.”"
    m "“所以你还要继续忍下去。”"

# game/murdochroute3.rpy:1326
translate Schinese murdochroute3a_9b77b1f9:

    # mu "“Yeah.”"
    mu "“是啊。”"

# game/murdochroute3.rpy:1328
translate Schinese murdochroute3a_e33f02ef:

    # "I laugh."
    "我笑了。"

# game/murdochroute3.rpy:1330
translate Schinese murdochroute3a_92d3198f_1:

    # mu "“What?”"
    mu "“怎么？”"

# game/murdochroute3.rpy:1332
translate Schinese murdochroute3a_c7a759c5:

    # m "“Nothin’.”"
    m "“没事。”"

# game/murdochroute3.rpy:1334
translate Schinese murdochroute3a_4b323846:

    # mu "“It’s clearly something.”"
    mu "“明明就有事。”"

# game/murdochroute3.rpy:1336
translate Schinese murdochroute3a_6b246000:

    # m "“It’s just that you sound more and more like me each day.”"
    m "“我只是在想，你说的话越来越像我了。”"

# game/murdochroute3.rpy:1338
translate Schinese murdochroute3a_030ef0ef:

    # mu "“That supposed to be a compliment?”"
    mu "“这算称赞吗？”"

# game/murdochroute3.rpy:1340
translate Schinese murdochroute3a_3a1f371a:

    # m "“Not really.”"
    m "“不算。”"

# game/murdochroute3.rpy:1342
translate Schinese murdochroute3a_639a90b2:

    # mu "“You really know how to sweet talk a guy.”"
    mu "“你真的很会说好听话。”"

# game/murdochroute3.rpy:1344
translate Schinese murdochroute3a_7d2033e9:

    # m "“Whorin’ ain’t about sweet talk.”"
    m "“出来卖，靠的可不是说好听话。”"

# game/murdochroute3.rpy:1533
translate Schinese murdochroute3a_64cbc879:

    # m "“It’s about doin’ what needs done and getting paid.”"
    m "“拿一分钱，办一分事。”"

# game/murdochroute3.rpy:1347
translate Schinese murdochroute3a_67739418:

    # mu "“Who says I had any interest in whoring?”"
    mu "“谁说我想卖了？”"

# game/murdochroute3.rpy:1349
translate Schinese murdochroute3a_27c7b241:

    # m "“You’re already doing it.”"
    m "“你早就在这么干了。”"

# game/murdochroute3.rpy:1351
translate Schinese murdochroute3a_48c2b409:

    # mu "“I’m not.”"
    mu "“没有。”"

# game/murdochroute3.rpy:1353
translate Schinese murdochroute3a_94f9ab30:

    # m "“Do you really want to fuck all those men downstairs?”"
    m "“所以你想跟下面那几个男的上床么？”"

# game/murdochroute3.rpy:1355
translate Schinese murdochroute3a_707a988d:

    # mu "“Well...”"
    mu "“我...”"

# game/murdochroute3.rpy:1356
translate Schinese murdochroute3a_87306273:

    # "He looks down."
    "他低下头。"

# game/murdochroute3.rpy:1358
translate Schinese murdochroute3a_915df4c6:

    # mu "“...why wouldn’t I?”"
    mu "“...有什么关系？”"

# game/murdochroute3.rpy:1360
translate Schinese murdochroute3a_746dc6f5:

    # m "“Because they’re complete strangers and you don’t know what they’re after.”"
    m "“你既不认识他们，也不知道他们想做什么。”"

# game/murdochroute3.rpy:1361
translate Schinese murdochroute3a_432d80a0:

    # m "“If you come into this room with them and they want you to do something, you’ll have to do it.”"
    m "“进了这房间，你就得对客人唯命是从。”"

# game/murdochroute3.rpy:1362
translate Schinese murdochroute3a_10072e36:

    # m "“Clients get angry when they don’t get what they want.”"
    m "“不然他们可是会不高兴的。”"

# game/murdochroute3.rpy:1364
translate Schinese murdochroute3a_7f43f14b:

    # mu "“They’re not my clients.”"
    mu "“他们又不是我的客户。”"

# game/murdochroute3.rpy:1366
translate Schinese murdochroute3a_7fb463e6:

    # m "“There’s something you want from them, don’t you?”"
    m "“但你有想从他们身上得到的东西吧？”"

# game/murdochroute3.rpy:1368
translate Schinese murdochroute3a_cd167dd4:

    # mu "“It’s not that simple.”"
    mu "“不是‘什么东西’那么简单。”"

# game/murdochroute3.rpy:1370
translate Schinese murdochroute3a_076183d0:

    # mu "“It’s a cluttered, messy mix of a lot of things.”"
    mu "“其中牵扯到很多。”"

# game/murdochroute3.rpy:1372
translate Schinese murdochroute3a_482edd1d:

    # m "“If you’re fucking for something other than love or pleasure, that’s whorin’.”"
    m "“如果不是为了爱或快感，那就是在卖。”"

# game/murdochroute3.rpy:1373
translate Schinese murdochroute3a_d424d141:

    # m "“Plain and simple.”"
    m "“简单明了。”"

# game/murdochroute3.rpy:1374
translate Schinese murdochroute3a_b89a962a:

    # "He holds my vanity and looks straight into the mirror."
    "他抓着梳妆台的边沿，直视镜子。"

# game/murdochroute3.rpy:1376
translate Schinese murdochroute3a_ba29d637:

    # mu "“I suppose you have a point.”"
    mu "“你说得对。”"

# game/murdochroute3.rpy:1378
translate Schinese murdochroute3a_a276e7a3:

    # m "“Do you get it now?”"
    m "“现在你懂了吧？”"

# game/murdochroute3.rpy:1379
translate Schinese murdochroute3a_e7763dc9:

    # "He nods slowly."
    "他缓缓点头。"

# game/murdochroute3.rpy:1381
translate Schinese murdochroute3a_9b77b1f9_1:

    # mu "“Yeah.”"
    mu "“嗯。”"

# game/murdochroute3.rpy:1383
translate Schinese murdochroute3a_22e8cde9:

    # m "“So are you still going through with it all?”"
    m "“所以听了这么多，你还想跟他们做吗？”"

# game/murdochroute3.rpy:1384
translate Schinese murdochroute3a_0ca3b558:

    # "He rolls his neck and bites his lip."
    "他转了转脖子，咬着嘴唇。"

# game/murdochroute3.rpy:1386
translate Schinese murdochroute3a_3106e4cb:

    # mu "“I think that I should.”"
    mu "“我必须得做。”"

# game/murdochroute3.rpy:1387
translate Schinese murdochroute3a_504d01d6:

    # m "“Can you live with that?”"
    m "“你是怎么说服自己的？”"

# game/murdochroute3.rpy:1389
translate Schinese murdochroute3a_6cc60c45:

    # "He looks at me."
    "他看着我。"

# game/murdochroute3.rpy:1391
translate Schinese murdochroute3a_17a5faff:

    # mu "“How do you?”"
    mu "“你是怎么说服自己的？”"

# game/murdochroute3.rpy:1393
translate Schinese murdochroute3a_3ddf812b:

    # "I chuckle."
    "我呵呵一笑。"

# game/murdochroute3.rpy:1394
translate Schinese murdochroute3a_6bf4f296:

    # m "“Not very well.”"
    m "“凑活过呗。”"

# game/murdochroute3.rpy:1396
translate Schinese murdochroute3a_99365f52:

    # "He laughs too."
    "他也笑了。"

# game/murdochroute3.rpy:1398
translate Schinese murdochroute3a_67f5a6be:

    # mu "“You know... I used to fuck a whole lot more.”"
    mu "“其实...我跟很多人都做过。”"

# game/murdochroute3.rpy:1400
translate Schinese murdochroute3a_e19cc5fc:

    # m "“For love and pleasure?”"
    m "“为了爱和快感？”"

# game/murdochroute3.rpy:1402
translate Schinese murdochroute3a_5c7aafe4:

    # mu "“Pleasure at the very least.”"
    mu "“快感有。”"

# game/murdochroute3.rpy:1403
translate Schinese murdochroute3a_24b4425c:

    # mu "“Love was always harder.”"
    mu "“爱却不常有。”"

# game/murdochroute3.rpy:1405
translate Schinese murdochroute3a_d09da1aa:

    # m "“...you ever love anybody?”"
    m "“...你曾经爱过谁吗？”"

# game/murdochroute3.rpy:1407
translate Schinese murdochroute3a_252f5a4f:

    # mu "“I used to love Ralph.”"
    mu "“我以前很爱Ralph。”"

# game/murdochroute3.rpy:1408
translate Schinese murdochroute3a_05a97b23:

    # mu "“He loved me too, in his ways.”"
    mu "“他也以他的方式爱着我。”"

# game/murdochroute3.rpy:1410
translate Schinese murdochroute3a_7428413f:

    # m "“Then what happened?”"
    m "“然后呢？”"

# game/murdochroute3.rpy:1412
translate Schinese murdochroute3a_167bd252:

    # mu "“After my brother died, he left for school.”"
    mu "“我弟弟死后，他就外出求学了。”"

# game/murdochroute3.rpy:1414
translate Schinese murdochroute3a_76c485cb:

    # m "“He came back, didn’t he?”"
    m "“可他不是回来了吗？”"

# game/murdochroute3.rpy:1416
translate Schinese murdochroute3a_c1f7705a:

    # mu "“Twelve years later.”"
    mu "“在十二年后。”"

# game/murdochroute3.rpy:1418
translate Schinese murdochroute3a_8619f2c6:

    # "I shrug."
    "我耸肩。"

# game/murdochroute3.rpy:1419
translate Schinese murdochroute3a_b38602dc:

    # m "“You both still seem close.”"
    m "“感觉你们还是挺亲的。”"

# game/murdochroute3.rpy:1421
translate Schinese murdochroute3a_e534a72c:

    # mu "“When somebody’s your best friend, it seems like you can pass by all the days in the universe, then pick up with them again like no time has passed at all.”"
    mu "“时间可以拉长人与人之间的距离，却拉不断人与人之间的思念。”"

# game/murdochroute3.rpy:1422
translate Schinese murdochroute3a_95b9c0de:

    # mu "“Except it did, and now you’re both different.”"
    mu "“但人是会变的。”"

# game/murdochroute3.rpy:1424
translate Schinese murdochroute3a_9aed6dd6:

    # mu "“You both want different things than you did before, and then you become strangers again without even knowing it.”"
    mu "“怀着不复从前的抱负，不知不觉就形同陌路。”"

# game/murdochroute3.rpy:1426
translate Schinese murdochroute3a_d3ef2e6e:

    # mu "“I don’t think we want the same kind of life.”"
    mu "“他给不了我想要的生活。”"

# game/murdochroute3.rpy:1428
translate Schinese murdochroute3a_414c3665:

    # m "“So what kind of life do you want?”"
    m "“你想要什么样的生活？”"

# game/murdochroute3.rpy:1430
translate Schinese murdochroute3a_c84d1236:

    # mu "“Something a little more glamorous than a shopkeep.”"
    mu "“比看店更刺激一点的。”"

# game/murdochroute3.rpy:1431
translate Schinese murdochroute3a_ed70c288:

    # mu "“And a little less stuffy than a chamber musician.”"
    mu "“比室内演奏更宽阔一点的。”"

# game/murdochroute3.rpy:1433
translate Schinese murdochroute3a_5aa85dd6:

    # "He looks at me, smiling weakly."
    "他看着我，无力地笑了。"

# game/murdochroute3.rpy:1434
translate Schinese murdochroute3a_68781b9c:

    # mu "“Why, do you think I’d make a good whore?”"
    mu "“那，你觉得我会是一个好娼妓吗？”"

# game/murdochroute3.rpy:1436
translate Schinese murdochroute3a_4fc95395:

    # m "“I think you already do.”"
    m "“我觉得你已经是了。”"

# game/murdochroute3.rpy:1437
translate Schinese murdochroute3a_f555fa4f:

    # "I’m not joking."
    "我可没开玩笑。"

# game/murdochroute3.rpy:1438
translate Schinese murdochroute3a_ffa540f5:

    # "He raps his knuckles against the wood."
    "他一拳捶向木桌。"

# game/murdochroute3.rpy:1440
translate Schinese murdochroute3a_52f6976d:

    # mu "“Sex used to be the one thing in my life that I wouldn’t let work or my family touch.”"
    mu "“性曾是我人生中唯一不会让工作或家人踏足的事。”"

# game/murdochroute3.rpy:1442
translate Schinese murdochroute3a_fbfa501f:

    # mu "“It’s apparent to me now that I couldn’t even do that, at the end of the day.”"
    mu "“但到头来还是阻挡不了。”"

# game/murdochroute3.rpy:1444
translate Schinese murdochroute3a_f3843cb9:

    # m "“Only now you can say that if somebody wants to fuck you, they have to pay.”"
    m "“至少现在，你可以要求别人掏钱才能干你了。”"

# game/murdochroute3.rpy:1445
translate Schinese murdochroute3a_3b664c2e:

    # m "“No more free rides when a job’s a job.”"
    m "“既然是工作，就不能免费。”"

# game/murdochroute3.rpy:1447
translate Schinese murdochroute3a_f9b27ce1:

    # "He exhales."
    "他叹了口气。"

# game/murdochroute3.rpy:1449
translate Schinese murdochroute3a_21e46ba6:

    # mu "“Can I make up my mind about it later?”"
    mu "“能给我点时间考虑吗？”"

# game/murdochroute3.rpy:1451
translate Schinese murdochroute3a_4decaeef:

    # m "“Just do what you have to do.”"
    m "“随你的心意就好。”"

# game/murdochroute3.rpy:1453
translate Schinese murdochroute3a_ddb3bcae:

    # mu "“I just want to know...”"
    mu "“我想知道一件事...”"

# game/murdochroute3.rpy:1455
translate Schinese murdochroute3a_0d1cdcb8:

    # mu "“Are you gonna show up in this room tonight?”"
    mu "“今晚你会不会出现在这房间里？”"

# game/murdochroute3.rpy:1457
translate Schinese murdochroute3a_c806ebc0:

    # m "“Yeah.”"
    m "“会。”"

# game/murdochroute3.rpy:1458
translate Schinese murdochroute3a_58c2d6d2:

    # m "“I have a job to do.”"
    m "“这是我的工作。”"

# game/murdochroute3.rpy:1460
translate Schinese murdochroute3a_138c5062:

    # mu "“Alright.”"
    mu "“明白了。”"

# game/murdochroute3.rpy:1461
translate Schinese murdochroute3a_ad5e9c65:

    # mu "“That gives me enough to think about.”"
    mu "“这就够我斟酌了。”"

# game/murdochroute3.rpy:1463
translate Schinese murdochroute3a_21aa8850:

    # mu "“I just have one request.”"
    mu "“我只有一个要求。”"

# game/murdochroute3.rpy:1465
translate Schinese murdochroute3a_6932873d:

    # m "“And what’s that?”"
    m "“什么要求？”"

# game/murdochroute3.rpy:1467
translate Schinese murdochroute3a_da6c819d:

    # mu "“Can I have a real kiss before you do any of this?”"
    mu "“在那之前，可以给我一个真心的吻吗？”"

# game/murdochroute3.rpy:1469
translate Schinese murdochroute3a_f3efe206:

    # mu "“Something just for me?”"
    mu "“只属于我一个人的。”"

# game/murdochroute3.rpy:1471
translate Schinese murdochroute3a_5e3f745c:

    # "I don’t know what to say."
    "我不知道该说什么。"

# game/murdochroute3.rpy:1472
translate Schinese murdochroute3a_5d41b486:

    # "Business aside, this is going to be a bad night for him."
    "撇开生意不谈，他注定会度过一个糟糕的夜晚。"

# game/murdochroute3.rpy:1473
translate Schinese murdochroute3a_868b63db:

    # "But I don’t want to kiss him out of pity."
    "但我不想出于同情才亲他。"

# game/murdochroute3.rpy:1474
translate Schinese murdochroute3a_732b6f67:

    # "That would be far too cruel."
    "那对他太残忍了。"

# game/murdochroute3.rpy:1475
translate Schinese murdochroute3a_061e905b:

    # m "“Do you really think...”"
    m "“你真的认为...”"

# game/murdochroute3.rpy:1476
translate Schinese murdochroute3a_71da4121:

    # m "“You’d be prepared to live the same kind of life that I do?”"
    m "“自己准备好过我这样的生活了？”"

# game/murdochroute3.rpy:1477
translate Schinese murdochroute3a_cc69d31a:

    # m "“Just based on how you handle what you already have to handle?”"
    m "“光是现在在做的，你就已经那么难受了。”"

# game/murdochroute3.rpy:1478
translate Schinese murdochroute3a_a6f01ab4:

    # m "“And to follow that wherever it goes?”"
    m "“你不会后悔吗？”"

# game/murdochroute3.rpy:1480
translate Schinese murdochroute3a_736194c8:

    # mu "“Well, I really don’t know.”"
    mu "“我不知道。”"

# game/murdochroute3.rpy:1481
translate Schinese murdochroute3a_c2f4b53c:

    # mu "“You can’t tell what a road is like until you’ve walked it.”"
    mu "“路平不平，要人走过才清楚。”"

# game/murdochroute3.rpy:1483
translate Schinese murdochroute3a_af3f4cb8:

    # m "“Think for a second.”"
    m "“你要想好了。”"

# game/murdochroute3.rpy:1484
translate Schinese murdochroute3a_bd2ac307:

    # m "“The life I live is selfish.”"
    m "“我的活法是自私的。”"

# game/murdochroute3.rpy:1486
translate Schinese murdochroute3a_72afc16a:

    # mu "“So what if it is?”"
    mu "“是又怎么样？”"

# game/murdochroute3.rpy:1488
translate Schinese murdochroute3a_432118ad:

    # m "“Because I don’t think you have a selfish bone in your body.”"
    m "“我感觉你本质上不是个自私的人。”"

# game/murdochroute3.rpy:1489
translate Schinese murdochroute3a_209ff61c:

    # m "“And that’s a problem for me.”"
    m "“这就有问题了。”"

# game/murdochroute3.rpy:1491
translate Schinese murdochroute3a_dd6893f3:

    # mu "“Why would I need to be selfish if I care about you?”"
    mu "“我在意你，跟我自不自私有什么关系？”"

# game/murdochroute3.rpy:1493
translate Schinese murdochroute3a_7e50ddb0:

    # m "“’Cause I don’t want to be responsible for you curling up to die.”"
    m "“因为我可不想为你的悔恨买单。”"

# game/murdochroute3.rpy:1494
translate Schinese murdochroute3a_6c255a15:

    # m "“You’ve known me what?”"
    m "“你认识我才多久？”"

# game/murdochroute3.rpy:1495
translate Schinese murdochroute3a_24148ffe:

    # m "“A week?”"
    m "“一个礼拜？”"

# game/murdochroute3.rpy:1496
translate Schinese murdochroute3a_c6230bfd:

    # "There’s tears in his eyes."
    "他眼里含着泪。"

# game/murdochroute3.rpy:1498
translate Schinese murdochroute3a_d9709236:

    # mu "“So?”"
    mu "“所以呢？”"

# game/murdochroute3.rpy:1500
translate Schinese murdochroute3a_1ed6c3e4:

    # m "“So why do you think I’m good enough for you?”"
    m "“所以你凭什么觉得我配得上你？”"

# game/murdochroute3.rpy:1502
translate Schinese murdochroute3a_64cf500a:

    # mu "“Because I think you are.”"
    mu "“我就是这么觉得。”"

# game/murdochroute3.rpy:1504
translate Schinese murdochroute3a_7e6d8a0d:

    # m "“Listen to me...”"
    m "“听我说...”"

# game/murdochroute3.rpy:1506
translate Schinese murdochroute3a_4e451dd8:

    # m "“I know that you know what I did.”"
    m "“我做过什么，想必你也知道了。”"

# game/murdochroute3.rpy:1507
translate Schinese murdochroute3a_91728a74:

    # "His eyes widen, and the tears flow faster."
    "他睁大了眼睛，泪水止不住地滑落。"

# game/murdochroute3.rpy:1508
translate Schinese murdochroute3a_73abc689:

    # m "“Do you really want to miss somebody who’s gonna be gone?”"
    m "“你真的要把一个留不住的人放在心上吗？”"

# game/murdochroute3.rpy:1510
translate Schinese murdochroute3a_c1b2da66:

    # mu "“I’m already talking with you like you’re gone!”"
    mu "“你虽然站在这里，却和不在又有什么区别！”"

# game/murdochroute3.rpy:1511
translate Schinese murdochroute3a_f6527a10:

    # mu "“I watched you and waited for you so long, and now that I get to talk to you, it’s like you’ve already decided that you’re gone!”"
    mu "“我注视了你那么久，等待了你那么久，现在终于和你说上话了，你却一副自己早已不属于这里的样子！”"

# game/murdochroute3.rpy:1513
translate Schinese murdochroute3a_e991ef5b:

    # mu "“But you’re not gone!”"
    mu "“明明你就站在我面前！”"

# game/murdochroute3.rpy:1515
translate Schinese murdochroute3a_f65040b0:

    # mu "“I can see you, I can touch you, I can hear you!”"
    mu "“我看得到你、碰得到你，也听得到你！”"

# game/murdochroute3.rpy:1517
translate Schinese murdochroute3a_c645b270:

    # m "“But what happens when somebody comes for me?”"
    m "“万一有人来抓我怎么办？”"

# game/murdochroute3.rpy:1518
translate Schinese murdochroute3a_299e32f4:

    # m "“I’m stupid and I’m sloppy.”"
    m "“我人笨，做事又马虎。”"

# game/murdochroute3.rpy:1519
translate Schinese murdochroute3a_57bc7e8e:

    # m "“If it isn’t the sheriff who comes for me it’ll be somebody else.”"
    m "“就算治安官不来，也会有其他人找上门。”"

# game/murdochroute3.rpy:1520
translate Schinese murdochroute3a_b2a037d1:

    # m "“Sooner or later I’m going to have to get out of town or else I’m gonna be buried here, and soon.”"
    m "“我有预感，再待下去的话，这座小镇很快就会变成我的葬身之地。”"

# game/murdochroute3.rpy:1522
translate Schinese murdochroute3a_7601ee42:

    # mu "“...Then that’s what we’ll do.”"
    mu "“...那我们就离开。”"

# game/murdochroute3.rpy:1524
translate Schinese murdochroute3a_072a76e1:

    # m "“That’s what who will do?”"
    m "“怎么离开？”"

# game/murdochroute3.rpy:1526
translate Schinese murdochroute3a_b954157c:

    # mu "“You’ll come with me when Jim gets us out of town.”"
    mu "“Jim带我们去大城市的时候，你也一起走。”"

# game/murdochroute3.rpy:1528
translate Schinese murdochroute3a_2cc7b95a:

    # "I blink."
    "我眨了眨眼。"

# game/murdochroute3.rpy:1529
translate Schinese murdochroute3a_0ca7d229:

    # m "“No offense, but do you really want to rely on that guy to help us?”"
    m "“丑话说在前头，你真想依靠那家伙的帮助？”"

# game/murdochroute3.rpy:1531
translate Schinese murdochroute3a_830195dc:

    # mu "“It’s one thing that won’t make you look like you’re running away, isn’t it?”"
    mu "“这是唯一能让你体面离开的办法了，不是吗？”"

# game/murdochroute3.rpy:1984
translate Schinese murdochroute3a_51ead4f6:

    # m "“’S’pose so.”"
    m "“或许是。”"

# game/murdochroute3.rpy:1535
translate Schinese murdochroute3a_f9e0cd72:

    # mu "“I’ll tell you what...”"
    mu "“这么说吧...”"

# game/murdochroute3.rpy:1536
translate Schinese murdochroute3a_4ea770dc:

    # mu "“If you don’t kiss me tonight I’ll accept that my feelings aren’t real.”"
    mu "“你今晚不吻我的话，我就承认是我自作多情。”"

# game/murdochroute3.rpy:1538
translate Schinese murdochroute3a_c28aefa8:

    # mu "“It will hurt, but I’ll promise to live.”"
    mu "“痛是会痛，但我保证，我撑得住。”"

# game/murdochroute3.rpy:1540
translate Schinese murdochroute3a_e78a43ed:

    # "My heart is pounding in my chest."
    "我的心狂跳不止。"

# game/murdochroute3.rpy:1541
translate Schinese murdochroute3a_ab4e5335:

    # "Part of me wants to touch him."
    "我不自觉地想抱他。"

# game/murdochroute3.rpy:1542
translate Schinese murdochroute3a_20b1e9bc:

    # "To smooth down his ears and hold his head as I stick my tongue down his throat."
    "抚平他的耳朵，搂着他的头，把舌头伸进他的喉咙。"

# game/murdochroute3.rpy:1543
translate Schinese murdochroute3a_df574efd:

    # "But I’m not going to break him."
    "但我不想伤害他。"

# game/murdochroute3.rpy:1544
translate Schinese murdochroute3a_3a21dd84:

    # "He’s been battered so much and gets back up every time."
    "他受到那么多次打击，却都忍痛爬了起来。"

# game/murdochroute3.rpy:1545
translate Schinese murdochroute3a_be0ab67e:

    # "But who’s going to be the last one to do it?"
    "可最后会栽在谁手里？"

# game/murdochroute3.rpy:1546
translate Schinese murdochroute3a_b9a612e8:

    # "Not me."
    "不是我。"

# game/murdochroute3.rpy:1547
translate Schinese murdochroute3a_ef699862:

    # "No, not me."
    "不能是我。"

# game/murdochroute3.rpy:1548
translate Schinese murdochroute3a_7c07609b:

    # m "“...Can I surprise you on the off chance that I decide to?”"
    m "“...如果我吻你，你会把这当作是惊喜吗？”"

# game/murdochroute3.rpy:1550
translate Schinese murdochroute3a_032f025d:

    # mu "“...Yeah.”"
    mu "“...可以。”"

# game/murdochroute3.rpy:1552
translate Schinese murdochroute3a_2ca0effb:

    # m "“That’s good.”"
    m "“好。”"

# game/murdochroute3.rpy:1553
translate Schinese murdochroute3a_032b0313:

    # m "“No promises though.”"
    m "“但我不能保证。”"

# game/murdochroute3.rpy:1555
translate Schinese murdochroute3a_582dd21d:

    # mu "“I never expect those anymore, really.”"
    mu "“我已经不指望别人的保证了。”"

# game/murdochroute3.rpy:1557
translate Schinese murdochroute3a_02784371:

    # m "“Good.”"
    m "“那就好。”"

# game/murdochroute3.rpy:1558
translate Schinese murdochroute3a_e1704cad:

    # m "“Now then...”"
    m "“现在...”"

# game/murdochroute3.rpy:1560
translate Schinese murdochroute3a_2e9b047e:

    # m "“...You want to ditch this party with me?”"
    m "“...要跟我一起离开这个派对么？”"

# game/murdochroute3.rpy:1562
translate Schinese murdochroute3a_bd66d3b3:

    # mu "“I thought you said you’re going to be in your room for them?”"
    mu "“你不是说你会接待他们？”"

# game/murdochroute3.rpy:1563
translate Schinese murdochroute3a_65526d8e:

    # m "“Sure did, but that’s hours away, and sure as shit ain’t nobody paying me to attend a goddamn bachelor party.”"
    m "“是没错，但反正还有好几个小时，再说参加这什么鬼单身派对又捞不到好处。”"

# game/murdochroute3.rpy:1566
translate Schinese murdochroute3a_4db022b5:

    # mu "“If we did, we’d have to distract them so they wouldn’t notice us gone for long.”"
    mu "“决定了的话，我们就得想办法转移他们的注意力，这样他们才不会发现我们缺席了太久。”"

# game/murdochroute3.rpy:1568
translate Schinese murdochroute3a_d6904165:

    # m "“My friend Cynthia is an expert at diversions.”"
    m "“我朋友Cynthia是转移注意力的专家。”"

# game/murdochroute3.rpy:1570
translate Schinese murdochroute3a_32b32d02:

    # m "“Let me see what I can arrange.”"
    m "“我看看能不能安排一下。”"

# game/murdochroute3.rpy:1574
translate Schinese murdochroute3a_47177f55:

    # "I see her darting in and out of the kitchen."
    "我看着她出入厨房。"

# game/murdochroute3.rpy:1575
translate Schinese murdochroute3a_33afb15e:

    # "It takes her the third time to see me in the washroom."
    "第三次经过，她才发觉我在厕所里。"

# game/murdochroute3.rpy:1576
translate Schinese murdochroute3a_44909494:

    # "She makes eye contact and tilts her head."
    "她歪头对上我的视线。"

# game/murdochroute3.rpy:1577
translate Schinese murdochroute3a_43b21821:

    # "She glances behind her shoulder, puts her empty tray on a counter and walks towards me, slow."
    "她朝身后瞥了一眼，然后把空餐盘放到台子上，缓缓走过来。"

# game/murdochroute3.rpy:1579
translate Schinese murdochroute3a_1756b7e8:

    # cy "“I could have nearly screamed my head off seeing your big red eyes staring at me from the dark if I wasn’t so used to it.”"
    cy "“要不是已经习惯了，我迟早被你那双红彤彤的大眼睛给吓死。”"

# game/murdochroute3.rpy:1580
translate Schinese murdochroute3a_22f810bc:

    # cy "“What are you doing down here?”"
    cy "“你在这儿做什么？”"

# game/murdochroute3.rpy:1582
translate Schinese murdochroute3a_dc7e9fe2:

    # cy "“I thought you had guests to entertain.”"
    cy "“不是要去接待客人吗？”"

# game/murdochroute3.rpy:1584
translate Schinese murdochroute3a_2aad6c16:

    # m "“They, uh, ain’t exactly my guests.”"
    m "“他们，呃，也不算我的客人。”"

# game/murdochroute3.rpy:1586
translate Schinese murdochroute3a_cec8699a_1:

    # mu "“Sam?”"
    mu "“Sam？”"

# game/murdochroute3.rpy:1588
translate Schinese murdochroute3a_6753ea67:

    # "We both heard Murdoch before we saw him and Cynthia jumped."
    "Murdoch冷不丁的声音吓了Cynthia一跳。"

# game/murdochroute3.rpy:1591
translate Schinese murdochroute3a_2e6950d9:

    # cy "“If one more man hops at me out of the shadows I’m gonna scream for real and it’s not gonna be pretty.”"
    cy "“再有人从暗处蹦出来，我就真的要叫到你们头痛了。”"

# game/murdochroute3.rpy:1594
translate Schinese murdochroute3a_0b20fa5e:

    # mu "“Sorry.”"
    mu "“对不起。”"

# game/murdochroute3.rpy:1596
translate Schinese murdochroute3a_3cbf79d3:

    # m "“We both need an opportunity to slip away from them for a while.”"
    m "“我们俩想溜走一段时间。”"

# game/murdochroute3.rpy:1598
translate Schinese murdochroute3a_df5239bc:

    # "Her face shifts from an annoyed look to a cautious one."
    "她的表情从不悦转为好奇。"

# game/murdochroute3.rpy:1600
translate Schinese murdochroute3a_b265657f:

    # cy "“They violent?”"
    cy "“他们很暴力吗？”"

# game/murdochroute3.rpy:1601
translate Schinese murdochroute3a_8f5fbfb4:

    # "I mean, they could be."
    "谁知道呢。"

# game/murdochroute3.rpy:1602
translate Schinese murdochroute3a_6bdc200f:

    # "I technically don’t know."
    "反正我不知道。"

# game/murdochroute3.rpy:1604
translate Schinese murdochroute3a_c46aa0a1:

    # m "“Not to my knowledge.”"
    m "“就我所知没有。”"

# game/murdochroute3.rpy:1605
translate Schinese murdochroute3a_3184ca44:

    # m "“More on the uppity side of things.”"
    m "“就是挺臭屁。”"

# game/murdochroute3.rpy:1607
translate Schinese murdochroute3a_a0defce4:

    # cy "“Yeah, I could tell they’re out of towners.”"
    cy "“嗯，我也看得出他们不是本地的。”"

# game/murdochroute3.rpy:1609
translate Schinese murdochroute3a_a8e111dd:

    # cy "“I can handle a man if I know what I’m dealing with.”"
    cy "“但要想对付一个人，起码得知道他想要什么呀。”"

# game/murdochroute3.rpy:1611
translate Schinese murdochroute3a_941ffb40:

    # cy "“But I don’t like to mess with unpredictability.”"
    cy "“我讨厌不确定性。”"

# game/murdochroute3.rpy:1612
translate Schinese murdochroute3a_a5cc951c:

    # m "“I get the feeling that the less chances I have to make them mad, the happier they’ll be when one comes.”"
    m "“根据我的经验，别让他们有生气的理由，他们自然就开心了。”"

# game/murdochroute3.rpy:1614
translate Schinese murdochroute3a_b46b10be:

    # cy "“They look rich, so I’m in.”"
    cy "“他们看起来就很有钱，算我一个。”"

# game/murdochroute3.rpy:1616
translate Schinese murdochroute3a_a52cdc08:

    # cy "“What do you need me to do?”"
    cy "“你要我怎么做？”"

# game/murdochroute3.rpy:1617
translate Schinese murdochroute3a_73979e21:

    # m "“A big, long distraction that’ll tire folks out.”"
    m "“一个又臭又长的节目。”"

# game/murdochroute3.rpy:1618
translate Schinese murdochroute3a_88b12190:

    # m "“And leave them a bit dazed.”"
    m "“让他们目不暇接。”"

# game/murdochroute3.rpy:1621
translate Schinese murdochroute3a_69ffd5a9:

    # cy "“Easy.”"
    cy "“简单。”"

# game/murdochroute3.rpy:1624
translate Schinese murdochroute3a_637271af:

    # mu "“That’s such a relief.”"
    mu "“那我就放心了。”"

# game/murdochroute3.rpy:1628
translate Schinese murdochroute3a_9bc46b8e:

    # ra "“Murdoch?!”"
    ra "“Murdoch？！”"

# game/murdochroute3.rpy:1630
translate Schinese murdochroute3a_f3ca0cd7:

    # "This time Cynthia did scream, followed by a surge of words in that language I don’t understand."
    "Cynthia这次真的叫出来了，还狂喷了一连串我听不懂的话。"

# game/murdochroute3.rpy:1632
translate Schinese murdochroute3a_4ddfd6f2:

    # cy "“Customers aren’t allowed in here!!!”"
    cy "“顾客禁止入内！！！”"

# game/murdochroute3.rpy:1635
translate Schinese murdochroute3a_61498e7e:

    # ra "“Then what’s he doing here?”"
    ra "“那他怎么能进？”"

# game/murdochroute3.rpy:1636
translate Schinese murdochroute3a_212456af:

    # "He gestures at the fox."
    "他指着狐狸。"

# game/murdochroute3.rpy:1639
translate Schinese murdochroute3a_875bedf6:

    # mu "“We’re trying to get out of the party without Jim getting furious with us.”"
    mu "“我们想溜出派对，但不想扫了Jim的兴。”"

# game/murdochroute3.rpy:1642
translate Schinese murdochroute3a_2938ba8f:

    # ra "“You’re leaving me alone with them?”"
    ra "“你们要把我一个留下？”"

# game/murdochroute3.rpy:1643
translate Schinese murdochroute3a_597d8891:

    # m "“You can come with us.”"
    m "“你也可以一起来。”"

# game/murdochroute3.rpy:1646
translate Schinese murdochroute3a_96b57d6d:

    # ra "“No, you’re leaving me alone with them.”"
    ra "“不行，你们必须把我留下。”"

# game/murdochroute3.rpy:1648
translate Schinese murdochroute3a_4f12187f:

    # ra "“Somebody’s going to guide their hung-over shells to that wedding tomorrow and if it’s not going to be you then it’s going to be me.”"
    ra "“总得有人把这帮醉鬼拖到明天的婚礼现场，如果不是你，那就是我。”"

# game/murdochroute3.rpy:1650
translate Schinese murdochroute3a_75ab9f4e:

    # mu "“Why does it have to be either of us?”"
    mu "“为什么非得是我们两个？”"

# game/murdochroute3.rpy:1653
translate Schinese murdochroute3a_bd091bb9:

    # ra "“Because I heard what Holly wants you to do.”"
    ra "“因为我听到Holly要你做的事了。”"

# game/murdochroute3.rpy:1654
translate Schinese murdochroute3a_e8a8a374:

    # ra "“I heard from the bathroom back at the house.”"
    ra "“从你家的浴室里。”"

# game/murdochroute3.rpy:1658
translate Schinese murdochroute3a_bfd6dfd3:

    # cy "“I don’t know who Holly is, but you all need to leave soon.”"
    cy "“我不知道Holly是谁，但请你马上离开。”"

# game/murdochroute3.rpy:1660
translate Schinese murdochroute3a_4a5574f7:

    # cy "“If you want a loud and long distraction, I’ve never heard a better call for a hootenanny.”"
    cy "“你要又吵又长的娱乐节目，民歌就是最好的选择。”"

# game/murdochroute3.rpy:1661
translate Schinese murdochroute3a_8156f3b0:

    # cy "“Can any of you play guitar?”"
    cy "“你们有人会弹吉他吗？”"

# game/murdochroute3.rpy:1663
translate Schinese murdochroute3a_cb588754:

    # ra "“Not well.”"
    ra "“我不太行。”"

# game/murdochroute3.rpy:1665
translate Schinese murdochroute3a_c2b667d5:

    # mu "“Well enough.”"
    mu "“我还可以。”"

# game/murdochroute3.rpy:1668
translate Schinese murdochroute3a_ce0fc393:

    # cy "“Well, if he starts the song, the rat can finish.”"
    cy "“那就让他开头，中途交给老鼠。”"

# game/murdochroute3.rpy:1670
translate Schinese murdochroute3a_5b0d580a:

    # ra "“The name’s Ralph, sweetheart.”"
    ra "“我的名字是Ralph，甜心。”"

# game/murdochroute3.rpy:1672
translate Schinese murdochroute3a_63ca3a55:

    # "She crinkles her nose on him."
    "她对他皱起鼻头。"

# game/murdochroute3.rpy:1673
translate Schinese murdochroute3a_c2f9de85:

    # cy "“I don’t need to know who you are, they’re on a timer!”"
    cy "“我管你是谁，他们赶时间！”"

# game/murdochroute3.rpy:1675
translate Schinese murdochroute3a_59225f11:

    # cy "“Just borrow one of the instruments back stage.”"
    cy "“从后台随便拿个乐器。”"

# game/murdochroute3.rpy:1677
translate Schinese murdochroute3a_d51f48a0:

    # m "“Those belong to Dora.”"
    m "“可那些是Dora的。”"

# game/murdochroute3.rpy:1679
translate Schinese murdochroute3a_db59fec1:

    # cy "“She doesn’t lock ‘em up during performance hours.”"
    cy "“演出时间不上锁。”"

# game/murdochroute3.rpy:1681
translate Schinese murdochroute3a_e2e40269:

    # cy "“It’s fine if you put it back where it belongs.”"
    cy "“用完还回去就行了。”"

# game/murdochroute3.rpy:1685
translate Schinese murdochroute3a_b5614465:

    # "We all walk out and take our positions."
    "我们一同出去，各就各位。"

# game/murdochroute3.rpy:1687
translate Schinese murdochroute3a_c5614eb4:

    # "Cynthia walks up to one of the women on stage transitioning between performances."
    "Cynthia走向一群正准备登台的女人。"

# game/murdochroute3.rpy:1688
translate Schinese murdochroute3a_a3194d62:

    # "They nod emphatically, and guide Cynthia forward to the metal microphone on stage."
    "她们煞有介事地点头，把Cynthia带到台上的麦克风前。"

# game/murdochroute3.rpy:1691
translate Schinese murdochroute3a_f99f1759:

    # cy "“Y’all having a bang up time?”"
    cy "“大家玩得还开心吗？”"

# game/murdochroute3.rpy:1694
translate Schinese murdochroute3a_15a3380c:

    # "Hoots and hollers shout out into the stage."
    "台下传来一片高呼声。"

# game/murdochroute3.rpy:1696
translate Schinese murdochroute3a_152b2837:

    # cy "“Here at the hip we have a little tradition I know most of y’all are familiar with.”"
    cy "“相信不少人都知道，我们Hip有个小小的传统。”"

# game/murdochroute3.rpy:1697
translate Schinese murdochroute3a_6a88e272:

    # cy "“It’s high time we had ourselves a hootenanny.”"
    cy "“是时候来场民歌了。”"

# game/murdochroute3.rpy:1699
translate Schinese murdochroute3a_cd53aaf6:

    # "Her stage voice is ridiculous."
    "好扯的台词。"

# game/murdochroute3.rpy:1701
translate Schinese murdochroute3a_db17f286:

    # cy "“Best song wins a free drink!”"
    cy "“谁唱得最好，谁就能免费喝到饱！”"

# game/murdochroute3.rpy:1703
translate Schinese murdochroute3a_c5007467:

    # cy "“Now let’s see.”"
    cy "“让我瞧瞧。”"

# game/murdochroute3.rpy:1705
translate Schinese murdochroute3a_bb31b153:

    # cy "“You there, the red fox in the formal getup.”"
    cy "“那边那位穿着正装的赤狐。”"

# game/murdochroute3.rpy:1707
translate Schinese murdochroute3a_efc6c6b8:

    # cy "“Get your tail on up here!”"
    cy "“快上台来！”"

# game/murdochroute3.rpy:1709
translate Schinese murdochroute3a_3882e1e1:

    # "Murdoch looks real bashful."
    "Murdoch似乎颇为害羞。"

# game/murdochroute3.rpy:1711
translate Schinese murdochroute3a_86439ee6:

    # mu "“Well, ah, thank you for the opportunity miss.”"
    mu "“我，呃，谢谢你的指名，小姐。”"

# game/murdochroute3.rpy:1714
translate Schinese murdochroute3a_fccbd7a6:

    # cy "“The world’s yours, Mr.!”"
    cy "“舞台是你的了，先生！”"

# game/murdochroute3.rpy:1717
translate Schinese murdochroute3a_d373b53d:

    # mu "“Ah, Murdoch.”"
    mu "“啊，我叫Murdoch。”"

# game/murdochroute3.rpy:1721
translate Schinese murdochroute3a_2ecf1200:

    # mu "“You see folks, this song I’m about to sing is special...”"
    mu "“各位，我要唱的歌有一点特别...”"

# game/murdochroute3.rpy:1723
translate Schinese murdochroute3a_3f578713:

    # mu "“Me and my friend Ralph over there were asked by my mother to attend this party for our musical abilities.”"
    mu "“我跟在那边的朋友Ralph，奉我母亲的命令出席这场派对。”"

# game/murdochroute3.rpy:1724
translate Schinese murdochroute3a_b79c22ec:

    # "Ralph pretends not to be seen."
    "Ralph假装自己不在场。"

# game/murdochroute3.rpy:1726
translate Schinese murdochroute3a_e7a815ea:

    # mu "“So, rusty as I am, I’d like to do some good tonight with something I’m good enough at.”"
    mu "“虽然有些生疏，但我想以自己擅长的音乐来点缀这个夜晚。”"

# game/murdochroute3.rpy:1728
translate Schinese murdochroute3a_a2fbf5b0:

    # mu "“This one goes out to my future brother-in-law, who’s tying the knot tomorrow.”"
    mu "“就以这首歌献给我未来的姐夫，他明天就要结婚了。”"

# game/murdochroute3.rpy:1732
translate Schinese murdochroute3a_ef89479b:

    # "There’s an uproarious applause."
    "现场响起了热烈的掌声。"

# game/murdochroute3.rpy:1733
translate Schinese murdochroute3a_07900426:

    # "Jim looks incredibly confused."
    "Jim显得非常困惑。"

# game/murdochroute3.rpy:1734
translate Schinese murdochroute3a_acfbc8f5:

    # "I don’t much care for dancin’, but if this is the quickest way to leave, I’ve long been ready."
    "我对跳舞没什么兴趣，但如果这是离开这里的最快方法，那我已经迫不及待了。"

# game/murdochroute3.rpy:1744
translate Schinese murdochroute3a_ce8ef559:

    # "We’re laughing and panting as the wind whips around us."
    "我们气喘吁吁地行走在劲风之中，放声大笑。"

# game/murdochroute3.rpy:1748
translate Schinese murdochroute3a_fa1d2ebb:

    # mu "“Did you see Ralph’s face when he caught that guitar.”"
    mu "“你看到我把吉他丢给Ralph的时候，他脸上的那个表情了吗？”"

# game/murdochroute3.rpy:1750
translate Schinese murdochroute3a_4b4b114e:

    # m "“He’s going to wring you out next time he sees you.”"
    m "“他肯定杀死你的心都有了。”"

# game/murdochroute3.rpy:1752
translate Schinese murdochroute3a_e0053dc5:

    # mu "“And Jim’s expression when your friend cut him off...”"
    mu "“还有Jim被你朋友抓走时的脸...”"

# game/murdochroute3.rpy:1754
translate Schinese murdochroute3a_83e95d89:

    # mu "“My sides have never hurt this much from laughing”"
    mu "“笑得我腰都要断了。”"

# game/murdochroute3.rpy:1756
translate Schinese murdochroute3a_b6f533ff:

    # m "“Didn’t think you’d be laughing much at all tonight.”"
    m "“我还以为你今晚笑不出来了呢。”"

# game/murdochroute3.rpy:1757
translate Schinese murdochroute3a_8a7665b3:

    # mu "“Oh?”"
    mu "“哦？”"

# game/murdochroute3.rpy:1758
translate Schinese murdochroute3a_1e990710:

    # m "“It’s a welcome surprise.”"
    m "“值得欣喜。”"

# game/murdochroute3.rpy:1760
translate Schinese murdochroute3a_dd321097:

    # mu "“So what do you want to do?”"
    mu "“那你现在要做什么？”"

# game/murdochroute3.rpy:1762
translate Schinese murdochroute3a_0fb2200c:

    # mu "“Where do you want to go?”"
    mu "“想去什么地方？”"

# game/murdochroute3.rpy:1764
translate Schinese murdochroute3a_3ad130be:

    # m "“Why are you askin’ me?”"
    m "“为什么问我？”"

# game/murdochroute3.rpy:1766
translate Schinese murdochroute3a_a418dbc1:

    # mu "“Because I don’t get to ask what you’d like to do enough.”"
    mu "“因为我还没有问过你的喜好。”"

# game/murdochroute3.rpy:1768
translate Schinese murdochroute3a_0b37dc1d:

    # m "“By now I’m usually lifting weights until I’m sore.”"
    m "“一般这种时候，我会举重到肌肉酸痛为止。”"

# game/murdochroute3.rpy:1770
translate Schinese murdochroute3a_38d0984b:

    # mu "“Is that how you get your arms that big?”"
    mu "“所以你的手臂才这么粗壮？”"

# game/murdochroute3.rpy:1771
translate Schinese murdochroute3a_31bf498e:

    # m "“They could be bigger.”"
    m "“还能更粗。”"

# game/murdochroute3.rpy:1773
translate Schinese murdochroute3a_eb93350b:

    # mu "“They’re monsters compared to mine.”"
    mu "“和我的相比，简直跟怪物一样了。”"

# game/murdochroute3.rpy:1774
translate Schinese murdochroute3a_bdffda46:

    # m "“All your bulk is in your legs.”"
    m "“你的肌肉主要集中在腿上。”"

# game/murdochroute3.rpy:1776
translate Schinese murdochroute3a_d5eda403:

    # mu "“At least lifting boxes is good for something.”"
    mu "“看来搬箱子也不全是无用功。”"

# game/murdochroute3.rpy:1777
translate Schinese murdochroute3a_8fc9df9d:

    # m "“I guess it wouldn’t be that hard to show you how to build up your arms.”"
    m "“其实锻炼手臂也不是什么难事。”"

# game/murdochroute3.rpy:1778
translate Schinese murdochroute3a_50bf9519:

    # mu "“Who says I want to build up my arms?”"
    mu "“我可没说要练手啊？”"

# game/murdochroute3.rpy:1779
translate Schinese murdochroute3a_444f80f5:

    # m "“’Cause if you did you could pick up Jim and Ralph at the same time and tuck them behind the top shelf of the store.”"
    m "“练好之后，你就可以把Jim跟Ralph同时举起来，丢到店里最高的柜子上吃灰了。”"

# game/murdochroute3.rpy:1781
translate Schinese murdochroute3a_d29dafac:

    # mu "“So are we sneaking back into your room to lift weights then?”"
    mu "“所以现在是要偷偷溜回你的房间练举重？”"

# game/murdochroute3.rpy:1783
translate Schinese murdochroute3a_a094b88f:

    # "I rub my chin."
    "我揉了揉下巴。"

# game/murdochroute3.rpy:1784
translate Schinese murdochroute3a_19c7b8ab:

    # m "“Nah.”"
    m "“还是算了。”"

# game/murdochroute3.rpy:1785
translate Schinese murdochroute3a_98c50e16:

    # m "“It’s a bad idea to get you sore before Holly’s weddin’.”"
    m "“明天有Holly的婚礼呢。”"

# game/murdochroute3.rpy:1787
translate Schinese murdochroute3a_abb4d4b2:

    # m "“There’s no tellin’ what stunts they’re gonna ask you to pull off tomorrow.”"
    m "“谁知道他们又要叫你干什么。”"

# game/murdochroute3.rpy:1789
translate Schinese murdochroute3a_31299a97:

    # mu "“So where to?”"
    mu "“那咱们去哪？”"

# game/murdochroute3.rpy:1791
translate Schinese murdochroute3a_4f571122:

    # "I lean against the railing of a nearby bank and cross my arms, thinking."
    "我双臂抱胸，就近靠在一家银行的栏杆上思考。"

# game/murdochroute3.rpy:1792
translate Schinese murdochroute3a_242ab420:

    # "There’s so much I had to do for Murdoch’s folks that the last days have all been a blur."
    "过去几天我为Murdoch家忙里忙外，几乎没闲过。"

# game/murdochroute3.rpy:1793
translate Schinese murdochroute3a_592aac63:

    # "I’d like to relax, sure, but I can’t help but feel like there’s something I’m supposed to do."
    "我当然是想放松一下，但总觉得忘了什么要紧的事。"

# game/murdochroute3.rpy:1794
translate Schinese murdochroute3a_212c630d:

    # "I suppose there’s always something I’m supposed to do, ain’t there?"
    "不过人嘛，总有事情要做，对吧？"

# game/murdochroute3.rpy:1795
translate Schinese murdochroute3a_c81d212c:

    # "I look up at the fancy sign above me and chuckle a little bitterly."
    "我略带苦涩地看向上方华丽的招牌。"

# game/murdochroute3.rpy:1796
translate Schinese murdochroute3a_38be0ab6:

    # "Would be nice if I had enough money to just take it out and treat Murdoch to a meal."
    "要是我有钱请Murdoch吃饭就好了。"

# game/murdochroute3.rpy:1797
translate Schinese murdochroute3a_473b2620:

    # "I did before I..."
    "之前确实有..."

# game/murdochroute3.rpy:1799
translate Schinese murdochroute3a_2ebc67ad:

    # "Wait a minute."
    "等一下。"

# game/murdochroute3.rpy:1801
translate Schinese murdochroute3a_e0880925:

    # m "“Oh hell, I was supposed to meet somebody the other night!”"
    m "“操，我昨天晚上应该去见一个人的！”"

# game/murdochroute3.rpy:1803
translate Schinese murdochroute3a_b5a7e98b:

    # mu "“Wait, what’s wrong?”"
    mu "“咦，什么情况？”"

# game/murdochroute3.rpy:1804
translate Schinese murdochroute3a_67dc8be8:

    # mu "“You sound upset all of a sudden.”"
    mu "“你怎么突然懊恼起来了？”"

# game/murdochroute3.rpy:1806
translate Schinese murdochroute3a_7b067c60:

    # m "“I’m upset because I’m a goddamn idiot.”"
    m "“我是很懊恼，因为我就是个大白痴。”"

# game/murdochroute3.rpy:1808
translate Schinese murdochroute3a_01d62849:

    # mu "“Well I don’t think so.”"
    mu "“我倒不这么认为。”"

# game/murdochroute3.rpy:1810
translate Schinese murdochroute3a_85bfa723:

    # m "“Listen, uh...”"
    m "“那个，呃...”"

# game/murdochroute3.rpy:1811
translate Schinese murdochroute3a_4823711a:

    # m "“You mind if we go cross the tracks?”"
    m "“介意走点远路吗？”"

# game/murdochroute3.rpy:1813
translate Schinese murdochroute3a_e87a689d:

    # mu "“Not at all.”"
    mu "“不介意。”"

# game/murdochroute3.rpy:1814
translate Schinese murdochroute3a_02784371_1:

    # m "“Good.”"
    m "“好。”"

# game/murdochroute3.rpy:1816
translate Schinese murdochroute3a_898130f3:

    # mu "“Any reason?”"
    mu "“原因是？”"

# game/murdochroute3.rpy:1817
translate Schinese murdochroute3a_a93bc4a0:

    # m "“There’s a mausoleum out there.”"
    m "“镇外有座公墓。”"

# game/murdochroute3.rpy:1818
translate Schinese murdochroute3a_92c3bc1b:

    # mu "“Ok.”"
    mu "“嗯。”"

# game/murdochroute3.rpy:1819
translate Schinese murdochroute3a_f84751c7:

    # m "“And because I need to check up on somebody.”"
    m "“我跟人约好了在那儿碰头。”"

# game/murdochroute3.rpy:1821
translate Schinese murdochroute3a_7dd2a48f:

    # mu "“At a mausoleum?”"
    mu "“在公墓里？”"

# game/murdochroute3.rpy:1823
translate Schinese murdochroute3a_c806ebc0_1:

    # m "“Yeah.”"
    m "“对。”"

# game/murdochroute3.rpy:1824
translate Schinese murdochroute3a_f6a7c1d8:

    # mu "“Oh.”"
    mu "“诶。”"

# game/murdochroute3.rpy:1825
translate Schinese murdochroute3a_27de7166:

    # m "“It’s that student in the rose dress and straw hat.”"
    m "“就是那个穿粉裙、戴草帽的学生。”"

# game/murdochroute3.rpy:1826
translate Schinese murdochroute3a_a60e4ea9:

    # mu "“Blithe Washington?”"
    mu "“Blithe Washington？”"

# game/murdochroute3.rpy:1827
translate Schinese murdochroute3a_acd76341:

    # m "“Yeah, that’s the one.”"
    m "“就是她。”"

# game/murdochroute3.rpy:1829
translate Schinese murdochroute3a_2a2cefbf:

    # m "“She nabbed some of my money and won’t give it back to me unless I do her a favor.”"
    m "“她拿了我的钱，要我帮她忙才肯还我。”"

# game/murdochroute3.rpy:1831
translate Schinese murdochroute3a_99be0e0d:

    # mu "“She stole from you?”"
    mu "“她偷了你的钱？”"

# game/murdochroute3.rpy:1832
translate Schinese murdochroute3a_35cea8af:

    # m "“Nah, she doesn’t know it was mine.”"
    m "“不是，她不知道钱是我的。”"

# game/murdochroute3.rpy:1834
translate Schinese murdochroute3a_82178eb8:

    # mu "“What?!”"
    mu "“什么？！”"

# game/murdochroute3.rpy:1836
translate Schinese murdochroute3a_c26706d7:

    # m "“It’s a long story.”"
    m "“说来话长。”"

# game/murdochroute3.rpy:1838
translate Schinese murdochroute3a_cb9764c3:

    # mu "“No kidding?”"
    mu "“你没开玩笑吧？”"

# game/murdochroute3.rpy:1840
translate Schinese murdochroute3a_a4aede70:

    # m "“Hopefully it won’t take too long at all.”"
    m "“希望来得及。”"

# game/murdochroute3.rpy:1842
translate Schinese murdochroute3a_c10f396d:

    # "We keep talking along the way."
    "我们边走边聊。"

# game/murdochroute3.rpy:1843
translate Schinese murdochroute3a_b508822a:

    # "It’s a lot easier now that he sees through me and I see through him."
    "在互诉衷肠后，气氛也轻松了不少。"

# game/murdochroute3.rpy:1844
translate Schinese murdochroute3a_6dc68d1d:

    # "We’re ain’t men who like to let ourselves be seen."
    "毕竟我和他都不是坦率的人。"

# game/murdochroute3.rpy:1846
translate Schinese murdochroute3a_abc232e4:

    # "The distant whistle of the train lets me know that we aren’t too far from our destination."
    "远方传来了火车的汽笛声，我知道我们离目的地不远了。"

# game/murdochroute3.rpy:1848
translate Schinese murdochroute3a_5087098b:

    # "When we get to the graveyard I take a peak around me."
    "抵达公墓后，我环顾四周。"

# game/murdochroute3.rpy:1850
translate Schinese murdochroute3a_492bfe84:

    # "The door to the mausoleum is slightly ajar."
    "通往陵墓的门开了一小道。"

# game/murdochroute3.rpy:1852
translate Schinese murdochroute3a_1fcb29a8:

    # "But when I go up to open it wider we don’t see nobody."
    "但进去后没看见任何人。"

# game/murdochroute3.rpy:1854
translate Schinese murdochroute3a_b725cff0:

    # m "“Damn it.”"
    m "“可恶。”"

# game/murdochroute3.rpy:1856
translate Schinese murdochroute3a_9edcfe64:

    # mu "“You might have better luck at her house.”"
    mu "“不如去她家碰碰运气。”"

# game/murdochroute3.rpy:1857
translate Schinese murdochroute3a_ac94747a:

    # m "“Huh?”"
    m "“哈？”"

# game/murdochroute3.rpy:1859
translate Schinese murdochroute3a_56868065:

    # mu "“We passed it on the way here.”"
    mu "“就在来这里的路上。”"

# game/murdochroute3.rpy:1860
translate Schinese murdochroute3a_acd7d699:

    # mu "“But then again, I didn’t see any lights on in the house.”"
    mu "“虽然屋里没有亮灯就是了。”"

# game/murdochroute3.rpy:1862
translate Schinese murdochroute3a_9970bac4:

    # mu "“They’re probably asleep by now.”"
    mu "“大概都睡了吧。”"

# game/murdochroute3.rpy:1864
translate Schinese murdochroute3a_8dbb04ac:

    # m "“If somebody told me that little witch didn’t sleep I’d believe ‘em.”"
    m "“就算有人说那小巫婆从不睡觉我都信。”"

# game/murdochroute3.rpy:1867
translate Schinese murdochroute3a_0effdc2e:

    # "His ears perk up."
    "他竖起耳朵。"

# game/murdochroute3.rpy:1869
translate Schinese murdochroute3a_186528da:

    # mu "“Quiet, I think I hear somebody coming.”"
    mu "“嘘，好像有人来了。”"

# game/murdochroute3.rpy:1871
translate Schinese murdochroute3a_bd45cf99:

    # m "“Maybe I’m not so out of luck after all.”"
    m "“看来我运气也没那么糟嘛。”"

# game/murdochroute3.rpy:1873
translate Schinese murdochroute3a_592b2ea6:

    # cl "“Careful my dear, those causeways are one slippery step away from a twisted ankle.”"
    cl "“请小心，这些堤道很滑，稍不留神就会扭到脚踝。”"

# game/murdochroute3.rpy:1874
translate Schinese murdochroute3a_2d6ee573:

    # m "“Oh.”"
    m "“咦。”"

# game/murdochroute3.rpy:1880
translate Schinese murdochroute3a_6d3bc08d:

    # dh "“Don’t worry, I came prepared.”"
    dh "“放心，我早有准备。”"

# game/murdochroute3.rpy:1884
translate Schinese murdochroute3a_014298bf:

    # dh "“They never maintain the pottersfields.”"
    dh "“他们从不修缮墓地。”"

# game/murdochroute3.rpy:1887
translate Schinese murdochroute3a_fc8c1949:

    # cl "“Too common a practice if you ask me.”"
    cl "“再正常不过了。”"

# game/murdochroute3.rpy:1890
translate Schinese murdochroute3a_edce718b:

    # dh "“The only unmarked family name we know of is the Begay man, who was accused of terrible crimes.”"
    dh "“无名冢中我们唯一知道姓氏的，是Begay家的一个男人，他被指控犯下了可怕的犯罪。”"

# game/murdochroute3.rpy:1892
translate Schinese murdochroute3a_a4f1f995:

    # dh "“People say he’s one of the unmarked graves here, but there are rumors that James Hendricks the first moved the body.”"
    dh "“据说他就被埋在这里，但也有传闻称James Hendricks一世转移了他的尸体。”"

# game/murdochroute3.rpy:1895
translate Schinese murdochroute3a_55d66644:

    # cl "“Ghastly stuff.”"
    cl "“太可怕了。”"

# game/murdochroute3.rpy:1897
translate Schinese murdochroute3a_7c62d0bf:

    # cl "“Is there some grain of truth to that?”"
    cl "“这些话有多少可信度？”"

# game/murdochroute3.rpy:1899
translate Schinese murdochroute3a_94b6e3bb:

    # dh "“Well nobody knows for sure.”"
    dh "“没有人清楚。”"

# game/murdochroute3.rpy:1902
translate Schinese murdochroute3a_172ee9a3:

    # dh "“All that’s certain is that those who say they’re certain certainly do not know.”"
    dh "“唯一可以肯定的是，那些自称知道的人肯定不知道。”"

# game/murdochroute3.rpy:1905
translate Schinese murdochroute3a_a5f3b780:

    # "Cliff waggles a finger at her."
    "Cliff伸出一根手指摇了摇。"

# game/murdochroute3.rpy:1907
translate Schinese murdochroute3a_bf53ce4b:

    # cl "“I bet you can’t say that five times fast.”"
    cl "“我赌你没办法把这句话快速读五遍。”"

# game/murdochroute3.rpy:1910
translate Schinese murdochroute3a_d8450bd4:

    # dh "“How much will you wager?”"
    dh "“要赌多少？”"

# game/murdochroute3.rpy:1913
translate Schinese murdochroute3a_e3dde196:

    # cl "“Hold on for a moment.”"
    cl "“先等一下。”"

# game/murdochroute3.rpy:1915
translate Schinese murdochroute3a_1e077724:

    # "He crouches in front of a wooden stake."
    "他蹲在一根木桩前。"

# game/murdochroute3.rpy:1917
translate Schinese murdochroute3a_7c486474:

    # cl "“Well what do we have here!”"
    cl "“快看呐！”"

# game/murdochroute3.rpy:1919
translate Schinese murdochroute3a_11e3f600:

    # cl "“These ones look like they might have belonged to the Peshlekai family.”"
    cl "“这好像是属于Peshlekai家的。”"

# game/murdochroute3.rpy:1920
translate Schinese murdochroute3a_8d19103c:

    # cl "“Or, at least somebody who thinks so.”"
    cl "“或者说，至少有人这么认为。”"

# game/murdochroute3.rpy:1922
translate Schinese murdochroute3a_8b419122:

    # dh "“That sounds like a stretch.”"
    dh "“这有些牵强吧。”"

# game/murdochroute3.rpy:1925
translate Schinese murdochroute3a_ac2a1184:

    # cl "“No, no, not a stretch at all!”"
    cl "“不不，一点都不牵强！”"

# game/murdochroute3.rpy:1928
translate Schinese murdochroute3a_8f4295fb:

    # cl "“Take a closer look at the cloth on this post.”"
    cl "“仔细看柱子上的布。”"

# game/murdochroute3.rpy:1931
translate Schinese murdochroute3a_af11b755:

    # cl "“There’s 7 blue strips spaced widely here next to 3 tightly packed red, then there’s another 7 blue beneath them, and a solitary orange.”"
    cl "“7条分得很开的蓝纹，旁边是3条紧密的红纹，下方还有7条蓝纹加1条独立出来的橘纹。”"

# game/murdochroute3.rpy:1934
translate Schinese murdochroute3a_96b160d1:

    # cl "“According to the locals, those people haven’t live in town since the 1870’s.”"
    cl "“据当地人所述，他们一家早在1870年就不住在回音镇了。”"

# game/murdochroute3.rpy:1936
translate Schinese murdochroute3a_177e9735:

    # cl "“Oh?”"
    cl "“哦？”"

# game/murdochroute3.rpy:1937
translate Schinese murdochroute3a_981b5a18:

    # cl "“But this doesn’t look that old at all.”"
    cl "“但这看起来根本没那么老嘛。”"

# game/murdochroute3.rpy:1939
translate Schinese murdochroute3a_7049159a:

    # "He rises."
    "他站起身。"

# game/murdochroute3.rpy:1941
translate Schinese murdochroute3a_39332bf4:

    # cl "“I’ll never know the specificities unless I desecrate the graves, but I could never be so ghoulish.”"
    cl "“看来真相只能埋没于此了，因为我无论如何都做不出亵渎死者这种野蛮的行径。”"

# game/murdochroute3.rpy:1943
translate Schinese murdochroute3a_3bdb4c78:

    # cl "“I think I’ve learned about as much as I can from here.”"
    cl "“这里应该没有我能学的东西了。”"

# game/murdochroute3.rpy:1946
translate Schinese murdochroute3a_9adce94a:

    # cl "“Thank you for your time and your ear, but I must off to the train.”"
    cl "“非常感谢你的时间和知识，但我必须去搭火车了。”"

# game/murdochroute3.rpy:1949
translate Schinese murdochroute3a_95cb2d67:

    # dh "“You’ve been nothing short of marvelous company, Mr. Tibbits.”"
    dh "“我也很享受您的陪伴，Tibbits先生。”"

# game/murdochroute3.rpy:1952
translate Schinese murdochroute3a_f9b640a6:

    # dh "“Are you leaving us for good?”"
    dh "“这是永别了吗？”"

# game/murdochroute3.rpy:1955
translate Schinese murdochroute3a_1c6b2aaf:

    # cl "“Heavens, no! Not for good.”"
    cl "“哎呀，当然不是！会回来的。”"

# game/murdochroute3.rpy:1957
translate Schinese murdochroute3a_d2fb0889:

    # cl "“But I was too ambitious to come along on my own.”"
    cl "“这次是我太自傲了。”"

# game/murdochroute3.rpy:1959
translate Schinese murdochroute3a_60a1702b:

    # cl "“I’ll supply my own men for the task I need doing when I next return.”"
    cl "“为了任务着想，下次来之前我会亲自打点好物资跟随行人员。”"

# game/murdochroute3.rpy:1962
translate Schinese murdochroute3a_779c1bf7:

    # "He dips to give he a quick kiss on the wrist, straightens his backpack, and trots off toward the direction of the train station."
    "他弯腰轻轻吻了她的手腕，然后整理好背包，朝着火车站的方向小跑而去。"

# game/murdochroute3.rpy:1969
translate Schinese murdochroute3a_4098b947:

    # m "“If he’s coming back then I really have to get out of town.”"
    m "“他还会回来，那我走的理由就又多了一个。”"

# game/murdochroute3.rpy:1971
translate Schinese murdochroute3a_480d1903:

    # mu "“I hope he never does honestly.”"
    mu "“我倒是真心希望他别再来了。”"

# game/murdochroute3.rpy:1972
translate Schinese murdochroute3a_996e06f0:

    # mu "“He’s nice.”"
    mu "“他是个好人。”"

# game/murdochroute3.rpy:1974
translate Schinese murdochroute3a_37e50c43:

    # "Dahlia turns towards the mausoleum."
    "Dahlia转向陵墓。"

# game/murdochroute3.rpy:1976
translate Schinese murdochroute3a_50f61f2e:

    # "Shit, she heard us."
    "操，被她听见了。"

# game/murdochroute3.rpy:1980
translate Schinese murdochroute3a_cd64c309:

    # dh "“Murdoch?”"
    dh "“Murdoch？”"

# game/murdochroute3.rpy:1982
translate Schinese murdochroute3a_bd2f99b2:

    # mu "“Evening, sister.”"
    m "“晚上好。”"

# game/murdochroute3.rpy:2107
translate Schinese murdochroute3a_489f049c:

    # dh "“And Mr. Ayers?”"
    dh "“Ayers先生也在？”"

# game/murdochroute3.rpy:1987
translate Schinese murdochroute3a_eaedf293:

    # m "“The very same.”"
    m "“是我。”"

# game/murdochroute3.rpy:1988
translate Schinese murdochroute3a_1cfa8c1b:

    # "She looks back and forth between the two of us."
    "她在我们两人之间来回张望。"

# game/murdochroute3.rpy:1990
translate Schinese murdochroute3a_3f5ea2b4:

    # dh "“Strange place to be on a night like this.”"
    dh "“在这时间、这地点看到你们可真稀奇。”"

# game/murdochroute3.rpy:1993
translate Schinese murdochroute3a_707a988d_1:

    # mu "“Well...”"
    mu "“呃...”"

# game/murdochroute3.rpy:1996
translate Schinese murdochroute3a_a8e0685d:

    # dh "“Though I should clarify that wherever you choose to be can always be our little secret.”"
    dh "“不过我需要澄清一点，无论你在哪，我都会替你保密的。”"

# game/murdochroute3.rpy:1998
translate Schinese murdochroute3a_74dab0a2:

    # dh "“I needed some air as well.”"
    dh "“我同样需要呼吸下新鲜空气。”"

# game/murdochroute3.rpy:2001
translate Schinese murdochroute3a_6dc36a05:

    # mu "“I suppose the preparations of Holly’s special day is taking its toll on all of us.”"
    mu "“看来准备Holly的人生大事把我们每个人都压得喘不过气了。”"

# game/murdochroute3.rpy:2003
translate Schinese murdochroute3a_f037f7f7:

    # dh "“Quite so.”"
    dh "“确实。”"

# game/murdochroute3.rpy:2005
translate Schinese murdochroute3a_1830b449:

    # dh "“Was the bachelor party tolerable?”"
    dh "“单身派对没太糟吧？”"

# game/murdochroute3.rpy:2008
translate Schinese murdochroute3a_969af568:

    # mu "“Technically it hasn’t finished.”"
    mu "“严格来说还没结束呢。”"

# game/murdochroute3.rpy:2010
translate Schinese murdochroute3a_49853291:

    # dh "“Has she been making demands of you?”"
    dh "“她又要求你做更多事了？”"

# game/murdochroute3.rpy:2013
translate Schinese murdochroute3a_b8b15dc0:

    # mu "“No more than usual.”"
    mu "“没比平常多。”"

# game/murdochroute3.rpy:2014
translate Schinese murdochroute3a_54077bce:

    # "That sounds like an honest way to dodge the question Murdoch."
    "你这回避问题的说法倒挺诚实的，Murdoch。"

# game/murdochroute3.rpy:2016
translate Schinese murdochroute3a_cb8e6d3b:

    # mu "“What about you?”"
    mu "“你那边呢？”"

# game/murdochroute3.rpy:2018
translate Schinese murdochroute3a_bdeb4125:

    # dh "“There have been strange ones for me.”"
    dh "“我这边有些蹊跷。”"

# game/murdochroute3.rpy:2021
translate Schinese murdochroute3a_dc2c2d3e:

    # mu "“Strange how?”"
    mu "“怎么个蹊跷法？”"

# game/murdochroute3.rpy:2024
translate Schinese murdochroute3a_ddee8f62:

    # dh "“Well first she became cross with me when I gave her a spot of tea from mother’s collection.”"
    dh "“起初是她对我发火，因为我给了她泡了一杯母亲珍藏的茶。”"

# game/murdochroute3.rpy:2026
translate Schinese murdochroute3a_80be923e:

    # dh "“And then she gave me a thick letter to keep, telling me not to open it unless Jim got cold feet.”"
    dh "“然后她给了我一个厚厚的信封，说除非Jim临阵脱逃，否则千万别打开。”"

# game/murdochroute3.rpy:2029
translate Schinese murdochroute3a_93e3e174:

    # mu "“That’s peculiar.”"
    mu "“确实蹊跷。”"

# game/murdochroute3.rpy:2030
translate Schinese murdochroute3a_f43f75d3:

    # mu "“Were the contents grim?”"
    mu "“内容很糟吗？”"

# game/murdochroute3.rpy:2033
translate Schinese murdochroute3a_df3d3eed:

    # dh "“Lord knows now.”"
    dh "“天知道。”"

# game/murdochroute3.rpy:2035
translate Schinese murdochroute3a_730ce743:

    # dh "“I fed it to the fire.”"
    dh "“我早就扔火炉里去了。”"

# game/murdochroute3.rpy:2037
translate Schinese murdochroute3a_f24bf98c:

    # dh "“If she decides again to burden me with knowledge that is entirely not my business then she can use her voice, not ink.”"
    dh "“她要是再想用跟我毫无关联的事情麻烦我，就得自己亲口跟我说，而不是用笔和墨水。”"

# game/murdochroute3.rpy:2040
translate Schinese murdochroute3a_b630b38a:

    # mu "“I see.”"
    mu "“这样啊。”"

# game/murdochroute3.rpy:2043
translate Schinese murdochroute3a_9f93ce3a:

    # dh "“No matter.”"
    dh "“不过都无所谓了。”"

# game/murdochroute3.rpy:2045
translate Schinese murdochroute3a_171d15e2:

    # dh "“I wish you well on your nightly endeavors, with whoever or wherever you wish to pursue them.”"
    dh "“无论你们今晚要跟谁在哪里做什么，祝你们今晚好运。”"

# game/murdochroute3.rpy:2049
translate Schinese murdochroute3a_dbc87dcd:

    # "She gives me a curt nod and then turns away."
    "她对我轻轻地点了点头，而后转身离去。"

# game/murdochroute3.rpy:2050
translate Schinese murdochroute3a_db2c72cd:

    # "Then she comes upon a gravestone and stops walking."
    "却在一个墓碑旁停了下来。"

# game/murdochroute3.rpy:2052
translate Schinese murdochroute3a_e06d6e49:

    # "She looks like she’s deciding to say something or not."
    "似乎在犹豫开不开口。"

# game/murdochroute3.rpy:2056
translate Schinese murdochroute3a_6a43f1c0:

    # "And then she turns around, looks at us, and does."
    "接着她转头看向我们，说："

# game/murdochroute3.rpy:2058
translate Schinese murdochroute3a_03598c8a:

    # dh "“Important grave over here.”"
    dh "“这块墓碑很重要。”"

# game/murdochroute3.rpy:2060
translate Schinese murdochroute3a_bbdda40e:

    # dh "“You should pay your respects.”"
    dh "“你们应该表示一下敬意。”"

# game/murdochroute3.rpy:2063
translate Schinese murdochroute3a_648091c6:

    # "And then she turns away."
    "说罢头也不回地离开了。"

# game/murdochroute3.rpy:2064
translate Schinese murdochroute3a_63c0cf75:

    # "Weird little woman."
    "奇怪的小姑娘。"

# game/murdochroute3.rpy:2065
translate Schinese murdochroute3a_6f19d038_1:

    # m "“Alright.”"
    m "“好。”"

# game/murdochroute3.rpy:2070
translate Schinese murdochroute3a_837fab84:

    # "I turn to Murdoch but he looks a bit stiff."
    "我转头去看Murdoch，但他像是僵在了原地似的。"

# game/murdochroute3.rpy:2076
translate Schinese murdochroute3a_73f75861:

    # "He’s walking up to the grave, and he looks scared, almost as if he’s making sure there’s nothing below the ground pushing up soil."
    "他朝那块墓碑走去，表情惊恐，仿佛有东西要从底下爬上来。"

# game/murdochroute3.rpy:2078
translate Schinese murdochroute3a_34e02326:

    # m "“You alright Murdoch?”"
    m "“你还好吗，Murdoch？”"

# game/murdochroute3.rpy:2080
translate Schinese murdochroute3a_9b77b1f9_2:

    # mu "“Yeah.”"
    mu "“嗯。”"

# game/murdochroute3.rpy:2081
translate Schinese murdochroute3a_33403245:

    # "I walked up to read the grave he was looking at."
    "我凑近看向那块墓碑。"

# game/murdochroute3.rpy:2082
translate Schinese murdochroute3a_f20edbdb:

    # "It was one of those plain grave stones with only the surname on it."
    "是很普通的石碑，上面只有姓氏。"

# game/murdochroute3.rpy:2083
translate Schinese murdochroute3a_1ddd3f32:

    # "Scholl."
    "Scholl。"

# game/murdochroute3.rpy:2084
translate Schinese murdochroute3a_67dee626:

    # m "“Family friend?”"
    m "“你们家的朋友吗？”"

# game/murdochroute3.rpy:2086
translate Schinese murdochroute3a_c25ea9c6:

    # mu "“Can’t say for sure.”"
    mu "“我不确定。”"

# game/murdochroute3.rpy:2088
translate Schinese murdochroute3a_030b6cd0:

    # m "“Never got too caught up emotionally with the graves of strangers myself.”"
    m "“我对陌生人的坟墓不感兴趣。”"

# game/murdochroute3.rpy:2090
translate Schinese murdochroute3a_30989c7f:

    # "I think I hear a owl hooting in the distance and I take a look around to see if I can find it."
    "我想我听到远处有一只猫头鹰在啼叫，于是四下张望寻找。"

# game/murdochroute3.rpy:2092
translate Schinese murdochroute3a_d3904e83:

    # m "“Alright then.”"
    m "“好啦。”"

# game/murdochroute3.rpy:2093
translate Schinese murdochroute3a_25d81df4:

    # m "“That’s enough playin’ with bones I think.”"
    m "“骨头就看到这里。”"

# game/murdochroute3.rpy:2094
translate Schinese murdochroute3a_0b92d7a1:

    # m "“That girl’s not here so we might as well return to the land of the living.”"
    m "“反正那女孩也不在，还是回去有活人的地方吧。”"

# game/murdochroute3.rpy:2096
translate Schinese murdochroute3a_ccd7a470:

    # "Murdoch exhales and nods a few times."
    "Murdoch叹着气，点了几下头。"

# game/murdochroute3.rpy:2098
translate Schinese murdochroute3a_618f2fd6:

    # mu "“Yeah, sounds nice.”"
    mu "“嗯，好。”"

# game/murdochroute3.rpy:2102
translate Schinese murdochroute3a_6d72c7cf:

    # "It doesn’t take long to walk back into town."
    "回到镇上没花多久。"

# game/murdochroute3.rpy:2103
translate Schinese murdochroute3a_6072525e:

    # "It’s the time of night where lights are still on in folk’s houses but the streets are empty enough to enjoy for a private stroll."
    "这时间的街道依旧灯火通明，不过没什么人，正适合低调散步。"

# game/murdochroute3.rpy:2105
translate Schinese murdochroute3a_0b53d2dd:

    # m "“Well we went where I wanted to go.”"
    m "“我想去的地方已经去了。”"

# game/murdochroute3.rpy:2121
translate Schinese murdochroute3a_163717d0:

    # m "“Your turn.”"
    m "“换你了。”"

# game/murdochroute3.rpy:2108
translate Schinese murdochroute3a_c46d2550:

    # "Murdoch puts his hands in his pockets."
    "Murdoch两手插兜。"

# game/murdochroute3.rpy:2109
translate Schinese murdochroute3a_0d35cc66:

    # mu "“It’s a lot of pressure to think up something that tops that kiss you gave me.”"
    mu "“要想出比你那个吻还好的很难欸。”"

# game/murdochroute3.rpy:2110
translate Schinese murdochroute3a_97e6df93:

    # m "“If you want then we can go somewhere else and do it again.”"
    m "“你喜欢的话也可以去其他地方再亲一次。”"

# game/murdochroute3.rpy:2112
translate Schinese murdochroute3a_513a3f23:

    # "He smiles at me."
    "他对我一笑。"

# game/murdochroute3.rpy:2113
translate Schinese murdochroute3a_30a7ca80:

    # mu "“It was just the important one that I wanted.”"
    mu "“只有那个吻是独一无二、也是我想要的。”"

# game/murdochroute3.rpy:2114
translate Schinese murdochroute3a_85ef9feb:

    # "I check my watch."
    "我看了眼手表。"

# game/murdochroute3.rpy:2115
translate Schinese murdochroute3a_45b3292c:

    # m "“You better think quick then.”"
    m "“那就赶快想吧。”"

# game/murdochroute3.rpy:2117
translate Schinese murdochroute3a_6b492ea9:

    # m "“I’m needed back at the Hip sooner than you might think.”"
    m "“我回Hip的时间应该比你预计的要早。”"

# game/murdochroute3.rpy:2119
translate Schinese murdochroute3a_adc3e2cf:

    # "He nods."
    "他点点头。"

# game/murdochroute3.rpy:2141
translate Schinese murdochroute3a_0a14e9e4:

    # mu "“I think I’m going back with you.”"
    mu "“那我跟你一起回去。”"

# game/murdochroute3.rpy:2122
translate Schinese murdochroute3a_18f2fa6f:

    # "I stop walking."
    "我停下脚步。"

# game/murdochroute3.rpy:2123
translate Schinese murdochroute3a_e19ea092:

    # "Then I whistle."
    "吹了声口哨。"

# game/murdochroute3.rpy:2124
translate Schinese murdochroute3a_526d1c76:

    # m "“You sure about that?”"
    m "“你确定？”"

# game/murdochroute3.rpy:2126
translate Schinese murdochroute3a_ccfd9a34:

    # mu "“I wasn’t earlier.”"
    mu "“之前还不确定。”"

# game/murdochroute3.rpy:2128
translate Schinese murdochroute3a_8c390122:

    # "He puts his paw flat against my chest and pushes me against a beam, pressing his waist to mine, dipping his muzzle into the air against my ear."
    "他一手按住我的胸，把我推到一根柱子上，以腰贴着我的腰，仰起头，把嘴凑在我的耳旁。"

# game/murdochroute3.rpy:2130
translate Schinese murdochroute3a_3886c177:

    # mu "“But now I am.”"
    mu "“但现在确定了。”"

# game/murdochroute3.rpy:2132
translate Schinese murdochroute3a_81003399:

    # "He pulls away with his momentum as quickly as came."
    "然后同样迅速地抽身回去。"

# game/murdochroute3.rpy:2134
translate Schinese murdochroute3a_dc1d0417:

    # mu "“I want to go through what you do.”"
    mu "“我想体验你的生活。”"

# game/murdochroute3.rpy:2135
translate Schinese murdochroute3a_00297180:

    # mu "“I think I’m ready for the men, now.”"
    mu "“现在，我想我能应付那几个家伙了。”"

# game/murdochroute3.rpy:2137
translate Schinese murdochroute3a_dfebe6cf:

    # "I loom over him just a bit, lowering my posture to look him in the eyes."
    "我走近他，垂头注视着他的双眼。"

# game/murdochroute3.rpy:2138
translate Schinese murdochroute3a_475ae9a5:

    # m "“Are you sure you want to do this.”"
    m "“你真的要做吗？”"

# game/murdochroute3.rpy:2139
translate Schinese murdochroute3a_381a45d8:

    # "He doesn’t break eye contact, and nods."
    "他没有移开视线，只是点了点头。"

# game/murdochroute3.rpy:2159
translate Schinese murdochroute3a_0b20d1da:

    # "I sigh and nod."
    "我叹了口气，也点点头。"

# game/murdochroute3.rpy:2141
translate Schinese murdochroute3a_bfad69ae:

    # m "“We’ll see about that.”"
    m "“那就看着办吧。”"

# game/murdochroute3.rpy:2142
translate Schinese murdochroute3a_bda094a2:

    # "I get as close to him as I can without kissing him again."
    "我尽可能靠近他，但不到接吻的距离。"

# game/murdochroute3.rpy:2144
translate Schinese murdochroute3a_cef90647:

    # m "“I’ll make it as easy for you as I can.”"
    m "“我会尽量让你轻松些。”"

# game/murdochroute3.rpy:2151
translate Schinese murdochroute3a_f11cefbe:

    # "There’s a fog swirling inside the drinking hall of The Saguaro’s Hip when we return to it."
    "我们回到了Saguaro’s Hip，只见酒馆内烟雾缭绕。"

# game/murdochroute3.rpy:2152
translate Schinese murdochroute3a_8b96cbaa:

    # "Alert postures have long been replaced with the slouches that smoke and spirits grant."
    "西装革履的身姿早已被烟与酒灌得散漫。"

# game/murdochroute3.rpy:2153
translate Schinese murdochroute3a_5c2412f1:

    # "The piano player has abandoned jauntiness in favor of meek, delicate scales."
    "钢琴的曲调也从活泼欢快换成了柔和抒情。"

# game/murdochroute3.rpy:2154
translate Schinese murdochroute3a_8c881915:

    # "Most of the show girls have long since abandoned their stations, but a few flirt amongst the bar as they prepare to transition to their night duties."
    "大多数表演女郎已经离台，也有一部分在酒吧中流连，寻觅着夜里的工作。"

# game/murdochroute3.rpy:2157
translate Schinese murdochroute3a_f76a52be:

    # "And I do the same, as Sam pulls me by the cuff of my shirt up the stairs and towards his room."
    "我也一样，任由Sam拉着我的衣袖，领我去他的房间。"

# game/murdochroute3.rpy:2174
translate Schinese murdochroute3a_25bd8de3:

    # "He exchanges some whispers with the Meseta woman, who nods, and rushes off to deliver directions."
    "他跟那位梅塞塔姑娘私下聊了几句，对方点点头，离开去转达指示。"

# game/murdochroute3.rpy:2161
translate Schinese murdochroute3a_45d29652:

    # "There are buckets waiting for us."
    "几桶水转眼就备好了。"

# game/murdochroute3.rpy:2162
translate Schinese murdochroute3a_556b4ee9:

    # "He asks me if I need help cleaning but tell him I already know how."
    "他问我需不需要帮忙，但我告诉他我知道怎么清洗。"

# game/murdochroute3.rpy:2163
translate Schinese murdochroute3a_01866dde:

    # "We rinse together, giving one another dignity in the opposite direction."
    "我们背对背，给彼此给出隐私。"

# game/murdochroute3.rpy:2164
translate Schinese murdochroute3a_3730d99e:

    # "It doesn’t take me long."
    "我很快便完成了。"

# game/murdochroute3.rpy:2165
translate Schinese murdochroute3a_b6b69605:

    # "I pat myself dry, and dress myself, chuckling to myself, knowing I’m just dressing to be undressed."
    "我擦干身子，穿好衣服，暗自发笑：这不过是为了脱而穿的罢了。"

# game/murdochroute3.rpy:2168
translate Schinese murdochroute3a_d9dd1bdc:

    # "And then I wait outside for them by the door."
    "我在门外等着他们。"

# game/murdochroute3.rpy:2169
translate Schinese murdochroute3a_0b7473ec:

    # "I see them walking in a row."
    "他们排成一列出现在走廊上。"

# game/murdochroute3.rpy:2170
translate Schinese murdochroute3a_b04d2af3:

    # "Down the hall, like criminals in a pact."
    "好似一群罪犯。"

# game/murdochroute3.rpy:2171
translate Schinese murdochroute3a_64234dc5:

    # "Coming towards me to engage in something just as criminal."
    "来找我做有罪的事。"

# game/murdochroute3.rpy:2172
translate Schinese murdochroute3a_44f28176:

    # "The smell of booze and the ardor of men’s deep revelry clouds the air when they approach his room."
    "随着他们走近，空气中顿时弥漫起酒精和欲望的味道。"

# game/murdochroute3.rpy:2904
translate Schinese murdochroute3a_34da8f72:

    # "I gesture at them with my arm beckoning, as if I’m just another waiter."
    "我向他们招手示意，活像一个服务员。"

# game/murdochroute3.rpy:2174
translate Schinese murdochroute3a_9b9e0cfa:

    # reu "“Your sense of service is a nice touch, kid.”"
    reu "“你的服务精神不错，小伙子。”"

# game/murdochroute3.rpy:2175
translate Schinese murdochroute3a_fe729a3d:

    # "The physician pats my cheek, and his paws linger on my face as he lets the back of his wrist smooth down my whiskers."
    "医生拍了拍我的脸颊，并顺势用手背抚平我的胡须。"

# game/murdochroute3.rpy:2176
translate Schinese murdochroute3a_a644558f:

    # "The grim congressman says little, and does not make eye contact with me, but the tent in his pants speaks for him."
    "严肃的议员话不多，我也看不透他的眼睛，但他高高鼓起的裤裆足以说明一切。"

# game/murdochroute3.rpy:2178
translate Schinese murdochroute3a_121dead6:

    # "Jim is the last to pass by me, but he’s close enough and full of enough rum for me to feel the warmth radiating off of his cheeks."
    "Jim是最后经过我，也是靠的最近的，我甚至能感觉到他的脸颊在朗姆酒的作用下散发出缕缕热气。"

# game/murdochroute3.rpy:2179
translate Schinese murdochroute3a_3e9d6093:

    # "I remember his smell."
    "我还记得他的气味。"

# game/murdochroute3.rpy:2180
translate Schinese murdochroute3a_32ec9204:

    # "I remember the low murmur of his voice, and how it rumbles, like a plea, all bravado shed whenever I know that he really wants something."
    "还记得他那低声下气的恳求，一切虚张声势都消失无踪。"

# game/murdochroute3.rpy:2182
translate Schinese murdochroute3a_ca0ae5a4:

    # ji "“This might be the last time we get to do this for a while.”"
    ji "“这或许是短期内最后一次了。”"

# game/murdochroute3.rpy:2185
translate Schinese murdochroute3a_bbf9132c:

    # ji "“Let’s make it good for each other.”"
    ji "“就让我们纵情狂欢吧。”"

# game/murdochroute3.rpy:2187
translate Schinese murdochroute3a_e82471d8:

    # "I don’t know if it was ever wholly good."
    "我是不知道自己有没有享受过。"

# game/murdochroute3.rpy:2188
translate Schinese murdochroute3a_dc0ef76a:

    # "Even if it feels good."
    "就算很爽。"

# game/murdochroute3.rpy:2189
translate Schinese murdochroute3a_a3d44fd5:

    # "He makes me stir between my pants all the same, leading me by the collar into Sam’s room."
    "不管怎么说，他仍害我支起了帐篷，牵着我的衣领进到Sam房间里。"

# game/murdochroute3.rpy:2196
translate Schinese murdochroute3a_246c7c8d:

    # "Sam is on the bed leering at them as they walk in."
    "Sam坐在床边，看着他们走近。"

# game/murdochroute3.rpy:2197
translate Schinese murdochroute3a_23cede75:

    # "He’s shirtless, but his pants are still on, his suspenders unhooked from his shoulders."
    "他脱了上衣，但还穿着裤子，吊带半挂在肩上。"

# game/murdochroute3.rpy:2199
translate Schinese murdochroute3a_feefd8e1:

    # m "“There’s a closet for your nice coats.”"
    m "“可以把你们的高级衣裳放进衣柜。”"

# game/murdochroute3.rpy:2201
translate Schinese murdochroute3a_a2aac995:

    # reu "“Is this room not the closet?”"
    reu "“这房间本身不就是个衣柜？”"

# game/murdochroute3.rpy:2203
translate Schinese murdochroute3a_531acf48:

    # "I take the jacket for him before he complains any longer."
    "我接过他的夹克，免得他继续抱怨。"

# game/murdochroute3.rpy:2205
translate Schinese murdochroute3a_7ba3c222:

    # ji "“We could all do with getting a little closer anyhow.”"
    ji "“反正总会搅成一团。”"

# game/murdochroute3.rpy:2208
translate Schinese murdochroute3a_ab3670d9:

    # "Jim unhooks his cumberbun, stripping slowly."
    "Jim解开腰带，开始慢慢脱衣。"

# game/murdochroute3.rpy:2209
translate Schinese murdochroute3a_f5b85109:

    # nei "“Only you would take us to a brothel with some of the most beautiful women in the west and manage to take us to the men.”"
    nei "“会在美女如云的西部妓院里带我们玩男人的，也就只有你了。”"

# game/murdochroute3.rpy:2210
translate Schinese murdochroute3a_c8ae7206:

    # ji "“There’s always room for seconds Neil.”"
    ji "“你随时都可以反悔啊，Neil。”"

# game/murdochroute3.rpy:2213
translate Schinese murdochroute3a_78855579:

    # "His pants drop to the floor and he steps out of them, slowly, gracefully, silver fur shining in the moonlight."
    "他任由裤子落地，优雅地缓步走出，银色的毛发在月光下闪闪发亮。"

# game/murdochroute3.rpy:2216
translate Schinese murdochroute3a_ca3b3fec:

    # ji "“The whole room can see that your cock is stiff, so let me prove a point.”"
    ji "“鸡巴倒是比嘴还硬。就让我证明一件事吧。”"

# game/murdochroute3.rpy:2218
translate Schinese murdochroute3a_efc179ab:

    # nei "“Point being what?”"
    nei "“什么事？”"

# game/murdochroute3.rpy:2219
translate Schinese murdochroute3a_b7a795bc:

    # "He unbuttoned his pants and fished out his balls."
    "他解开内裤上的钮扣，掏出他的肉丸。"

# game/murdochroute3.rpy:2222
translate Schinese murdochroute3a_949fd2d5:

    # ji "“Men know how to suck better.”"
    ji "“男人更会吸喔。”"

# game/murdochroute3.rpy:2224
translate Schinese murdochroute3a_fd6d00f0:

    # "Neil rolled his eyes."
    "Neil翻了个白眼。"

# game/murdochroute3.rpy:2226
translate Schinese murdochroute3a_0274b593:

    # "Reubin looked curious, but unconvinced."
    "Reubin一脸好奇，但又不太相信。"

# game/murdochroute3.rpy:2228
translate Schinese murdochroute3a_c7dc9bc4:

    # ji "“It makes sense, doesn’t it?”"
    ji "“不是很有道理吗？”"

# game/murdochroute3.rpy:2231
translate Schinese murdochroute3a_c93922f1:

    # ji "“We know what feels good.”"
    ji "“怎样比较爽，只有我们才知道。”"

# game/murdochroute3.rpy:2233
translate Schinese murdochroute3a_4e53cde5:

    # "He turns to me."
    "他转向我。"

# game/murdochroute3.rpy:2234
translate Schinese murdochroute3a_8aeb3ed0:

    # "I can already smell the sharp scent of his frenzy in the air."
    "强烈的气味涌进我的鼻腔。"

# game/murdochroute3.rpy:2236
translate Schinese murdochroute3a_821be005:

    # ji "“Would you care to show them?”"
    ji "“你能示范给他们看吗？”"

# game/murdochroute3.rpy:2239
translate Schinese murdochroute3a_5dc14b25:

    # "I hear Sam sit up in the bed."
    "我听见Sam从床上坐起。"

# game/murdochroute3.rpy:2240
translate Schinese murdochroute3a_29b82e65:

    # "The doctor lets out a one-note laugh."
    "医生干笑了一声。"

# game/murdochroute3.rpy:2242
translate Schinese murdochroute3a_b85de9e7:

    # reu "“Of course he’s having the usher do it.”"
    reu "“果真是要让招待来啊。”"

# game/murdochroute3.rpy:2243
translate Schinese murdochroute3a_be2f44e2:

    # nei "“That’s not just an usher, that’s his brother.”"
    nei "“那可不是普通的招待，还是他小舅子。”"

# game/murdochroute3.rpy:2245
translate Schinese murdochroute3a_c7a654dc:

    # "Jim rolls his eyes."
    "Jim翻了个白眼。"

# game/murdochroute3.rpy:2247
translate Schinese murdochroute3a_01666f73:


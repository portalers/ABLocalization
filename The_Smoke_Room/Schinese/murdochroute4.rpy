# game/murdochroute4.rpy:27
translate Schinese murdochroute4_ed3424b3:

    # me "\"...Do you really think we’re alone here, Mr. Ayers?\""
    me "“...你真的认为这里只有我们在吗，Ayers先生？”"

# game/murdochroute4.rpy:101
translate Schinese murdochroute4_db840078:

    # bl "\"The school ain’t that big, Mr. Ayers.\""
    bl "“这间学校没那么大，Ayers先生。”"

# game/murdochroute4.rpy:102
translate Schinese murdochroute4_8c800ff1:

    # bl "\"Nobody can get lost, and if something happens, we’d hear it.\""
    bl "“迷不了路，万一出事了我们也能听见动静。”"

# game/murdochroute4.rpy:174
translate Schinese murdochroute4_18ebbf91:

    # reu "\"Don’t you have a firearm, miss?\""
    reu "“你不是带着枪吗，小姐？”"

# game/murdochroute4.rpy:180
translate Schinese murdochroute4_b382dd5b:

    # reu "\"My friend {i}just{/i} said manning the front of the school with firearms would be prudent.\""
    reu "“我朋友{b}刚刚{/b}还说，有武器守住校门最好。”"

# game/murdochroute4.rpy:312
translate Schinese schoolexplorationmain_168c75f8:

    # me "\"Mister Ayers?\""
    me "“Ayers先生？”"

# game/murdochroute4.rpy:347
translate Schinese schoolexplorationmain_cdaaa792:

    # bl "\"If I said I did, would it much matter?\""
    bl "“我说介意的话，有差吗？”"

# game/murdochroute4.rpy:351
translate Schinese schoolexplorationmain_bed5fc99:

    # "Something I ought to stop forgetting in spite of her behavior - this girl is smart."
    "我得提醒自己，虽然这姑娘行为有问题，但脑瓜很灵。"

# game/murdochroute4.rpy:471
translate Schinese schoolauditorium_673615f6:

    # m "\"Do you think I’d be doing this if I didn’t think it was necessary?\""
    m "“不然你以为我为什么要这么做？”"

# game/murdochroute4.rpy:548
translate Schinese schoolauditorium_de69ddc2:

    # m "\"...Can we just check behind the curtains and get out of here?\""
    m "“...能快速检查一下幕布后面，然后赶紧离开么？”"

# game/murdochroute4.rpy:633
translate Schinese schoolauditorium_042402b0:

    # "...Still nobody there."
    "...还是没人。"

# game/murdochroute4.rpy:639
translate Schinese schoolauditorium_2dde9590:

    # "If he wants to complain about how I’m doing things then he can be the first person to check out the dangerous places."
    "要是对我的做法有意见，他就该带头检查危险区域。"

# game/murdochroute4.rpy:662
translate Schinese schoolauditorium_04111a3d:

    # ji "\"So there was some digging, and some permits to procure.\""
    ji "“自然要经过许可才能挖掘。”"

# game/murdochroute4.rpy:724
translate Schinese schoolauditorium_89dfe098:

    # "That didn’t seem entirely right to me, but it wasn’t like I was gonna argue about it."
    "感觉不太对，但我懒得跟他争辩。"

# game/murdochroute4.rpy:767
translate Schinese schoolauditorium_5b4b5372:

    # m "\"Murdoch, what the hell?\""
    m "“有完没完，Murdoch？”"

# game/murdochroute4.rpy:805
translate Schinese schoolauditorium_17774a42:

    # me "\"What’s the matter, Mr. Ayers?\""
    me "“怎么了，Ayers先生？”"

# game/murdochroute4.rpy:815
translate Schinese schoolauditorium_748c215c:

    # me "\"My ears work real good, you know.\""
    me "“不是我说大话，我的耳朵可灵了。”"

# game/murdochroute4.rpy:830
translate Schinese schoolauditorium_301abb14:

    # bl "\"The hell you doin’, Mr. Ayers?\""
    bl "“你在搞什么，Ayers先生？”"

# game/murdochroute4.rpy:863
translate Schinese schoolauditorium_da6ba21c:

    # bl "\"This isn’t a comedy of errors, Mr. Byrnes.\""
    bl "现实又不是荒诞的喜剧，Byrnes先生。"

# game/murdochroute4.rpy:964
translate Schinese schoolbasement_e3a1e126:

    # "I barely have room to walk, considering the clutter."
    "杂物多得几乎无处下脚。"

# game/murdochroute4.rpy:1036
translate Schinese schoolbasement_7a5e32f7:

    # ra "\"...Thus proving my point.\""
    ra "“...所以我才这么说啊。”"

# game/murdochroute4.rpy:1103
translate Schinese schoolbasement_31e3493b:

    # mu "\"Probably not, in honesty.\""
    mu "“说实话，应该没有吧。”"

# game/murdochroute4.rpy:1104
translate Schinese schoolbasement_6ca68560:

    # mu "\"A lot of the stuff down here was old and out of commission since Mother became the principal.\""
    mu "“自母亲就任校长以后，我们淘汰了很多老物件。”"

# game/murdochroute4.rpy:1113
translate Schinese schoolbasement_0514b4fc:

    # "At least he’s trying, I suppose."
    "算他有点良心。"

# game/murdochroute4.rpy:1154
translate Schinese schoolbasement_6b37ff63:

    # me "\"...No, I think I’ll stay.\""
    me "“...不用，我要留下来。”"

# game/murdochroute4.rpy:1185
translate Schinese schoolbasement_2ea2d0bd:

    # mu "\"Be careful with those. They might be full of mold.\""
    mu "“小心点，可能全都是霉菌。”"

# game/murdochroute4.rpy:1199
translate Schinese schoolbasement_10fa0de2:

    # "It dawns on me now that a girl that scrawny has had no trouble holding up and waving a book that size around like that."
    "我才反应过来，这女孩这么弱不禁风，却能不费吹灰之力把一本厚书拿着乱甩。"

# game/murdochroute4.rpy:1224
translate Schinese schoolbasement_565636b1:

    # me "\"Hey, this one sounds hollow too!\""
    me "“这本好像也是空的？”"

# game/murdochroute4.rpy:1292
translate Schinese schoolbasement_81181aa9:

    # "As he slams it, I catch the scuttling sound of somebody running up towards us." with hpunch
    "他甩上门的时候，我听见有人冲上来的跑步声。" with hpunch

# game/murdochroute4.rpy:1330
translate Schinese schoolbasement_fa40c4e5:

    # mu "\"That door locks from only one side, so I don’t think we have to worry.\""
    mu "“这扇门只能从这边上锁，应该不用担心。”"

# game/murdochroute4.rpy:1347
translate Schinese schoolbasement_c2ca119c:

    # mu "\"...Let’s take a small break before we cover the next area, alright Sam?\""
    mu "“...先休息一下再去其他地方行吗，Sam？”"

# game/murdochroute4.rpy:1394
translate Schinese schoolbasement_f03dbd2d:

    # bl "\"Something really did happen to you back in the tunnels, Mr. Ayers.\""
    bl "“你在隧道里是真的出事了，Ayers先生。”"

# game/murdochroute4.rpy:1452
translate Schinese schoolclassroom_e6d775c1:

    # m "\"Didn’t say I think she will be either.\""
    m "“我也没说她在。”"

# game/murdochroute4.rpy:1455
translate Schinese schoolclassroom_4ee9ab2b:

    # "When we get to the door on the corner of the building, I step out of the way."
    "我们来到拐角处的一扇门前，我侧身让开道。"

# game/murdochroute4.rpy:1463
translate Schinese schoolclassroom_096782ad:

    # "Getting back to Holly’s office is one of the more time-consuming backtracks."
    "往返一趟Holly的办公室很耗时间。"

# game/murdochroute4.rpy:1505
translate Schinese schoolclassroom_245c089a:

    # ji "\"...Yes.\""
    ji "“...对。”"

# game/murdochroute4.rpy:1507
translate Schinese schoolclassroom_63468d89:

    # m "\"The more, the merrier as far as I’m concerned.\""
    m "“反正人越多越好。”"

# game/murdochroute4.rpy:1527
translate Schinese schoolclassroom_0f143761:

    # ji "\"...It’s where we started dating.\""
    ji "“...我们坠入爱河的地方。”"

# game/murdochroute4.rpy:1563
translate Schinese schoolclassroom_74f03783:

    # "It’s the usual shit you’d expect a teacher to have."
    "都是老师会有的东西。"

# game/murdochroute4.rpy:1571
translate Schinese schoolclassroom_abd2cced:

    # ra "\"Is it a key or a combination lock.\""
    ra "“钥匙锁还是密码锁？”"

# game/murdochroute4.rpy:1631
translate Schinese schoolclassroom_eecdec4f:

    # "Murdoch takes his out of his pockets and sets it on the table."
    "Murdoch从口袋掏出自己的，放在桌上。"

# game/murdochroute4.rpy:1646
translate Schinese schoolclassroom_beffe80a:

    # mu "\"Wait Jim.\""
    mu "“等等，Jim。”"

# game/murdochroute4.rpy:1672
translate Schinese schoolclassroom_30199045:

    # m "\"Burn it, Jim.\""
    m "“烧了它，Jim。”"

# game/murdochroute4.rpy:1782
translate Schinese schoolclassroom_ebb0f7d9:

    # bl "\"I’m sayin’ you’re looking around for dark holes more often than me, if you get what I mean.\""
    bl "“那是你吧，懂我意思不？”"

# game/murdochroute4.rpy:1785
translate Schinese schoolclassroom_a3b9848e:

    # bl "\"You’re not {i}that{i} good of a liar, Mr. Byrnes.\""
    bl "“你撒谎的水平没有你想的{b}那么{/b}高，Byrnes先生。”"

# game/murdochroute4.rpy:1823
translate Schinese schoolclassroom_cd32feae:

    # "I think we’ve already found all that really mattered here, anyway."
    "反正我们早就找到所有关键物品了。"

# game/murdochroute4.rpy:1835
translate Schinese schooloffice_0184422d:

    # "The idea of looking inside of Gretchen’s office is one of the only thoughts that makes me hesitate."
    "Gretchen的办公室是少数令我犹豫要不要检查的地方。"

# game/murdochroute4.rpy:1836
translate Schinese schooloffice_3620ef27:

    # "I can’t decide if that’s because it’s the one place that would feel most like breaking and entering..."
    "不知道是因为这里比起进入更像闯入..."

# game/murdochroute4.rpy:1915
translate Schinese schooloffice_ed47a0b8:

    # "The only evidence of comfort is the giant bay window in the back wall, but even that is partially covered by plain-looking curtains."
    "唯一称得上精致的，只有后方墙上的巨大凸窗，但也半掩在朴素的窗帘后面。"

# game/murdochroute4.rpy:1922
translate Schinese schooloffice_d75e82fb:

    # "Going back to Gretchen’s office the second time puts me more on edge than it did the first time."
    "再次回到Gretchen的办公室，比第一次来还令我紧张。"

# game/murdochroute4.rpy:1975
translate Schinese schooloffice_efa6fcad:

    # ra "\"And sometimes people take on more responsibilities than they should because they prefer to be busy rather than be alone with their thoughts.\""
    ra "“有的人宁愿主动挑起大梁，好让自己忙起来，也要避免独自一人胡思乱想。”"

# game/murdochroute4.rpy:2028
translate Schinese schooloffice_ca389c2f:

    # ji "\"Come now, how the hell do you live with this?\""
    ji "“你们是怎么坚持下来的？”"

# game/murdochroute4.rpy:2032
translate Schinese schooloffice_6bf44c86:

    # ji "\"You mean your rat-infested hovel?\""
    ji "“你说那个老鼠窝吗？”"

# game/murdochroute4.rpy:2039
translate Schinese schooloffice_89096960:

    # mu "\"In truth, I don’t find the behavior particularly funny.\""
    mu "“说实话，这种行为并不可取。”"

# game/murdochroute4.rpy:2049
translate Schinese schooloffice_daa758a1:

    # ji "\"Well then, the coast is clear, unless your mother is hanging in the chimney like a vampire.\""
    ji "“这里一切正常，除非你妈像只吸血鬼一样倒吊在烟囱里。”"

# game/murdochroute4.rpy:2224
translate Schinese schooloffice_3c14ff08:

    # "It’s a stack of letters in a basket labelled 1915."
    "一个标着1915的篮子里面有一叠信。"

# game/murdochroute4.rpy:2242
translate Schinese schooloffice_f63c765f:

    # bl "\"{i}Mary Applegate will be transferred to P.S. 4, Camp Rosa, this following fall.{/i}\""
    bl "“{b}Mary Applegater将于今年秋季转入罗莎营地第四公立学校。{/b}”"

# game/murdochroute4.rpy:2264
translate Schinese schooloffice_688fcef4:

    # bl "\"Read it out loud, Mr. Byrnes.\""
    bl "“大声念出来，Byrnes先生。”"

# game/murdochroute4.rpy:2273
translate Schinese schooloffice_3a18319b:

    # mu "\"{i}Melissa Boike will be transferred to P.S. 3, Payton, this following fall.{/i}\""
    mu "“{b}Melissa Boike将于今年秋季转入佩顿第三公立学校。{/b}”"

# game/murdochroute4.rpy:2349
translate Schinese schoollibrary_486f8d2e:

    # "Behind the glass wall, the library looks dark and empty."
    "玻璃墙对面的图书馆昏暗而空荡。"

# game/murdochroute4.rpy:2468
translate Schinese schoollibrary_a4f753e6:

    # ra "\"Then there’s no point in thinking the worst when there’s nothing to suggest it.\""
    ra "“既然没有坏事发生的迹象，就别瞎操心了。”"

# game/murdochroute4.rpy:2493
translate Schinese schoollibrary_55bf0f8f:

    # ji "\"Did you know that the the geologist teaching here at the time just said that’s how the world really moves rather than fix the damn thing?\""
    ji "“你知道当时的地理老师懒得把这个修好，直接跟大家说地球就是这么转的吗？”"

# game/murdochroute4.rpy:2525
translate Schinese schoollibrary_5f5ca6a2:

    # m "\"You found those yearbooks I take it?\""
    m "“你找到你说的毕业纪念册了？”"

# game/murdochroute4.rpy:2621
translate Schinese schoollibrary_14ac180a:

    # me "\"I didn’t take you for the envious type, Mr. Ayers.\""
    me "“没想到你这么善妒，Ayers先生。”"

# game/murdochroute4.rpy:2665
translate Schinese schoollibrary_87783ca7:

    # bl "\"You look scared, Mr. Ayers.\""
    bl "“你好像在害怕，Ayers先生。”"

# game/murdochroute4.rpy:2741
translate Schinese schoollibrary_bddce34e:

    # mu "\"I’ll be back in a little while. Please watch over one another.\""
    mu "“我晚点回来，请你们顾好彼此。”"

# game/murdochroute4.rpy:2836
translate Schinese schoolconvos_b7674fe3:

    # cy "\"About as good as one can, I suppose.\""
    cy "“还算说得过去吧。”"

# game/murdochroute4.rpy:2845
translate Schinese schoolconvos_0b6fd347:

    # m "\"...Don’t you mean Scarlet?\""
    m "“...不是更该担心Scarlet吗？”"

# game/murdochroute4.rpy:2852
translate Schinese schoolconvos_dd737c58:

    # cy "\"After everything she’s been through, I reckon she’d be too embarrassed to put {i}perished to flames{/i} on her tombstone if that’s what does her in.\""
    cy "“大风大浪她都经历过，如果就这么死了，她自己也不好意思把{b}亡于火灾{/b}几个字刻在墓碑上吧。”"

# game/murdochroute4.rpy:2882
translate Schinese schoolconvos_3ae75d15:

    # reu "\"If lunatic yokels busted down the door, at least I’d have something to do.\""
    reu "“要是有神经病把门拆了闯进来，倒还有点事做。”"

# game/murdochroute4.rpy:2950
translate Schinese schoolconvos_2f4c5529:

    # m "\"Take a deep breath, or something’.\""
    m "“你先做个深呼吸之类的。”"

# game/murdochroute4.rpy:2960
translate Schinese schoolconvos_e818dd40:

    # "The dog is sitting in a seat, staring out the window."
    "狗坐在椅子上，望着窗外。"

# game/murdochroute4.rpy:3065
translate Schinese schoolconvos_8cbe52d7:

    # ji "\"This isn’t a sob story Mr Ayers.\""
    ji "“这又不是什么悲情故事，Ayers先生。”"

# game/murdochroute4.rpy:3090
translate Schinese schoolconvos_d942695a:

    # m "\"It wasn’t {i}that{/i} long ago, was it?\""
    m "“也没过{b}那么{/b}久吧？”"

# game/murdochroute4.rpy:3143
translate Schinese schoolconvos_4f02feaa:

    # me "\"Hello, Mr. Ayers.\""
    me "“你好，Ayers先生。”"

# game/murdochroute4.rpy:3221
translate Schinese schoolconvos_51178dec:

    # me "\"Yes, Mr Ayers.\""
    me "“嗯，Ayers先生。”"

# game/murdochroute4.rpy:3251
translate Schinese schoolconvos_92ad6394:

    # bl "\"You’re so sensitive about that, Mr. Ayers.\""
    bl "“你对年龄太敏感了，Ayers先生。”"

# game/murdochroute4.rpy:3287
translate Schinese schoolconvos_0a6e587b:

    # m "\"I’m still an employee with the Byrneses.\""
    m "“我依然是Byrnes家的员工。”"

# game/murdochroute4.rpy:3290
translate Schinese schoolconvos_ba4c50be:

    # bl "\"The Byrneses are not exactly known for charity, Mr. Ayers.\""
    bl "“Byrnes家可不是做慈善的，Ayers先生。”"

# game/murdochroute4.rpy:3302
translate Schinese schoolconvos_dcb1def3:

    # m "\"I don’t think I could afford more of your services, lil ma’am.\""
    m "“我恐怕请不起你，小姑娘。”"

# game/murdochroute4.rpy:3330
translate Schinese schoolconvos_d3c27107:

    # m "\"...You good?\""
    m "“...你还好吗？”"

# game/murdochroute4.rpy:3369
translate Schinese dahliaprogression_b409ee36:

    # m "\"Thank you, Miss Washington.\""
    m "“谢谢你，Washington小姐。”"

# game/murdochroute4.rpy:3379
translate Schinese dahliaprogression_451853bc:

    # bl "\"Then again, it’s impossible to save everybody, ain’t it?\""
    bl "“不过，想救所有人终究是不可能的吧？”"

# game/murdochroute4.rpy:3403
translate Schinese dahliaprogression_7421b3fa:

    # "I grip the wood, making my first step up, and it squeaks beneath me, bearin’ my weight."
    "我抓住梯子爬上一步，木头因我的体重吱呀作响。"

# game/murdochroute4.rpy:3495
translate Schinese dahliaprogression_4df975e6:

    # dh "\"It’s when the nature of waves changes when they hit a barrier.\""
    dh "“是指波在遇到障碍物时会改变原有的性质。”"

# game/murdochroute4.rpy:3506
translate Schinese dahliaprogression_a88dac5b:

    # dh "\"It’s believed that shape of the wave changes as it spreads.\""
    dh "“学界认为波在扩散时会改变形状。”"

# game/murdochroute4.rpy:3549
translate Schinese dahliaprogression_39d9671c:

    # dh "\"But there are some things that they can’t do.\""
    dh "“但有些事情是它们做不到的。”"

# game/murdochroute4.rpy:3552
translate Schinese dahliaprogression_a03c338b:

    # dh "\"I see Kepler’s star tonight, Mr. Ayers.\""
    dh "“我今晚看到开普勒星了，Ayers先生。”"

# game/murdochroute4.rpy:3565
translate Schinese dahliaprogression_1e4d724d:

    # m "\"I know that that I’m ignorant of all this, but your brother’s worried sick!\""
    m "“我承认我对这些一窍不通，但你哥哥已经快急疯了！”"

# game/murdochroute4.rpy:3580
translate Schinese dahliaprogression_3395afe9:

    # dh "\"If I step away for even a moment, I could miss something, and that’s one sliver of data the future won’t have.\""
    dh "“即便只是离开一瞬间，都有可能错过关键信息，成为永远无法填补的空白。”"

# game/murdochroute4.rpy:3678
translate Schinese thirddahliaattempt_de2bdfd9:

    # dh "\"Each and every one of us, as the planet moves on its axis.\""
    dh "“星球沿着轴心旋转，带动所有人一起。”"

# game/murdochroute4.rpy:3689
translate Schinese thirddahliaattempt_63163985:

    # dh "\"Beamsick with the rotting light of dead stars which have spiraled downward, fetid upon arrival.\""
    dh "“死星的腐败光芒盘旋落下，来时已然发臭。”"

# game/murdochroute4.rpy:3701
translate Schinese thirddahliaattempt_2ff87dcb:

    # "It’s hard to see what she’s doing over there in the dark, but from the shape of her silhouette, I can see that she shakes her head."
    "在黑暗中很难看清她在那边做什么，但从身影轮廓看来，她在摇头。"

# game/murdochroute4.rpy:3717
translate Schinese thirddahliaattempt_acf94379:

    # dh "\"Go now, Mr. Ayers.\""
    dh "“请你离开，Ayers先生。”"

# game/murdochroute4.rpy:3730
translate Schinese thirddahliaattempt_b8c9700f:

    # m "\"I’m going, see?\""
    m "“我这就走，好吧？”"

# game/murdochroute4.rpy:3745
translate Schinese thirddahliaattempt_27514e84:

    # "I knew the Byrneses were crazy, but I had a feeling she was different."
    "虽然早知道Byrnes一家人都很疯，但我以为她不一样。"

# game/murdochroute4.rpy:3764
translate Schinese thirddahliaattempt_9d2937c9:

    # "Or at least have the capacity to understand what just happened."
    "或至少有能力理解刚才发生的事。"

# game/murdochroute4.rpy:3790
translate Schinese thirddahliaattempt_4eabf7fc:

    # cy "\"...Was she alright?\""
    cy "“...那她还好吗？”"

# game/murdochroute4.rpy:3794
translate Schinese thirddahliaattempt_5d10e21a:

    # "Cynthia lets a low, one note laugh."
    "Cynthia轻笑了一声。"

# game/murdochroute4.rpy:3820
translate Schinese dahliasuccess_46b6acb4:

    # dh "\"...So you have been paying some attention.\""
    dh "“...看来你好歹有注意到。”"

# game/murdochroute4.rpy:3852
translate Schinese dahliasuccess_d00d403a:

    # dh "\"Repeat it back to me.\""
    dh "“你复读一遍。”"

# game/murdochroute4.rpy:3947
translate Schinese dahliasuccess_6f19d038:

    # m "\"Alright.\""
    m "“好。”"

# game/murdochroute4.rpy:3950
translate Schinese dahliasuccess_18d37fff:

    # m "\"I’m gonna back up real soon and you’re gonna follow.\""
    m "“我马上退开，你也跟上来。”"

# game/murdochroute4.rpy:3951
translate Schinese dahliasuccess_11b3a699:

    # m "\"Do we have a deal?\""
    m "“这样可以吗？”"

# game/murdochroute4.rpy:3953
translate Schinese dahliasuccess_28e6410f:

    # dh "\"We do.\""
    dh "“可以。”"

# game/murdochroute4.rpy:3955
translate Schinese dahliasuccess_59cdbb37:

    # "I back up, always looking forward, when I reach the ladder."
    "我向后退，始终注视着前方，直到碰到梯子。"

# game/murdochroute4.rpy:3957
translate Schinese dahliasuccess_6872c23f:

    # "I put one paw behind the other as she approaches, following me down."
    "我一步一步往下爬，她走来随我下楼。"

# game/murdochroute4.rpy:3959
translate Schinese dahliasuccess_2f15cf5d:

    # "Out of the observatory."
    "离开天文台。"

# game/murdochroute4.rpy:3961
translate Schinese dahliasuccess_dccf8d1e:

    # "Out of the library."
    "离开图书馆。"

# game/murdochroute4.rpy:3963
translate Schinese dahliasuccess_4e431fea:

    # "Jim and his friends are waiting on the steps with Cynthia."
    "Jim和他的朋友们跟Cynthia一起在楼梯上等着。"

# game/murdochroute4.rpy:3965
translate Schinese dahliasuccess_2ac864fe:

    # "Their turn their necks when they hear us walking."
    "一听见我们的脚步声便转过头来。"

# game/murdochroute4.rpy:3967
translate Schinese dahliasuccess_4f85cba2:

    # mu "\"Dahlia?\""
    mu "“Dahlia？”"

# game/murdochroute4.rpy:3972
translate Schinese dahliasuccess_8fd766c0:

    # "Murdoch’s voice comes from the end of the hallway at the other side of the staircase."
    "楼梯另一侧走廊的尽头响起Murdoch的声音。"

# game/murdochroute4.rpy:3974
translate Schinese dahliasuccess_0aef36ea:

    # dh "\"Murdoch.\""
    dh "“Murdoch。”"

# game/murdochroute4.rpy:3977
translate Schinese dahliasuccess_668339e7:

    # mu "\"Why weren’t you at the wedding?\""
    mu "“你怎么没去婚礼？”"

# game/murdochroute4.rpy:3979
translate Schinese dahliasuccess_c64c11f7:

    # dh "\"I had duties.\""
    dh "“我有我的职责。”"

# game/murdochroute4.rpy:3982
translate Schinese dahliasuccess_20716e03:

    # mu "\"That doesn’t matter.\""
    mu "“这不重要。”"

# game/murdochroute4.rpy:3984
translate Schinese dahliasuccess_1d635a42:

    # mu "\"Everybody was looking for you.\""
    mu "“大家都在找你。”"

# game/murdochroute4.rpy:3986
translate Schinese dahliasuccess_7e28f461:

    # dh "\"This couldn’t wait.\""
    dh "“这件事不能等。”"

# game/murdochroute4.rpy:3990
translate Schinese dahliasuccess_833e256a:

    # dh "\"I would have been stopped had I told anyone.\""
    dh "“如果我告诉别人，会遭受阻碍。”"

# game/murdochroute4.rpy:3993
translate Schinese dahliasuccess_e7ccb796:

    # mu "\"...\""
    mu "“...”"

# game/murdochroute4.rpy:3995
translate Schinese dahliasuccess_d74a8040:

    # dh "\"Well?\""
    dh "“怎么样？”"

# game/murdochroute4.rpy:3998
translate Schinese dahliasuccess_e7bfa603:

    # dh "\"You wanted answers, didn’t you?\""
    dh "“你们不是想要答案吗？”"

# game/murdochroute4.rpy:4001
translate Schinese dahliasuccess_fc6c6cac:

    # dh "\"Prove that I can trust you with them.\""
    dh "“那就向我证明你们值得托付吧。”"

# game/murdochroute4.rpy:4007
translate Schinese dahliasuccess_66b7f073:

    # ji "\"What is she talking about?\""
    ji "“她在说什么？”"

# game/murdochroute4.rpy:4010
translate Schinese dahliasuccess_e0d66acb:

    # dh "\"Everybody who needs to understand already does.\""
    dh "“心里有数的人，不用我说也会明白。”"

# game/murdochroute4.rpy:4014
translate Schinese dahliasuccess_049540ec:

    # ji "\"...What the fuck is that supposed to mean?\""
    ji "“...这他妈又是什么意思？”"

# game/murdochroute4.rpy:4016
translate Schinese dahliasuccess_e66e3475:

    # m "\"Remember when we saw a cellar downstairs?\""
    m "“还记得我们在楼下看到一个地窖吗？”"

# game/murdochroute4.rpy:4020
translate Schinese dahliasuccess_2762e133:

    # m "\"There was light coming from behind one of the{nw}"
    m "“其中一个书架后面{nw}"

# game/murdochroute4.rpy:4024
translate Schinese dahliasuccess_98118025:

    # extend " shelves.\""
    extend "有光透出来。”"

# game/murdochroute4.rpy:4026
translate Schinese dahliasuccess_51eba043:

    # ji "\"So what?\""
    ji "“那又怎样？”"

# game/murdochroute4.rpy:4032
translate Schinese dahliasuccess_75d793de:

    # cy "\"Do you really think it’s a good idea to go poking around down there, Sam?\""
    cy "“你真觉得下去乱翻一通是个好主意吗，Sam？”"

# game/murdochroute4.rpy:4033
translate Schinese dahliasuccess_3ffbe621:

    # cy "\"Whoever was down there seemed like they wanted people to stay out.\""
    cy "“不管那家伙是谁，似乎都不想遇到别人。”"

# game/murdochroute4.rpy:4034
translate Schinese dahliasuccess_123f1765:

    # m "\"Well, if he’s the arsonist I’d like to make sure he doesn’t have an opportunity to smoke us up while we sleep.\""
    m "“这个嘛，如果他是纵火犯，我可不想让他趁我们睡着时放火把我们熏死。”"

# game/murdochroute4.rpy:4036
translate Schinese dahliasuccess_48a5a220:

    # cy "\"What makes you think he’s the guy?\""
    cy "“你怎么认定他就是纵火犯？”"

# game/murdochroute4.rpy:4037
translate Schinese dahliasuccess_25b6238f:

    # m "\"I figure if he wants to light the whole town up, then this place is probably next, right?\""
    m "“要是他想烧掉整个镇子，这里多半就是下一个目标，没错吧？”"

# game/murdochroute4.rpy:4041
translate Schinese dahliasuccess_b9e66a0b:

    # ji "\"Not necessarily.\""
    ji "“不一定。”"

# game/murdochroute4.rpy:4044
translate Schinese dahliasuccess_cdbe46c0:

    # ji "\"We have no understanding why somebody set fire to the town.\""
    ji "“我们又不知道他为什么纵火。”"

# game/murdochroute4.rpy:4047
translate Schinese dahliasuccess_c3708a01:

    # ji "\"For all we know they’ve already fled.\""
    ji "“说不定犯人早就逃之夭夭了。”"

# game/murdochroute4.rpy:4050
translate Schinese dahliasuccess_822de030:

    # nei "\"It wouldn’t hurt to make sure.\""
    nei "“确认一下也没坏处。”"

# game/murdochroute4.rpy:4052
translate Schinese dahliasuccess_4c0faea0:

    # m "\"Yeah, that’s what I’m sayin’.\""
    m "“对啊，我就是这意思。”"

# game/murdochroute4.rpy:4054
translate Schinese dahliasuccess_fed48b1d:

    # nei "\"Fear isn’t becoming of you, Jim.\""
    nei "“你可不是胆小怕事的人啊，Jim。”"

# game/murdochroute4.rpy:4057
translate Schinese dahliasuccess_518e3829:

    # ji "\"Asking for rational explanation for something risky isn’t fear.\""
    ji "“这不是胆小怕事，是对一件有风险的事寻求合理的解释。”"

# game/murdochroute4.rpy:4061
translate Schinese dahliasuccess_2b35989a:

    # reu "\"What manner of pussy talk is this?\""
    reu "“这话怎么听起来娘儿们唧唧的？”"

# game/murdochroute4.rpy:4063
translate Schinese dahliasuccess_cb44c247:

    # ji "\"...\""
    ji "“...”"

# game/murdochroute4.rpy:4067
translate Schinese dahliasuccess_41a36f95:

    # lu "\"I don’t like the way that basement smells.\""
    lu "“我不喜欢地下室的味道。”"

# game/murdochroute4.rpy:4068
translate Schinese dahliasuccess_28ec4553:

    # lu "\"It’s an evil kinda smell.\""
    lu "“闻起来很邪门。”"

# game/murdochroute4.rpy:4069
translate Schinese dahliasuccess_2d51183d:

    # "A few of us flinch when we hear Lucy’s voice."
    "Lucy一开口，吓了众人一跳。"

# game/murdochroute4.rpy:4070
translate Schinese dahliasuccess_c6a087ef:

    # "She’s so quiet that a few of us had forgotten she was here."
    "她实在太安静，我们好几个人都忘了她还在场了。"

# game/murdochroute4.rpy:4072
translate Schinese dahliasuccess_2300d693:

    # lu "\"I ain’t going down there.\""
    lu "“我不会下去。”"

# game/murdochroute4.rpy:4075
translate Schinese dahliasuccess_98d84b06:

    # nei "\"I don’t think anybody expected you to, my dear.\""
    nei "“没人指望你干这事，宝贝儿。”"

# game/murdochroute4.rpy:4078
translate Schinese dahliasuccess_4c305a2b:

    # "Cynthia puts her paw on her temple."
    "Cynthia一手拄着太阳穴。"

# game/murdochroute4.rpy:4079
translate Schinese dahliasuccess_deef8fe8:

    # "It’s something she does whenever she’s very irritated."
    "每当她非常不爽的时候，她都会这么做。"

# game/murdochroute4.rpy:4081
translate Schinese dahliasuccess_598a2030:

    # cy "\"...right.\""
    cy "“...行吧。”"

# game/murdochroute4.rpy:4083
translate Schinese dahliasuccess_ce24fbf8:

    # cy "\"But does it make sense to leave the front exposed?\""
    cy "“但也不能放着正门不管。”"

# game/murdochroute4.rpy:4085
translate Schinese dahliasuccess_ca580b7e:

    # cy "\"...how about the men go {i}downstairs{/i} and the women stay {i}upstairs?{/i}\""
    cy "“...要不男人{b}下去{/b}，女人留在{b}楼上{/b}如何？”"

# game/murdochroute4.rpy:4087
translate Schinese dahliasuccess_ca6f2486:

    # cy "\"I don’t think it’s a bad idea to keep a lookout for looters, and we can take sleeping shifts.\""
    cy "“我们可以轮流守夜，提防强盗袭击。”"

# game/murdochroute4.rpy:4097
translate Schinese dahliasuccess_1733e6c9:

    # bl "\"I’m not staying up here.\""
    bl "“我才不要待在楼上。”"

# game/murdochroute4.rpy:4101
translate Schinese dahliasuccess_2dad29e4:

    # "Cynthia gives her a stupefied look."
    "Cynthia一脸愕然地看着她。"

# game/murdochroute4.rpy:4103
translate Schinese dahliasuccess_89ba3473:

    # cy "\"But {i}why?{/i}\""
    cy "“这又是{b}为什么？{/b}”"

# game/murdochroute4.rpy:4105
translate Schinese dahliasuccess_96462298:

    # bl "\"Because at this point I need to know everything I can about this goddamn school.\""
    bl "“事到如今，我要把这破学校的秘密翻个底朝天。”"

# game/murdochroute4.rpy:4110
translate Schinese dahliasuccess_e4cdd47c:

    # bl "\"Don’t you see that something is very wrong here?\""
    bl "“你没发觉这里有多不对劲吗？”"

# game/murdochroute4.rpy:4113
translate Schinese dahliasuccess_41445181:

    # cy "\"I can know something’s wrong without needing to prod it with a stick.\""
    cy "“我光用看的就知道这里水很深。"

# game/murdochroute4.rpy:4115
translate Schinese dahliasuccess_e1f7f9c7:

    # bl "\"Maybe try using a knife sometime.\""
    bl "“那你偶尔淌下水吧。”"

# game/murdochroute4.rpy:4117
translate Schinese dahliasuccess_a57447f4:

    # bl "\"That’s the only way to get what you want sometimes.\""
    bl "“有时候，为了得到想要的东西只能这么做。”"

# game/murdochroute4.rpy:4119
translate Schinese dahliasuccess_4ef51f74:

    # cy "\"Not the sort of things I want.\""
    cy "“我想要的可不是这种东西。”"

# game/murdochroute4.rpy:4121
translate Schinese dahliasuccess_dde67164:

    # cy "\"Me and Lucy are staying upstairs.\""
    cy "“我和Lucy会留在楼上。”"

# game/murdochroute4.rpy:4126
translate Schinese dahliasuccess_32ce4429:

    # mu "\"I think it’s a good idea to keep a lookout anyway.\""
    mu "“总之，留人把守是个好主意。”"

# game/murdochroute4.rpy:4130
translate Schinese dahliasuccess_f395e56d:

    # cy "\"If it’s just the two of us we aren’t going to be able to take breaks or check on the rest of you.\""
    cy "“如果只有我们两个，就没法休息或去查看你们的情况了。”"

# game/murdochroute4.rpy:4132
translate Schinese dahliasuccess_047c8812:

    # m "\"If...\""
    m "“要是...”"

# game/murdochroute4.rpy:4134
translate Schinese dahliasuccess_c5eb1ee3:

    # "I do a quick count of everybody coming."
    "我快速数了一下要去的人。"

# game/murdochroute4.rpy:4136
translate Schinese dahliasuccess_c71b288a:

    # m "\"Eight people manage to get in trouble, you shouldn’t come down for us anyway.\""
    m "“去的八个人全都出事了，我看你们也别来找了。”"

# game/murdochroute4.rpy:4138
translate Schinese dahliasuccess_60309c65:

    # ra "\"Nine people, but agreed.\""
    ra "“是九个人，但我有同感。”"

# game/murdochroute4.rpy:4140
translate Schinese dahliasuccess_f92b4d20:

    # ra "\"I think it’s safe to say you can’t take whatever got us.\""
    ra "“真到了那时候，想必你们也没法应付。”"

# game/murdochroute4.rpy:4142
translate Schinese dahliasuccess_863a2b40:

    # cy "\"Just be careful, Sam.\""
    cy "“小心点啊，Sam。”"

# game/murdochroute4.rpy:4144
translate Schinese dahliasuccess_69f248f9:

    # m "\"I feel good about the odds Cynthia.\""
    m "“我觉得胜算挺大的，Cynthia。”"

# game/murdochroute4.rpy:4146
translate Schinese dahliasuccess_828374c6:

    # cy "\"You be surprised how quickly mistakes can stack up.\""
    cy "“正所谓一步错，步步错。”"

# game/murdochroute4.rpy:4148
translate Schinese dahliasuccess_689b3ac6:

    # cy "\"Some things are better off not knowing, if it means you don’t piss off the wrong person.\""
    cy "“有些事还是不知道的好，免得得罪不该得罪的人。”"

# game/murdochroute4.rpy:4150
translate Schinese dahliasuccess_e42ee7d6:

    # m "\"I suppose the same goes when people get left in the dark for too long.\""
    m "“一直被人蒙在鼓里，时间久了也得出事。”"

# game/murdochroute4.rpy:4152
translate Schinese dahliasuccess_bc267737:

    # m "\"Now I know this isn’t going to sound {i}sensible{/i}...\""
    m "“我知道这听着不太靠谱...”"

# game/murdochroute4.rpy:4154
translate Schinese dahliasuccess_5659f183:

    # m "\"But I think Lucy was onto something when she thought there was something wrong with that basement.\""
    m "“但我相信Lucy的直觉，那个地下室确实有问题。”"

# game/murdochroute4.rpy:4156
translate Schinese dahliasuccess_8785f4bc:

    # "I don’t know how to tell her that both Murdoch and Blithe were reading Dahlia’s messages."
    "我不知道该怎么告诉她，Murdoch和Blithe都解读出了Dahlia的讯息。"

# game/murdochroute4.rpy:4158
translate Schinese dahliasuccess_c12191dd:

    # "She knows something that she wanted somebody to find."
    "她掌握着某件事，并且希望有人能发现。"

# game/murdochroute4.rpy:4160
translate Schinese dahliasuccess_cf19c923:

    # "But for some reason she could never just come out and say it."
    "但出于某种原因，她从来不直说。"

# game/murdochroute4.rpy:4162
translate Schinese dahliasuccess_edd0c7a4:

    # "She’s afraid about it getting traced back to her."
    "她怕这事会查到她头上。"

# game/murdochroute4.rpy:4164
translate Schinese dahliasuccess_3440caa5:

    # "But why?"
    "但这又是为什么？"

# game/murdochroute4.rpy:4166
translate Schinese dahliasuccess_d504f6b0:

    # m "\"Just trust me when I say this...\""
    m "“总之听我说...”"

# game/murdochroute4.rpy:4168
translate Schinese dahliasuccess_276ff9f9:

    # m "\"...I don’t feel like any force on heaven or on earth could stop some of them from gettin’ through that door.\""
    m "“...我感觉这世上没有什么能阻止某些存在穿过那扇门。”"

# game/murdochroute4.rpy:4170
translate Schinese dahliasuccess_867d8701:

    # "Something about the way I said that must have scared her."
    "她好像被我的说法吓到了。"

# game/murdochroute4.rpy:4172
translate Schinese dahliasuccess_06feb4cf:

    # cy "\"Jesus.\""
    cy "“天啊。”"

# game/murdochroute4.rpy:4174
translate Schinese dahliasuccess_75d0667b:

    # "She puts her hands on her hips, sighing with exasperation."
    "她两手叉腰，恼怒叹气。"

# game/murdochroute4.rpy:4175
translate Schinese dahliasuccess_1f2c9a81:

    # cy "\"...okay.\""
    cy "“...那好吧。”"

# game/murdochroute4.rpy:4176
translate Schinese dahliasuccess_1a61daaf:

    # cy "\"Can you promise that you won’t let anybody know Lucy and I are here if you get caught?\""
    cy "“能答应我，如果你被抓了，别把我和Lucy供出来吗？”"

# game/murdochroute4.rpy:4177
translate Schinese dahliasuccess_896f681c:

    # cy "\"Can you at least promise that?\""
    cy "“可以至少保证这点吗？”"

# game/murdochroute4.rpy:4178
translate Schinese dahliasuccess_7edb3c26:

    # m "\"Well, there {i}are{/i} eight of us--\""
    m "“呃，我们{b}有{/b}八个人-”"

# game/murdochroute4.rpy:4180
translate Schinese dahliasuccess_909b3ca5:

    # ra "\"{i}Nine{/i}.\""
    ra "“{b}是九个。{/b}”"

# game/murdochroute4.rpy:4182
translate Schinese dahliasuccess_596aae0c:

    # m "\"...\""
    m "“...”"

# game/murdochroute4.rpy:4183
translate Schinese dahliasuccess_354cf154:

    # m "\"Nobody will know because of me.\""
    m "“我反正是不会说的。”"

# game/murdochroute4.rpy:4184
translate Schinese dahliasuccess_2614316f:

    # m "\"Lock the door behind us.\""
    m "“我们出发后，把门锁上。”"

# game/murdochroute4.rpy:4185
translate Schinese dahliasuccess_0b62e41b:

    # cy "\"Already planned to.\""
    cy "“我本来就是这个打算。”"

# game/murdochroute4.rpy:4189
translate Schinese dahliasuccess_858ea818:

    # "One by one, we descend into the basement."
    "我们一个接一个地走进地下室。"

# game/murdochroute4.rpy:4191
translate Schinese dahliasuccess_c56a1f5e:

    # "The stairs creak beneath us quietly."
    "楼梯在我们脚下吱嘎作响。"

# game/murdochroute4.rpy:4193
translate Schinese dahliasuccess_127dd781:

    # "I don’t know if it’s just paranoia or the real sensation, but I do feel like we’re being watched."
    "我不确定这是我疑神疑鬼，还是真实的感受，但我们正被监视着。"

# game/murdochroute4.rpy:4194
translate Schinese dahliasuccess_77c1e5c6:

    # "Melissa points out where the false shelf was and {nw}"
    "Melissa指出假书架的位置，{nw}"

# game/murdochroute4.rpy:4198
translate Schinese dahliasuccess_0f15615b:

    # extend "we pull it back."
    extend "我们把它拉开。"

# game/murdochroute4.rpy:4199
translate Schinese dahliasuccess_f2d8c0ed:

    # "The metal door gleams back at us."
    "出现一扇闪着冷光的金属门。"

# game/murdochroute4.rpy:4200
translate Schinese dahliasuccess_657d5de7:

    # "The corridor behind it is too dark to see how far it goes."
    "门后的走廊一片漆黑，望不到尽头。"

# game/murdochroute4.rpy:4202
translate Schinese dahliasuccess_6d4fb261:

    # "I see a lock with four dials."
    "我看到一把四位数的密码锁。"

# game/murdochroute4.rpy:4203
translate Schinese dahliasuccess_add3cf57:

    # "All I have to do is put in the right numbers."
    "只要输入正确的数字就好。"

# game/murdochroute4.rpy:4204
translate Schinese dahliasuccess_175b1271:

    # "Dahlia''s riddle is still fresh in my mind."
    "Dahlia的谜语我还记忆犹新。"

# game/murdochroute4.rpy:4205
translate Schinese dahliasuccess_295d97ce:

    # "{i}There is a Canis Major and a Canis Minor. Orion has a Belt. Its handle is Polaris. He is God’s brightest angel.{/i}"
    "{b}大犬座与小犬座并存于天，猎户座的腰带高悬，以北极星为柄，他乃是神的至耀天使。{/b}"

# game/murdochroute4.rpy:4206
translate Schinese dahliasuccess_151e923b:

    # "I suck in air as I grab hold of the lock in my hand."
    "我深吸一口气，握住那把锁。"

# game/murdochroute4.rpy:4212
translate Schinese basementlock_16ab8929:

    # "I feel a click."
    "咔嗒一声。"

# game/murdochroute4.rpy:4219
translate Schinese basementlock_c33484d2:

    # "The lock won''t budge."
    "锁纹丝不动。"

# game/murdochroute4.rpy:4224
translate Schinese basementlock_a20cefa7:

    # "..."
    "..."

# game/murdochroute4.rpy:4229
translate Schinese basementlock_fb6e33a2:

    # "Shit."
    "操。"

# game/murdochroute4.rpy:4230
translate Schinese basementlock_4f6499cf:

    # "It just won’t open."
    "死活打不开。"

# TODO: Translation updated at 2026-09-01 17:41

# game/murdochroute4.rpy:20
translate Schinese murdochroute4_7c66a342:

    # "Melissa slowly peeks her head around an archway, looking left, then looking right."
    "Melissa从门廊边缓缓探出头，来回张望。"

# game/murdochroute4.rpy:345
translate Schinese schoolexplorationmain_dd45861b:

    # m "\"Would you mind comin’ with us, Miss Washington?\""
    m "“你介意跟我们一起去吗，Washington小姐？”"

# game/murdochroute4.rpy:724
translate Schinese schoolauditorium_d8caa6c6:

    # "That doesn’t seem entirely right to me, but it isn’t like I’m gonna argue about it."
    "感觉不太对，但我懒得跟他争辩。"

# game/murdochroute4.rpy:1161
translate Schinese schoolbasement_c0ed96e8:

    # m "\"...What, books?\""
    m "“...什么怪怪的，书吗？”"

# game/murdochroute4.rpy:1589
translate Schinese schoolclassroom_92bfd7bb:

    # "He removes the lock, then pulls open the drawer."
    "他拿掉锁，拉开抽屉。"

# game/murdochroute4.rpy:2398
translate Schinese schoollibrary_54416a53:

    # "It wouldn’t be hard for somebody to hide in here at all, but {i}why{/i} they would, I can’t figure."
    "要想躲在这是不难，但{b}为什么{/b}就是另一回事了。"

# game/murdochroute4.rpy:2525
translate Schinese schoollibrary_6ba33319:

    # m "\"You found those yearbooks, I take it?\""
    m "“你找到你说的毕业纪念册了？”"

# game/murdochroute4.rpy:2701
translate Schinese schoollibrary_0a6e770f:

    # bl "\"You mean the little Miss Byrnes.\""
    bl "“你是指小Byrnes女士。”"

# game/murdochroute4.rpy:2764
translate Schinese schoollibrary_193551f6:

    # m "\"...Huh?\""
    m "“...啊？”"

# game/murdochroute4.rpy:2950
translate Schinese schoolconvos_4ae23770:

    # m "\"Take a deep breath or something’.\""
    m "“你先做个深呼吸之类的。”"

# game/murdochroute4.rpy:3109
translate Schinese schoolconvos_dc74eaf3:

    # m "\"I’ve done way more for men than make them smile, and I don’t know most of their names, either.\""
    m "“我为很多男人做过不只让他们开心的事，也都不知道他们大部分的人的名字。”"

# game/murdochroute4.rpy:3310
translate Schinese schoolconvos_23292c9f:

    # bl "\"Getting five grown men to cooperate is more than I could ever do on my own, so there’s something about you that I figure is useful to have around.\""
    bl "“找来五个大男人乖乖合作，靠我自己一个人永远办不到，所以你也不是一无是处。”"

# game/murdochroute4.rpy:3407
translate Schinese dahliaprogression_744fa477:

    # "That feeling of dread isn’t new, but I can’t help but feel it get worse the higher I go."
    "这种恐慌也不算新奇了，但爬得越高，我就越是不安。"

# game/murdochroute4.rpy:3441
translate Schinese dahliaprogression_78d1aaa5:

    # m "\"Murdoch’s been turnin’ over every rock in creation lookin’ for you.\""
    m "“Murdoch正在到处找你。”"

# game/murdochroute4.rpy:3577
translate Schinese dahliaprogression_532d72cd:

    # dh "\"Because I am the only one who can do what I am doing, Mr. Ayers.\""
    dh "“现在能胜任这项工作的只有我一人，Ayers先生。”"

# game/murdochroute4.rpy:3588
translate Schinese dahliaprogression_d5ac6034:

    # dh "\"This sky is {i}not{/i} my sky, Mr. Ayers, nor is it yours.\""
    dh "“这片天空{b}并非{/b}我的天空，Ayers先生，也不是你的。”"

# game/murdochroute4.rpy:3882
translate Schinese dahliasuccess_923b805c:

    # dh "\"Light which exists on a frequency that, in many ways...\""
    dh "“那些光以特定的频率存在...”"

# game/murdochroute4.rpy:3967
translate Schinese dahliasuccess_35734da7:

    # "They turn their necks when they hear us walking."
    "一听见我们的脚步声便转过头来。"

# game/murdochroute4.rpy:4036
translate Schinese dahliasuccess_dc566b16:

    # m "\"Well, if he’s the arsonist, I’d like to make sure he doesn’t have an opportunity to smoke us up while we sleep.\""
    m "“这个嘛，如果他是纵火犯，我可不想让他趁我们睡着时放火把我们熏死。”"

# game/murdochroute4.rpy:4059
translate Schinese dahliasuccess_380c51b2:

    # ji "\"Asking for a rational explanation for something risky isn’t fear.\""
    ji "“这不是胆小怕事，是对一件有风险的事寻求合理的解释。”"

# game/murdochroute4.rpy:4083
translate Schinese dahliasuccess_5673332a:

    # cy "\"...Right.\""
    cy "“...行吧。”"

# game/murdochroute4.rpy:4087
translate Schinese dahliasuccess_5d03ce78:

    # cy "\"...How about the men go {i}downstairs{/i} and the women stay {i}upstairs?{/i}\""
    cy "“...要不然男人{b}下去{/b}，女人留在{b}楼上{/b}，如何？”"

# game/murdochroute4.rpy:4132
translate Schinese dahliasuccess_75797f8f:

    # cy "\"If it’s just the two of us, we aren’t going to be able to take breaks or check on the rest of you.\""
    cy "“如果只有我们两个，就没法休息或去查看你们的情况了。”"

# game/murdochroute4.rpy:4138
translate Schinese dahliasuccess_abf8c6df:

    # m "\"...eight people manage to get in trouble, you shouldn’t come down for us anyway.\""
    m "“去的八个人全都出事了，我看你们也别来找了。”"

# game/murdochroute4.rpy:4146
translate Schinese dahliasuccess_f57eb7e8:

    # m "\"I feel good about the odds, Cynthia.\""
    m "“我觉得胜算挺大的，Cynthia。”"

# game/murdochroute4.rpy:4148
translate Schinese dahliasuccess_acbb3e1f:

    # cy "\"You'd be surprised how quickly mistakes can stack up.\""
    cy "“正所谓一步错，步步错。”"

# game/murdochroute4.rpy:4150
translate Schinese dahliasuccess_ff3d4dce:

    # cy "\"Some things we’re better off not knowing, if it means you don’t piss off the wrong person.\""
    cy "“有些事还是不知道的好，免得得罪不该得罪的人。”"

# game/murdochroute4.rpy:4156
translate Schinese dahliasuccess_ea45c0f9:

    # m "\"...but I think Lucy was onto something when she thought there was something wrong with that basement.\""
    m "“但我相信Lucy的直觉，那个地下室确实有问题。”"

# game/murdochroute4.rpy:4177
translate Schinese dahliasuccess_9d55735c:

    # cy "\"...Okay.\""
    cy "“...那好吧。”"

# game/murdochroute4.rpy:4206
translate Schinese dahliasuccess_1fdbdce4:

    # "Dahlia’s riddle is still fresh in my mind."
    "Dahlia的谜语我还记忆犹新。"

# game/murdochroute4.rpy:4221
translate Schinese basementlock_b0e24b94:

    # "The lock won’t budge."
    "锁纹丝不动。"

# TODO: Translation updated at 2026-08-05 05:59

# game/murdochroute4.rpy:4239
translate Schinese basementlocklasttry_14317e0f:

    # m "\"It’s not opening.\""
    m "“打不开。”"

# game/murdochroute4.rpy:4240
translate Schinese basementlocklasttry_d7951e47:

    # m "\"...Why doesn’t she just tell us the damn combination?\""
    m "“...她怎么就不能痛快点，把那破密码告诉我们？”"

# game/murdochroute4.rpy:4242
translate Schinese basementlocklasttry_05c389ec:

    # mu "\"I think some part of her doesn’t want us to get through these doors.\""
    mu "“我想，她心里还在犹豫要不要让我们进去。”"

# game/murdochroute4.rpy:4244
translate Schinese basementlocklasttry_e742f0f7:

    # mu "\"...What did she tell you?\""
    mu "“...她跟你说了什么？”"

# game/murdochroute4.rpy:4245
translate Schinese basementlocklasttry_c903d4d9:

    # "I list off the phrases, one by one."
    "我把那些话一句句报了出来。"

# game/murdochroute4.rpy:4247
translate Schinese basementlocklasttry_e4419124:

    # mu "\"Hrm.\""
    mu "“嗯...”"

# game/murdochroute4.rpy:4249
translate Schinese basementlocklasttry_a5c715d0:

    # mu "\"The thing about Dahlia is that she refuses to be straightforward.\""
    mu "“Dahlia这人说话就爱拐弯抹角。”"

# game/murdochroute4.rpy:4251
translate Schinese basementlocklasttry_dc301fdf:

    # mu "\"Some of those phrases seem to be talking about individual stars and some seem to be talking about constellations.\""
    mu "“有的句子像是在指星体，有的则像是在指星座。”"

# game/murdochroute4.rpy:4252
translate Schinese basementlocklasttry_2433992f:

    # mu "\"Figuring out which is which will probably give us the combination.\""
    mu "“把这些理清楚，应该就能解出密码了。”"

# game/murdochroute4.rpy:4259
translate Schinese basementlocklasttry_16ab8929:

    # "I feel a click."
    "咔嗒一声。"

# game/murdochroute4.rpy:4268
translate Schinese basementlocklasttry_a6dcd2bb:

    # m "\"It won’t open.\""
    m "“打不开。”"

# game/murdochroute4.rpy:4270
translate Schinese basementlocklasttry_1896907e:

    # m "\"It still won’t open.\""
    m "“还是打不开。”"

# game/murdochroute4.rpy:4272
translate Schinese basementlocklasttry_30e861b8:

    # mu "\"Are you going to try again?\""
    mu "“要不要再试几次？”"

# game/murdochroute4.rpy:4273
translate Schinese basementlocklasttry_cd399b0f:

    # m "\"I don’t think it will make a difference.\""
    m "“试了也白试。”"

# game/murdochroute4.rpy:4275
translate Schinese basementlocklasttry_dc098958:

    # me "\"Um... excuse me?\""
    me "“那个...打扰一下？”"

# game/murdochroute4.rpy:4276
translate Schinese basementlocklasttry_ac24eeaf:

    # "We hear the rabbit’s voice calling from the top of the stairs."
    "兔子在楼梯顶上喊话。"

# game/murdochroute4.rpy:4277
translate Schinese basementlocklasttry_fb4a7567:

    # me "\"There’s somebody here at the door.\""
    me "“门口有人来了。”"

# game/murdochroute4.rpy:4278
translate Schinese basementlocklasttry_f7f6cefc:

    # me "\"We’re not sure if we should let them in or not.\""
    me "“我们不确定该不该放他进来。”"

# game/murdochroute4.rpy:4280
translate Schinese basementlocklasttry_76cc4abf:

    # ra "\"Who is it?\""
    ra "“是谁？”"

# game/murdochroute4.rpy:4281
translate Schinese basementlocklasttry_37cb56b1:

    # me "\"Um...\""
    me "“呃...”"

# game/murdochroute4.rpy:4282
translate Schinese basementlocklasttry_d26d2ff7:

    # me "\"We don’t know, but--\""
    me "“我们不知道，但是-”"

# game/murdochroute4.rpy:4284
translate Schinese basementlocklasttry_12ac7066:

    # cy "\"They’re unlocking the door!\""
    cy "“他在开锁！”"

# game/murdochroute4.rpy:4285
translate Schinese basementlocklasttry_a9e923ab:

    # cy "\"Somebody get up here!\""
    cy "“快点，上来个人！”"

# game/murdochroute4.rpy:4287
translate Schinese basementlocklasttry_cceadb2e:

    # "I stare at that cellar door again."
    "我又看向地窖的门。"

# game/murdochroute4.rpy:4288
translate Schinese basementlocklasttry_fd468c2a:

    # "Something about it makes me feel like it wants to be unlocked."
    "不知道为什么，我觉得那扇门正等着被人打开。"

# game/murdochroute4.rpy:4289
translate Schinese basementlocklasttry_2e2f44f7:

    # "Wants us inside."
    "它想让我们进去。"

# game/murdochroute4.rpy:4290
translate Schinese basementlocklasttry_aa7eedc0:

    # "Murdoch is staring at it harder than me."
    "Murdoch比我看得还专注。"

# game/murdochroute4.rpy:4291
translate Schinese basementlocklasttry_ab598825:

    # "Maybe leaving it be might be for the best."
    "也许放着不管反而是对的。"

# game/murdochroute4.rpy:4292
translate Schinese basementlocklasttry_8794e2d9:

    # m "\"Coming.\""
    m "“来了。”"

# game/murdochroute4.rpy:4294
translate Schinese basementlocklasttry_64e2e099:

    # mu "\"But what about the door?\""
    mu "“那门怎么办？”"

# game/murdochroute4.rpy:4295
translate Schinese basementlocklasttry_6302ff6f:

    # m "\"It’s not going anywhere.\""
    m "“它又不会长腿跑掉。”"

# game/murdochroute4.rpy:4296
translate Schinese basementlocklasttry_85c99b79:

    # m "\"Leave it be for now.\""
    m "“先别管了。”"

# game/murdochroute4.rpy:4298
translate Schinese basementlocklasttry_8d1c4e0f:

    # "Disappointment washes over his face."
    "他的脸上写满了失望。"

# game/murdochroute4.rpy:4299
translate Schinese basementlocklasttry_f5fbccc2:

    # "His fixation on that door worries me some."
    "他对那道门的执着让我有点不安。"

# game/murdochroute4.rpy:4300
translate Schinese basementlocklasttry_cf9e7561:

    # m "\"Let’s just do one thing at a time, yeah?\""
    m "“事情一件一件做，别想太多，好吗？”"

# game/murdochroute4.rpy:4302
translate Schinese basementlocklasttry_7c15d310:

    # mu "\"I really think we should be focusing on this.\""
    mu "“我真的认为这个才是关键中的关键。”"

# game/murdochroute4.rpy:4303
translate Schinese basementlocklasttry_58fd3e52:

    # m "\"Well, maybe somebody smarter than me can figure out the combination then.\""
    m "“成，那就找个比我聪明的人来解密码。”"

# game/murdochroute4.rpy:4304
translate Schinese basementlocklasttry_53f10690:

    # m "\"Let’s just see who’s at the door for now, okay?\""
    m "“咱们先去看看谁在门口，行吧？”"

# game/murdochroute4.rpy:4306
translate Schinese basementlocklasttry_fa98d387:

    # "He bites his bottom lip."
    "他咬住下唇。"

# game/murdochroute4.rpy:4308
translate Schinese basementlocklasttry_3a5001d4:

    # mu "\"Fine.\""
    mu "“好。”"

# game/murdochroute4.rpy:4311
translate Schinese basementlocklasttry_0d81a592:

    # "The wooden steps creak and groan from how fast I stomp up them."
    "我快步上楼，踩得木头地板吱嘎作响。"

# game/murdochroute4.rpy:4332
translate Schinese failuremerge_c610577a:

    # "Everybody in the atrium is looking at the front door."
    "中庭里的人们齐刷刷地望着前门。"

# game/murdochroute4.rpy:4334
translate Schinese failuremerge_a81f9de0:

    # "The end of a long, narrow key slips through the lock."
    "一把细长的钥匙缓缓插进了锁孔。"

# game/murdochroute4.rpy:4336
translate Schinese failuremerge_1fbc6c56:

    # "It turns."
    "转动。"

# game/murdochroute4.rpy:4338
translate Schinese failuremerge_73379d98:

    # "Clicks softly."
    "咔哒一声。"

# game/murdochroute4.rpy:4340
translate Schinese failuremerge_f2d007b0:

    # "Holly Byrnes steps through the doorway."
    "Holly Byrnes走进门来。"

# game/murdochroute4.rpy:4343
translate Schinese failuremerge_1eb98365:

    # "She pauses, seeing all of us staring back at her."
    "她见所有人都在盯着她看，便停下脚步。"

# game/murdochroute4.rpy:4345
translate Schinese failuremerge_18e8b3d2:

    # ho "\"What are you all doing here?!\""
    ho "“你们在这儿做什么？！”"

# game/murdochroute4.rpy:4348
translate Schinese failuremerge_1175694b:

    # ho "\"Who let you in?!\""
    ho "“谁允许你们进来的？！”"

# game/murdochroute4.rpy:4352
translate Schinese failuremerge_f57bed26:

    # "Murdoch steps forward."
    "Murdoch走上前。"

# game/murdochroute4.rpy:4354
translate Schinese failuremerge_0b20fa5e:

    # mu "\"Sorry.\""
    mu "“对不起。”"

# game/murdochroute4.rpy:4357
translate Schinese failuremerge_527333f8:

    # "Holly sees him, and her expression shifts from surprised to irritated."
    "Holly看到他，脸上先是惊讶，接着转为不悦。"

# game/murdochroute4.rpy:4360
translate Schinese failuremerge_fa43ebc0:

    # ho "\"Of course.\""
    ho "“我就知道。”"

# game/murdochroute4.rpy:4363
translate Schinese failuremerge_722128ef:

    # ho "\"Now we’ll never hear the end of this.\""
    ho "“这下可好，爸妈肯定又要抱怨个没完了。”"

# game/murdochroute4.rpy:4366
translate Schinese failuremerge_6ac71d17:

    # ho "\"Why did you think this was a good idea?\""
    ho "“你到底是怎么想的？”"

# game/murdochroute4.rpy:4368
translate Schinese failuremerge_04b9e317:

    # mu "\"We’ve used the school for emergency contingencies before.\""
    mu "“这学校过去充当过紧急避险的场所。”"

# game/murdochroute4.rpy:4370
translate Schinese failuremerge_c9f15e1b:

    # ho "\"The church was sufficiently safe.\""
    ho "“教堂已经很安全了。”"

# game/murdochroute4.rpy:4373
translate Schinese failuremerge_08766c0a:

    # mu "\"We wanted to be away from the fires and as close to the train as possible.\""
    mu "“我们想避开起火点，同时尽量靠近火车站。”"

# game/murdochroute4.rpy:4375
translate Schinese failuremerge_7f620fce:

    # ho "\"Well what’s the point of--\""
    ho "“那有什么意义-”"

# game/murdochroute4.rpy:4377
translate Schinese failuremerge_4989ebf0:

    # "Her gaze meets somebody else's."
    "她的目光与某人对上。"

# game/murdochroute4.rpy:4378
translate Schinese failuremerge_d4cd4983:

    # "I turn around to see Jim staring down from the top of the stairs."
    "我转身，发现Jim正从楼上望着这边。"

# game/murdochroute4.rpy:4381
translate Schinese failuremerge_9c95ae76:

    # "Her expression softens."
    "她的脸色缓和了一些。"

# game/murdochroute4.rpy:4383
translate Schinese failuremerge_3af91d8b:

    # ho "\"...I wasn’t sure that I’d be seeing you again.\""
    ho "“...我本来以为再也见不到你了。”"

# game/murdochroute4.rpy:4385
translate Schinese failuremerge_d4ae121f:

    # "He scowls."
    "他皱起眉头。"

# game/murdochroute4.rpy:4387
translate Schinese failuremerge_693fd103:

    # ji "\"Everybody’s leaving, Holly.\""
    ji "“大家都要走了，Holly。”"

# game/murdochroute4.rpy:4390
translate Schinese failuremerge_050711d6:

    # ji "\"First chance that we get.\""
    ji "“一有机会就走。”"

# game/murdochroute4.rpy:4393
translate Schinese failuremerge_293c4eb9:

    # ho "\"Well, obviously.\""
    ho "“嗯，这不用说。”"

# game/murdochroute4.rpy:4396
translate Schinese failuremerge_a94e2e2e:

    # ho "\"Half of downtown’s already been swallowed by flames.\""
    ho "“半个镇都被烧没了。”"

# game/murdochroute4.rpy:4399
translate Schinese failuremerge_0bd0e9aa:

    # ji "\"...Do you regret that?\""
    ji "“...你后悔吗？”"

# game/murdochroute4.rpy:4402
translate Schinese failuremerge_027058b1:

    # ho "\"Of course I regret that.\""
    ho "“我怎么可能不后悔。”"

# game/murdochroute4.rpy:4405
translate Schinese failuremerge_d4c5585e:

    # ji "\"Good to know you’re capable.\""
    ji "“挺好的，你还有良知。”"

# game/murdochroute4.rpy:4408
translate Schinese failuremerge_a264eff7:

    # "She opens her mouth, as if to speak, {nw}"
    "她张开嘴，像是要说话，{nw}"

# game/murdochroute4.rpy:4410
translate Schinese failuremerge_fefeb965:

    # extend "then closes it."
    extend "然后又闭上。"

# game/murdochroute4.rpy:4412
translate Schinese failuremerge_4c13c181:

    # ho "\"Yes, I’m capable.\""
    ho "“是啊，我有。”"

# game/murdochroute4.rpy:4414
translate Schinese failuremerge_71e2a82c:

    # "They stare at each other, in silence."
    "他们沉默地对视着。"

# game/murdochroute4.rpy:4416
translate Schinese failuremerge_53faec48:

    # "It’s almost like they’ve forgotten everybody else in the room."
    "仿佛屋里再无他人。"

# game/murdochroute4.rpy:4418
translate Schinese failuremerge_e48a1508:

    # ho "\"Could we speak in private?\""
    ho "“我们能私下谈谈吗？”"

# game/murdochroute4.rpy:4420
translate Schinese failuremerge_97b865c8:

    # "Jim makes a beckoning gesture with his hand."
    "Jim朝她招了招手。"

# game/murdochroute4.rpy:4422
translate Schinese failuremerge_75f768b2:

    # "Quickly, she glides up the stairs."
    "她轻盈地上了楼。"

# game/murdochroute4.rpy:4426
translate Schinese failuremerge_f478266f:

    # "The two of them disappear in the direction of the library."
    "两人一前一后，消失在了图书馆的方向。"

# game/murdochroute4.rpy:4428
translate Schinese failuremerge_de050a39:

    # m "\"She looks like she forgot what she was going to say real quick.\""
    m "“瞧她那样儿，连自己想说什么都忘了。”"

# game/murdochroute4.rpy:4430
translate Schinese failuremerge_2b213610:

    # ra "\"Wouldn’t be the first time.\""
    ra "“也不是第一次了。”"

# game/murdochroute4.rpy:4432
translate Schinese failuremerge_878a2deb:

    # "Ralph’s tail is curling with agitation."
    "Ralph的尾巴烦躁地卷曲着。"

# game/murdochroute4.rpy:4434
translate Schinese failuremerge_c81c8947:

    # ra "\"He’s always had that effect on her.\""
    ra "“他对她的影响就是这么大。”"

# game/murdochroute4.rpy:4436
translate Schinese failuremerge_c2a90e79:

    # ra "\"I don’t like those two being alone together.\""
    ra "“我不放心让他们两个独处。”"

# game/murdochroute4.rpy:4438
translate Schinese failuremerge_7301e869:

    # mu "\"Let them be.\""
    mu "“随他们去吧。”"

# game/murdochroute4.rpy:4440
translate Schinese failuremerge_259f44ef:

    # mu "\"If it’s anything, she’s trying to apologize again.\""
    mu "“估计也就是她想再道一次歉。”"

# game/murdochroute4.rpy:4443
translate Schinese failuremerge_9a3ca57f:

    # ra "\"Funny how it’s never to you.\""
    ra "“有意思，她从来没对你道过歉。”"

# game/murdochroute4.rpy:4445
translate Schinese failuremerge_a2234e0e:

    # "The fox lowers his voice."
    "狐狸压低声音。"

# game/murdochroute4.rpy:4447
translate Schinese failuremerge_8f8650a3:

    # mu "\"That’s just how it works when you’re family.\""
    mu "“一家人向来如此。”"

# game/murdochroute4.rpy:4449
translate Schinese failuremerge_2c065278:

    # "Ralph opens his mouth to push back but the glare Murdoch gives him stops him."
    "Ralph刚要反驳，却被Murdoch一个眼神给堵了回去。"

# game/murdochroute4.rpy:4451
translate Schinese failuremerge_0e4d3fc9:

    # ra "\"...Lunacy.\""
    ra "“...真是疯了。”"

# game/murdochroute4.rpy:4455
translate Schinese failuremerge_cf0f533c:

    # "Ralph steps away, squatting in a corner."
    "Ralph退到角落里蹲下。"

# game/murdochroute4.rpy:4457
translate Schinese failuremerge_442bd256:

    # ra "\"You know, they banished my ancestors to an island for very good reason.\""
    ra "“你知道吗，我祖先被流放到岛上，那可不是被冤枉的。”"

# game/murdochroute4.rpy:4460
translate Schinese failuremerge_e85c1fc4:

    # ra "\"Criminal is criminal.\""
    ra "“罪犯就是罪犯。”"

# game/murdochroute4.rpy:4461
translate Schinese failuremerge_d92897ca:

    # ra "\"And blood be damned.\""
    ra "“血缘算个屁。”"

# game/murdochroute4.rpy:4463
translate Schinese failuremerge_86488cbf:

    # "Murdoch’s tail swishes with agitation."
    "Murdoch不耐烦地甩动着尾巴。"

# game/murdochroute4.rpy:4465
translate Schinese failuremerge_c57ba101:

    # "I can’t say my relations with my own family were much different."
    "我跟家里人的关系其实也没好到哪去。"

# game/murdochroute4.rpy:4467
translate Schinese failuremerge_1d423401:

    # "Forgiveness was mandated."
    "强制性的原谅。"

# game/murdochroute4.rpy:4469
translate Schinese failuremerge_714a5be3:

    # "You honored your elders."
    "必须尊敬长辈。"

# game/murdochroute4.rpy:4471
translate Schinese failuremerge_0d3044ce:

    # "You didn’t break covenants with your siblings."
    "不能对兄弟姐妹食言。"

# game/murdochroute4.rpy:4473
translate Schinese failuremerge_de43df30:

    # "That was just how it was."
    "向来如此。"

# game/murdochroute4.rpy:4475
translate Schinese failuremerge_53cf37bb:

    # "It’s partly why I ran from them."
    "这也是我当初逃走的原因之一。"

# game/murdochroute4.rpy:4483
translate Schinese failuremerge_671f3613:

    # reu "\"I won’t complain if he’s listening to her so we don’t have to.\""
    reu "“他愿意听她唠叨，那正好，总比我们听强。”"

# game/murdochroute4.rpy:4486
translate Schinese failuremerge_16b8b276:

    # reu "\"She’s his ball and chain.\""
    reu "“她是他的拖油瓶。”"

# game/murdochroute4.rpy:4489
translate Schinese failuremerge_e379c35a:

    # reu "\"Not mine.\""
    reu "“不是我的。”"

# game/murdochroute4.rpy:4492
translate Schinese failuremerge_3e8ca38b:

    # mu "\"Looks like they’re smoothing things over.\""
    mu "“看来他们要和好了。”"

# game/murdochroute4.rpy:4494
translate Schinese failuremerge_61baea5d:

    # m "\"...What makes you say that?\""
    m "“...怎么说？”"

# game/murdochroute4.rpy:4497
translate Schinese failuremerge_89fb2cc3:

    # "The dog barks out a quiet laugh."
    "狗低笑了一声。"

# game/murdochroute4.rpy:4499
translate Schinese failuremerge_e504dae6:

    # nei "\"I’ve seen this happen countless times.\""
    nei "“老戏码了。”"

# game/murdochroute4.rpy:4502
translate Schinese failuremerge_19f7ea5b:

    # nei "\"I know the body language.\""
    nei "“光看他们的动作我就知道。”"

# game/murdochroute4.rpy:4505
translate Schinese failuremerge_1afd945c:

    # nei "\"Relationships of this manner always fall back into place, in spite of the hiccups.\""
    nei "“他们这种关系，不管中间闹成什么样，兜兜转转总会回到原点。”"

# game/murdochroute4.rpy:4512
translate Schinese failuremerge_5791b968:

    # "I’m not sure if that’s true, not that it’s my business, or that I even care."
    "我不知道这是真是假，但反正与我无关，我也不在乎。"

# game/murdochroute4.rpy:4514
translate Schinese failuremerge_e7402532:

    # "But if she’s too preoccupied to push us out of the school for the night, that’s all we need to pass until morning."
    "要是她忙着应付Jim，顾不上赶人，我们就能在学校里安安稳稳待上一晚。"

# game/murdochroute4.rpy:4517
translate Schinese failuremerge_8451333b:

    # "I try my best to stay awake, but I’m more exhausted than I realized, and stopping for a spell is all my body needs to feel heavy."
    "我硬撑着保持清醒，可刚歇了歇脚，整个身子就沉得抬不起来。"

# game/murdochroute4.rpy:4518
translate Schinese failuremerge_685de594:

    # "Before I know it, I feel my eyes flipping open."
    "不知过了多久，我睁开眼睛。"

# game/murdochroute4.rpy:4520
translate Schinese failuremerge_6af86606:

    # "I see sunlight stream through the windows."
    "看见阳光从窗户洒进来。"

# game/murdochroute4.rpy:4522
translate Schinese failuremerge_ae3d2d77:

    # "It’s morning."
    "已经是早上了。"

# game/murdochroute4.rpy:4524
translate Schinese failuremerge_b487d419:

    # ra "\"Good morning, your highness.\""
    ra "“早安，王子殿下。”"

# game/murdochroute4.rpy:4526
translate Schinese failuremerge_f08d229d:

    # m "\"...Shit.\""
    m "“...淦。”"

# game/murdochroute4.rpy:4528
translate Schinese failuremerge_5855582e:

    # m "\"I don’t remember falling asleep.\""
    m "“我都不记得自己睡着了。”"

# game/murdochroute4.rpy:4530
translate Schinese failuremerge_eae26027:

    # ra "\"Well.\""
    ra "“嗯。”"

# game/murdochroute4.rpy:4532
translate Schinese failuremerge_2c0c9271:

    # ra "\"You did.\""
    ra "“你确实睡了。”"

# game/murdochroute4.rpy:4534
translate Schinese failuremerge_3eaf512a:

    # ra "\"Jim’s group already left for the station.\""
    ra "“Jim那伙人已经去车站了。”"

# game/murdochroute4.rpy:4536
translate Schinese failuremerge_1e701bfb:

    # m "\"They went without us?\""
    m "“就这么撂下咱们？”"

# game/murdochroute4.rpy:4538
translate Schinese failuremerge_d670fa20:

    # ra "\"Are you surprised?\""
    ra "“意外吗？”"

# game/murdochroute4.rpy:4540
translate Schinese failuremerge_531d71da:

    # ra "\"Our usefulness has run out.\""
    ra "“我们已经没用了。”"

# game/murdochroute4.rpy:4542
translate Schinese failuremerge_9b3221f3:

    # ra "\"Of course, Holly was quite insistent that they leave without waking too many people up.\""
    ra "“而且Holly特地让他们悄悄走，别把人给弄醒了。”"

# game/murdochroute4.rpy:4544
translate Schinese failuremerge_d58b68ee:

    # m "\"...Who’s left?\""
    m "“...还有谁在？”"

# game/murdochroute4.rpy:4546
translate Schinese failuremerge_6e33976a:

    # ra "\"Just the Hip workers.\""
    ra "“只剩Hip的员工。”"

# game/murdochroute4.rpy:4548
translate Schinese failuremerge_71152eb4:

    # ra "\"Those two girls must have slipped off sometime when Holly arrived.\""
    ra "“那两个女孩多半是Holly来的时候就趁机溜走了。”"

# game/murdochroute4.rpy:4550
translate Schinese failuremerge_d2ef88e2:

    # cy "\"Sam?\""
    cy "“Sam？”"

# game/murdochroute4.rpy:4552
translate Schinese failuremerge_ca9a236e:

    # "I feel a little more at ease when I hear Cynthia’s voice."
    "听到Cynthia的声音，我感觉轻松了一点。"

# game/murdochroute4.rpy:4554
translate Schinese failuremerge_f2093ff4:

    # "She walks toward me, rubbing her eyes."
    "她揉着眼睛走向我。"

# game/murdochroute4.rpy:4556
translate Schinese failuremerge_a5081413:

    # "I’ve rarely ever seen her this tired."
    "我很少看到她这么累。"

# game/murdochroute4.rpy:4558
translate Schinese failuremerge_f14adaeb:

    # cy "\"It’s good that you’re up.\""
    cy "“你醒了就好。”"

# game/murdochroute4.rpy:4560
translate Schinese failuremerge_354d8cbf:

    # cy "\"I was worried you were going to keep sleeping.\""
    cy "“我还担心你会睡死过去呢。”"

# game/murdochroute4.rpy:4562
translate Schinese failuremerge_690e867f:

    # m "\"Shit.\""
    m "“操。”"

# game/murdochroute4.rpy:4564
translate Schinese failuremerge_fd2eb9ea:

    # m "\"How late is it?\""
    m "“现在几点了？”"

# game/murdochroute4.rpy:4566
translate Schinese failuremerge_b08f1847:

    # cy "\"I’d wager about half past ten.\""
    cy "“我猜大概十点半吧。”"

# game/murdochroute4.rpy:4568
translate Schinese failuremerge_1c238f71:

    # cy "\"We need to be off if we want to make the noon train.\""
    cy "“要赶上正午的火车，咱们得抓紧了。”"

# game/murdochroute4.rpy:4570
translate Schinese failuremerge_6bff4e6b:

    # m "\"...Yeah.\""
    m "“...嗯。”"

# game/murdochroute4.rpy:4572
translate Schinese failuremerge_a2832ddf:

    # m "\"It would be good to go soon then, wouldn’t it?\""
    m "“确实该出发了。”"

# game/murdochroute4.rpy:4574
translate Schinese failuremerge_90cd340b:

    # m "\"Where’s Murdoch?\""
    m "“Murdoch人呢？”"

# game/murdochroute4.rpy:4576
translate Schinese failuremerge_ec108c2f:

    # ra "\"He’s already at the station.\""
    ra "“他早就到车站了。”"

# game/murdochroute4.rpy:4578
translate Schinese failuremerge_d558ef9b:

    # "...Huh?"
    "...啊？"

# game/murdochroute4.rpy:4580
translate Schinese failuremerge_fdcfd18e:

    # m "\"Why?\""
    m "“为什么？”"

# game/murdochroute4.rpy:4582
translate Schinese failuremerge_063d0e48:

    # ra "\"Why don’t you ask him?\""
    ra "“你去问他啊？”"

# game/murdochroute4.rpy:4584
translate Schinese failuremerge_5119ff21:

    # m "\"What’s that supposed to mean?\""
    m "“什么意思？”"

# game/murdochroute4.rpy:4586
translate Schinese failuremerge_3693e18a:

    # ra "\"You’re the one he’s been talking to the last few weeks.\""
    ra "“他这几周一直在谈的人，不就是你吗。”"

# game/murdochroute4.rpy:4588
translate Schinese failuremerge_7e045c2e:

    # ra "\"He’d tell you before he told me.\""
    ra "“比起我，他肯定会先告诉你。”"

# game/murdochroute4.rpy:4590
translate Schinese failuremerge_3520f701:

    # "The rat sounds a bit resentful."
    "老鼠语气发酸。"

# game/murdochroute4.rpy:4592
translate Schinese failuremerge_cee8d13f:

    # m "\"I just didn’t think he’d go to the station without me is all.\""
    m "“我只是没想到他会撇下我，自己去车站。”"

# game/murdochroute4.rpy:4594
translate Schinese failuremerge_806c9704:

    # ra "\"When Murdoch wants to do something, there’s no talking to him about it.\""
    ra "“Murdoch下定决心想做的事，没人劝得动。”"

# game/murdochroute4.rpy:4596
translate Schinese failuremerge_0fd799fd:

    # ra "\"He makes up his mind and he does it.\""
    ra "“他铁了心的。”"

# game/murdochroute4.rpy:4598
translate Schinese failuremerge_36fbab8a:

    # m "\"That doesn’t sound like him.\""
    m "“这听着不像他。”"

# game/murdochroute4.rpy:4600
translate Schinese failuremerge_cd2594d0:

    # ra "\"I’ve known him a lot longer than you have.\""
    ra "“我认识他比你久多了。”"

# game/murdochroute4.rpy:4602
translate Schinese failuremerge_a4dcf766:

    # ra "\"Anyways, if you want to talk to him about it, you’d better catch him at the station before the train is off.\""
    ra "“总之，你要想当面问他，就别在这儿磨蹭了。”"

# game/murdochroute4.rpy:4604
translate Schinese failuremerge_ff5f4bbc:

    # "Right."
    "是啊。"

# game/murdochroute4.rpy:4606
translate Schinese failuremerge_9acddd6a:

    # "There’s no use speculating anyway."
    "反正瞎猜也没用。"

# game/murdochroute4.rpy:4608
translate Schinese failuremerge_babbf797:

    # m "\"Are we all ready?\""
    m "“大家都准备好了吗？”"

# game/murdochroute4.rpy:4610
translate Schinese failuremerge_d7009bf1:

    # cy "\"Yeah.\""
    cy "“嗯。”"

# game/murdochroute4.rpy:4612
translate Schinese failuremerge_3b4d8dd3:

    # lu "\"...I’m real dizzy.\""
    lu "“...我头好晕。”"

# game/murdochroute4.rpy:4614
translate Schinese failuremerge_3d4c8fe2:

    # cy "\"You’ll feel better once we get you away from all this bad air...\""
    cy "“这里空气不好，等出去后你就能缓过来了...”"

# game/murdochroute4.rpy:4617
translate Schinese failuremerge_9c6db5df:

    # cy "\"Let’s go, gentlemen.\""
    cy "“出发吧，各位。”"

# game/murdochroute4.rpy:4620
translate Schinese failuremerge_a5327c5b:

    # "The sky is a pale white rather than bloody red."
    "血红褪去，天空一片苍白。"

# game/murdochroute4.rpy:4622
translate Schinese failuremerge_9c5d1013:

    # "The ruins of Echo’s downtown smolder in the distance as we trudge along."
    "我们向前走着，视线越过荒地，看见远处的回声镇残骸仍在冒烟。"

# game/murdochroute4.rpy:4624
translate Schinese failuremerge_75a77bbe:

    # "We take about thirty feet of steps out the front door before we hear a noise."
    "出门没一会儿，大概三十英尺左右，我们听到一声响动。"

# game/murdochroute4.rpy:4626
translate Schinese failuremerge_e9f4fc11:

    # "The door slams behind us."
    "身后的门砰地关上了。"

# game/murdochroute4.rpy:4628
translate Schinese failuremerge_ef44780f:

    # m "\"That was the younger sister, wasn’t it?\""
    m "“那是他妹妹吧？”"

# game/murdochroute4.rpy:4630
translate Schinese failuremerge_b35f8e9b:

    # "Ralph looks back."
    "Ralph回头望去。"

# game/murdochroute4.rpy:4632
translate Schinese failuremerge_804e8901:

    # "He looks like he’s thinking."
    "若有所思。"

# game/murdochroute4.rpy:4634
translate Schinese failuremerge_6312e981:

    # ra "\"Her whole life’s achievements are wrapped up in this place.\""
    ra "“她的毕生心血全在这里。”"

# game/murdochroute4.rpy:4636
translate Schinese failuremerge_d1fa1774:

    # ra "\"Makes some sense that she wouldn’t bring herself to leave.\""
    ra "“她舍不得离开也情有可原。”"

# game/murdochroute4.rpy:4637
translate Schinese failuremerge_90c39e8d:

    # "Something is bothering me, but I can’t tell what."
    "有点不对劲，可我也说不准是什么。"

# game/murdochroute4.rpy:4639
translate Schinese failuremerge_f04dccb3:

    # "Maybe it’s the way in which the door slammed."
    "也许是门关上的方式。"

# game/murdochroute4.rpy:4641
translate Schinese failuremerge_491a5669:

    # "Or the feeling that I’ve left something unfinished."
    "也许是该做的事还没做完。"

# game/murdochroute4.rpy:4643
translate Schinese failuremerge_73a8f37e:

    # "But Ralph's answer is satisfactory enough."
    "但Ralph的回答已经足够了。"

# game/murdochroute4.rpy:4645
translate Schinese failuremerge_cd79f48a:

    # "I don’t want to hold up Cynthia anymore than I already have."
    "我也不想继续拖累Cynthia。"

# game/murdochroute4.rpy:4647
translate Schinese failuremerge_d8313ecf:

    # "So we keep on walking."
    "于是我们继续前行。"

# game/murdochroute4.rpy:4650
translate Schinese failuremerge_7d39876e:

    # "White ash sifts through the air as we go."
    "白色的灰从空中飘落。"

# game/murdochroute4.rpy:4652
translate Schinese failuremerge_21a8bf04:

    # "It might feel like freshly fallen snow if it wasn’t in the dead of summer heat."
    "要不是正值盛夏，简直像一场新雪。"

# game/murdochroute4.rpy:4654
translate Schinese failuremerge_8414dd24:

    # "The Hip didn’t make it."
    "Hip没保住。"

# game/murdochroute4.rpy:4656
translate Schinese failuremerge_3baa17bf:

    # "Neither did city hall."
    "镇公所也毁了。"

# game/murdochroute4.rpy:4658
translate Schinese failuremerge_d1fb81ef:

    # "We’re lucky the train station didn’t get caught up in the fire, else we would be standing in the heat with no escape from the sun."
    "万幸火车站没被烧到，不然在这烈阳天里，我们连个落脚的地方都没有。"

# game/murdochroute4.rpy:4661
translate Schinese failuremerge_71408323:

    # "A crowd like nothing I’ve never seen before has assembled in the ticket lines."
    "售票处前密密麻麻全是人，那规模我头一回见。"

# game/murdochroute4.rpy:4663
translate Schinese failuremerge_8865a65a:

    # "I can see a flash of red fur within the crowd."
    "我在人群中瞥见一抹红色。"

# game/murdochroute4.rpy:4665
translate Schinese failuremerge_a8693e6a:

    # "When I make my way deep enough through, I can see who it belongs to."
    "我拼命往里挤，直到看清那红毛的主人。"

# game/murdochroute4.rpy:4668
translate Schinese failuremerge_0aefacd5:

    # m "\"Holly Byrnes.\""
    m "“Holly Byrnes。”"

# game/murdochroute4.rpy:4669
translate Schinese failuremerge_da637587:

    # "She tilts her head before turning it."
    "她歪了下头，然后转身。"

# game/murdochroute4.rpy:4671
translate Schinese failuremerge_29bd03aa:

    # ho "\"Oh. You.\""
    ho "“是你啊。”"

# game/murdochroute4.rpy:4673
translate Schinese failuremerge_32916f9f:

    # "She closes her eyes, unbothered, rubbing her forehead with the back of her palm."
    "她闭着眼，一脸不在乎地用手背揉了揉额角。"

# game/murdochroute4.rpy:4675
translate Schinese failuremerge_655b29e5:

    # ho "\"I didn’t much expect to run into you again.\""
    ho "“没想到会在这里遇见你。”"

# game/murdochroute4.rpy:4677
translate Schinese failuremerge_4a68aeac:

    # m "\"I can say the same.\""
    m "“我也没想到。”"

# game/murdochroute4.rpy:4679
translate Schinese failuremerge_90cd340b_1:

    # m "\"Where’s Murdoch?\""
    m "“Murdoch在哪？”"

# game/murdochroute4.rpy:4681
translate Schinese failuremerge_39b786af:

    # "A twinge of annoyance flashes across her face."
    "她脸上闪过一丝不悦。"

# game/murdochroute4.rpy:4683
translate Schinese failuremerge_bcef83bf:

    # ho "\"I’m not sure why you’re asking me.\""
    ho "“我不清楚你为什么要问我。”"

# game/murdochroute4.rpy:4685
translate Schinese failuremerge_e0b336ac:

    # m "\"I was told he went to the train station with you.\""
    m "“有人说你们一起去了火车站。”"

# game/murdochroute4.rpy:4687
translate Schinese failuremerge_52107312:

    # m "\"At your insistence.\""
    m "“在你的坚持下。”"

# game/murdochroute4.rpy:4689
translate Schinese failuremerge_c0e3f59a:

    # ho "\"Hrm.\""
    ho "“嗯。”"

# game/murdochroute4.rpy:4691
translate Schinese failuremerge_b89e3755:

    # ho "\"If that were the case, he would be here, wouldn’t he?\""
    ho "“既然如此，他应该跟我在一起才对吧？”"

# game/murdochroute4.rpy:4693
translate Schinese failuremerge_499b85ea:

    # m "\"Yes.\""
    m "“是啊。”"

# game/murdochroute4.rpy:4695
translate Schinese failuremerge_bf293c7a:

    # ho "\"Well, as you can see, he isn’t.\""
    ho "“不过，如你所见，他并不在。”"

# game/murdochroute4.rpy:4697
translate Schinese failuremerge_03e0f990:

    # "She could be lying to me."
    "她可能在骗我。"

# game/murdochroute4.rpy:4699
translate Schinese failuremerge_73463806:

    # "She probably is lying to me."
    "她八成是在骗我。"

# game/murdochroute4.rpy:4701
translate Schinese failuremerge_7ade962a:

    # "But I can’t shake the fact that she’s right."
    "但她的话我无法反驳。"

# game/murdochroute4.rpy:4703
translate Schinese failuremerge_018d54d3:

    # "I can see Jim standing near her, avoiding eye contact with me."
    "我看到Jim就站在她身旁，故意躲着我的目光。"

# game/murdochroute4.rpy:4705
translate Schinese failuremerge_5574fa6d:

    # "But no other flash of red."
    "却不见其他红毛。"

# game/murdochroute4.rpy:4707
translate Schinese failuremerge_86126630:

    # "No other red fox in the crowd."
    "人群中没有第二只赤狐。"

# game/murdochroute4.rpy:4709
translate Schinese failuremerge_80c3e519:

    # ho "\"My brother is free to live his own life.\""
    ho "“我弟弟想怎么活是他的自由。”"

# game/murdochroute4.rpy:4712
translate Schinese failuremerge_f698b618:

    # ho "\"It’s about time he started.\""
    ho "“他也该真正活一次了。”"

# game/murdochroute4.rpy:4715
translate Schinese failuremerge_3b73520c:

    # "The whistle blows. The doors of the train open."
    "汽笛鸣响，火车门随之打开。"

# game/murdochroute4.rpy:4717
translate Schinese failuremerge_eb3c8569:

    # ho "\"Are you ready, dear?\""
    ho "“准备好了吗，亲爱的？”"

# game/murdochroute4.rpy:4720
translate Schinese failuremerge_abbf5974:

    # "The silver fox has the look of somebody deeply troubled but made up in his mind."
    "银狐看起来心事重重，但他没有迟疑。"

# game/murdochroute4.rpy:4723
translate Schinese failuremerge_f9a1d25c:

    # ji "\"I am.\""
    ji "“准备好了。”"

# game/murdochroute4.rpy:4726
translate Schinese failuremerge_96af5d68:

    # ho "\"Then let’s not look back.\""
    ho "“那就走吧，别回头。”"

# game/murdochroute4.rpy:4728
translate Schinese failuremerge_a52dedef:

    # "She holds out her paw to him."
    "她向他伸手。"

# game/murdochroute4.rpy:4732
translate Schinese failuremerge_34352670:

    # "He takes it and they step on board."
    "他握住，随后两人便上了车。"

# game/murdochroute4.rpy:4734
translate Schinese failuremerge_5f3ddbd8:

    # m "\"Holly what the hell HAPPENED last night?\""
    m "“Holly，昨晚到底{b}发生{/b}了什么？”"

# game/murdochroute4.rpy:4736
translate Schinese failuremerge_54b58e3d:

    # "She stops for a moment at the door."
    "她在门边顿了一下。"

# game/murdochroute4.rpy:4738
translate Schinese failuremerge_f58c77e7:

    # "I hear her speak."
    "开口说道："

# game/murdochroute4.rpy:4740
translate Schinese failuremerge_4475fa98:

    # ho "\"You can see that he’s not with us.\""
    ho "“你看得出来，他没有跟我们在一起。”"

# game/murdochroute4.rpy:4742
translate Schinese failuremerge_2f795f9d:

    # "And then she disappears."
    "说完她没入车厢。"

# game/murdochroute4.rpy:4744
translate Schinese failuremerge_6614e40f:

    # "Dozens more fill into the train."
    "更多人涌进火车。"

# game/murdochroute4.rpy:4746
translate Schinese failuremerge_99477cc2:

    # "I look around me, half expecting to see some sign of Murdoch."
    "我左顾右盼，希望能发现Murdoch的身影。"

# game/murdochroute4.rpy:4748
translate Schinese failuremerge_dd645ed3:

    # "But there isn’t any."
    "但什么也没有。"

# game/murdochroute4.rpy:4750
translate Schinese failuremerge_706573ce:

    # cy "\"Sam, are you getting on the train?\""
    cy "“Sam，你还要不要上车了？”"

# game/murdochroute4.rpy:4752
translate Schinese failuremerge_ebd5094d:

    # m "\"Huh...?\""
    m "“啊...？”"

# game/murdochroute4.rpy:4754
translate Schinese failuremerge_7078ebbf:

    # cy "\"Everybody’s boarding!\""
    cy "“火车都快满了！”"

# game/murdochroute4.rpy:4756
translate Schinese failuremerge_37ef442b:

    # cy "\"You got your ticket, right?\""
    cy "“你有票，对吧？”"

# game/murdochroute4.rpy:4758
translate Schinese failuremerge_6bff4e6b_1:

    # m "\"...Yeah.\""
    m "“...有。”"

# game/murdochroute4.rpy:4760
translate Schinese failuremerge_1b451e7c:

    # "She’s right."
    "她说得对。"

# game/murdochroute4.rpy:4762
translate Schinese failuremerge_704bd6cb:

    # "But I’m not sure what to do."
    "但我不知该如何是好。"

# game/murdochroute4.rpy:4764
translate Schinese failuremerge_b35e429d:

    # "There’s a possibility Murdoch is already on that train."
    "Murdoch可能已经在火车上了。"

# game/murdochroute4.rpy:4766
translate Schinese failuremerge_95eb7d1d:

    # "Is he avoiding me?"
    "他是在躲我吗？"

# game/murdochroute4.rpy:4768
translate Schinese failuremerge_78ef3828:

    # "I wouldn’t know why."
    "我不明白为什么。"

# game/murdochroute4.rpy:4770
translate Schinese failuremerge_4dcce2b6:

    # "I haven’t done anything."
    "我什么都没做啊。"

# game/murdochroute4.rpy:4772
translate Schinese failuremerge_b037163a:

    # "But if he isn’t on the train, where would he be?"
    "可他不在车上的话，又能去哪儿？"

# game/murdochroute4.rpy:4774
translate Schinese failuremerge_11cee0b7:

    # "That doesn’t make sense either."
    "这不合常理。"

# game/murdochroute4.rpy:4776
translate Schinese failuremerge_6e5b57b8:

    # cy "\"Sam, we’ve got to go.\""
    cy "“Sam，我们得走了。”"

# game/murdochroute4.rpy:4778
translate Schinese failuremerge_dc6ac5c6:

    # m "\"But my friend is missing.\""
    m "“可我的朋友不见了。”"

# game/murdochroute4.rpy:4780
translate Schinese failuremerge_10e22a42:

    # cy "\"Which one?\""
    cy "“哪个？”"

# game/murdochroute4.rpy:4782
translate Schinese failuremerge_6745d7ed:

    # cy "\"You’ve had a lot of those recently.\""
    cy "“你最近交了挺多朋友的。”"

# game/murdochroute4.rpy:4784
translate Schinese failuremerge_a57a9297:

    # m "\"The red fox.\""
    m "“那只赤狐。”"

# game/murdochroute4.rpy:4786
translate Schinese failuremerge_c2c24598:

    # cy "\"Oh!\""
    cy "“喔！”"

# game/murdochroute4.rpy:4788
translate Schinese failuremerge_6f97b046:

    # cy "\"Hrm.\""
    cy "“嗯...”"

# game/murdochroute4.rpy:4790
translate Schinese failuremerge_5ea13399:

    # cy "\"That family’s never been hurting for money, so if somebody said he’s getting out, I’d believe he has the means.\""
    cy "“他们家没缺过钱，他要是想走，自然有的是办法。”"

# game/murdochroute4.rpy:4792
translate Schinese failuremerge_9788f6f8:

    # m "\"...Right.\""
    m "“...也对。”"

# game/murdochroute4.rpy:4794
translate Schinese failuremerge_4fbcc48b:

    # cy "\"Why don’t you come with me to Payton and we can work it out?\""
    cy "“不如先跟我去佩顿，到了那边再从长计议？”"

# game/murdochroute4.rpy:4796
translate Schinese failuremerge_2e550946:

    # cy "\"We’ve got to get out of here until the roads are cleared anyway.\""
    cy "“不管怎么样，咱们都得先撤出去，等路通了再说。”"

# game/murdochroute4.rpy:4798
translate Schinese failuremerge_f10cd663:

    # cy "\"If he’s still here, it’s only a short train ride back?\""
    cy "“他要真的没走，咱们回来也就一趟车的事儿，对吧？”"

# game/murdochroute4.rpy:4800
translate Schinese failuremerge_fdded483:

    # "That seems like the sensible option."
    "听起来是个好办法。"

# game/murdochroute4.rpy:4802
translate Schinese failuremerge_c9188ca6:

    # "But something feels wrong."
    "可我心里总觉得不太踏实。"

# game/murdochroute4.rpy:4804
translate Schinese failuremerge_01058330:

    # "Like I’ve missed something."
    "我好像错过了什么。"

# game/murdochroute4.rpy:4806
translate Schinese failuremerge_3e48424c:

    # "Something I can’t afford to miss."
    "某种我绝不可错过的事物。"

# game/murdochroute4.rpy:4808
translate Schinese failuremerge_8bdd5ca4:

    # "I don’t know."
    "我不知道。"

# game/murdochroute4.rpy:4812
translate Schinese failuremerge_e771e908:

    # "All I know is that I feel terrible, like my stomach is sinking."
    "我只知道自己很难受，胃里像压了块石头。"

# game/murdochroute4.rpy:4816
translate Schinese failuremerge_c608345f:

    # "But I board that train."
    "但我还是上了火车。"

# game/murdochroute4.rpy:4819
translate Schinese failuremerge_3ab81b23:

    # "And I walk each and every cart as it starts to move."
    "火车启动时，我顺着车厢一节一节地找过去。"

# game/murdochroute4.rpy:4821
translate Schinese failuremerge_e1b1db10:

    # "I can’t find him."
    "就是找不到他。"

# game/murdochroute4.rpy:4823
translate Schinese failuremerge_1671f191:

    # "I find Ralph Walker sitting alone."
    "Ralph Walker独自一人坐在座位上。"

# game/murdochroute4.rpy:4825
translate Schinese failuremerge_58548615:

    # "I decide to sit beside him."
    "我决定坐到他旁边。"

# game/murdochroute4.rpy:4826
translate Schinese failuremerge_fde90112:

    # "Tell him something I think he already knows."
    "告诉他一些我觉得他已经知道的事。"

# game/murdochroute4.rpy:4827
translate Schinese failuremerge_9376e556:

    # m "\"He’s not on this train.\""
    m "“他不在车上。”"

# game/murdochroute4.rpy:4829
translate Schinese failuremerge_0ac0335f:

    # ra "\"Or if he is, he’s hiding from us.\""
    ra "“要么没上车，要么就是避着咱们。”"

# game/murdochroute4.rpy:4830
translate Schinese failuremerge_d558b60d:

    # ra "\"I’m sorry.\""
    ra "“我很抱歉。”"

# game/murdochroute4.rpy:4831
translate Schinese failuremerge_431aedfa:

    # m "\"Sorry for what?\""
    m "“为什么？”"

# game/murdochroute4.rpy:4833
translate Schinese failuremerge_77eada3a:

    # ra "\"For knowing what it’s like to be me.\""
    ra "“因为现在我们感同身受。”"

# game/murdochroute4.rpy:4834
translate Schinese failuremerge_9c02709f:

    # ra "\"He’d rather chase the past than be in the present.\""
    ra "“他宁愿追逐过去，也不愿面对当下。”"

# game/murdochroute4.rpy:4836
translate Schinese failuremerge_65a7576a:

    # ra "\"You might see him again one day.\""
    ra "“有朝一日，你可能会再见到他。”"

# game/murdochroute4.rpy:4837
translate Schinese failuremerge_aa439ab7:

    # ra "\"But you’ll just remember how things can never be the same.\""
    ra "“但你记住一点：事情再也回不到从前了。”"

# game/murdochroute4.rpy:4838
translate Schinese failuremerge_b9c04d9f:

    # m "\"But what does that have to do with where he is?\""
    m "“这跟他在哪又有什么关系？”"

# game/murdochroute4.rpy:4839
translate Schinese failuremerge_943bfb81:

    # ra "\"Because he’s not with you.\""
    ra "“因为他没和你在一起。”"

# game/murdochroute4.rpy:4841
translate Schinese failuremerge_b84cdbaa:

    # ra "\"Accept that point.\""
    ra "“接受这个事实吧。”"

# game/murdochroute4.rpy:4842
translate Schinese failuremerge_e68b6fad:

    # m "\"That doesn’t make any damn sense.\""
    m "“这什么鬼逻辑。”"

# game/murdochroute4.rpy:4844
translate Schinese failuremerge_7e53a65a:

    # ra "\"Welcome to people.\""
    ra "“欢迎来到人间。”"

# game/murdochroute4.rpy:4845
translate Schinese failuremerge_3999cfb8:

    # ra "\"You must be new.\""
    ra "“门外汉。”"

# game/murdochroute4.rpy:4847
translate Schinese failuremerge_6b3e0ac3:

    # "We don’t talk for the rest of the train ride."
    "剩下的车程里，我们谁都没有说话。"

# game/murdochroute4.rpy:4849
translate Schinese failuremerge_3e40ea97:

    # "That's the last time I see Ralph Walker, who elects to stay on the train."
    "那是我最后一次见到Ralph Walker，他留在了那列火车上。"

# game/murdochroute4.rpy:4851
translate Schinese failuremerge_128c6b5e:

    # "He says he isn’t stopping until he reaches the sea."
    "说是要一路坐到海边为止。"

# game/murdochroute4.rpy:4853
translate Schinese failuremerge_b8b0b598:

    # "When we arrive in Payton, I don’t see Murdoch get off the train."
    "抵达佩顿时，我没看到Murdoch下车。"

# game/murdochroute4.rpy:4854
translate Schinese failuremerge_4b8a3a78:

    # "Just another flash of red fur from one of the windows that must be Holly’s as the train continues into the east."
    "火车继续向东行驶，只见一扇窗户闪过一抹红色，估计是Holly。"

# game/murdochroute4.rpy:4856
translate Schinese failuremerge_b297ee21:

    # "Cynthia’s rendezvous in Payton is a little bed and breakfast."
    "Cynthia在佩顿的会合点是一家小旅馆。"

# game/murdochroute4.rpy:4857
translate Schinese failuremerge_63d93160:

    # "Scarlet shows up with a sizable chunk of money to put her, me, and a few of the other Hip girls up for a while."
    "Scarlet带着一笔数目不小的钱过来，把我、她自己，还有几个Hip的姑娘都安顿了下来。"

# game/murdochroute4.rpy:4858
translate Schinese failuremerge_33b72a6c:

    # "News of what has happened in Echo is spreading across the nation."
    "回音镇的事故传遍了全国。"

# game/murdochroute4.rpy:4859
translate Schinese failuremerge_6f6eb664:

    # "There are a few interviews from Mayor Testerman in the local paper announcing his resignation, as little there is left to govern."
    "地方报纸上有几篇Testerman镇长的采访，他宣布辞职了，毕竟也没剩什么东西给他治理。"

# game/murdochroute4.rpy:4860
translate Schinese failuremerge_9b21a43a:

    # "A long list of missing people runs through the paper."
    "失踪人员名单列了长长一串。"

# game/murdochroute4.rpy:4861
translate Schinese failuremerge_ca940ba8:

    # "Some of the more notable names include James Hendricks and William Adler."
    "名单上比较显眼的有James Hendricks和William Adler。"

# game/murdochroute4.rpy:4862
translate Schinese failuremerge_0bd867d6:

    # "Murdoch Byrnes isn’t mentioned, though the paper does state there are likely unaccounted-for persons."
    "没有Murdoch Byrnes的名字，但报纸也说了，可能还有遗漏。"

# game/murdochroute4.rpy:4868
translate Schinese failuremerge_d4193009:

    # "After relying on Scarlet’s hospitality for a while, I decided to take the train back to Echo."
    "靠着Scarlet的接济住了一段时间后，我决定坐火车回去。"

# game/murdochroute4.rpy:4870
translate Schinese failuremerge_97297e8f:

    # "When I arrived, I wasn’t too shocked to see how little had been repaired or cleaned up."
    "毫不意外的，回音镇几乎没有被修缮或清理过。"

# game/murdochroute4.rpy:4871
translate Schinese failuremerge_eab36ee1:

    # "It was almost like all of the lifeblood had drained from it and spilled into Payton."
    "仿佛这里的命脉被抽干，尽数流向了佩顿。"

# game/murdochroute4.rpy:4872
translate Schinese failuremerge_71c8602a:

    # "Everything was familiar, but unfamiliar."
    "一切既熟悉，又陌生。"

# game/murdochroute4.rpy:4873
translate Schinese failuremerge_f6dd5fe9:

    # "Porches where people drank and hollered were crusted with black dust."
    "曾经供人们饮酒作乐的门廊，如今覆满黑尘。"

# game/murdochroute4.rpy:4874
translate Schinese failuremerge_7d7e1264:

    # "Roads where traffic ran heavy had only tracks."
    "曾经车水马龙的道路，如今只余车辙。"

# game/murdochroute4.rpy:4875
translate Schinese failuremerge_ddbae2ff:

    # "The place was a shell of itself."
    "这镇子只剩下一具空壳了。"

# game/murdochroute4.rpy:4876
translate Schinese failuremerge_a731d71d:

    # "The tent city was still here though."
    "不过帐篷区还在。"

# game/murdochroute4.rpy:4877
translate Schinese failuremerge_78a30ff2:

    # "People were still living here."
    "还有人住在这里。"

# game/murdochroute4.rpy:4878
translate Schinese failuremerge_723542cd:

    # "The ones who couldn’t get out, or didn’t want to leave."
    "那些出不去，或不愿离开的人。"

# game/murdochroute4.rpy:4879
translate Schinese failuremerge_3b2919f4:

    # "Life recovered partially."
    "生活勉强有了些起色。"

# game/murdochroute4.rpy:4881
translate Schinese failuremerge_a650f1fd:

    # "The Stag didn’t get hit by the fire, but it was on its last legs."
    "Stag没被大火波及，但也离关门也不远了。"

# game/murdochroute4.rpy:4883
translate Schinese failuremerge_e3afb8e1:

    # "I sat there on weekends, waiting for a guitar pluck or a gentle tap on my shoulder, but it never came."
    "每个周末，我都会坐在那里，等待某个人弹奏吉他或拍我肩膀，可始终等不到。"

# game/murdochroute4.rpy:4885
translate Schinese failuremerge_3dd77e3b:

    # "At times the pit in my stomach turned to bitter acid."
    "有时候，胃里的空洞会化为苦涩的酸水。"

# game/murdochroute4.rpy:4887
translate Schinese failuremerge_bc726b65:

    # "Where had he gone?"
    "他去哪了？"

# game/murdochroute4.rpy:4889
translate Schinese failuremerge_a9cef83b:

    # "Had something happened to him, or did he trick me?"
    "是出事了，还是他骗了我？"

# game/murdochroute4.rpy:4891
translate Schinese failuremerge_e091705d:

    # "How can somebody say that they care about you more than anything one day, then disappear altogether the next?"
    "为什么昨天还说着我在他心里胜过一切，隔天就人间蒸发了？"

# game/murdochroute4.rpy:4893
translate Schinese failuremerge_12a55d24:

    # "As if nothing happened?"
    "像是什么都没发生过？"

# game/murdochroute4.rpy:4895
translate Schinese failuremerge_7bf43377:

    # "As if we hadn’t happened."
    "像是我们之间什么都没发生过。"

# game/murdochroute4.rpy:4897
translate Schinese failuremerge_b1c74f38:

    # "But it did happen."
    "但那些回忆是实实在在的。"

# game/murdochroute4.rpy:4899
translate Schinese failuremerge_f114d630:

    # "I remember it like it was yesterday."
    "我仍然历历在目。"

# game/murdochroute4.rpy:4901
translate Schinese failuremerge_7cca650e:

    # "Sometimes it felt like he was still right there with me, telling me his worries or brushing his muzzle against me."
    "有时我会产生一种错觉：他还在我身边，诉说着自己的烦恼，或者用鼻头轻轻蹭我。"

# game/murdochroute4.rpy:4903
translate Schinese failuremerge_a1ce0de2:

    # "The more time passed, the more it felt like time wasn’t real."
    "日子越久，越感觉时间不真实。"

# game/murdochroute4.rpy:4905
translate Schinese failuremerge_44b07208:

    # "Each day I felt more like I was there with him, in that summer."
    "每一天过去，我都更觉得自己还和他在一起，停留在那个夏天。"

# game/murdochroute4.rpy:4907
translate Schinese failuremerge_692515e4:

    # "I walked by his house on occasion."
    "我偶尔会路过他家。"

# game/murdochroute4.rpy:4909
translate Schinese failuremerge_024310eb:

    # "Somebody still lived there, but I never saw them come out."
    "有人住，但从不见人出来。"

# game/murdochroute4.rpy:4911
translate Schinese failuremerge_bd81de91:

    # "I learned it was his mother, after she had sold the house."
    "后来我才知道那是他母亲，知道的时候她已经把房子卖了。"

# game/murdochroute4.rpy:4913
translate Schinese failuremerge_65e569ff:

    # "When she left, the school closed."
    "她离开后，学校也跟着关停了。"

# game/murdochroute4.rpy:4915
translate Schinese failuremerge_e899772c:

    # "After it was abandoned, I broke in."
    "学校废弃后，我撬门闯了进去。"

# game/murdochroute4.rpy:4917
translate Schinese failuremerge_5ba05212:

    # "The walls were painted slightly different, but it was the same place."
    "墙壁刷的颜色和以前不太一样，但地方还是那个地方。"

# game/murdochroute4.rpy:4919
translate Schinese failuremerge_ef167f80:

    # "It had the same photos."
    "同样的照片。"

# game/murdochroute4.rpy:4921
translate Schinese failuremerge_19560eca:

    # "The same trophies."
    "同样的奖杯。"

# game/murdochroute4.rpy:4923
translate Schinese failuremerge_dd6f0bdc:

    # "The same musty smells."
    "同样的霉味。"

# game/murdochroute4.rpy:4925
translate Schinese failuremerge_7b7a2d84:

    # "I knew he wasn’t here, but this was the last place I had seen him."
    "我知道他不在这里，但这毕竟是我最后一次见到他的地方。"

# game/murdochroute4.rpy:4927
translate Schinese failuremerge_e75b34d5:

    # "I needed a hint."
    "我需要线索。"

# game/murdochroute4.rpy:4929
translate Schinese failuremerge_cfa93b86:

    # "He was always sharing hints he found with me, wasn’t he?"
    "他总是把他的发现分享给我，不是吗？"

# game/murdochroute4.rpy:4931
translate Schinese failuremerge_ddfeadbd:

    # "But it was just another sterile building."
    "但到头来，这学校不过是另一具空壳。"

# game/murdochroute4.rpy:4933
translate Schinese failuremerge_8edca564:

    # "I checked the auditorium."
    "我检查了礼堂。"

# game/murdochroute4.rpy:4935
translate Schinese failuremerge_fc8319d8:

    # "The classrooms."
    "教室。"

# game/murdochroute4.rpy:4937
translate Schinese failuremerge_14954165:

    # "The offices."
    "办公室。"

# game/murdochroute4.rpy:4939
translate Schinese failuremerge_8fe6f8d1:

    # "There was no trace left of Murdoch Byrnes, or his sisters."
    "没有Murdoch Byrnes和他姐妹们的踪迹，一点都没有。"

# game/murdochroute4.rpy:4941
translate Schinese failuremerge_de7eb4cc:

    # "The observatory had long been relocated."
    "天文台也在很多年前就搬走了。"

# game/murdochroute4.rpy:4943
translate Schinese failuremerge_0a5ea803:

    # "The last place I needed to check was the basement."
    "最后要检查的地方是地下室。"

# game/murdochroute4.rpy:4945
translate Schinese failuremerge_45900144:

    # "The door was locked, but I wasn’t going to let that stop me."
    "门锁着，但我可不会打退堂鼓。"

# game/murdochroute4.rpy:4948
translate Schinese failuremerge_991f0d44:

    # "I was still strong enough to break it, even though I was long past my prime, and my joints were starting to hurt."
    "哪怕早过了壮年，关节开始犯疼，可撞开这扇门的力气我还拿得出来。"

# game/murdochroute4.rpy:4951
translate Schinese failuremerge_357ede2f:

    # "The basement had only gotten worse."
    "地下室比以前更糟了。"

# game/murdochroute4.rpy:4952
translate Schinese failuremerge_f5b71d15:

    # "More dusty."
    "更多尘埃。"

# game/murdochroute4.rpy:4953
translate Schinese failuremerge_6e272015:

    # "But it felt the same."
    "不过给我的感觉没变。"

# game/murdochroute4.rpy:4954
translate Schinese failuremerge_b76f98a4:

    # "Everything was left as we put it."
    "东西都在原位，一如我们当初走的时候。"

# game/murdochroute4.rpy:4955
translate Schinese failuremerge_05297cd5:

    # "Even the cellar door was left exposed."
    "地窖门也还暴露在外面。"

# game/murdochroute4.rpy:4956
translate Schinese failuremerge_edc48353:

    # "Except that the locks were open."
    "只唯独，那道锁是开着的。"

translate Schinese strings:

    # game/murdochroute4.rpy:4236
    old "Ask Murdoch."
    new "询问Murdoch。"

    # game/murdochroute4.rpy:4264
    old "Give Up."
    new "放弃。"